true; }\n    if (type === 'window-change') { var c = r.u32(), ro = r.u32(); if (this.pty) { this.pty.cols = c; this.pty.rows = ro; } this.emit('resize', c, ro); return true; }\n    return false;\n};\n// flow-controlled write to the client. Data is queued and sent as the client opens its window; returns false when the\n// queue is above the high-water mark so producers can pause (see 'drain').\nChannel.prototype.write = function (buf) {\n    if (this.closed) return false;\n    if (typeof buf === 'string') buf = Buffer.from(buf, 'utf8');\n    if (buf.length) { this.outQ.push(buf); this.outPending += buf.length; this._flush(); }\n    return this.outPending < this.HIGH;\n};\nChannel.prototype._flush = function () {\n    while (this.outQ.length && this.peerWin > 0 && !this.sentClose) {\n        var head = this.outQ[0];\n        var room = Math.min(this.peerWin, this.peerMax, head.length);\n        var slice = head.length === room ? this.outQ.shift() : (this.outQ[0] = head.slice(room), head.slice(0, room));\n        this.conn.send(new Writer().byte(MSG.CHANNEL_DATA).u32(this.peerId).string(slice).done());\n        this.peerWin -= slice.length; this.outPending -= slice.length;\n    }\n    if (!this.outQ.length) {\n        if (this.outPending < this.HIGH) this.emit('drain');\n        if (this.wantEof) this._sendEof();\n    }\n};\nChannel.prototype.writeStderr = function (buf) {\n    if (this.closed) return; if (typeof buf === 'string') buf = Buffer.from(buf, 'utf8');\n    // stderr is small (shell diagnostics); send directly but still respect the window counter.\n    this.conn.send(new Writer().byte(MSG.CHANNEL_EXTENDED_DATA).u32(this.peerId).u32(1).string(buf).done());\n    this.peerWin -= buf.length;\n};\nChannel.prototype.exit = function (code) {\n    if (this.sentClose || this._exitSent) return; this._exitSent = true;\n    this.conn.send(new Writer().byte(MSG.CHANNEL_REQUEST).u32(this.peerId).string('exit-status').bool(false).u32(code >>> 0).done());\n    this.eof();\n    // close once everything queued has been written\n    var self = this;\n    if (!this.outQ.length) this.close(); else this.once('drain', function () { self.close(); });\n};\nChannel.prototype.eof = function () { if (this.sentEof || this.closed) return; this.wantEof = true; if (!this.outQ.length) this._sendEof(); };\nChannel.prototype._sendEof = function () { if (this.sentEof || this.closed) return; this.sentEof = true; this.wantEof = false; this.conn.send(new Writer().byte(MSG.CHANNEL_EOF).u32(this.peerId).done()); };\nChannel.prototype.close = function () {\n    if (this.sentClose) return; this.sentClose = true; this.closed = true;\n    try { this.conn.send(new Writer().byte(MSG.CHANNEL_CLOSE).u32(this.peerId).done()); } catch (e) {}\n    this._shutdown();\n};\nChannel.prototype._shutdown = function () { if (this._down) return; this._down = true; this.closed = true; delete this.conn.channels[this.id]; this.emit('close'); };\n\nfunction timingEqual(a, b) { if (a.length !== b.length) return false; try { return crypto.timingSafeEqual(a, b); } catch (e) { return false; } }\n\n// ================= public API =================\n// opts: { hostKeyPem, authorizedKeys: [rawEd25519...] | text, log }\n// events: 'shell'(channel), 'exec'(channel, cmd), 'subsystem'(channel, name), 'connection'(conn)\nfunction Server(opts) {\n    EventEmitter.call(this);\n    this.opts = opts || {};\n    this.hostKey = loadHostKey(this.opts.hostKeyPem);\n    this.authorizedKeys = Array.isArray(this.opts.authorizedKeys) ? this.opts.authorizedKeys : parseAuthorizedKeys(this.opts.authorizedKeys);\n    this.connections = [];   // live accepted connections, so stop()/close() can tear them down\n    this.pending = 0;        // connections accepted but not yet authenticated (bounds buffered memory)\n    this.stopped = false;\n    this.listening = false;  // true only while the listener is actually bound\n    this.lastError = null;   // last listener error (e.g. EADDRINUSE), surfaced to the UI\n    var self = this;\n    this.net = net.createServer(function (socket) {\n        // Guard everything: this runs inside Vetro's own process, so an uncaught throw here would crash the service.\n        try {\n            if (self.stopped) { try { socket.destroy(); } catch (x) {} return; }\n            var maxPending = (self.opts.maxPending != null) ? self.opts.maxPending : 8;\n            if (self.pending >= maxPending) {                       // too many half-open sessions: shed load\n                try { socket.destroy(); } catch (x) {}\n                if (self.opts.log) self.opts.log('refused connection: too many unauthenticated sessions');\n                return;\n            }\n            socket.setNoDelay(true);\n            var conn = new Connection(socket, self);\n            self.connections.push(conn);\n            conn.on('end', function () { var i = self.connections.indexOf(conn); if (i >= 0) self.connections.splice(i, 1); });\n            conn.startKex();\n            self.emit('connection', conn);\n        } catch (e) { try { socket.destroy(); } catch (x) {} if (self.opts.log) self.opts.log('accept error: ' + (e && e.message || e)); }\n    });\n    this.net.on('error', function (e) {\n        self.listening = false;\n        self.lastError = (e && e.message) || String(e);\n        if (self.opts.log) self.opts.log('listener error: ' + self.lastError);\n    });\n}\nServer.prototype = Object.create(EventEmitter.prototype);\nServer.prototype.keyAllowed = function (rawKey) {\n    for (var i = 0; i < this.authorizedKeys.length; i++) if (timingEqual(this.authorizedKeys[i], rawKey)) return true;\n    return false;\n};\nServer.prototype.setAuthorizedKeys = function (keysOrText) { this.authorizedKeys = Array.isArray(keysOrText) ? keysOrText : parseAuthorizedKeys(keysOrText); };\nServer.prototype.hostKeyPem = function () { return this.hostKey.pem; };\nServer.prototype.listen = function (port, host, cb) {\n    var self = this; this.stopped = false; this.lastError = null;\n    return this.net.listen(port, host, function () { self.listening = true; if (cb) cb(); });\n};\n// Stop the listener AND tear down every connection already open. Without destroying live sockets, an interactive\n// session keeps running commands and an open SFTP session keeps its uid-5001 fs access after the Shard is switched off.\nServer.prototype.close = function (cb) {\n    this.stopped = true; this.listening = false;\n    var conns = this.connections.slice();\n    this.connections = [];\n    for (var i = 0; i < conns.length; i++) {\n        try { conns[i].disconnect(11, 'server stopping'); } catch (e) {}   // best-effort polite DISCONNECT\n        try { conns[i].socket.destroy(); } catch (e) {}                    // force the socket shut\n        try { conns[i].cleanup(); } catch (e) {}                           // shut down channels now (fires 'close' -> sftp closes fds)\n    }\n    return this.net.close(cb);\n};\nServer.prototype.address = function () { return this.net.address(); };\n\nmodule.exports = {\n    createServer: function (opts) { return new Server(opts); },\n    parseAuthorizedKeys: parseAuthorizedKeys,\n    loadHostKey: loadHostKey,\n    Writer: Writer, Reader: Reader\n};\n","ui.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\"><title>SSH server</title>\n<style>\n:root{--bg:#0b1020;--card:#121a30;--border:#2b3a5c;--text:#e7ecf7;--muted:#9fb0d0;--accent:#7aa2ff;--ok:#5fd08a;--err:#ff8a7a;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}\n@media (prefers-color-scheme:light){:root{--bg:#f4f7ff;--card:#fff;--border:#d3dcef;--text:#0d1430;--muted:#51618a;--accent:#1f49c9;--ok:#1a8a4e;--err:#b3261e}}\n*{box-sizing:border-box}body{margin:0;padding:16px;background:var(--bg);color:var(--text);font:15px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:48rem}\nh2{margin:0 0 2px}h3{margin:0 0 8px;font-size:15px}.sub{color:var(--muted);font-size:13px;margin:0 0 14px}\n.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:14px;margin:12px 0}\n.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}\nbutton{font:inherit;padding:7px 13px;border:1px solid var(--border);border-radius:7px;background:transparent;color:inherit;cursor:pointer}\nbutton.primary{background:var(--accent);border-color:var(--accent);color:#061126}\ninput[type=number]{font:inherit;background:var(--bg);color:inherit;border:1px solid var(--border);border-radius:7px;padding:7px;width:7em}\ntextarea{width:100%;min-height:84px;font-family:var(--mono);font-size:12.5px;background:var(--bg);color:inherit;border:1px solid var(--border);border-radius:7px;padding:8px}\ncode,.mono{font-family:var(--mono)}.mono{word-break:break-all}\n.pill{display:inline-block;padding:1px 8px;border-radius:99px;border:1px solid var(--border);font-size:12px;color:var(--muted)}\n.pill.on{color:var(--ok);border-color:var(--ok)}\n.msg{min-height:1.3em;font-size:13px;margin:6px 0}.msg.err{color:var(--err)}.msg.ok{color:var(--ok)}\npre{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px;overflow:auto;max-height:220px;font-size:12px;white-space:pre-wrap;word-break:break-word}\n.note{color:var(--muted);font-size:12.5px;line-height:1.5}\ntable.hints{border-collapse:collapse;width:100%;font-size:13px}table.hints td{padding:3px 8px 3px 0;vertical-align:top}table.hints td:first-child{white-space:nowrap}\n.warn{border-left:3px solid var(--err);padding-left:10px}\n</style></head><body>\n<h2>SSH server</h2>\n<p class=\"sub\">A real SSH endpoint on the TV, in pure JavaScript. Status: <span id=\"pill\" class=\"pill\">…</span></p>\n\n<div id=\"unsupported\" class=\"card warn\" hidden><p class=\"note\" id=\"unsupported_msg\"></p></div>\n\n<div class=\"card\">\n<h3>What you can do</h3>\n<table class=\"hints\">\n<tr><td><code>ssh&nbsp;-p&nbsp;<span class=\"P\">2222</span>&nbsp;root@<span class=\"IP\">TV-IP</span></code></td><td>interactive <b>root</b> line-shell via Vetro's agent — each command runs as root, <code>cd</code> is remembered. <b>No PTY</b>: no <code>top</code>/<code>vi</code>/<code>less</code> (use <code>top&nbsp;-b&nbsp;-n1</code>)</td></tr>\n<tr><td><code>ssh&nbsp;-p&nbsp;<span class=\"P\">2222</span>&nbsp;root@<span class=\"IP\">TV-IP</span>&nbsp;'id'</code></td><td>runs a single command as <b>root</b> via the agent</td></tr>\n<tr><td><code>sftp&nbsp;-P&nbsp;<span class=\"P\">2222</span>&nbsp;x@<span class=\"IP\">TV-IP</span></code></td><td><code>scp</code>/<code>sftp</code> file transfer as the <b>owner</b> (uid 5001) — owner-readable files</td></tr>\n</table>\n<p class=\"note\">The username is ignored (you authenticate with your key). The interactive shell and single commands run as <b>root</b> through Vetro's agent; file transfer runs in-process as the owner (uid 5001), because the TV's sandbox blocks this process from executing binaries. Keep this on a trusted LAN — never expose the port to the Internet.</p>\n</div>\n\n<div class=\"card\">\n<h3>Authorized keys</h3>\n<p class=\"note\">Paste the <b>public</b> ed25519 key(s) allowed to log in (one per line). Generate one with <code>ssh-keygen -t ed25519</code> and paste the <code>.pub</code>. Keys are stored in this Shard, not in <code>~/.ssh</code>. Applies to new connections at once.</p>\n<textarea id=\"keys\" placeholder=\"ssh-ed25519 AAAA... you@laptop\"></textarea>\n<div class=\"row\"><button id=\"savekeys\" class=\"primary\">Save keys</button> <span class=\"note\" id=\"keycount\"></span></div>\n<div id=\"m_keys\" class=\"msg\"></div>\n</div>\n\n<div class=\"card\">\n<h3>Settings</h3>\n<div class=\"row\"><label>Port <input type=\"number\" id=\"port\" min=\"1\" max=\"65535\" value=\"2222\"></label><button id=\"saveport\">Save port</button></div>\n<div id=\"m_port\" class=\"msg\"></div>\n<p class=\"note\">Host key fingerprint (what your client shows on first connect): <span class=\"mono\" id=\"fp\">…</span></p>\n<div class=\"row\"><button id=\"regen\">Regenerate host key</button></div>\n<div id=\"m_regen\" class=\"msg\"></div>\n</div>\n\n<div class=\"card\"><h3>Log</h3><pre id=\"log\">…</pre></div>\n\n<script>\nfunction $(id){return document.getElementById(id)}\nfunction say(el,t,c){var m=$(el);m.textContent=t||'';m.className='msg'+(c?' '+c:'')}\nfunction post(sub,b){return fetch(sub,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b||{})}).then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d}})})}\nfunction setAll(cls,v){var n=document.querySelectorAll('.'+cls);for(var i=0;i<n.length;i++)n[i].textContent=v}\nfunction show(d){\n $('pill').textContent=d.unsupported?'unsupported':(d.running?('listening · port '+d.port+(d.connections?' · '+d.connections+' client(s)':'')):'off');\n $('pill').className='pill'+(d.running&&!d.unsupported?' on':'');\n if(d.unsupported){$('unsupported').hidden=false;$('unsupported_msg').textContent=d.unsupported}else{$('unsupported').hidden=true}\n if(d.port){$('port').value=d.port;setAll('P',d.port)}\n $('fp').textContent=d.fingerprint||'(server off)';\n $('keycount').textContent=(d.keyCount||0)+' key(s) saved';\n if(d.log)$('log').textContent=d.log.join('\\n')||'(empty)';\n if(d.lastError)say('m_port',d.lastError,'err');\n}\nfunction reload(){fetch('state').then(function(r){return r.json()}).then(show).catch(function(){})}\n$('savekeys').onclick=function(){say('m_keys','Saving…');post('authkeys',{keys:$('keys').value}).then(function(r){say('m_keys',r.d.error?r.d.error:'Saved.',r.d.error?'err':'ok');if(!r.d.error)show(r.d)})};\n$('saveport').onclick=function(){say('m_port','Saving…');post('port',{port:Number($('port').value)}).then(function(r){say('m_port',r.d.error?r.d.error:'Saved (sessions restarted).',r.d.error?'err':'ok');if(!r.d.error)show(r.d)})};\n$('regen').onclick=function(){if(!confirm('Regenerate the host key? Clients that connected before will warn about a changed key.'))return;say('m_regen','Working…');post('regen-hostkey',{}).then(function(r){say('m_regen','Done. New fingerprint below.','ok');show(r.d)})};\nreload();setInterval(reload,5000);\n</script></body></html>\n"}}
