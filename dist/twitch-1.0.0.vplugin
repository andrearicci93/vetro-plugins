\n      \"reloadError\": \"Impossibile ricaricare Twitch.\",\n      \"sessionError\": \"Twitch non ha potuto aggiornare la sessione dell’account.\"\n    },\n    \"indicators\": {\n      \"adFiltered\": \"Pubblicità filtrata\",\n      \"point\": \"+{value} punto canale\",\n      \"points\": \"+{value} punti canale\"\n    }\n  },\n  \"es\": {\n    \"native\": {\n      \"settings\": [\n        \"Configuración\",\n        \"Ajustes\"\n      ],\n      \"loginBack\": [\n        \"Volver atrás\",\n        \"Volver\"\n      ]\n    },\n    \"accounts\": {\n      \"accounts\": \"Cuentas\",\n      \"guest\": \"Invitado\",\n      \"switchAccount\": \"Cambiar de cuenta · {value}\",\n      \"cancellingSignIn\": \"Cancelando el inicio de sesión…\",\n      \"savingAccount\": \"Guardando la cuenta de Twitch…\",\n      \"addingAccount\": \"Añadiendo una cuenta de Twitch · Atrás para cancelar\",\n      \"forgetTitle\": \"¿Olvidar esta cuenta?\",\n      \"manageAccounts\": \"Gestionar cuentas\",\n      \"chooseAccount\": \"¿Quién está viendo?\",\n      \"wait\": \"Espera un momento…\",\n      \"forgetDescription\": \"Elimina la sesión guardada de {value}.\",\n      \"finishSignIn\": \"Termina de iniciar sesión en Twitch o cancela para recuperar tu cuenta anterior.\",\n      \"cancel\": \"Cancelar\",\n      \"forgetAccount\": \"Olvidar {value}\",\n      \"continueSignIn\": \"Continuar el inicio de sesión\",\n      \"cancelSignIn\": \"Cancelar el inicio de sesión\",\n      \"backToProfiles\": \"Volver a los perfiles\",\n      \"signInAgain\": \"Volver a iniciar sesión\",\n      \"currentAccount\": \"Cuenta activa\",\n      \"currentSession\": \"Sesión activa\",\n      \"addAccount\": \"Añadir cuenta\",\n      \"saveAccount\": \"Guardar la cuenta activa\",\n      \"back\": \"Atrás\",\n      \"errorGeneric\": \"La acción de la cuenta ha fallado. Inténtalo de nuevo.\",\n      \"replaceError\": \"Twitch no ha confirmado el cambio de cuenta.\",\n      \"validationError\": \"No se puede verificar la cuenta de Twitch.\",\n      \"identityError\": \"Twitch no ha confirmado esta cuenta.\",\n      \"expiredError\": \"Vuelve a seleccionar esta cuenta para iniciar sesión.\",\n      \"currentExpiredError\": \"Vuelve a iniciar sesión con la cuenta activa.\",\n      \"wrongAccountError\": \"Inicia sesión en la cuenta seleccionada o elige «Añadir cuenta».\",\n      \"signInError\": \"Inicia sesión en Twitch antes de guardar una cuenta.\",\n      \"readyError\": \"Abre Twitch en la TV y espera a que termine de cargar.\",\n      \"keepOpenError\": \"Mantén Twitch abierto hasta que termine el cambio de cuenta.\",\n      \"restoreError\": \"Vuelve a abrir Twitch con la gestión de cuentas activada para recuperar tu cuenta anterior.\",\n      \"pendingError\": \"Termina de iniciar sesión o cancela el cambio de cuenta.\",\n      \"limitError\": \"Olvida una cuenta antes de añadir otra.\",\n      \"reloadError\": \"No se ha podido recargar Twitch.\",\n      \"sessionError\": \"Twitch no ha podido actualizar la sesión de la cuenta.\"\n    },\n    \"indicators\": {\n      \"adFiltered\": \"Anuncio filtrado\",\n      \"point\": \"+{value} punto del canal\",\n      \"points\": \"+{value} puntos del canal\"\n    }\n  },\n  \"de\": {\n    \"native\": {\n      \"settings\": [\n        \"Einstellungen\"\n      ],\n      \"loginBack\": [\n        \"Zurück\",\n        \"Zurückgehen\"\n      ]\n    },\n    \"accounts\": {\n      \"accounts\": \"Konten\",\n      \"guest\": \"Gast\",\n      \"switchAccount\": \"Konto wechseln · {value}\",\n      \"cancellingSignIn\": \"Anmeldung wird abgebrochen…\",\n      \"savingAccount\": \"Twitch-Konto wird gespeichert…\",\n      \"addingAccount\": \"Twitch-Konto hinzufügen · Zurück zum Abbrechen\",\n      \"forgetTitle\": \"Dieses Konto entfernen?\",\n      \"manageAccounts\": \"Konten verwalten\",\n      \"chooseAccount\": \"Wer schaut zu?\",\n      \"wait\": \"Bitte warten…\",\n      \"forgetDescription\": \"Die gespeicherte Sitzung für {value} entfernen.\",\n      \"finishSignIn\": \"Melde dich bei Twitch an oder brich ab, um zum vorherigen Konto zurückzukehren.\",\n      \"cancel\": \"Abbrechen\",\n      \"forgetAccount\": \"{value} entfernen\",\n      \"continueSignIn\": \"Anmeldung fortsetzen\",\n      \"cancelSignIn\": \"Anmeldung abbrechen\",\n      \"backToProfiles\": \"Zurück zu den Profilen\",\n      \"signInAgain\": \"Erneut anmelden\",\n      \"currentAccount\": \"Aktives Konto\",\n      \"currentSession\": \"Aktive Sitzung\",\n      \"addAccount\": \"Konto hinzufügen\",\n      \"saveAccount\": \"Aktives Konto speichern\",\n      \"back\": \"Zurück\",\n      \"errorGeneric\": \"Die Kontoaktion ist fehlgeschlagen. Versuche es erneut.\",\n      \"replaceError\": \"Twitch hat den Kontowechsel nicht bestätigt.\",\n      \"validationError\": \"Die Prüfung des Twitch-Kontos ist nicht verfügbar.\",\n      \"identityError\": \"Twitch hat dieses Konto nicht bestätigt.\",\n      \"expiredError\": \"Wähle dieses Konto erneut aus, um dich anzumelden.\",\n      \"currentExpiredError\": \"Melde dich erneut beim aktiven Konto an.\",\n      \"wrongAccountError\": \"Melde dich beim ausgewählten Konto an oder wähle „Konto hinzufügen“.\",\n      \"signInError\": \"Melde dich bei Twitch an, bevor du ein Konto speicherst.\",\n      \"readyError\": \"Öffne Twitch auf dem Fernseher und warte, bis es geladen ist.\",\n      \"keepOpenError\": \"Lass Twitch geöffnet, bis der Kontowechsel abgeschlossen ist.\",\n      \"restoreError\": \"Öffne Twitch mit aktivierter Kontoverwaltung erneut, um das vorherige Konto wiederherzustellen.\",\n      \"pendingError\": \"Schließe die Anmeldung ab oder brich den Kontowechsel ab.\",\n      \"limitError\": \"Entferne ein Konto, bevor du ein weiteres hinzufügst.\",\n      \"reloadError\": \"Twitch konnte nicht neu geladen werden.\",\n      \"sessionError\": \"Twitch konnte die Kontositzung nicht aktualisieren.\"\n    },\n    \"indicators\": {\n      \"adFiltered\": \"Werbung gefiltert\",\n      \"point\": \"+{value} Kanalpunkt\",\n      \"points\": \"+{value} Kanalpunkte\"\n    }\n  },\n  \"pt\": {\n    \"native\": {\n      \"settings\": [\n        \"Definições\",\n        \"Configurações\"\n      ],\n      \"loginBack\": [\n        \"Voltar\",\n        \"Voltar atrás\"\n      ]\n    },\n    \"accounts\": {\n      \"accounts\": \"Contas\",\n      \"guest\": \"Convidado\",\n      \"switchAccount\": \"Mudar de conta · {value}\",\n      \"cancellingSignIn\": \"A cancelar o início de sessão…\",\n      \"savingAccount\": \"A guardar a conta da Twitch…\",\n      \"addingAccount\": \"A adicionar uma conta da Twitch · Voltar para cancelar\",\n      \"forgetTitle\": \"Esquecer esta conta?\",\n      \"manageAccounts\": \"Gerir contas\",\n      \"chooseAccount\": \"Quem está a ver?\",\n      \"wait\": \"Aguarda um momento…\",\n      \"forgetDescription\": \"Remover a sessão guardada de {value}.\",\n      \"finishSignIn\": \"Conclui o início de sessão na Twitch ou cancela para recuperar a conta anterior.\",\n      \"cancel\": \"Cancelar\",\n      \"forgetAccount\": \"Esquecer {value}\",\n      \"continueSignIn\": \"Continuar a iniciar sessão\",\n      \"cancelSignIn\": \"Cancelar o início de sessão\",\n      \"backToProfiles\": \"Voltar aos perfis\",\n      \"signInAgain\": \"Iniciar sessão novamente\",\n      \"currentAccount\": \"Conta ativa\",\n      \"currentSession\": \"Sessão ativa\",\n      \"addAccount\": \"Adicionar conta\",\n      \"saveAccount\": \"Guardar a conta ativa\",\n      \"back\": \"Voltar\",\n      \"errorGeneric\": \"A ação da conta falhou. Tenta novamente.\",\n      \"replaceError\": \"A Twitch não confirmou a mudança de conta.\",\n      \"validationError\": \"A validação da conta da Twitch está indisponível.\",\n      \"identityError\": \"A Twitch não confirmou esta conta.\",\n      \"expiredError\": \"Seleciona novamente esta conta para iniciar sessão.\",\n      \"currentExpiredError\": \"Inicia sessão novamente na conta ativa.\",\n      \"wrongAccountError\": \"Inicia sessão na conta selecionada ou escolhe «Adicionar conta».\",\n      \"signInError\": \"Inicia sessão na Twitch antes de guardar uma conta.\",\n      \"readyError\": \"Abre a Twitch na TV e aguarda até terminar de carregar.\",\n      \"keepOpenError\": \"Mantém a Twitch aberta até terminar a mudança de conta.\",\n      \"restoreError\": \"Volta a abrir a Twitch com a gestão de contas ativa para recuperar a conta anterior.\",\n      \"pendingError\": \"Conclui o início de sessão ou cancela a mudança de conta.\",\n      \"limitError\": \"Esquece uma conta antes de adicionar outra.\",\n      \"reloadError\": \"Não foi possível recarregar a Twitch.\",\n      \"sessionError\": \"A Twitch não conseguiu atualizar a sessão da conta.\"\n    },\n    \"indicators\": {\n      \"adFiltered\": \"Anúncio filtrado\",\n      \"point\": \"+{value} ponto de canal\",\n      \"points\": \"+{value} pontos de canal\"\n    }\n  }\n};\n\nvar INDICATOR_TRANSLATIONS = translationSource('indicators');\n\nmodule.exports = {\n    translationSource: translationSource,\n    readNativeSession: readNativeSession,\n    showIndicatorScript: showIndicatorScript,\n    hideIndicatorScript: hideIndicatorScript,\n    createAdSkipIndicator: createAdSkipIndicator\n};\n","ui.html":"<!doctype html>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n    body { font: 16px system-ui; margin: 20px; max-width: 48rem; }\n    p { line-height: 1.5; }\n    button { font: inherit; padding: 8px; }\n    section { border: 1px solid #8886; border-radius: 8px; padding: 12px; margin: 12px 0; }\n    pre { white-space: pre-wrap; font-size: 13px; }\n    label { display: block; margin: 8px 0; }\n    input { margin-right: 8px; }\n</style>\n\n<h2>Twitch enhancements</h2>\n<p>Open Twitch with at least one feature enabled. Vetro starts a protected local session and applies the selected features. Opening Twitch from Samsung Home may cause one restart to prepare the session.</p>\n\n<section>\n    <b>Options</b>\n    <label><input type=\"checkbox\" id=\"adFiltering\" disabled>Ad filtering</label>\n    <label><input type=\"checkbox\" id=\"adFallback\" disabled>Use a backup when ad playlists cannot be aligned (experimental)</label>\n    <label><input type=\"checkbox\" id=\"emotes7tv\" disabled>7TV chat emotes</label>\n    <label><input type=\"checkbox\" id=\"adSkipIndicator\" disabled>Show an indicator when an ad is filtered</label>\n    <p>The indicator appears briefly in the top-right corner. It requires ad filtering and is off by default.</p>\n    <label><input type=\"checkbox\" id=\"playerControls\" aria-describedby=\"player-controls-help\" disabled>Improved remote navigation in live streams</label>\n    <p id=\"player-controls-help\">Back can exit a stream with the controls visible, and OK can activate a hidden button. With this option, Back hides visible controls and OK only reveals hidden controls.</p>\n    <label><input type=\"checkbox\" id=\"channelPoints\" aria-describedby=\"channel-points-help\" disabled>Automatically claim channel point bonuses</label>\n    <p id=\"channel-points-help\">Waits a random 3–12 seconds after detecting a bonus, then checks it is still available before claiming. Leaving the stream cancels the pending claim.</p>\n    <label><input type=\"checkbox\" id=\"channelPointsIndicator\" disabled>Show a notification when a bonus is credited</label>\n    <label><input type=\"checkbox\" id=\"accountManager\" disabled>Manage multiple Twitch accounts</label>\n    <label><input type=\"checkbox\" id=\"accountChooserOnLaunch\" disabled>Choose an account when Twitch opens (two or more saved accounts)</label>\n    <p>On the Twitch home screen, select your profile next to Settings to switch accounts. Adding an account uses Twitch’s normal sign-in. Saved sessions are encrypted on this TV. Switching reloads Twitch. Forget saved accounts before uninstalling the plugin if you want to erase them.</p>\n    <div id=\"save-state\" role=\"status\" aria-live=\"polite\">Loading settings…</div>\n    <p>Changes are saved automatically. Turning all features off closes the inspection session. If Twitch is open, it may restart normally.</p>\n</section>\n\n<section>\n    <b>Session</b>\n    <div id=\"state\">Checking…</div>\n    <button id=\"retry\" disabled>Retry preparation</button>\n</section>\n\n<section>\n    <b>Accounts</b>\n    <p id=\"accounts-state\">Account management is disabled.</p>\n    <div id=\"accounts-list\"></div>\n    <button id=\"accounts-manage\" disabled>Manage on TV</button>\n    <button id=\"accounts-add\" disabled>Add account</button>\n    <button id=\"accounts-capture\" disabled>Save current account</button>\n    <button id=\"accounts-cancel\" disabled>Cancel sign-in</button>\n    <button id=\"accounts-forget-all\" disabled>Forget all saved accounts</button>\n    <p id=\"accounts-message\" role=\"status\" aria-live=\"polite\"></p>\n</section>\n\n<section>\n    <b>Ad filtering</b>\n    <pre id=\"filter\">Waiting for Twitch.</pre>\n</section>\n\n<section>\n    <b>7TV chat emotes</b>\n    <pre id=\"emotes\">Waiting for Twitch.</pre>\n</section>\n\n<section>\n    <b>Channel point bonuses</b>\n    <p id=\"points-state\">Disabled</p>\n    <p id=\"points-last\" hidden></p>\n</section>\n\n<p>Switch this plugin off to stop its features. Saved accounts remain available when you enable it again. Some ads may still play.</p>\n<script>\n    var optionKeys = [\n        'adFiltering', 'adFallback', 'emotes7tv', 'adSkipIndicator', 'accountManager',\n        'accountChooserOnLaunch', 'channelPoints', 'channelPointsIndicator', 'playerControls'\n    ];\n    var pointsPhases = {\n        'waiting-for-twitch': 'Waiting for Twitch.',\n        'waiting-for-signed-in-live': 'Waiting for a signed-in live stream.',\n        'waiting-for-native-session': 'Twitch sign-in or client information is unavailable. Retrying…',\n        'points-unavailable': 'Twitch did not return points for this channel.',\n        checking: 'Checking for a bonus…',\n        'waiting-for-bonus': 'Waiting for an available bonus.',\n        scheduled: 'Bonus available. Claim scheduled.',\n        claiming: 'Claiming the bonus…',\n        confirming: 'Waiting for Twitch to confirm the credit…'\n    };\n    var settings = null, saving = false, reloadingSettings = false, settingsRevision = 0;\n    var polling = false, accountsBusy = false;\n\n    function el(id) { return document.getElementById(id); }\n\n    function request(path, options) {\n        return fetch(path, options).then(function (response) {\n            return response.json().then(function (value) {\n                if (!response.ok) throw new Error(value.error || 'Request failed');\n                return value;\n            });\n        });\n    }\n\n    function post(path, value) {\n        return request(path, {\n            method: 'POST',\n            headers: { 'content-type': 'application/json' },\n            body: JSON.stringify(value)\n        });\n    }\n\n    function showSettings() {\n        optionKeys.forEach(function (key) {\n            var checkbox = el(key);\n            checkbox.checked = !!(settings && settings[key]);\n            checkbox.disabled = saving || !settings || (key === 'channelPointsIndicator' && !settings.channelPoints);\n        });\n    }\n\n    // A status request can finish after the user changes an option. Ignore that old reading.\n    function canRenderStatus(expectedRevision) {\n        return !saving && settingsRevision === expectedRevision;\n    }\n\n    function showDetails(path, elementId, format, expectedRevision) {\n        request(path).then(function (value) {\n            if (canRenderStatus(expectedRevision)) el(elementId).textContent = format(value);\n        }).catch(function () {});\n    }\n\n    function renderFilter(value, expectedRevision) {\n        if (!settings.adFiltering) el('filter').textContent = 'Disabled';\n        else if (!value.attached) el('filter').textContent = value.error || 'Waiting for Twitch.';\n        else {\n            showDetails('filter/status', 'filter', function (details) {\n                return JSON.stringify({ network: details.network, indicator: details.indicator }, null, 2);\n            }, expectedRevision);\n        }\n    }\n\n    function renderEmotes(value, expectedRevision) {\n        if (!settings.emotes7tv) el('emotes').textContent = 'Disabled';\n        else if (!value.attached) el('emotes').textContent = value.error || 'Waiting for Twitch.';\n        else {\n            showDetails('emotes/status', 'emotes', function (details) {\n                return JSON.stringify({\n                    global: details.globalEmotes, channel: details.channelEmotes, rendering: details.page, error: details.error\n                }, null, 2);\n            }, expectedRevision);\n        }\n    }\n\n    function poll() {\n        if (polling || saving) return;\n        polling = true;\n        var expectedRevision = settingsRevision;\n\n        request('status').then(function (value) {\n            if (!canRenderStatus(expectedRevision)) return;\n            settings = value.settings;\n            showSettings();\n            if (reloadingSettings) {\n                el('save-state').textContent = 'Save not confirmed. Showing saved settings.';\n                reloadingSettings = false;\n            }\n            if (el('save-state').textContent === 'Loading settings…') el('save-state').textContent = '';\n\n            var anyEnabled = settings.adFiltering || settings.emotes7tv || settings.accountManager ||\n                settings.channelPoints || settings.playerControls;\n            el('retry').disabled = !anyEnabled;\n            var error = value.error || value.session.error;\n            el('state').textContent = (anyEnabled ? '' : 'All features disabled — ') + value.session.phase + (error ? ' — ' + error : '');\n            renderAccounts(value.accounts);\n            renderPoints(value.points);\n            renderFilter(value.filter, expectedRevision);\n            renderEmotes(value.emotes, expectedRevision);\n        }).catch(function () {\n            if (canRenderStatus(expectedRevision)) el('state').textContent = 'Connection unavailable';\n        }).then(function () {\n            polling = false;\n        });\n    }\n\n    function saveOption(key) {\n        if (saving || !settings) return;\n        var patch = {};\n        patch[key] = el(key).checked;\n        saving = true;\n        settingsRevision++;\n        showSettings();\n        el(key).checked = patch[key];\n        el('retry').disabled = true;\n        el('save-state').textContent = 'Saving…';\n\n        post('settings', patch).then(function (value) {\n            settings = value;\n            el('save-state').textContent = 'Saved';\n        }).catch(function (error) {\n            el('save-state').textContent = 'Save not confirmed: ' + error.message + '. Reloading saved settings…';\n            settings = null;\n            reloadingSettings = true;\n        }).then(function () {\n            saving = false;\n            showSettings();\n            poll();\n        });\n    }\n\n    function renderAccounts(value) {\n        value = value || { profiles: [] };\n        var enabled = !!(settings && settings.accountManager);\n        var blocked = !enabled || accountsBusy || !!value.busy;\n        var profiles = value.profiles || [];\n\n        el('accounts-state').textContent = enabled ?\n            (value.phase || 'Waiting for Twitch') + (value.error ? ' — ' + value.error : '') : 'Account management is disabled.';\n        var list = el('accounts-list');\n        while (list.firstChild) list.removeChild(list.firstChild);\n\n        profiles.forEach(function (profile) {\n            var row = document.createElement('p');\n            var label = document.createElement('span');\n            label.textContent = profile.login + (profile.active ? ' (current)' : '') +\n                (profile.state === 'sign-in-required' ? ' — sign in again' : '') + ' ';\n            row.appendChild(label);\n\n            [['Switch', 'switch'], ['Forget', 'forget']].forEach(function (action) {\n                var button = document.createElement('button');\n                button.textContent = action[0];\n                button.disabled = blocked || !!value.adding;\n                button.onclick = function () {\n                    if (action[1] === 'forget' && !confirm('Forget ' + profile.login + ' on this TV? This does not sign out of Twitch.')) return;\n                    accountAction(action[1], profile.id);\n                };\n                row.appendChild(button);\n            });\n            list.appendChild(row);\n        });\n        el('accounts-manage').disabled = blocked;\n        el('accounts-add').disabled = blocked || !!value.adding;\n        el('accounts-capture').disabled = blocked || !value.canCapture || !!value.adding;\n        el('accounts-cancel').disabled = blocked || !value.adding;\n        el('accounts-forget-all').disabled = blocked || !!value.adding || !profiles.length;\n    }\n\n    function renderPoints(value) {\n        value = value || {};\n        el('points-state').textContent = settings.channelPoints ?\n            (value.error || pointsPhases[value.phase] || 'Waiting for Twitch.') : 'Disabled';\n        var claim = settings.channelPoints && value.lastClaim;\n        el('points-last').hidden = !claim;\n        el('points-last').textContent = claim ? 'Last confirmed: +' + claim.points + ' points on ' + claim.channel +\n            ' at ' + new Date(claim.at).toLocaleTimeString() + ' · ' + value.confirmed + ' confirmed' : '';\n    }\n\n    function accountAction(action, id) {\n        if (accountsBusy) return;\n        accountsBusy = true;\n        el('accounts-message').textContent = 'Please wait…';\n        renderAccounts({ phase: 'Working', profiles: [] });\n        var body = { action: action };\n        if (id) body.id = id;\n\n        post('accounts', body).then(function (value) {\n            el('accounts-message').textContent = 'Done';\n            accountsBusy = false;\n            renderAccounts(value);\n            poll();\n        }).catch(function (error) {\n            accountsBusy = false;\n            el('accounts-message').textContent = error.message;\n            poll();\n        });\n    }\n\n    optionKeys.forEach(function (key) {\n        el(key).onchange = function () { saveOption(key); };\n    });\n    ['manage', 'add', 'capture', 'cancel', 'forget-all'].forEach(function (action) {\n        el('accounts-' + action).onclick = function () {\n            if (action === 'forget-all' && !confirm('Forget all saved accounts on this TV? This does not sign out of Twitch.')) return;\n            accountAction(action);\n        };\n    });\n    el('retry').onclick = function () {\n        el('retry').disabled = true;\n        request('retry', { method: 'POST' }).then(poll).catch(function (error) {\n            el('state').textContent = error.message;\n            poll();\n        });\n    };\n\n    poll();\n    setInterval(poll, 3000);\n</script>\n"}}
