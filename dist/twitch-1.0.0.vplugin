cessIdentity === suppressedProcessIdentity) {\n                sessionState.phase = 'normal-fallback';\n                return;\n            }\n            return prepare(snapshot);\n        }\n\n        function handleCheckFailure(error) {\n            sessionState.error = error.message;\n            if (fromTile) {\n                clearReadySession('waiting-for-twitch');\n                return false;\n            }\n            clearReadySession('retrying');\n            preparationFailures++;\n            nextPreparationAttemptAt = Date.now() + Math.min(MAX_PREPARATION_BACKOFF_MS, preparationFailures * PREPARATION_RETRY_STEP_MS);\n            // A normal fallback remains usable until an explicit retry or app exit/reopen.\n            return inspectSession().then(function (snapshot) {\n                sessionState.foreground = snapshot.foreground;\n                if (snapshot.pid && !snapshot.ownedSession) suppressedProcessIdentity = snapshot.pid + ':' + snapshot.start;\n            }).catch(function () {});\n        }\n\n        function finishCheck(handled) {\n            sessionTask = null;\n            if (isCurrent()) {\n                if (fromTile) tileFallbackUntil = handled ? 0 : Date.now() + TILE_FALLBACK_MS;\n                if (onChange && (previousPhase !== sessionState.phase || previousKey !== sessionState.key ||\n                    previousForeground !== sessionState.foreground)) onChange();\n            }\n            return handled;\n        }\n\n        sessionTask = inspectSession().then(handleSnapshot).catch(handleCheckFailure).then(finishCheck);\n        return sessionTask;\n    }\n    function cleanupWithRetry(attempt) {\n        return runSessionScript(sessionShell.cleanupSessionScript({restoreNormalApp: true})).then(function (output) {\n            if (/^lock_unavailable=1$/m.test(output)) throw new Error('Session lock is unavailable');\n            if (!/^busy$/m.test(output)) return output;\n            if (attempt >= MAX_CLEANUP_ATTEMPTS) throw new Error('Session cleanup is busy');\n            return new Promise(function (resolve) { setTimeout(resolve, CLEANUP_RETRY_MS); })\n                .then(function () { return cleanupWithRetry(attempt + 1); });\n        });\n    }\n    return {\n        start: function () {\n            running = true;\n            lifecycleGeneration++;\n            sessionState.phase = 'starting';\n            pollTimer = setInterval(checkSession, SESSION_POLL_MS);\n            if (pollTimer.unref) pollTimer.unref();\n            checkSession();\n        },\n        launch: function () {\n            if (tileLaunchTask) return tileLaunchTask;\n            var generation = lifecycleGeneration;\n            tileLaunchTask = Promise.resolve(sessionTask).then(function () {\n                if (!running || generation !== lifecycleGeneration) return false;\n                return checkSession(true);\n            }).then(function (handled) { tileLaunchTask = null; return handled === true; }, function (error) {\n                tileLaunchTask = null;\n                throw error;\n            });\n            return tileLaunchTask;\n        },\n        stop: function () {\n            running = false;\n            lifecycleGeneration++;\n            if (pollTimer) clearInterval(pollTimer);\n            pollTimer = null;\n            return (sessionTask || Promise.resolve()).then(function () { return cleanupWithRetry(1); }).then(function (output) {\n                clearReadySession(/cleanup_pending=1/.test(output) ? 'cleanup-pending' : 'stopped');\n            }, function () {\n                clearReadySession('cleanup-failed');\n                sessionState.error = 'Close Twitch to end the inspector; its network guard remains until then';\n            });\n        },\n        status: function () {\n            return Object.assign({}, sessionState);\n        },\n        retry: function () {\n            suppressedProcessIdentity = null;\n            tileFallbackUntil = 0;\n            nextPreparationAttemptAt = 0;\n            preparationFailures = 0;\n            checkSession();\n        }\n    };\n};\n","session-shell/cleanup-helpers.sh":"# Locking and mutation helpers, omitted from periodic inspection commands.\nacquire_session_lock() {\n    command -v flock >/dev/null 2>&1 || { echo lock_unavailable=1; return 1; }\n    umask 077\n    exec 9>>\"$SESSION_DIR/session.lock\"\n    if flock -n 9; then return 0; fi\n    release_session_lock\n    echo busy\n    return 1\n}\n\nrelease_session_lock() {\n    exec 9>&-\n}\n\nadd_startup_jump() {\n    \"$1\" -I INPUT 1 ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\" &&\n    \"$1\" -C INPUT ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\"\n}\n\nremove_startup_jump() {\n    rules=$(\"$1\" -S INPUT 2>/dev/null) || return 1\n    if printf '%s\\n' \"$rules\" | awk -v chain=\"$FIREWALL_CHAIN\" '\n        $0 ~ /--(syn|tcp-flags) / && $NF==chain {found=1} END {exit !found}'; then\n        \"$1\" -D INPUT ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\" || return 1\n    fi\n}\n\nremove_startup_guard() {\n    [ -f \"$SESSION_DIR/starting\" ] || return 0\n    if [ -f \"$SESSION_DIR/ipv4-chain\" ]; then remove_startup_jump iptables || return 1; fi\n    if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then remove_startup_jump ip6tables || return 1; fi\n    rm -f \"$SESSION_DIR/starting\" \"$SESSION_DIR/launch-requested\"\n}\n\nremove_isolation_rules() {\n    remove_startup_guard || return 1\n    if [ -n \"$INSPECTOR_PORT\" ]; then\n        iptables -D INPUT -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        iptables -D INPUT -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        iptables -D OUTPUT -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        iptables -D OUTPUT -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then\n            ip6tables -D INPUT ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        fi\n    fi\n    if [ -f \"$SESSION_DIR/ipv4-chain\" ] || [ -f \"$SESSION_DIR/owner\" ]; then\n        iptables -F \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        iptables -X \"$FIREWALL_CHAIN\" 2>/dev/null || true\n    fi\n    if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then\n        ip6tables -F \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        ip6tables -X \"$FIREWALL_CHAIN\" 2>/dev/null || true\n    fi\n    rm -f \"$SESSION_DIR/state.json\" \"$SESSION_DIR/owner\" \"$SESSION_DIR/ipv4-chain\" \"$SESSION_DIR/ipv6-chain\"\n}\n\nretire_owned_session() {\n    rm -f \"$SESSION_DIR/state.json\"\n    # Wait at most three seconds. An unavailable socket table is not proof of closure.\n    listener_checks=0\n    while [ \"$listener_checks\" -le 30 ]; do\n        listener_status=0\n        inspector_is_listening \"$INSPECTOR_PORT\" || listener_status=$?\n        if [ \"$listener_status\" = 1 ]; then\n            remove_isolation_rules && return 0\n            break\n        fi\n        [ \"$listener_checks\" -lt 30 ] || break\n        sleep 0.1\n        listener_checks=$((listener_checks+1))\n    done\n    echo cleanup_pending=1\n    return 1\n}\n\nclose_owned_twitch() {\n    if [ \"$(process_start_time \"$SESSION_PID\")\" = \"$SESSION_START\" ] && [ \"$(twitch_pid)\" = \"$SESSION_PID\" ]; then\n        app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n    fi\n}\n\nrecover_unfinished_startup() {\n    [ -f \"$SESSION_DIR/starting\" ] || return 0\n    if read_owned_session; then\n        close_owned_twitch\n        retire_owned_session\n        return\n    fi\n    if [ -f \"$SESSION_DIR/launch-requested\" ]; then\n        app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        attempts=0\n        while [ \"$attempts\" -le 30 ]; do\n            if app_pid=$(twitch_pid) && [ -z \"$app_pid\" ]; then break; fi\n            sleep 0.1\n            attempts=$((attempts+1))\n        done\n        [ \"$attempts\" -le 30 ] || { echo cleanup_pending=1; return 1; }\n        reported_port=$(sed -n 's/.* port: \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" 2>/dev/null | head -1)\n        if [ -n \"$reported_port\" ] && [ \"$reported_port\" -ge 1024 ] && [ \"$reported_port\" -le 65535 ]; then\n            INSPECTOR_PORT=$reported_port\n            retire_owned_session\n            return\n        fi\n        netstat -ltn >/dev/null 2>&1 || { echo cleanup_pending=1; return 1; }\n    fi\n    remove_isolation_rules || { echo cleanup_pending=1; return 1; }\n}\n\ncleanup_session() {\n    # Close/restore Twitch only when requested; always retain rules until the listener closes.\n    acquire_session_lock || exit 0\n    trap release_session_lock EXIT\n    if [ -f \"$SESSION_DIR/starting\" ]; then\n        recover_unfinished_startup || return 0\n    elif read_owned_session; then\n        WAS_FOREGROUND=0\n        if [ \"$RESTORE_NORMAL_APP\" = 1 ]; then\n            if twitch_is_foreground; then WAS_FOREGROUND=1; fi\n            close_owned_twitch\n        fi\n        RULES_RETIRED=1\n        retire_owned_session || RULES_RETIRED=0\n        if [ \"$RESTORE_NORMAL_APP\" = 1 ] && [ \"$WAS_FOREGROUND\" = 1 ] && [ \"$RULES_RETIRED\" = 1 ]; then\n            app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        fi\n    fi\n    echo cleaned=1\n}\n\nguard_session() {\n    # Runs independently of Vetro; retain isolation until this listener disappears.\n    read_owned_session || exit 0\n    GUARD_PID=$SESSION_PID\n    GUARD_START=$SESSION_START\n    GUARD_PORT=$INSPECTOR_PORT\n    while :; do\n        listener_status=0\n        inspector_is_listening \"$GUARD_PORT\" || listener_status=$?\n        [ \"$listener_status\" != 1 ] || break\n        sleep 5\n    done\n    acquire_session_lock || exit 0\n    trap release_session_lock EXIT\n    if read_owned_session && [ \"$SESSION_PID:$SESSION_START:$INSPECTOR_PORT\" = \"$GUARD_PID:$GUARD_START:$GUARD_PORT\" ]; then\n        retire_owned_session || true\n    fi\n}\n\nguard_startup() {\n    owner_pid=$1\n    owner_start=$2\n    while [ \"$(cat \"$SESSION_DIR/starting\" 2>/dev/null || true)\" = \"$owner_pid $owner_start\" ]; do\n        if [ \"$(process_start_time \"$owner_pid\")\" != \"$owner_start\" ] && acquire_session_lock; then\n            trap release_session_lock EXIT\n            if [ \"$(cat \"$SESSION_DIR/starting\" 2>/dev/null || true)\" = \"$owner_pid $owner_start\" ]; then\n                recover_unfinished_startup || true\n            fi\n            release_session_lock\n            trap - EXIT\n        fi\n        sleep 1\n    done\n}\n","session-shell/prepare.sh":"# Prepare an observed foreground app or start it directly from its launcher tile.\nacquire_session_lock || exit 0\ntrap release_session_lock EXIT\nCURRENT_PID=$(twitch_pid); CURRENT_PID=${CURRENT_PID:-0}\nCURRENT_START=0\n[ \"$CURRENT_PID\" = 0 ] || CURRENT_START=$(process_start_time \"$CURRENT_PID\")\nif [ \"$CURRENT_PID:$CURRENT_START\" != \"$OBSERVED_PID:$OBSERVED_START\" ] ||\n        { [ \"$FROM_TILE\" = 0 ] && ! twitch_is_foreground; }; then\n    echo raced=1\n    exit 0\nfi\nif [ -f \"$SESSION_DIR/starting\" ]; then\n    recover_unfinished_startup || exit 1\n    echo raced=1\n    exit 0\nfi\nif read_owned_session; then\n    if [ \"$FROM_TILE\" = 1 ]; then\n        if [ \"$SESSION_PID:$SESSION_START\" = \"$CURRENT_PID:$CURRENT_START\" ] &&\n                [ -f \"$SESSION_DIR/state.json\" ] && inspector_is_listening \"$INSPECTOR_PORT\" && isolation_rules_present; then\n            if ! twitch_is_foreground; then\n                app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1\n            fi\n            echo reused=1\n            exit 0\n        fi\n        close_owned_twitch\n    fi\n    retire_owned_session || exit 1\n    INSPECTOR_PORT=\nfi\niptables -S INPUT >/dev/null\nif ipv6_available; then ip6tables -S INPUT >/dev/null; fi\nif iptables -nL \"$FIREWALL_CHAIN\" >/dev/null 2>&1 ||\n        { ipv6_available && ip6tables -nL \"$FIREWALL_CHAIN\" >/dev/null 2>&1; }; then\n    echo foreign_chain=1\n    exit 0\nfi\nSESSION_PREPARED=0\nHAD_LAUNCH=0\nLAUNCHER_PID=\n\nrestore_after_failed_preparation() {\n    if [ \"$SESSION_PREPARED\" != 1 ]; then\n        WAS_FOREGROUND=0\n        if twitch_is_foreground; then WAS_FOREGROUND=1; fi\n        if [ -n \"$LAUNCHER_PID\" ]; then\n            kill \"$LAUNCHER_PID\" 2>/dev/null || true\n            wait \"$LAUNCHER_PID\" 2>/dev/null || true\n        fi\n        RULES_RETIRED=1\n        if [ -f \"$SESSION_DIR/starting\" ]; then\n            recover_unfinished_startup || RULES_RETIRED=0\n        elif [ \"$HAD_LAUNCH\" = 1 ] && read_owned_session; then\n            close_owned_twitch\n            retire_owned_session || RULES_RETIRED=0\n        fi\n        if [ \"$FROM_TILE\" = 0 ] && [ \"$HAD_LAUNCH\" = 1 ] && [ \"$RULES_RETIRED\" = 1 ] && [ \"$WAS_FOREGROUND\" = 1 ]; then\n            app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        fi\n    fi\n    release_session_lock\n}\ntrap restore_after_failed_preparation EXIT\ntrap 'exit 1' HUP INT TERM\nstartup_stamp=$(process_start_time \"$$\")\n[ -n \"$startup_stamp\" ] || exit 1\nprintf '%s %s\\n' \"$$\" \"$startup_stamp\" > \"$SESSION_DIR/starting\"\nnohup sh -c \"echo $CLEANUP_GUARD_BASE64 | base64 -d | sh -s -- startup $$ $startup_stamp\" > \"$SESSION_DIR/startup-guard.log\" 2>&1 </dev/null 9>&- &\n\niptables -N \"$FIREWALL_CHAIN\"\ntouch \"$SESSION_DIR/ipv4-chain\"\niptables -A \"$FIREWALL_CHAIN\" -i lo -j ACCEPT\niptables -A \"$FIREWALL_CHAIN\" -j REJECT\n# Tizen reports the dynamic inspector port after opening it. Protect new inbound connections until then.\nadd_startup_jump iptables\nif ipv6_available; then\n    ip6tables -N \"$FIREWALL_CHAIN\"\n    touch \"$SESSION_DIR/ipv6-chain\"\n    ip6tables -A \"$FIREWALL_CHAIN\" -j REJECT\n    add_startup_jump ip6tables\nfi\n\nrm -f \"$SESSION_DIR/launch.out\"\ntouch \"$SESSION_DIR/launch-requested\"\nHAD_LAUNCH=1\nif [ \"$CURRENT_PID\" != 0 ]; then\n    app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\nfi\napp_launcher -w -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" > \"$SESSION_DIR/launch.out\" 2>&1 9>&- &\nLAUNCHER_PID=$!\n# Wait up to eight seconds for the launcher to report the PID and inspector port.\nlaunch_poll=0\nwhile [ \"$launch_poll\" -lt 80 ]; do\n    if grep -q \"port: [0-9]\" \"$SESSION_DIR/launch.out\"; then break; fi\n    if ! kill -0 \"$LAUNCHER_PID\" 2>/dev/null; then break; fi\n    sleep 0.1\n    launch_poll=$((launch_poll+1))\ndone\nkill \"$LAUNCHER_PID\" 2>/dev/null || true\nwait \"$LAUNCHER_PID\" 2>/dev/null || true\nLAUNCHER_PID=\nINSPECTOR_PORT=$(sed -n 's/.* port: \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" | head -1)\nSESSION_PID=$(sed -n 's/.* pid = \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" | head -1)\ncase \"$INSPECTOR_PORT:$SESSION_PID\" in\n    *[!0-9:]*|''|:*) echo launch_failed=1; exit 1 ;;\nesac\n[ -n \"$INSPECTOR_PORT\" ] && [ -n \"$SESSION_PID\" ] &&\n    [ \"$INSPECTOR_PORT\" -ge 1024 ] && [ \"$INSPECTOR_PORT\" -le 65535 ] || exit 1\nSESSION_START=$(process_start_time \"$SESSION_PID\")\n[ -n \"$SESSION_START\" ] && [ \"$(twitch_pid)\" = \"$SESSION_PID\" ] || exit 1\nprintf \"%s %s %s\\n\" \"$SESSION_PID\" \"$SESSION_START\" \"$INSPECTOR_PORT\" > \"$SESSION_DIR/owner.tmp\"\nchmod 600 \"$SESSION_DIR/owner.tmp\"\nmv \"$SESSION_DIR/owner.tmp\" \"$SESSION_DIR/owner\"\n\niptables -I INPUT 1 -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\"\niptables -I INPUT 1 -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT\niptables -I OUTPUT 1 -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT\niptables -I OUTPUT 1 -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT\nif ipv6_available; then ip6tables -I INPUT 1 ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\"; fi\nisolation_rules_present\ninspector_is_listening \"$INSPECTOR_PORT\" tcp\nipv6_status=0\ninspector_is_listening \"$INSPECTOR_PORT\" tcp6 || ipv6_status=$?\n[ \"$ipv6_status\" = 1 ] || { echo ipv6_unconfirmed=1; exit 1; }\nremove_startup_guard\nprintf '{\"format\":1,\"pid\":%s,\"start\":\"%s\",\"port\":%s,\"ready\":true}\\n' \\\n    \"$SESSION_PID\" \"$SESSION_START\" \"$INSPECTOR_PORT\" > \"$SESSION_DIR/state.tmp\"\nchmod 644 \"$SESSION_DIR/state.tmp\"\nmv \"$SESSION_DIR/state.tmp\" \"$SESSION_DIR/state.json\"\nnohup sh -c \"echo $CLEANUP_GUARD_BASE64 | base64 -d | sh\" > \"$SESSION_DIR/guard.log\" 2>&1 </dev/null 9>&- &\nSESSION_PREPARED=1\necho ready=1\n","session-shell/read-helpers.sh":"# Runtime paths and identity checks shared by the session commands.\nset -e\nSESSION_DIR=/run/vetro-twitch-session\nTWITCH_APP_ID=Jz7aUrV2Q4.Twitch\nFIREWALL_CHAIN=VETRO_TWITCH_AUTO\n\n[ ! -L \"$SESSION_DIR\" ] || exit 40\nif [ -e \"$SESSION_DIR\" ]; then\n    [ -d \"$SESSION_DIR\" ] && [ \"$(stat -c %u \"$SESSION_DIR\")\" = 0 ] || exit 40\nelse\n    mkdir \"$SESSION_DIR\"\nfi\nchmod 755 \"$SESSION_DIR\"\n\ntwitch_pid() {\n    running_apps=$(app_launcher -S 2>/dev/null) || return 2\n    printf '%s\\n' \"$running_apps\" |\n        awk -v app=\"$TWITCH_APP_ID\" '$1==app {gsub(/[()]/,\"\",$2); print $2; exit}'\n}\n\n# PID plus kernel start time identifies one process, including after PID reuse.\nprocess_start_time() {\n    awk '{print $22}' \"/proc/$1/stat\" 2>/dev/null || true\n}\n\ntwitch_is_foreground() {\n    vconftool get memory/appfw/current_fullscreen_appid 2>/dev/null |\n        grep -Fq \"value = $TWITCH_APP_ID (String)\"\n}\n\ninspector_is_listening() {\n    listeners=$(netstat -ltn 2>/dev/null) || return 2\n    printf '%s\\n' \"$listeners\" |\n        awk -v port_suffix=\":$1\" -v family=\"${2:-}\" '\n            $4 ~ port_suffix\"$\" && $6==\"LISTEN\" && (family==\"\" || $1==family) {found=1} END {exit !found}'\n}\n\nipv6_available() {\n    [ -e /proc/net/tcp6 ]\n}\n\nread_owned_session() {\n    SESSION_PID=; SESSION_START=; INSPECTOR_PORT=\n    [ -f \"$SESSION_DIR/owner\" ] && [ ! -L \"$SESSION_DIR/owner\" ] || return 1\n    read SESSION_PID SESSION_START INSPECTOR_PORT < \"$SESSION_DIR/owner\"\n    case \"$SESSION_PID:$SESSION_START:$INSPECTOR_PORT\" in\n        *[!0-9:]*|::*|'') return 1 ;;\n    esac\n    [ -n \"$SESSION_PID\" ] && [ -n \"$SESSION_START\" ] &&\n        [ \"$INSPECTOR_PORT\" -ge 1024 ] && [ \"$INSPECTOR_PORT\" -le 65535 ]\n}\n\nisolation_rules_present() {\n    iptables -C INPUT -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" &&\n    iptables -C \"$FIREWALL_CHAIN\" -i lo -j ACCEPT &&\n    iptables -C \"$FIREWALL_CHAIN\" -j REJECT &&\n    iptables -C INPUT -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    iptables -C OUTPUT -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    iptables -C OUTPUT -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    { ! ipv6_available || {\n        ip6tables -C INPUT ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" &&\n        ip6tables -C \"$FIREWALL_CHAIN\" -j REJECT\n    }; }\n}\n\ninspect_session() {\n    # Inspect app identity and verify any published inspector session.\n    CURRENT_PID=$(twitch_pid); CURRENT_PID=${CURRENT_PID:-0}\n    CURRENT_START=0\n    IS_FOREGROUND=0\n    [ \"$CURRENT_PID\" = 0 ] || CURRENT_START=$(process_start_time \"$CURRENT_PID\")\n    if twitch_is_foreground; then IS_FOREGROUND=1; fi\n    printf \"pid=%s\\nstart=%s\\nforeground=%s\\n\" \"$CURRENT_PID\" \"$CURRENT_START\" \"$IS_FOREGROUND\"\n    if [ -f \"$SESSION_DIR/starting\" ]; then\n        echo unsafe=1\n    elif read_owned_session; then\n        if [ \"$SESSION_PID\" = \"$CURRENT_PID\" ] && [ \"$SESSION_START\" = \"$CURRENT_START\" ] &&\n                inspector_is_listening \"$INSPECTOR_PORT\" && [ -f \"$SESSION_DIR/state.json\" ]; then\n            if isolation_rules_present; then\n                printf \"state=\"; cat \"$SESSION_DIR/state.json\"\n            else\n                echo unsafe=1\n            fi\n        else\n            echo stale=1\n        fi\n    fi\n}\n","session-shell.js":"'use strict';\n// Assemble fixed shell sources for the owned Twitch session; execute them through stdin.\nvar fs = require('fs'), path = require('path');\nfunction shellSource(name) {\n    return fs.readFileSync(path.join(__dirname, 'session-shell', name + '.sh'), 'utf8');\n}\nvar READ_HELPERS = shellSource('read-helpers');\nvar CLEANUP_HELPERS = shellSource('cleanup-helpers');\nvar PREPARE_BODY = shellSource('prepare');\nvar CLEANUP_GUARD = new Buffer([READ_HELPERS, CLEANUP_HELPERS,\n    'if [ \"${1:-}\" = startup ]; then APP_USER_ID=$(id -u owner); guard_startup \"$2\" \"$3\"; else guard_session; fi'].join('\\n'), 'utf8').toString('base64');\n\n// Send the generated program as stdin so it needs no executable file on the TV.\nfunction encodeShellCommand(script) {\n    return 'echo ' + new Buffer(script, 'utf8').toString('base64') + ' | base64 -d | sh';\n}\nfunction inspectSessionScript() {\n    return READ_HELPERS + '\\ninspect_session';\n}\nfunction prepareSessionScript(observedPid, observedStart, fromTile) {\n    if (!/^\\d+$/.test(String(observedPid)) || !/^\\d+$/.test(String(observedStart)) ||\n        (Number(observedPid) === 0 && (!fromTile || String(observedStart) !== '0'))) {\n        throw new Error('Invalid observed process');\n    }\n    return [READ_HELPERS, CLEANUP_HELPERS, 'APP_USER_ID=$(id -u owner)',\n        'OBSERVED_PID=' + observedPid, 'OBSERVED_START=' + observedStart,\n        'FROM_TILE=' + (fromTile ? '1' : '0'),\n        'CLEANUP_GUARD_BASE64=' + CLEANUP_GUARD, PREPARE_BODY].join('\\n');\n}\nfunction cleanupSessionScript(options) {\n    var restoreNormalApp = !!(options && options.restoreNormalApp);\n    return [READ_HELPERS, CLEANUP_HELPERS, 'APP_USER_ID=$(id -u owner)',\n        'RESTORE_NORMAL_APP=' + (restoreNormalApp ? '1' : '0'), 'cleanup_session'].join('\\n');\n}\nfunction parseSessionSnapshot(output) {\n    var snapshot = { pid: 0, start: '0', foreground: false, ownedSession: null, staleSession: false, isolationMissing: false };\n    String(output || '').split(/\\r?\\n/).forEach(function (line) {\n        var pair = /^([a-z]+)=(.*)$/.exec(line); if (!pair) return;\n        if (pair[1] === 'pid' && /^\\d+$/.test(pair[2])) snapshot.pid = Number(pair[2]);\n        if (pair[1] === 'start' && /^\\d+$/.test(pair[2])) snapshot.start = pair[2];\n        if (pair[1] === 'foreground') snapshot.foreground = pair[2] === '1';\n        if (pair[1] === 'unsafe') snapshot.isolationMissing = pair[2] === '1';\n        if (pair[1] === 'stale') snapshot.staleSession = pair[2] === '1';\n        if (pair[1] === 'state') {\n            var ownedSession;\n            try { ownedSession = JSON.parse(pair[2]); } catch (error) { return; }\n            if (!ownedSession || ownedSession.format !== 1 || ownedSession.ready !== true) return;\n            var validPort = typeof ownedSession.port === 'number' && ownedSession.port % 1 === 0 &&\n                ownedSession.port >= 1024 && ownedSession.port <= 65535;\n            var validPid = typeof ownedSession.pid === 'number' && ownedSession.pid > 0 && ownedSession.pid % 1 === 0;\n            var validStart = typeof ownedSession.start === 'string' && /^\\d+$/.test(ownedSession.start);\n            if (validPort && validPid && validStart) snapshot.ownedSession = ownedSession;\n        }\n    });\n    if (snapshot.ownedSession && (snapshot.ownedSession.pid !== snapshot.pid || snapshot.ownedSession.start !== snapshot.start)) {\n        snapshot.ownedSession = null;\n        snapshot.staleSession = true;\n    }\n    return snapshot;\n}\nmodule.exports = {\n    encodeShellCommand: encodeShellCommand,\n    inspectSessionScript: inspectSessionScript,\n    prepareSessionScript: prepareSessionScript,\n    cleanupSessionScript: cleanupSessionScript,\n    parseSessionSnapshot: parseSessionSnapshot\n};\n","twitch-page.js":"'use strict';\n\nvar inspector = require('./inspector-client.js');\n\n// Helpers used by the scripts injected into the Twitch TV page.\nvar AD_TOAST = 'ad';\nvar QUIET_GAP_MS = 30000;\n\n// Runs in Twitch's page. Match its settings label before falling back to the document or browser language.\nfunction pageTranslations(catalog, settingsNames, backNames) {\n    var languages = Object.keys(catalog);\n    var errors = Object.keys(catalog.en).filter(function (key) { return /Error$/.test(key); });\n\n    function normalize(value) { return String(value || '').replace(/\\s+/g, ' ').trim().toLowerCase(); }\n    function language() {\n        var settings = document.querySelector('a[href=\"/settings\"]');\n        var name = normalize(settings && (settings.getAttribute('aria-label') || settings.textContent));\n        for (var i = 0; name && i < languages.length; i++) {\n            var locale = languages[i];\n            if (settingsNames[locale].some(function (label) { return normalize(label) === name; })) return locale;\n        }\n        var tag = document.documentElement && document.documentElement.lang || navigator.language || '';\n        var code = tag.toLowerCase().split(/[-_]/)[0];\n        return languages.indexOf(code) >= 0 ? code : 'en';\n    }\n    function text(key, locale, value) {\n        var message = catalog[locale][key] || catalog.en[key];\n        return value === undefined ? message : message.replace('{value}', function () { return String(value); });\n    }\n    function error(message, locale) {\n        for (var i = 0; i < errors.length; i++) {\n            if (catalog.en[errors[i]] === message) return text(errors[i], locale);\n        }\n        return text('errorGeneric', locale);\n    }\n    function isBack(value) {\n        var name = normalize(value);\n        return backNames.some(function (label) { return normalize(label) === name; });\n    }\n    return { language: language, text: text, error: error, isBack: isBack };\n}\n\n// Pass only the strings needed by the injected surface. The TV page cannot require Shard files.\nfunction translationSource(surface) {\n    var catalog = {}, settings = {}, back = [];\n    Object.keys(locales).forEach(function (code) {\n        var locale = locales[code];\n        catalog[code] = locale[surface];\n        settings[code] = locale.native.settings;\n        if (surface === 'accounts') back = back.concat(locale.native.loginBack);\n    });\n    return '(' + pageTranslations.toString() + ')(' + JSON.stringify(catalog) + ',' + JSON.stringify(settings) + ',' + JSON.stringify(back) + ')';\n}\n\nfunction readNativeSession(includeClient) {\n    var root = null;\n    var nodes = document.querySelectorAll('#__next,#__next > *,body > *');\n    var count = 0;\n    for (var i = 0; i < nodes.length && i < 25 && !root; i++) {\n        var names = Object.keys(nodes[i]);\n        for (var j = 0; j < names.length && !root; j++) {\n            if (/^__react(?:Fiber|Container)\\$/.test(names[j])) root = nodes[i][names[j]];\n            else if (names[j] === '_reactRootContainer' && nodes[i][names[j]]) root = nodes[i][names[j]]._internalRoot.current;\n        }\n    }\n    if (root) {\n        while (root.return && count++ < 100) root = root.return;\n        if (root.stateNode && root.stateNode.current) root = root.stateNode.current;\n    }\n    var stack = root ? [root] : [];\n    var result = { signedIn: null, clientId: null };\n    while (stack.length && count++ < 18000) {\n        var fiber = stack.pop();\n        var value = fiber.memoizedProps && fiber.memoizedProps.value;\n        if (includeClient && value && typeof value.clientId === 'string' && /^[a-z0-9]{20,40}$/i.test(value.clientId)) result.clientId = value.clientId;\n        if (value && value.authCookieName === 'auth-token' && typeof value.loggedIn === 'boolean' && typeof value.logout === 'function') result.signedIn = value.loggedIn;\n        if (result.signedIn !== null && (!includeClient || result.clientId)) break;\n        if (fiber.child) stack.push(fiber.child);\n        if (fiber.sibling) stack.push(fiber.sibling);\n    }\n    return result;\n}\n\nfunction showIndicator(kind, points, translations) {\n    var key = kind === 'ad' ? '__vetroTwitchAdIndicator' : '__vetroTwitchPointsIndicator', previous = window[key];\n    if (previous) previous.stop();\n    var element = document.createElement('div'), timer = null, owner = { stop: stop };\n    element.setAttribute('data-vetro-' + kind + '-indicator', '');\n    element.setAttribute('role', 'status'); element.setAttribute('aria-live', 'polite');\n    var textKey = kind === 'ad' ? 'adFiltered' : points === 1 ? 'point' : 'points';\n    element.textContent = translations.text(textKey, translations.language(), points);\n    element.style.cssText = 'all:initial;position:fixed!important;top:24px!important;' + (kind === 'ad' ? 'right' : 'left') +\n        ':24px!important;z-index:2147483647!important;pointer-events:none!important;' +\n        'display:block!important;padding:10px 16px!important;border-radius:8px!important;border:1px solid #bf94ff!important;' +\n        'background:rgba(24,16,36,0.94)!important;color:#fff!important;font:500 22px sans-serif!important;line-height:1.3!important;';\n    function stop() {\n        if (timer !== null) { window.clearTimeout(timer); timer = null; }\n        if (element.parentNode) element.parentNode.removeChild(element);\n        if (window[key] === owner) delete window[key];\n    }\n    window[key] = owner;\n    document.documentElement.appendChild(element);\n    timer = window.setTimeout(stop, 3000);\n}\nfunction showIndicatorScript(kind, points) {\n    return '(' + showIndicator.toString() + ')(' + JSON.stringify(kind) + ',' + JSON.stringify(points) + ',' + INDICATOR_TRANSLATIONS + ');';\n}\nfunction hideIndicatorScript(kind) {\n    var key = kind === AD_TOAST ? 'window.__vetroTwitchAdIndicator' : 'window.__vetroTwitchPointsIndicator';\n    return 'if(' + key + ')' + key + '.stop();';\n}\nfunction createAdSkipIndicator(client) {\n    var enabled = false, stopped = false, generation = 0, lastReplacementAt = null, mayBeVisible = false;\n    var pending = Promise.resolve(), notifications = 0, errors = 0;\n    function enqueue(action) {\n        // Optional UI work never holds up playback or rejects into the interception pipeline.\n        pending = pending.then(action).catch(function () { errors++; });\n        return pending;\n    }\n    function hide() {\n        if (!mayBeVisible) return;\n        mayBeVisible = false;\n        return inspector.evaluate(client, hideIndicatorScript(AD_TOAST));\n    }\n    return {\n        setEnabled: function (value) {\n            value = value === true;\n            if (stopped || value === enabled) return pending;\n            enabled = value;\n            generation++;\n            lastReplacementAt = null;\n            return enabled ? pending : enqueue(hide);\n        },\n        notify: function () {\n            if (!enabled || stopped) return;\n            var now = Date.now();\n            var previous = lastReplacementAt;\n            lastReplacementAt = now;\n            // Repeated HLS refreshes keep the same notification group alive without showing more toasts.\n            if (previous !== null && now >= previous && now - previous < QUIET_GAP_MS) return;\n            var expectedGeneration = generation;\n            enqueue(function () {\n                if (!enabled || stopped || expectedGeneration !== generation) return;\n                mayBeVisible = true;\n                return inspector.evaluate(client, showIndicatorScript(AD_TOAST, null)).then(function () { notifications++; });\n            });\n        },\n        stop: function () {\n            stopped = true;\n            enabled = false;\n            generation++;\n            return enqueue(hide);\n        },\n        status: function () { return { enabled: enabled, notifications: notifications, errors: errors }; }\n    };\n}\n\nvar locales = {\n  \"en\": {\n    \"native\": {\n      \"settings\": [\n        \"Settings\"\n      ],\n      \"loginBack\": [\n        \"Go back\"\n      ]\n    },\n    \"accounts\": {\n      \"accounts\": \"Accounts\",\n      \"guest\": \"Guest\",\n      \"switchAccount\": \"Switch account · {value}\",\n      \"cancellingSignIn\": \"Cancelling sign-in…\",\n      \"savingAccount\": \"Saving Twitch account…\",\n      \"addingAccount\": \"Adding a Twitch account · Back to cancel\",\n      \"forgetTitle\": \"Forget this account?\",\n      \"manageAccounts\": \"Manage accounts\",\n      \"chooseAccount\": \"Who’s watching?\",\n      \"wait\": \"Please wait…\",\n      \"forgetDescription\": \"Remove the saved session for {value}.\",\n      \"finishSignIn\": \"Finish signing in with Twitch or cancel to restore your previous account.\",\n      \"cancel\": \"Cancel\",\n      \"forgetAccount\": \"Forget {value}\",\n      \"continueSignIn\": \"Continue signing in\",\n      \"cancelSignIn\": \"Cancel sign-in\",\n      \"backToProfiles\": \"Back to profiles\",\n      \"signInAgain\": \"Sign in again\",\n      \"currentAccount\": \"Current account\",\n      \"currentSession\": \"Current session\",\n      \"addAccount\": \"Add account\",\n      \"saveAccount\": \"Save current account\",\n      \"back\": \"Back\",\n      \"errorGeneric\": \"The account action failed. Try again.\",\n      \"replaceError\": \"Twitch did not confirm the account change\",\n      \"validationError\": \"Twitch account validation is unavailable\",\n      \"identityError\": \"Twitch did not confirm this account\",\n      \"expiredError\": \"This account needs to sign in again. Select it again to reconnect.\",\n      \"currentExpiredError\": \"The current account needs to sign in again\",\n      \"wrongAccountError\": \"Sign in to the selected account, or use Add account\",\n      \"signInError\": \"Sign in to Twitch before saving an account\",\n