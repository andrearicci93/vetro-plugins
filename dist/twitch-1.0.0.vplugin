es(data) {\n    var entries = data && (data.emote_set || data).emotes || [];\n    if (!Array.isArray(entries)) entries = [];\n    var result = [], seen = Object.create(null);\n    entries.slice(0, 2500).forEach(function (emote) {\n        if (!emote || typeof emote !== 'object') return;\n        var host = emote.data && emote.data.host, base = host && host.url;\n        if (typeof emote.name !== 'string' || !/^\\S{1,64}$/.test(emote.name) || !/^\\/\\/cdn\\.7tv\\.app\\/emote\\/[A-Za-z0-9]+$/.test(base || '') || seen[emote.name]) return;\n        var files = Array.isArray(host.files) ? host.files : [], chosen = null;\n        ['2x.webp', '1x.webp', '2x.gif', '1x.gif', '2x.png', '1x.png'].some(function (name) {\n            chosen = files.filter(function (f) { return f && f.name === name; })[0]; return !!chosen;\n        });\n        if (!chosen) return;\n        seen[emote.name] = true;\n        result.push({ name: emote.name, url: 'https:' + base + '/' + chosen.name, zeroWidth: !!(emote.flags & 1) });\n    });\n    return result;\n}\nfunction createEmoteCatalogue(transport) {\n    var cache = {}, alive = true, lastLookup = 'idle';\n    var client = createJsonClient(3 * 1024 * 1024), request = transport || client.request;\n    function cached(key, load) {\n        if (!alive) return Promise.reject(new Error('Stopped'));\n        if (cache[key] && Date.now() - cache[key].at < 15 * 60 * 1000) return Promise.resolve(cache[key].value);\n        return load().then(function (value) {\n            if (!alive) throw new Error('Stopped');\n            if (Object.keys(cache).length >= 8) cache = {};\n            cache[key] = { at: Date.now(), value: value }; return value;\n        });\n    }\n    return {\n        global: function () { return cached('global', function () { return request('api.7tv.app', '/v3/emote-sets/global').then(normalizeEmotes); }); },\n        channel: function (login) {\n            if (!/^[a-z0-9_]{1,25}$/.test(login || '')) return Promise.reject(new Error('Invalid channel'));\n            return cached('channel:' + login, function () {\n                return request('gql.twitch.tv', '/gql', { query: 'query($login:String!){user(login:$login){id}}', variables: { login: login } }).then(function (d) {\n                    var id = d.data && d.data.user && d.data.user.id;\n                    if (d.errors && d.errors.length) { lastLookup = 'query-rejected'; throw new Error('Anonymous channel lookup rejected'); }\n                    if (typeof id !== 'string' || !/^\\d{1,24}$/.test(id)) { lastLookup = 'user-not-found'; return []; }\n                    return request('api.7tv.app', '/v3/users/twitch/' + id).then(function (data) { var entries = normalizeEmotes(data); lastLookup = entries.length ? 'ready' : 'no-channel-emotes'; return entries; });\n                });\n            });\n        },\n        status: function () { return lastLookup; },\n        stop: function () { alive = false; client.stop(); cache = {}; }\n    };\n}\n\nvar AVATAR_RETRY_MS = 60000, AVATAR_CACHE_MS = 3600000;\nvar TWITCH_AVATAR = /^https:\\/\\/static-cdn\\.jtvnw\\.net\\/jtv_user_pictures\\/(?:[A-Za-z0-9_-]+\\/)*[A-Za-z0-9_-]+\\.(?:png|jpe?g|webp|gif)$/i;\n\nfunction createAvatarCatalogue(client) {\n    client = client || createJsonClient(64 * 1024);\n    var cache = Object.create(null), pending = false;\n\n    function refresh(ids, retainedIds) {\n        if (pending) return;\n        Object.keys(cache).forEach(function (id) { if (retainedIds.indexOf(id) < 0) delete cache[id]; });\n        var now = Date.now();\n        var missing = ids.filter(function (id) { return !cache[id] || cache[id].nextCheckAt <= now; });\n        if (!missing.length) return;\n\n        missing.forEach(function (id) { cache[id] = { url: cache[id] && cache[id].url, nextCheckAt: now + AVATAR_RETRY_MS }; });\n        pending = true;\n        client.request('gql.twitch.tv', '/gql', {\n            query: 'query($ids:[ID!]!){users(ids:$ids){id profileImageURL(width:300)}}',\n            variables: { ids: missing }\n        }).then(function (response) {\n            var users = response && response.data && response.data.users;\n            if (!Array.isArray(users)) return;\n            users.forEach(function (user) {\n                if (!user || missing.indexOf(user.id) < 0 || typeof user.profileImageURL !== 'string' ||\n                    user.profileImageURL.length > 512 || !TWITCH_AVATAR.test(user.profileImageURL)) return;\n                cache[user.id] = { url: user.profileImageURL, nextCheckAt: Date.now() + AVATAR_CACHE_MS };\n            });\n        }).then(function () { pending = false; }, function () { pending = false; });\n    }\n\n    return {\n        refresh: refresh,\n        get: function (id) { return cache[id] && cache[id].url; },\n        stop: function () { client.stop(); cache = Object.create(null); }\n    };\n}\n\nmodule.exports = { createEmoteCatalogue: createEmoteCatalogue, normalizeEmotes: normalizeEmotes, createAvatarCatalogue: createAvatarCatalogue };\n","session-manager.js":"'use strict';\nvar sessionShell = require('./session-shell.js');\nvar SESSION_POLL_MS = 2000;\nvar SCRIPT_TIMEOUT_MS = 10000;\nvar PREPARATION_TIMEOUT_MS = 20000;\nvar PREPARATION_RETRY_STEP_MS = 5000;\nvar MAX_PREPARATION_BACKOFF_MS = 30000;\nvar TILE_FALLBACK_MS = 8000;\nvar CLEANUP_RETRY_MS = 250;\nvar MAX_CLEANUP_ATTEMPTS = 3;\n\nmodule.exports = function (context, onChange) {\n    var running = false, pollTimer = null, sessionTask = null, tileLaunchTask = null;\n    var lifecycleGeneration = 0, preparationFailures = 0, nextPreparationAttemptAt = 0;\n    var suppressedProcessIdentity = null, tileFallbackUntil = 0;\n    var sessionState = { phase: 'stopped', port: null, error: null, takeovers: 0, key: null, foreground: false };\n\n    function runSessionScript(script, timeout) {\n        return context.execute(sessionShell.encodeShellCommand(script), timeout || SCRIPT_TIMEOUT_MS).then(function (result) {\n            if (!result || result.exit_code !== 0 || result.timed_out) throw new Error('TV session command failed');\n            return String(result.stdout || '');\n        });\n    }\n    function clearReadySession(phase) {\n        sessionState.phase = phase;\n        sessionState.port = null;\n        sessionState.key = null; sessionState.foreground = false;\n    }\n    function adoptOwnedSession(snapshot) {\n        var owned = snapshot.ownedSession;\n        sessionState.phase = 'ready';\n        sessionState.port = owned.port;\n        sessionState.key = owned.pid + ':' + owned.start + ':' + owned.port;\n        sessionState.foreground = snapshot.foreground;\n        sessionState.error = null;\n        preparationFailures = 0;\n    }\n    function checkSession(fromTile) {\n        if (!running || sessionTask || (!fromTile && Date.now() < nextPreparationAttemptAt)) return;\n        var checkGeneration = lifecycleGeneration;\n        var previousPhase = sessionState.phase, previousKey = sessionState.key, previousForeground = sessionState.foreground;\n\n        function prepare(snapshot) {\n            if (!snapshot.ownedSession) sessionState.phase = 'preparing';\n            return runSessionScript(sessionShell.prepareSessionScript(snapshot.pid, snapshot.start, fromTile), PREPARATION_TIMEOUT_MS).then(function (prepareOutput) {\n                if (!running || checkGeneration !== lifecycleGeneration) return;\n                var started = /^ready=1$/m.test(prepareOutput);\n                var reused = fromTile && /^reused=1$/m.test(prepareOutput);\n                if (!started && !reused) {\n                    if (/^raced=1$|^busy$/m.test(prepareOutput)) {\n                        if (!snapshot.ownedSession) sessionState.phase = 'waiting-for-twitch';\n                        return false;\n                    }\n                    throw new Error('Protected Twitch session was not confirmed');\n                }\n                if (started) {\n                    sessionState.takeovers++;\n                    clearReadySession('connecting');\n                }\n                sessionState.error = null;\n                preparationFailures = 0;\n                nextPreparationAttemptAt = 0;\n                return runSessionScript(sessionShell.inspectSessionScript()).then(function (output) {\n                    if (!running || checkGeneration !== lifecycleGeneration) return false;\n                    var prepared = sessionShell.parseSessionSnapshot(output);\n                    if (prepared.ownedSession && !prepared.staleSession && !prepared.isolationMissing) adoptOwnedSession(prepared);\n                    return true;\n                }, function () {\n                    // The launch succeeded; the regular inspection will retry confirmation.\n                    return running && checkGeneration === lifecycleGeneration;\n                });\n            });\n        }\n\n        sessionTask = runSessionScript(sessionShell.inspectSessionScript()).then(function (output) {\n            if (!running || checkGeneration !== lifecycleGeneration) return;\n            var snapshot = sessionShell.parseSessionSnapshot(output);\n            sessionState.foreground = snapshot.foreground;\n            sessionState.error = null;\n            if (fromTile) return prepare(snapshot);\n            if (snapshot.staleSession || snapshot.isolationMissing) {\n                return runSessionScript(sessionShell.cleanupSessionScript({restoreNormalApp: snapshot.isolationMissing})).then(function (cleanupOutput) {\n                    clearReadySession(/cleanup_pending=1/.test(cleanupOutput) ? 'waiting-for-inspector-close' : 'waiting-for-twitch');\n                });\n            }\n            if (snapshot.ownedSession) {\n                adoptOwnedSession(snapshot);\n                return;\n            }\n            clearReadySession('waiting-for-twitch'); sessionState.foreground = snapshot.foreground;\n            if (!snapshot.pid || !snapshot.foreground) {\n                suppressedProcessIdentity = null;\n                return;\n            }\n            var processIdentity = snapshot.pid + ':' + snapshot.start;\n            if (Date.now() < tileFallbackUntil) suppressedProcessIdentity = processIdentity;\n            tileFallbackUntil = 0;\n            if (processIdentity === suppressedProcessIdentity) {\n                sessionState.phase = 'normal-fallback';\n                return;\n            }\n            return prepare(snapshot);\n        }).catch(function (error) {\n            sessionState.error = error.message;\n            if (fromTile) {\n                clearReadySession('waiting-for-twitch');\n                return false;\n            }\n            clearReadySession('retrying');\n            preparationFailures++;\n            nextPreparationAttemptAt = Date.now() + Math.min(MAX_PREPARATION_BACKOFF_MS, preparationFailures * PREPARATION_RETRY_STEP_MS);\n            // A normal fallback remains usable until an explicit retry or app exit/reopen.\n            return runSessionScript(sessionShell.inspectSessionScript()).then(function (output) {\n                var snapshot = sessionShell.parseSessionSnapshot(output);\n                sessionState.foreground = snapshot.foreground;\n                if (snapshot.pid && !snapshot.ownedSession) suppressedProcessIdentity = snapshot.pid + ':' + snapshot.start;\n            }).catch(function () {});\n        }).then(function (handled) {\n            sessionTask = null;\n            if (running && checkGeneration === lifecycleGeneration) {\n                if (fromTile) tileFallbackUntil = handled ? 0 : Date.now() + TILE_FALLBACK_MS;\n                if (onChange && (previousPhase !== sessionState.phase || previousKey !== sessionState.key ||\n                    previousForeground !== sessionState.foreground)) onChange();\n            }\n            return handled;\n        });\n        return sessionTask;\n    }\n    function cleanupWithRetry(attempt) {\n        return runSessionScript(sessionShell.cleanupSessionScript({restoreNormalApp: true})).then(function (output) {\n            if (!/^busy$/m.test(output)) return output;\n            if (attempt >= MAX_CLEANUP_ATTEMPTS) throw new Error('Session cleanup is busy');\n            return new Promise(function (resolve) { setTimeout(resolve, CLEANUP_RETRY_MS); })\n                .then(function () { return cleanupWithRetry(attempt + 1); });\n        });\n    }\n    return {\n        start: function () {\n            running = true;\n            lifecycleGeneration++;\n            sessionState.phase = 'starting';\n            pollTimer = setInterval(checkSession, SESSION_POLL_MS);\n            if (pollTimer.unref) pollTimer.unref();\n            checkSession();\n        },\n        launch: function () {\n            if (tileLaunchTask) return tileLaunchTask;\n            var generation = lifecycleGeneration;\n            tileLaunchTask = Promise.resolve(sessionTask).then(function () {\n                if (!running || generation !== lifecycleGeneration) return false;\n                return checkSession(true);\n            }).then(function (handled) { tileLaunchTask = null; return handled === true; }, function (error) {\n                tileLaunchTask = null;\n                throw error;\n            });\n            return tileLaunchTask;\n        },\n        stop: function () {\n            running = false;\n            lifecycleGeneration++;\n            if (pollTimer) clearInterval(pollTimer);\n            pollTimer = null;\n            return (sessionTask || Promise.resolve()).then(function () { return cleanupWithRetry(1); }).then(function (output) {\n                clearReadySession(/cleanup_pending=1/.test(output) ? 'cleanup-pending' : 'stopped');\n            }, function () {\n                clearReadySession('cleanup-failed');\n                sessionState.error = 'Close Twitch to end the inspector; its network guard remains until then';\n            });\n        },\n        status: function () {\n            return { phase: sessionState.phase, port: sessionState.port, error: sessionState.error,\n                takeovers: sessionState.takeovers, key: sessionState.key, foreground: sessionState.foreground };\n        },\n        retry: function () {\n            suppressedProcessIdentity = null;\n            tileFallbackUntil = 0;\n            nextPreparationAttemptAt = 0;\n            preparationFailures = 0;\n            checkSession();\n        }\n    };\n};\n","session-shell/cleanup-helpers.sh":"# Locking and mutation helpers, omitted from periodic inspection commands.\nacquire_session_lock() {\n    if ! mkdir \"$SESSION_DIR/lock\" 2>/dev/null; then\n        lock_pid= lock_start=\n        read lock_pid lock_start < \"$SESSION_DIR/lock/pid\" 2>/dev/null || true\n        case \"$lock_pid\" in\n            ''|*[!0-9]*) echo busy; return 1 ;;\n        esac\n        if [ -d \"/proc/$lock_pid\" ] && { [ -z \"$lock_start\" ] || [ \"$(process_start_time \"$lock_pid\")\" = \"$lock_start\" ]; }; then\n            echo busy\n            return 1\n        fi\n        rm -f \"$SESSION_DIR/lock/pid\"\n        rmdir \"$SESSION_DIR/lock\" 2>/dev/null || { echo busy; return 1; }\n        mkdir \"$SESSION_DIR/lock\" || return 1\n    fi\n    printf '%s %s\\n' \"$$\" \"$(process_start_time \"$$\")\" > \"$SESSION_DIR/lock/pid\"\n}\n\nrelease_session_lock() {\n    rm -f \"$SESSION_DIR/lock/pid\"\n    rmdir \"$SESSION_DIR/lock\" 2>/dev/null || true\n}\n\nadd_startup_jump() {\n    \"$1\" -I INPUT 1 ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\" &&\n    \"$1\" -C INPUT ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\"\n}\n\nremove_startup_jump() {\n    rules=$(\"$1\" -S INPUT 2>/dev/null) || return 1\n    if printf '%s\\n' \"$rules\" | awk -v chain=\"$FIREWALL_CHAIN\" '\n        $0 ~ /--(syn|tcp-flags) / && $NF==chain {found=1} END {exit !found}'; then\n        \"$1\" -D INPUT ! -i lo -p tcp --syn -j \"$FIREWALL_CHAIN\" || return 1\n    fi\n}\n\nremove_startup_guard() {\n    [ -f \"$SESSION_DIR/starting\" ] || return 0\n    if [ -f \"$SESSION_DIR/ipv4-chain\" ]; then remove_startup_jump iptables || return 1; fi\n    if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then remove_startup_jump ip6tables || return 1; fi\n    rm -f \"$SESSION_DIR/starting\" \"$SESSION_DIR/launch-requested\"\n}\n\nremove_isolation_rules() {\n    remove_startup_guard || return 1\n    if [ -n \"$INSPECTOR_PORT\" ]; then\n        iptables -D INPUT -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        iptables -D INPUT -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        iptables -D OUTPUT -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        iptables -D OUTPUT -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT 2>/dev/null || true\n        if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then\n            ip6tables -D INPUT ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        fi\n    fi\n    if [ -f \"$SESSION_DIR/ipv4-chain\" ] || [ -f \"$SESSION_DIR/owner\" ]; then\n        iptables -F \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        iptables -X \"$FIREWALL_CHAIN\" 2>/dev/null || true\n    fi\n    if [ -f \"$SESSION_DIR/ipv6-chain\" ]; then\n        ip6tables -F \"$FIREWALL_CHAIN\" 2>/dev/null || true\n        ip6tables -X \"$FIREWALL_CHAIN\" 2>/dev/null || true\n    fi\n    rm -f \"$SESSION_DIR/state.json\" \"$SESSION_DIR/owner\" \"$SESSION_DIR/ipv4-chain\" \"$SESSION_DIR/ipv6-chain\"\n}\n\nretire_owned_session() {\n    rm -f \"$SESSION_DIR/state.json\"\n    # Wait at most three seconds. An unavailable socket table is not proof of closure.\n    listener_checks=0\n    while [ \"$listener_checks\" -le 30 ]; do\n        listener_status=0\n        inspector_is_listening \"$INSPECTOR_PORT\" || listener_status=$?\n        if [ \"$listener_status\" = 1 ]; then\n            remove_isolation_rules && return 0\n            break\n        fi\n        [ \"$listener_checks\" -lt 30 ] || break\n        sleep 0.1\n        listener_checks=$((listener_checks+1))\n    done\n    echo cleanup_pending=1\n    return 1\n}\n\nclose_owned_twitch() {\n    if [ \"$(process_start_time \"$SESSION_PID\")\" = \"$SESSION_START\" ] && [ \"$(twitch_pid)\" = \"$SESSION_PID\" ]; then\n        app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n    fi\n}\n\nrecover_unfinished_startup() {\n    [ -f \"$SESSION_DIR/starting\" ] || return 0\n    if read_owned_session; then\n        close_owned_twitch\n        retire_owned_session\n        return\n    fi\n    if [ -f \"$SESSION_DIR/launch-requested\" ]; then\n        app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        attempts=0\n        while [ \"$attempts\" -le 30 ]; do\n            if app_pid=$(twitch_pid) && [ -z \"$app_pid\" ]; then break; fi\n            sleep 0.1\n            attempts=$((attempts+1))\n        done\n        [ \"$attempts\" -le 30 ] || { echo cleanup_pending=1; return 1; }\n        reported_port=$(sed -n 's/.* port: \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" 2>/dev/null | head -1)\n        if [ -n \"$reported_port\" ] && [ \"$reported_port\" -ge 1024 ] && [ \"$reported_port\" -le 65535 ]; then\n            INSPECTOR_PORT=$reported_port\n            retire_owned_session\n            return\n        fi\n        netstat -ltn >/dev/null 2>&1 || { echo cleanup_pending=1; return 1; }\n    fi\n    remove_isolation_rules || { echo cleanup_pending=1; return 1; }\n}\n\ncleanup_session() {\n    # Close/restore Twitch only when requested; always retain rules until the listener closes.\n    acquire_session_lock || exit 0\n    trap release_session_lock EXIT\n    if [ -f \"$SESSION_DIR/starting\" ]; then\n        recover_unfinished_startup || return 0\n    elif read_owned_session; then\n        WAS_FOREGROUND=0\n        if [ \"$RESTORE_NORMAL_APP\" = 1 ]; then\n            if twitch_is_foreground; then WAS_FOREGROUND=1; fi\n            close_owned_twitch\n        fi\n        RULES_RETIRED=1\n        retire_owned_session || RULES_RETIRED=0\n        if [ \"$RESTORE_NORMAL_APP\" = 1 ] && [ \"$WAS_FOREGROUND\" = 1 ] && [ \"$RULES_RETIRED\" = 1 ]; then\n            app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        fi\n    fi\n    echo cleaned=1\n}\n\nguard_session() {\n    # Runs independently of Vetro; retain isolation until this listener disappears.\n    read_owned_session || exit 0\n    GUARD_PID=$SESSION_PID\n    GUARD_START=$SESSION_START\n    GUARD_PORT=$INSPECTOR_PORT\n    while :; do\n        listener_status=0\n        inspector_is_listening \"$GUARD_PORT\" || listener_status=$?\n        [ \"$listener_status\" != 1 ] || break\n        sleep 5\n    done\n    acquire_session_lock || exit 0\n    trap release_session_lock EXIT\n    if read_owned_session && [ \"$SESSION_PID:$SESSION_START:$INSPECTOR_PORT\" = \"$GUARD_PID:$GUARD_START:$GUARD_PORT\" ]; then\n        retire_owned_session || true\n    fi\n}\n\nguard_startup() {\n    owner_pid=$1\n    owner_start=$2\n    while [ \"$(cat \"$SESSION_DIR/starting\" 2>/dev/null || true)\" = \"$owner_pid $owner_start\" ]; do\n        if [ \"$(process_start_time \"$owner_pid\")\" != \"$owner_start\" ] && acquire_session_lock; then\n            trap release_session_lock EXIT\n            if [ \"$(cat \"$SESSION_DIR/starting\" 2>/dev/null || true)\" = \"$owner_pid $owner_start\" ]; then\n                recover_unfinished_startup || true\n            fi\n            release_session_lock\n            trap - EXIT\n        fi\n        sleep 1\n    done\n}\n","session-shell/prepare.sh":"# Prepare an observed foreground app or start it directly from its launcher tile.\nacquire_session_lock || exit 0\ntrap release_session_lock EXIT\nCURRENT_PID=$(twitch_pid); CURRENT_PID=${CURRENT_PID:-0}\nCURRENT_START=0\n[ \"$CURRENT_PID\" = 0 ] || CURRENT_START=$(process_start_time \"$CURRENT_PID\")\nif [ \"$CURRENT_PID:$CURRENT_START\" != \"$OBSERVED_PID:$OBSERVED_START\" ] ||\n        { [ \"$FROM_TILE\" = 0 ] && ! twitch_is_foreground; }; then\n    echo raced=1\n    exit 0\nfi\nif [ -f \"$SESSION_DIR/starting\" ]; then\n    recover_unfinished_startup || exit 1\n    echo raced=1\n    exit 0\nfi\nif read_owned_session; then\n    if [ \"$FROM_TILE\" = 1 ]; then\n        if [ \"$SESSION_PID:$SESSION_START\" = \"$CURRENT_PID:$CURRENT_START\" ] &&\n                [ -f \"$SESSION_DIR/state.json\" ] && inspector_is_listening \"$INSPECTOR_PORT\" && isolation_rules_present; then\n            if ! twitch_is_foreground; then\n                app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1\n            fi\n            echo reused=1\n            exit 0\n        fi\n        close_owned_twitch\n    fi\n    retire_owned_session || exit 1\n    INSPECTOR_PORT=\nfi\niptables -S INPUT >/dev/null\nif ipv6_available; then ip6tables -S INPUT >/dev/null; fi\nif iptables -nL \"$FIREWALL_CHAIN\" >/dev/null 2>&1 ||\n        { ipv6_available && ip6tables -nL \"$FIREWALL_CHAIN\" >/dev/null 2>&1; }; then\n    echo foreign_chain=1\n    exit 0\nfi\nSESSION_PREPARED=0\nHAD_LAUNCH=0\nLAUNCHER_PID=\n\nrestore_after_failed_preparation() {\n    if [ \"$SESSION_PREPARED\" != 1 ]; then\n        WAS_FOREGROUND=0\n        if twitch_is_foreground; then WAS_FOREGROUND=1; fi\n        if [ -n \"$LAUNCHER_PID\" ]; then\n            kill \"$LAUNCHER_PID\" 2>/dev/null || true\n            wait \"$LAUNCHER_PID\" 2>/dev/null || true\n        fi\n        RULES_RETIRED=1\n        if [ -f \"$SESSION_DIR/starting\" ]; then\n            recover_unfinished_startup || RULES_RETIRED=0\n        elif [ \"$HAD_LAUNCH\" = 1 ] && read_owned_session; then\n            close_owned_twitch\n            retire_owned_session || RULES_RETIRED=0\n        fi\n        if [ \"$FROM_TILE\" = 0 ] && [ \"$HAD_LAUNCH\" = 1 ] && [ \"$RULES_RETIRED\" = 1 ] && [ \"$WAS_FOREGROUND\" = 1 ]; then\n            app_launcher -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\n        fi\n    fi\n    release_session_lock\n}\ntrap restore_after_failed_preparation EXIT\ntrap 'exit 1' HUP INT TERM\nstartup_stamp=$(process_start_time \"$$\")\n[ -n \"$startup_stamp\" ] || exit 1\nprintf '%s %s\\n' \"$$\" \"$startup_stamp\" > \"$SESSION_DIR/starting\"\nnohup sh -c \"echo $CLEANUP_GUARD_BASE64 | base64 -d | sh -s -- startup $$ $startup_stamp\" > \"$SESSION_DIR/startup-guard.log\" 2>&1 </dev/null &\n\niptables -N \"$FIREWALL_CHAIN\"\ntouch \"$SESSION_DIR/ipv4-chain\"\niptables -A \"$FIREWALL_CHAIN\" -i lo -j ACCEPT\niptables -A \"$FIREWALL_CHAIN\" -j REJECT\n# Tizen reports the dynamic inspector port after opening it. Protect new inbound connections until then.\nadd_startup_jump iptables\nif ipv6_available; then\n    ip6tables -N \"$FIREWALL_CHAIN\"\n    touch \"$SESSION_DIR/ipv6-chain\"\n    ip6tables -A \"$FIREWALL_CHAIN\" -j REJECT\n    add_startup_jump ip6tables\nfi\n\nrm -f \"$SESSION_DIR/launch.out\"\ntouch \"$SESSION_DIR/launch-requested\"\nHAD_LAUNCH=1\nif [ \"$CURRENT_PID\" != 0 ]; then\n    app_launcher -t \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" >/dev/null 2>&1 || true\nfi\napp_launcher -w -s \"$TWITCH_APP_ID\" -u \"$APP_USER_ID\" > \"$SESSION_DIR/launch.out\" 2>&1 &\nLAUNCHER_PID=$!\n# Wait up to eight seconds for the launcher to report the PID and inspector port.\nlaunch_poll=0\nwhile [ \"$launch_poll\" -lt 80 ]; do\n    if grep -q \"port: [0-9]\" \"$SESSION_DIR/launch.out\"; then break; fi\n    if ! kill -0 \"$LAUNCHER_PID\" 2>/dev/null; then break; fi\n    sleep 0.1\n    launch_poll=$((launch_poll+1))\ndone\nkill \"$LAUNCHER_PID\" 2>/dev/null || true\nwait \"$LAUNCHER_PID\" 2>/dev/null || true\nLAUNCHER_PID=\nINSPECTOR_PORT=$(sed -n 's/.* port: \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" | head -1)\nSESSION_PID=$(sed -n 's/.* pid = \\([0-9]*\\).*/\\1/p' \"$SESSION_DIR/launch.out\" | head -1)\ncase \"$INSPECTOR_PORT:$SESSION_PID\" in\n    *[!0-9:]*|''|:*) echo launch_failed=1; exit 1 ;;\nesac\n[ -n \"$INSPECTOR_PORT\" ] && [ -n \"$SESSION_PID\" ] &&\n    [ \"$INSPECTOR_PORT\" -ge 1024 ] && [ \"$INSPECTOR_PORT\" -le 65535 ] || exit 1\nSESSION_START=$(process_start_time \"$SESSION_PID\")\n[ -n \"$SESSION_START\" ] && [ \"$(twitch_pid)\" = \"$SESSION_PID\" ] || exit 1\nprintf \"%s %s %s\\n\" \"$SESSION_PID\" \"$SESSION_START\" \"$INSPECTOR_PORT\" > \"$SESSION_DIR/owner.tmp\"\nchmod 600 \"$SESSION_DIR/owner.tmp\"\nmv \"$SESSION_DIR/owner.tmp\" \"$SESSION_DIR/owner\"\n\niptables -I INPUT 1 -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\"\niptables -I INPUT 1 -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT\niptables -I OUTPUT 1 -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT\niptables -I OUTPUT 1 -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT\nif ipv6_available; then ip6tables -I INPUT 1 ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\"; fi\nisolation_rules_present\ninspector_is_listening \"$INSPECTOR_PORT\" tcp\nipv6_status=0\ninspector_is_listening \"$INSPECTOR_PORT\" tcp6 || ipv6_status=$?\n[ \"$ipv6_status\" = 1 ] || { echo ipv6_unconfirmed=1; exit 1; }\nremove_startup_guard\nprintf '{\"format\":1,\"pid\":%s,\"start\":\"%s\",\"port\":%s,\"ready\":true}\\n' \\\n    \"$SESSION_PID\" \"$SESSION_START\" \"$INSPECTOR_PORT\" > \"$SESSION_DIR/state.tmp\"\nchmod 644 \"$SESSION_DIR/state.tmp\"\nmv \"$SESSION_DIR/state.tmp\" \"$SESSION_DIR/state.json\"\nnohup sh -c \"echo $CLEANUP_GUARD_BASE64 | base64 -d | sh\" > \"$SESSION_DIR/guard.log\" 2>&1 </dev/null &\nSESSION_PREPARED=1\necho ready=1\n","session-shell/read-helpers.sh":"# Runtime paths and identity checks shared by the session commands.\nset -e\nSESSION_DIR=/run/vetro-twitch-session\nTWITCH_APP_ID=Jz7aUrV2Q4.Twitch\nFIREWALL_CHAIN=VETRO_TWITCH_AUTO\n\n[ ! -L \"$SESSION_DIR\" ] || exit 40\nif [ -e \"$SESSION_DIR\" ]; then\n    [ -d \"$SESSION_DIR\" ] && [ \"$(stat -c %u \"$SESSION_DIR\")\" = 0 ] || exit 40\nelse\n    mkdir \"$SESSION_DIR\"\nfi\nchmod 755 \"$SESSION_DIR\"\n\ntwitch_pid() {\n    running_apps=$(app_launcher -S 2>/dev/null) || return 2\n    printf '%s\\n' \"$running_apps\" |\n        awk -v app=\"$TWITCH_APP_ID\" '$1==app {gsub(/[()]/,\"\",$2); print $2; exit}'\n}\n\n# PID plus kernel start time identifies one process, including after PID reuse.\nprocess_start_time() {\n    awk '{print $22}' \"/proc/$1/stat\" 2>/dev/null || true\n}\n\ntwitch_is_foreground() {\n    vconftool get memory/appfw/current_fullscreen_appid 2>/dev/null |\n        grep -Fq \"value = $TWITCH_APP_ID (String)\"\n}\n\ninspector_is_listening() {\n    listeners=$(netstat -ltn 2>/dev/null) || return 2\n    printf '%s\\n' \"$listeners\" |\n        awk -v port_suffix=\":$1\" -v family=\"${2:-}\" '\n            $4 ~ port_suffix\"$\" && $6==\"LISTEN\" && (family==\"\" || $1==family) {found=1} END {exit !found}'\n}\n\nipv6_available() {\n    [ -e /proc/net/tcp6 ]\n}\n\nread_owned_session() {\n    SESSION_PID=; SESSION_START=; INSPECTOR_PORT=\n    [ -f \"$SESSION_DIR/owner\" ] && [ ! -L \"$SESSION_DIR/owner\" ] || return 1\n    read SESSION_PID SESSION_START INSPECTOR_PORT < \"$SESSION_DIR/owner\"\n    case \"$SESSION_PID:$SESSION_START:$INSPECTOR_PORT\" in\n        *[!0-9:]*|::*|'') return 1 ;;\n    esac\n    [ -n \"$SESSION_PID\" ] && [ -n \"$SESSION_START\" ] &&\n        [ \"$INSPECTOR_PORT\" -ge 1024 ] && [ \"$INSPECTOR_PORT\" -le 65535 ]\n}\n\nisolation_rules_present() {\n    iptables -C INPUT -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" &&\n    iptables -C \"$FIREWALL_CHAIN\" -i lo -j ACCEPT &&\n    iptables -C \"$FIREWALL_CHAIN\" -j REJECT &&\n    iptables -C INPUT -i lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    iptables -C OUTPUT -o lo -d 127.0.0.2 -p tcp --dport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    iptables -C OUTPUT -o lo -s 127.0.0.2 -p tcp --sport \"$INSPECTOR_PORT\" -j ACCEPT &&\n    { ! ipv6_available || {\n        ip6tables -C INPUT ! -i lo -p tcp --dport \"$INSPECTOR_PORT\" -j \"$FIREWALL_CHAIN\" &&\n        ip6tables -C \"$FIREWALL_CHAIN\" -j REJECT\n    }; }\n}\n\ninspect_session() {\n    # Inspect app identity and verify any published inspector session.\n    CURRENT_PID=$(twitch_pid); CURRENT_PID=${CURRENT_PID:-0}\n    CURRENT_START=0\n    IS_FOREGROUND=0\n    [ \"$CURRENT_PID\" = 0 ] || CURRENT_START=$(process_start_time \"$CURRENT_PID\")\n    if twitch_is_foreground; then IS_FOREGROUND=1; fi\n    printf \"pid=%s\\nstart=%s\\nforeground=%s\\n\" \"$CURRENT_PID\" \"$CURRENT_START\" \"$IS_FOREGROUND\"\n    if [ -f \"$SESSION_DIR/starting\" ]; then\n        echo unsafe=1\n    elif read_owned_session; then\n        if [ \"$SESSION_PID\" = \"$CURRENT_PID\" ] && [ \"$SESSION_START\" = \"$CURRENT_START\" ] &&\n                inspector_is_listening \"$INSPECTOR_PORT\" && [ -f \"$SESSION_DIR/state.json\" ]; then\n            if isolation_rules_present; then\n                printf \"state=\"; cat \"$SESSION_DIR/state.json\"\n            else\n                echo unsafe=1\n            fi\n        else\n            echo stale=1\n        fi\n    fi\n}\n","session-shell.js":"'use strict';\n// Assemble fixed shell sources for the owned Twitch session; execute them through stdin.\nvar fs = require('fs'), path = require('path');\nfunction shellSource(name) {\n    return fs.readFileSync(path.join(__dirname, 'session-shell', name + '.sh'), 'utf8');\n}\nvar READ_HELPERS = shellSource('read-helpers');\nvar CLEANUP_HELPERS = shellSource('cleanup-helpers');\nvar PREPARE_BODY = shellSource('prepare');\nvar CLEANUP_GUARD = new Buffer([READ_HELPERS, CLEANUP_HELPERS,\n    'if [ \"${1:-}\" = startup ]; then APP_USER_ID=$(id -u owner); guard_startup \"$2\" \"$3\"; else guard_session; fi'].join('\\n'), 'utf8').toString('base64');\n\n// Send the generated program as stdin so it needs no executable file on the TV.\nfunction encodeShellCommand(script) {\n    return 'echo ' + new Buffer(script, 'utf8').toString('base64') + ' | base64 -d | sh';\n}\nfunction inspectSessionScript() {\n    return READ_HELPERS + '\\ninspect_session';\n}\nfunction prepareSessionScript(observedPid, observedStart, fromTile) {\n    if (!/^\\d+$/.test(String(observedPid)) || !/^\\d+$/.test(String(observedStart)) ||\n        (Number(observedPid) === 0 && (!fromTile || String(observedStart) !== '0'))) {\n        throw new Error('Invalid observed process');\n    }\n    return [READ_HELPERS, CLEANUP_HELPERS, 'APP_USER_ID=$(id -u owner)',\n        'OBSERVED_PID=' + observedPid, 'OBSERVED_START=' + observedStart,\n        'FROM_TILE=' + (fromTile ? '1' : '0'),\n        'CLEANUP_GUARD_BASE64=' + CLEANUP_GUARD, PREPARE_BODY].join('\\n');\n}\nfunction cleanupSessionScript(options) {\n    var restoreNormalApp = !!(options && options.restoreNormalApp);\n    return [READ_HELPERS, CLEANUP_HELPERS, 'APP_USER_ID=$(id -u owner)',\n        'RESTORE_NORMAL_APP=' + (restoreNormalApp ? '1' : '0'), 'cleanup_session'].join('\\n');\n}\nfunction parseSessionSnapshot(output) {\n    var snapshot = { pid: 0, start: '0', foreground: false, ownedSession: null, staleSession: false, isolationMissing: false };\n    String(output || '').split(/\\r?\\n/).forEach(function (line) {\n        var pair = /^([a-z]+)=(.*)$/.exec(line); if (!pair) return;\n        if (pair[1] === 'pid' && /^\\d+$/.test(pair[2])) snapshot.pid = Number(pair[2]);\n        if (pair[1] === 'start' && /^\\d+$/.test(pair[2])) snapshot.start = pair[2];\n        if (pair[1] === 'foreground') snapshot.foreground = pair[2] === '1';\n        if (pair[1] === 'unsafe') snapshot.isolationMissing = pair[2] === '1';\n        if (pair[1] === 'stale') snapshot.staleSession = pair[2] === '1';\n        if (pair[1] === 'state') {\n            var ownedSession;\n            try { ownedSession = JSON.parse(pair[2]); } catch (error) { return; }\n            if (!ownedSession || ownedSession.format !== 1 || ownedSession.ready !== true) return;\n            var validPort = typeof ownedSession.port === 'number' && ownedSession.port % 1 === 0 &&\n                ownedSession.port >= 1024 && ownedSession.port <= 65535;\n            var validPid = typeof ownedSession.pid === 'number' && ownedSession.pid > 0 && ownedSession.pid % 1 === 0;\n            var validStart = typeof ownedSession.start === 'string' && /^\\d+$/.test(ownedSession.start);\n            if (validPort && validPid && validStart) snapshot.ownedSession = ownedSession;\n        }\n    });\n    if (snapshot.ownedSession && (snapshot.ownedSession.pid !== snapshot.pid || snapshot.ownedSession.start !== snapshot.start)) {\n        snapshot.ownedSession = null;\n        snapshot.staleSession = true;\n    }\n    return snapshot;\n}\nmodule.exports = {\n    encodeShellCommand: encodeShellCommand,\n    inspectSessionScript: inspectSessionScript,\n    prepareSessionScript: prepareSessionScript,\n    cleanupSessionScript: cleanupSessionScript,\n    parseSessionSnapshot: parseSessionSnapshot\n};\n","ui.html":"<!doctype html><meta charset=\"utf-8\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>body{font:16px system-ui;margin:20px;max-width:48rem}p{line-height:1.5}button{font:inherit;padding:8px}section{border:1px solid #8886;border-radius:8px;padding:12px;margin:12px 0}pre{white-space:pre-wrap;font-size:13px}label{display:block;margin:8px 0}input{margin-right:8px}</style>\n<h2>Twitch enhancements</h2>\n<p>Open Twitch with at least one feature enabled. Vetro starts a protected local session and applies the selected features. Opening Twitch from Samsung Home may cause one restart to prepare the session.</p>\n<section><b>Options</b>\n<label><input type=\"checkbox\" id=\"adFiltering\" disabled>Ad filtering</label>\n<label><input type=\"checkbox\" id=\"emotes7tv\" disabled>7TV chat emotes</label>\n<label><input type=\"checkbox\" id=\"adSkipIndicator\" disabled>Show an indicator when an ad is filtered</label>\n<p>The indicator appears briefly in the top-right corner. It requires ad filtering and is off by default.</p>\n<label><input type=\"checkbox\" id=\"playerControls\" aria-describedby=\"player-controls-help\" disabled>Improved remote navigation in live streams</label>\n<p id=\"player-controls-help\">Back can exit a stream with the controls visible, and OK can activate a hidden button. With this option, Back hides visible controls and OK only reveals hidden controls.</p>\n<label><input type=\"checkbox\" id=\"channelPoints\" aria-describedby=\"channel-points-help\" disabled>Automatically claim channel point bonuses</label>\n<p id=\"channel-points-help\">Waits a random 3–12 seconds after detecting a bonus, then checks it is still available before claiming. Leaving the stream cancels the pending claim.</p>\n<label><input type=\"checkbox\" id=\"channelPointsIndicator\" disabled>Show a notification when a bonus is credited</label>\n<label><input type=\"checkbox\" id=\"accountManager\" disabled>Manage multiple Twitch accounts</label>\n<label><input type=\"checkbox\" id=\"accountChooserOnLaunch\" disabled>Choose an account when Twitch opens (two or more saved accounts)</label>\n<p>On the Twitch home screen, select your profile next to Settings to switch accounts. Adding an account uses Twitch’s normal sign-in. Saved sessions are encrypted on this TV. Switching reloads Twitch. Forget saved accounts before uninstalling the plugin if you want to erase them.</p>\n<div id=\"save-state\" role=\"status\" aria-live=\"polite\">Loading settings…</div>\n<p>Changes are saved automatically. Turning all features off closes the inspection session. If Twitch is open, it may restart normally.</p></section>\n<section><b>Session</b><div id=\"state\">Checking…</div><button id=\"retry\" disabled>Retry preparation</button></section>\n<section><b>Accounts</b><p id=\"accounts-state\">Account management is disabled.</p><div id=\"accounts-list\"></div>\n<button id=\"accounts-manage\" disabled>Manage on TV</button> <button id=\"accounts-add\" disabled>Add account</button> <button id=\"accounts-capture\" disabled>Save current account</button> <button id=\"accounts-cancel\" disabled>Cancel sign-in</button> <button id=\"accounts-forget-all\" disabled>Forget all saved accounts</button>\n<p id=\"accounts-message\" role=\"status\" aria-live=\"polite\"></p></section>\n<section><b>Ad filtering</b><pre id=\"filter\">Waiting for Twitch.</pre></section>\n<section><b>7TV chat emotes</b><pre id=\"emotes\">Waiting for Twitch.</pre></section>\n<section><b>Channel point bonuses</b><p id=\"points-state\">Disabled</p><p id=\"points-last\" hidden></p></section>\n<p>Switch this plugin off to stop its features. Saved accounts remain available when you enable it again. Some ads may still play.</p>\n<script>\nvar keys=['adFiltering','emotes7tv','adSkipIndicator','accountManager','accountChooserOnLaunch','channelPoints','channelPointsIndicator','playerControls'],settings=null,saving=false,polling=false,revision=0,reloadingSettings=false,accountsBusy=false;\nfunction el(id){return document.getElementById(id)}\nfunction request(p,options){return fetch(p,options).then(function(r){return r.json().then(function(v){if(!r.ok)throw new Error(v.error||'Request failed');return v})})}\nfunction showSettings(){keys.forEach(function(k){el(k).checked=!!(settings&&settings[k]);el(k).disabled=saving||!settings||(k==='channelPointsIndicator'&&!settings.channelPoints)})}\nfunction detail(path,id,format,expectedRevision){request(path).then(function(d){if(!saving&&revision===expectedRevision)el(id).textContent=format(d)}).catch(function(){})}\nfunction poll(){\n if(polling||saving)return;\n polling=true;var expectedRevision=revision;\n request('status').then(function(v){\n  if(saving||revision!==expectedRevision)return;\n  settings=v.settings;showSettings();\n  if(reloadingSettings){el('save-state').textContent='Save not confirmed. Showing saved settings.';reloadingSettings=false}\n  if(el('save-state').textContent==='Loading settings…')el('save-state').textContent='';\n  el('retry').disabled=!settings.adFiltering&&!settings.emotes7tv&&!settings.accountManager&&!settings.channelPoints&&!settings.playerControls;\n  renderAccounts(v.accounts);\n  renderPoints(v.points);\n  el('state').textContent=(el('retry').disabled?'All features disabled — ':'')+v.session.phase+(v.error?' — '+v.error:v.session.error?' — '+v.session.error:'');\n  if(!settings.adFiltering)el('filter').textContent='Disabled';\n  else if(v.filter.attached)detail('filter/status','filter',function(d){return JSON.stringify({network:d.network,indicator:d.indicator},null,2)},expectedRevision);\n  else el('filter').textContent=v.filter.error||'Waiting for Twitch.';\n  if(!settings.emotes7tv)el('emotes').textContent='Disabled';\n  else if(v.emotes.attached)detail('emotes/status','emotes',function(d){return JSON.stringify({global:d.globalEmotes,channel:d.channelEmotes,rendering:d.page,error:d.error},null,2)},expectedRevision);\n  else el('emotes').textContent=v.emotes.error||'Waiting for Twitch.';\n }).catch(function(){if(!saving&&revision===expectedRevision)el('state').textContent='Connection unavailable'}).then(function(){polling=false});\n}\nkeys.forEach(function(key){el(key).onchange=function(){\n if(saving||!settings)return;\n var patch={};patch[key]=el(key).checked;saving=true;revision++;showSettings();el(key).checked=patch[key];el('retry').disabled=true;el('save-state').textContent='Saving…';\n request('settings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(patch)})\n  .then(function(v){settings=v;el('save-state').textContent='Saved'})\n  .catch(function(e){el('save-state').textContent='Save not confirmed: '+e.message+'. Reloading saved settings…';settings=null;reloadingSettings=true})\n  .then(function(){saving=false;showSettings();poll()});\n}});\nfunction renderAccounts(value){\n value=value||{profiles:[]};var enabled=!!(settings&&settings.accountManager),blocked=!enabled||accountsBusy||!!value.busy;\n el('accounts-state').textContent=enabled?(value.phase||'Waiting for Twitch')+(value.error?' — '+value.error:''):'Account management is disabled.';\n var list=el('accounts-list');while(list.firstChild)list.removeChild(list.firstChild);\n (value.profiles||[]).forEach(function(p){\n  var row=document.createElement('p'),label=document.createElement('span');label.textContent=p.login+(p.active?' (current)':'')+(p.state==='sign-in-required'?' — sign in again':'')+' ';row.appendChild(label);\n  [['Switch','switch'],['Forget','forget']].forEach(function(action){var b=document.createElement('button');b.textContent=action[0];b.disabled=blocked||!!value.adding;b.onclick=function(){if(action[1]==='forget'&&!confirm('Forget '+p.login+' on this TV? This does not sign out of Twitch.'))return;accountAction(action[1],p.id)};row.appendChild(b)});list.appendChild(row);\n });\n ['manage','add','capture','cancel','forget-all'].forEach(function(action){el('accounts-'+action).disabled=blocked||((action==='add'||action==='capture'||action==='forget-all')&&!!value.adding)});\n el('accounts-capture').disabled=blocked||!value.canCapture||!!value.adding;\n el('accounts-cancel').disabled=blocked||!value.adding;\n el('accounts-forget-all').disabled=blocked||!!value.adding||!(value.profiles||[]).length;\n}\nfunction renderPoints(value){\n value=value||{};\n var phase={'waiting-for-twitch':'Waiting for Twitch.','waiting-for-signed-in-live':'Waiting for a signed-in live stream.',watching:'Watching for a bonus.'};\n el('points-state').textContent=settings.channelPoints?(value.error||phase[value.phase]||'Waiting for Twitch.'):'Disabled';\n var claim=settings.channelPoints&&value.lastClaim;\n el('points-last').hidden=!claim;\n el('points-last').textContent=claim?'Last confirmed: +'+claim.points+' points on '+claim.channel+' at '+new Date(claim.at).toLocaleTimeString()+' · '+value.confirmed+' confirmed':'';\n}\nfunction accountAction(action,id){\n if(accountsBusy)return;accountsBusy=true;el('accounts-message').textContent='Please wait…';renderAccounts({phase:'Working',profiles:[]});\n var body={action:action};if(id)body.id=id;\n request('accounts',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})\n  .then(function(v){el('accounts-message').textContent='Done';accountsBusy=false;renderAccounts(v);poll()})\n  .catch(function(e){accountsBusy=false;el('accounts-message').textContent=e.message;poll()});\n}\n['manage','add','capture','cancel','forget-all'].forEach(function(action){el('accounts-'+action).onclick=function(){if(action==='forget-all'&&!confirm('Forget all saved accounts on this TV? This does not sign out of Twitch.'))return;accountAction(action)}});\nel('retry').onclick=function(){el('retry').disabled=true;request('retry',{method:'POST'}).then(poll).catch(function(e){el('state').textContent=e.message;poll()})};poll();setInterval(poll,3000);\n</script>\n"}}
