g: Tajikistan\",\"bandeira: Tadjiquist\\u00e3o\",\"TJ flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf0\",8,\"flag: Tokelau\",\"bandeira: Tokelau\",\"TK flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf1\",8,\"flag: Timor-Leste\",\"bandeira: Timor-Leste\",\"TL flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf2\",8,\"flag: Turkmenistan\",\"bandeira: Turcomenist\\u00e3o\",\"TM flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf3\",8,\"flag: Tunisia\",\"bandeira: Tun\\u00edsia\",\"TN flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf4\",8,\"flag: Tonga\",\"bandeira: Tonga\",\"TO flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf7\",8,\"flag: T\\u00fcrkiye\",\"bandeira: Turquia\",\"TR flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddf9\",8,\"flag: Trinidad & Tobago\",\"bandeira: Trinidad e Tobago\",\"TT flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddfb\",8,\"flag: Tuvalu\",\"bandeira: Tuvalu\",\"TV flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddfc\",8,\"flag: Taiwan\",\"bandeira: Taiwan\",\"TW flag\"],[\"\\ud83c\\uddf9\\ud83c\\uddff\",8,\"flag: Tanzania\",\"bandeira: Tanz\\u00e2nia\",\"TZ flag\"],[\"\\ud83c\\uddfa\\ud83c\\udde6\",8,\"flag: Ukraine\",\"bandeira: Ucr\\u00e2nia\",\"UA flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddec\",8,\"flag: Uganda\",\"bandeira: Uganda\",\"UG flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddf2\",8,\"flag: U.S. Outlying Islands\",\"bandeira: Ilhas Menores Distantes dos EUA\",\"UM flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddf3\",8,\"flag: United Nations\",\"bandeira: Na\\u00e7\\u00f5es Unidas\",\"UN flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddf8\",8,\"flag: United States\",\"bandeira: Estados Unidos\",\"US flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddfe\",8,\"flag: Uruguay\",\"bandeira: Uruguai\",\"UY flag\"],[\"\\ud83c\\uddfa\\ud83c\\uddff\",8,\"flag: Uzbekistan\",\"bandeira: Uzbequist\\u00e3o\",\"UZ flag\"],[\"\\ud83c\\uddfb\\ud83c\\udde6\",8,\"flag: Vatican City\",\"bandeira: Cidade do Vaticano\",\"VA flag\"],[\"\\ud83c\\uddfb\\ud83c\\udde8\",8,\"flag: St. Vincent & Grenadines\",\"bandeira: S\\u00e3o Vicente e Granadinas\",\"VC flag\"],[\"\\ud83c\\uddfb\\ud83c\\uddea\",8,\"flag: Venezuela\",\"bandeira: Venezuela\",\"VE flag\"],[\"\\ud83c\\uddfb\\ud83c\\uddec\",8,\"flag: British Virgin Islands\",\"bandeira: Ilhas Virgens Brit\\u00e2nicas\",\"VG flag\"],[\"\\ud83c\\uddfb\\ud83c\\uddee\",8,\"flag: U.S. Virgin Islands\",\"bandeira: Ilhas Virgens Americanas\",\"VI flag\"],[\"\\ud83c\\uddfb\\ud83c\\uddf3\",8,\"flag: Vietnam\",\"bandeira: Vietn\\u00e3\",\"VN flag\"],[\"\\ud83c\\uddfb\\ud83c\\uddfa\",8,\"flag: Vanuatu\",\"bandeira: Vanuatu\",\"VU flag\"],[\"\\ud83c\\uddfc\\ud83c\\uddeb\",8,\"flag: Wallis & Futuna\",\"bandeira: Wallis e Futuna\",\"WF flag\"],[\"\\ud83c\\uddfc\\ud83c\\uddf8\",8,\"flag: Samoa\",\"bandeira: Samoa\",\"WS flag\"],[\"\\ud83c\\uddfd\\ud83c\\uddf0\",8,\"flag: Kosovo\",\"bandeira: Kosovo\",\"XK flag\"],[\"\\ud83c\\uddfe\\ud83c\\uddea\",8,\"flag: Yemen\",\"bandeira: I\\u00eamen\",\"YE flag\"],[\"\\ud83c\\uddfe\\ud83c\\uddf9\",8,\"flag: Mayotte\",\"bandeira: Mayotte\",\"YT flag\"],[\"\\ud83c\\uddff\\ud83c\\udde6\",8,\"flag: South Africa\",\"bandeira: \\u00c1frica do Sul\",\"ZA flag\"],[\"\\ud83c\\uddff\\ud83c\\uddf2\",8,\"flag: Zambia\",\"bandeira: Z\\u00e2mbia\",\"ZM flag\"],[\"\\ud83c\\uddff\\ud83c\\uddfc\",8,\"flag: Zimbabwe\",\"bandeira: Zimb\\u00e1bue\",\"ZW flag\"]]}","index.js":"'use strict';\n// Notification Center: queue notifications from any device on the LAN and show them as native TV banners\n// through a small companion web app (see README). It talks to Vetro on 127.0.0.1:8099 (to launch that app); the one other thing it does on the\n// network is to fetch an http(s) image URL when a sender gives an `image` or `wallpaper` (at most 2 at a time, 10 s each, 3 MB).\n// Everything that arrives from the LAN is untrusted JSON: values are type-checked (str/num/has from rules.js) before they are used.\n// Plain ES5: older TVs run Node 4.4.\nvar fs = require('fs');\nvar path = require('path');\nvar http = require('http');\nvar https = require('https');\nvar urlmod = require('url');\nvar os = require('os');\nvar rules = require('./rules.js');\n\nvar MAX_HOOK_BODY = 65536;\n// The tunes: [milliseconds from the start, sound]. We Will Rock You: stomp, stomp, clap (81 beats per minute). Beethoven's 5th: short, short, short, LONG (twice, then again).\nvar SONGS = { rock: { title: 'We Will Rock You', steps: [] }, fate: { title: \"Beethoven's 5th\", steps: [] } };\n(function () {\n    var i, bar;\n    for (bar = 0; bar < 4; bar++) { for (i = 0; i < 3; i++) { SONGS.rock.steps.push([bar * 2960 + i * 740, i < 2 ? 'soft' : 'success']); } }\n    [0, 3400, 6800].forEach(function (base, n) {\n        [0, 280, 560].forEach(function (d) { SONGS.fate.steps.push([base + d, n === 1 ? 'chime' : 'success']); });\n        SONGS.fate.steps.push([base + 840, n === 1 ? 'alert' : 'rotation']);\n    });\n}());\nvar SOUND_DIR = '/usr/share/feedback/sound/operation/', SOUND_GAP_MS = 800;\n// The TV's system sounds are quiet: the volume the user sets (10-100 %) is multiplied by this to get the paplay volume (100 % = 3.0, about +9.5 dB).\nvar SOUND_BOOST = 3;\n// The sound waits for the banner: Vetro needs a few seconds to start the banner service, which then records the id in this file (see app/service.js).\n// If the id never shows up there, the sound plays after SOUND_WAIT_MS anyway.\nvar SEEN_FILE = '/tmp/notification-center-seen.json', SOUND_WAIT_MS = 10000, SOUND_POLL_MS = 50, MAX_WAITING_SOUNDS = 8;   // at most 8 sounds wait for their banner at once; more are skipped\n// The TV's system sounds a request can choose (the names are the closed list in rules.js).\nvar SOUND_FILES = { chime: 'normal_noti.wav', soft: 'select.wav', reward: 'vi_reward.wav', success: 'vi_success.wav', alert: 'vi_fail.wav', rotation: 'p_rotation_fail.wav', open: 'home_open.wav', poweron: 'power_on.wav' };\nvar MAX_TITLE = 40, MAX_MESSAGE = 200, MAX_QUEUE = 5, MAX_RECENT = 20, MAX_BODY = 8192, MAX_ICON = 16;\nvar DEFAULT_SECONDS = 30, MIN_SECONDS = 5, MAX_SECONDS = 300, MIN_RELAUNCH_MS = 2000, APP_ACTIVE_MS = 3500;\n// The banner service reads the queue from this file, so it needs no network and no Vetro key (it still works with pairing on).\nvar QUEUE_FILE = '/tmp/notification-center-queue.json';\nvar DEFAULT_APP = 'NotifCtr01.NotifCenter';   // the companion app (screen: full-screen card, native banner)\nvar SERVICE_APP = 'NotifCtr01.Svc';           // its background service (native banner over the running app, no app switch)\nvar LEVELS = { info: 1, ok: 1, warn: 1, alert: 1 };\nvar MIN_DURATION = 1, MAX_DURATION = 60, DEFAULT_DURATION = 8;\nvar MODES = { both: 1, banner: 1, full: 1 };   // banner (default) = native banner over the running app, from the background service; full = full-screen card; both = card + banner\n\nmodule.exports = function (ctx) {\n    // Where Vetro listens. Only a test passes ctx.vetro; on the TV it is always 127.0.0.1:8099.\n    var vetro = ctx.vetro && typeof ctx.vetro === 'object' ? ctx.vetro : {};\n    var VHOST = typeof vetro.host === 'string' ? vetro.host : '127.0.0.1', VPORT = typeof vetro.port === 'number' ? vetro.port : 8099;\n    var soundLast = null, soundAt = 0, soundTrace = null;   // soundTrace: when the last banner sound started and when its banner was seen (for the panel)\n    var queueFile = QUEUE_FILE, seenFile = SEEN_FILE, soundWaitMs = SOUND_WAIT_MS, waitingSounds = {}, songScale = 1;   // waitingSounds: notification id -> {fire, timer}\n    if (typeof ctx.queueFile === 'string') { queueFile = ctx.queueFile; }   // only a test changes this (each test Shard gets its own file)\n    if (typeof ctx.sound === 'object' && ctx.sound) {   // only a test changes these\n        if (typeof ctx.sound.gapMs === 'number') { SOUND_GAP_MS = ctx.sound.gapMs; }\n        if (typeof ctx.sound.waitMs === 'number') { soundWaitMs = ctx.sound.waitMs; }\n        if (typeof ctx.sound.seenFile === 'string') { seenFile = ctx.sound.seenFile; }\n        if (typeof ctx.sound.songScale === 'number') { songScale = ctx.sound.songScale; }\n    }\n    var queue = [];      // active notifications (memory only)\n    var recent = [];     // last ones sent, for the page; kept in ctx.config so they survive a restart or an update\n    try { var saved = (ctx.config.get() || {}).recent; if (Array.isArray(saved)) { recent = saved.slice(0, MAX_RECENT); } } catch (e) { recent = []; }\n    function saveRecent() { try { var c = ctx.config.get() || {}; c.recent = recent; ctx.config.set(c); } catch (e) { /* storage unavailable */ } }\n    var seq = 0;\n    var lastOpen = 0, appPoll = 0;   // appPoll: when the app screen last asked for the queue (0 = it is closed)\n\n    // Display language of the app screen and the panel: 'en' (default) or 'pt'. The only thing kept in ctx.config.\n    function getLang() { var c = ctx.config.get() || {}; return c.lang === 'pt' ? 'pt' : 'en'; }\n    function appId() { return DEFAULT_APP; }   // fixed: nothing can point the Shard at another app\n    function send(res, code, type, body) {\n        res.writeHead(code, { 'Content-Type': type, 'Cache-Control': 'no-store' });\n        res.end(body);\n    }\n    function sendJson(res, code, obj) { send(res, code, 'application/json; charset=utf-8', JSON.stringify(obj)); }\n    // The companion app can read the queue as a <script> when the TV's web runtime blocks cross-origin XHR.\n    function sendScript(res, obj) {\n        var json = JSON.stringify(obj).replace(/</g, '\\\\u003c');\n        json = json.split(String.fromCharCode(0x2028)).join('\\\\u2028').split(String.fromCharCode(0x2029)).join('\\\\u2029');\n        send(res, 200, 'application/javascript; charset=utf-8', 'window.__ncNotes&&window.__ncNotes(' + json + ');');\n    }\n    function wantsScript(req) { return /[?&]js=1(&|$)/.test(String(req.url || '')); }\n    // The body is collected as bytes and decoded once at the end, so a multi-byte character split between two chunks stays intact.\n    function toBuf(d) { return Buffer.isBuffer(d) ? d : (Buffer.from && Buffer.from !== Uint8Array.from ? Buffer.from(String(d), 'utf8') : new Buffer(String(d), 'utf8')); }\n    function readBody(req, cb, max) {\n        var chunks = [], n = 0, limit = max || MAX_BODY, over = false;\n        req.on('data', function (d) {\n            if (over) { return; }\n            var b = toBuf(d);\n            n += b.length;\n            if (n > limit) {\n                // Too large: answer 413 and drop the rest of the body without buffering it.\n                over = true; chunks = [];\n                if (cb.res) { try { sendJson(cb.res, 413, { error: 'request body too large' }); } catch (e) { /* already answered */ } }\n                return;\n            }\n            chunks.push(b);\n        });\n        req.on('end', function () { if (!over) { cb(Buffer.concat(chunks).toString('utf8')); } });\n    }\n    // A body handler that throws must never take the Shard down: answer 500 instead of letting the exception reach Vetro.\n    function guard(res, fn) {\n        var f = function (raw) {\n            try { fn(raw); } catch (e) { try { sendJson(res, 500, { error: 'internal error' }); } catch (e2) { /* the answer was already sent */ } }\n        };\n        f.res = res;   // readBody answers 413 on this response when the body is too large\n        return f;\n    }\n    function readBodyG(req, res, cb, max) { readBody(req, guard(res, cb), max); }\n    var limiter = rules.makeLimiter(), groups = {};   // per-source rate windows and recently seen repeats (memory only)\n    var str = rules.str, num = rules.num, has = rules.has;\n    function cfgGet() { return ctx.config.get() || {}; }\n    // Drops the grouping entries older than the window, and keeps at most MAX_GROUPS (the oldest go first). It walks the map only once it has grown past\n    // 50 entries, so a flood of distinct notifications cannot make every request slower.\n    var MAX_GROUPS = 200;\n    function pruneGroups(now, windowMs) {\n        var keys = Object.keys(groups);\n        if (keys.length <= 50) { return; }\n        keys.forEach(function (k) { if (now - groups[k].at >= windowMs) { delete groups[k]; } });\n        keys = Object.keys(groups);\n        if (keys.length > MAX_GROUPS) {\n            keys.sort(function (x, y) { return groups[x].at - groups[y].at; }).slice(0, keys.length - MAX_GROUPS).forEach(function (k) { delete groups[k]; });\n        }\n    }\n    function soundVolume(v) { return rules.clampVolume(v); }\n    function settingsNow() { return rules.sanitizeSettings(cfgGet().settings, {}); }\n    function clean(text, max) {\n        return str(text).replace(/[\\x00-\\x1f]/g, ' ').slice(0, max).trim();\n    }\n    function prune() {\n        var now = Date.now();\n        queue = queue.filter(function (n) { return n.expires > now; });\n        var keep = {};\n        queue.forEach(function (n) { keep[n.id] = 1; });\n        Object.keys(imgCache).forEach(function (k) { if (!keep[k.split(':')[0]]) { delete imgCache[k]; } });\n    }\n\n    // Asks Vetro to launch the companion app (at most once every 10 s), or its background service (every time: it is\n    // headless, so launching it only makes it read the queue and post the banner).\n    function openApp(service) {\n        var now = Date.now();\n        if (!service) {\n            // The app screen announces itself while it is open (it polls every 2 s and says goodbye when it leaves), so a notification\n            // queued while it is open is simply picked up, and one queued while it is closed launches it again right away.\n            if (now - appPoll < APP_ACTIVE_MS) { return 'app is open: it will pick it up'; }\n            if (now - lastOpen < MIN_RELAUNCH_MS) { return 'skipped (launched less than 2 s ago)'; }\n            lastOpen = now;\n        }\n        var body = JSON.stringify({ appId: service ? SERVICE_APP : appId() });\n        try {\n            var rq = http.request({\n                host: VHOST, port: VPORT, path: '/apps/launch', method: 'POST', timeout: 5000,\n                headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }\n            }, function (r) { r.resume(); });\n            rq.on('error', function () { /* Vetro busy or app not installed */ });\n            rq.setTimeout(5000);   // the timeout option alone is ignored before Node 6.8\n            rq.on('timeout', function () { rq.destroy(); });\n            rq.write(body);\n            rq.end();\n            return 'requested';\n        } catch (e) { return 'error'; }\n    }\n\n    // The app may only load resources from the addresses its config.xml declares, so the Shard fetches the picture and serves it itself.\n    // Only a notification's own `image` / `wallpaper` URL is ever fetched (there is no route that fetches an arbitrary URL). Limits: 2 fetches at once\n    // (the others wait, at most 8 waiting, then \"busy\"), 10 s in total per fetch however slowly the server sends, 3 MB, 3 redirects; stop() aborts them all.\n    var imgCache = {}, MAX_IMG = 3000000, MAX_FETCHES = 2, MAX_WAITING = 8, FETCH_DEADLINE_MS = 10000;\n    var running = [], waiting = [];\n    function pump() {\n        while (running.length < MAX_FETCHES && waiting.length) { var w = waiting.shift(); startFetch(w.url, w.cb); }\n    }\n    function fetchImage(url, cb) {\n        if (running.length >= MAX_FETCHES) {\n            if (waiting.length >= MAX_WAITING) { return cb('busy: too many picture downloads'); }\n            waiting.push({ url: url, cb: cb });\n            return;\n        }\n        startFetch(url, cb);\n    }\n    function startFetch(url, cb) {\n        var job = { reqs: [], done: false, timer: null };\n        function end(e, r) {\n            if (job.done) { return; }\n            job.done = true;\n            clearTimeout(job.timer);\n            job.reqs.forEach(function (q) { try { q.destroy(); } catch (x) { /* already closed */ } });\n            running = running.filter(function (j) { return j !== job; });\n            try { cb(e, r); } catch (x) { /* the caller's answer failed: nothing to do */ }\n            pump();\n        }\n        job.end = end;\n        running.push(job);\n        job.timer = setTimeout(function () { end('timeout (10 s)'); }, FETCH_DEADLINE_MS);\n        get(url, 0);\n        function get(u0, hops) {\n            var u = urlmod.parse(u0), lib = u.protocol === 'https:' ? https : http;\n            try {\n                var rq = lib.get({ host: u.hostname, port: u.port, path: u.path, headers: { 'User-Agent': 'vetro-notification-center', 'Accept': 'image/*' }, timeout: 8000 }, function (r) {\n                    if (job.done) { r.resume(); return; }\n                    if (r.statusCode >= 300 && r.statusCode < 400 && r.headers.location && hops < 3) {\n                        r.resume();\n                        return get(urlmod.resolve(u0, r.headers.location), hops + 1);\n                    }\n                    var type = str(r.headers['content-type']).split(';')[0];\n                    if (r.statusCode !== 200 || !/^image\\/(png|jpe?g|gif|webp|bmp)$/i.test(type)) { r.resume(); return end('not an image (http ' + r.statusCode + ' ' + type + ')'); }\n                    var chunks = [], n = 0;\n                    r.on('data', function (d) { n += d.length; if (n > MAX_IMG) { r.destroy(); end('image is larger than 3 MB'); } else { chunks.push(d); } });\n                    r.on('end', function () { end(null, { type: type, buf: Buffer.concat(chunks) }); });\n                    r.on('error', function () { end('download failed'); });\n                });\n                job.reqs.push(rq);\n                rq.on('error', function (e) { end(str(e && e.code || e && e.message)); });\n                rq.setTimeout(8000);\n                rq.on('timeout', function () { end('timeout'); });\n            } catch (e) { end('request failed'); }\n        }\n    }\n    function abortFetches() {\n        var w = waiting; waiting = [];\n        running.slice().forEach(function (j) { j.end('stopped'); });\n        w.forEach(function (x) { try { x.cb('stopped'); } catch (e) { /* ignore */ } });\n    }\n\n    // Sound: plays one of the TV's own system sounds. This Shard has the `exec` permission for exactly ONE command shape:\n    //     paplay --volume=<integer> /usr/share/feedback/sound/operation/<one of the fixed files above>\n    // The sound comes from a closed list and the volume is a clamped integer, so no text from a request ever reaches the command.\n    // At most one sound every 0.8 s (a flood of requests cannot make the TV play a flood of sounds).\n    function playSound(name, volume) {\n        if (typeof name !== 'string' || !has(SOUND_FILES, name)) { return 'none'; }\n        var now = Date.now();\n        if (now - soundAt < SOUND_GAP_MS) { return 'skipped'; }\n        soundAt = now;\n        return execSound(name, volume, now);\n    }\n    // The only place that runs a command.\n    function execSound(name, volume, now) {\n        var v = Math.round(65536 * (volume >= 10 && volume <= 100 ? volume : 100) / 100 * settingsNow().soundVolume / 100 * SOUND_BOOST), job;\n        try { job = ctx.execute('paplay --volume=' + v + ' ' + SOUND_DIR + SOUND_FILES[name], 8000); } catch (e) { soundLast = { at: now, ok: false, error: 'exec failed' }; return 'requested'; }\n        if (!job || typeof job.then !== 'function') { soundLast = { at: now, ok: false, error: 'exec unavailable' }; return 'requested'; }\n        job.then(function (r) {\n            soundLast = r && r.exit_code ? { at: now, ok: false, error: 'paplay exit ' + r.exit_code + (r.stderr ? ': ' + str(r.stderr).slice(0, 120) : '') } : { at: now, ok: true };\n        }, function (e) { soundLast = { at: now, ok: false, error: str(e && e.message).slice(0, 160) || 'exec failed' }; });\n        return 'requested';\n    }\n\n    // Goodie: about 10 seconds of a well-known tune made only of the notification sounds. The sounds have fixed pitches, so the tunes are recognised by their\n    // rhythm. The songs are fixed lists in the code (a request only picks a name), every step runs the same paplay command, one song at a time, at most 12 s.\n    var songTimers = [], songEnd = null;\n    function playSong(name) {\n        if (!has(SONGS, name)) { return 'unknown'; }\n        if (songEnd) { return 'busy'; }\n        var steps = SONGS[name].steps, last = 0;\n        steps.forEach(function (s) {\n            last = s[0] > last ? s[0] : last;\n            songTimers.push(setTimeout(function () { execSound(s[1], 100, Date.now()); }, Math.round(s[0] * songScale)));\n        });\n        songEnd = setTimeout(function () { songTimers = []; songEnd = null; }, Math.round((last + 2500) * songScale));\n        return 'playing';\n    }\n    function stopSong() {\n        songTimers.forEach(function (x) { clearTimeout(x); });\n        songTimers = []; clearTimeout(songEnd); songEnd = null;\n    }\n\n    // The sound goes with the banner. The banner appears some seconds after the request (Vetro has to start the banner service) and the Shard cannot see\n    // when: the service has no permission to write back. So the sound starts `soundDelayMs` after the request (a setting you tune by ear, with the test in the\n    // Testing tab); if the banner service did record the id in the file the Shard can read (other TVs), the sound starts as soon as it is seen.\n    // Full and both: the sound plays when the app screen asks for the queue. open:false notifications (never shown) play at once.\n    function scheduleSound(note) {\n        if (Object.keys(waitingSounds).length >= MAX_WAITING_SOUNDS) { return false; }\n        var entry = { timer: null, done: false, fired: false }, started = Date.now();\n        var fireAt = started + Math.min(settingsNow().soundDelayMs, soundWaitMs);\n        var trace = { id: note.id, mode: note.mode, plannedMs: fireAt - started, startedMs: null, seenMs: null };\n        soundTrace = trace;\n        function fire() { if (!entry.fired) { entry.fired = true; trace.startedMs = Date.now() - started; playSound(note.sound, note.volume); } }\n        function finish() { entry.done = true; clearTimeout(entry.timer); delete waitingSounds[note.id]; }\n        entry.fire = function () { fire(); finish(); };\n        waitingSounds[note.id] = entry;\n        function shown() { try { return has(JSON.parse(fs.readFileSync(seenFile, 'utf8')), note.id); } catch (e) { return false; } }\n        function tick() {\n            if (entry.done) { return; }\n            var now = Date.now();\n            if (note.mode === 'banner') {\n                if (shown()) { trace.seenMs = now - started; fire(); return finish(); }\n                if (!entry.fired && now >= fireAt) { fire(); }\n                if (now - started > soundWaitMs + 3000) { return finish(); }\n            } else if (now - started >= soundWaitMs) { fire(); return finish(); }\n            entry.timer = setTimeout(tick, SOUND_POLL_MS);\n        }\n        entry.timer = setTimeout(tick, SOUND_POLL_MS);\n        return true;\n    }\n    function cancelSounds() { Object.keys(waitingSounds).forEach(function (id) { var e = waitingSounds[id]; e.done = true; clearTimeout(e.timer); }); waitingSounds = {}; }\n    function soundAvailable() { return typeof ctx.execute === 'function'; }\n\n    // Installation status for the panel: is the companion app (and its service) installed, is Vetro pairing on, which Shard version.\n    function statusInfo(cb) {\n        var out = { version: '', app: false, appVersion: '', service: false, pairing: 'unknown', handoff: false, sound: soundAvailable() }, left = 2;\n        try { out.handoff = fs.existsSync(queueFile); } catch (e) { /* unknown */ }\n        try { out.version = require('./manifest.json').version; } catch (e) { /* manifest not readable */ }\n        function once() { var d = false; return function () { if (!d) { d = true; left -= 1; if (!left) { cb(out); } } }; }\n        var d1 = once(), d2 = once();\n        try {\n            var rq = http.get({ host: VHOST, port: VPORT, path: '/apps', timeout: 5000 }, function (r) {\n                var s = '';\n                r.setEncoding('utf8');\n                r.on('data', function (d) { s += d; if (s.length > 3000000) { r.destroy(); } });\n                r.on('end', function () {\n                    try {\n                        var j = JSON.parse(s), list = Array.isArray(j) ? j : (j.apps || []), i;\n                        for (i = 0; i < list.length; i++) {\n                            if (list[i].appId === DEFAULT_APP) { out.app = true; out.appVersion = str(list[i].version); }\n                            if (list[i].appId === SERVICE_APP) { out.service = true; }\n                        }\n                    } catch (e) { /* leave unknown */ }\n                    d1();\n                });\n            });\n            rq.on('error', d1);\n            rq.setTimeout(5000);\n            rq.on('timeout', function () { rq.destroy(); });\n        } catch (e) { d1(); }\n        // Pairing: ask this TV on its own LAN address without a key; 401 means pairing is on.\n        var ip = null, ifs = os.networkInterfaces(), k, j2;\n        for (k in ifs) { if (ifs.hasOwnProperty(k)) { for (j2 = 0; j2 < ifs[k].length; j2++) { if (ifs[k][j2].family === 'IPv4' && !ifs[k][j2].internal && !ip) { ip = ifs[k][j2].address; } } } }\n        if (!ip) { return d2(); }\n        try {\n            var rq2 = http.get({ host: ip, port: 8099, path: '/plugins/notification-center/api/lang', timeout: 4000 }, function (r) {\n                r.resume();\n                out.pairing = r.statusCode === 401 ? 'on' : r.statusCode === 200 ? 'off' : 'unknown';\n                d2();\n            });\n            rq2.on('error', d2);\n            rq2.setTimeout(4000);\n            rq2.on('timeout', function () { rq2.destroy(); });\n        } catch (e) { d2(); }\n    }\n\n    function serveImage(req, res) {\n        var m = /[?&]id=([^&]+)/.exec(String(req.url || '')), id = '', info = /[?&]info=1(&|$)/.test(String(req.url || '')), note = null, i;\n        try { id = m ? decodeURIComponent(m[1]) : ''; } catch (e) { id = ''; }\n        for (i = 0; i < queue.length; i++) { if (queue[i].id === id) { note = queue[i]; } }\n        var kind = /[?&]kind=wallpaper(&|$)/.test(String(req.url || '')) ? 'wallpaper' : 'image', src = note && note[kind], key = id + ':' + kind;\n        if (!src) { return sendJson(res, 404, { error: 'no ' + kind + ' for that notification' }); }\n        function out(hit) {\n            if (info) { return sendJson(res, 200, { ok: true, type: hit.type, bytes: hit.buf.length }); }\n            res.writeHead(200, { 'Content-Type': hit.type, 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Content-Length': hit.buf.length });\n            res.end(hit.buf);\n        }\n        if (imgCache[key]) { return out(imgCache[key]); }\n        fetchImage(src, function (err, hit) {\n            if (err) { return sendJson(res, 502, { ok: false, error: err }); }\n            imgCache[key] = hit;\n            out(hit);\n        });\n    }\n\n    // Self-description of the API, built from the same constants that validate the requests, so it cannot drift from the code.\n    // Keep it in step with API.md: every new field, mode or route is added in code, here, and in API.md together.\n    function describe() {\n        var ver = '';\n        try { ver = require('./manifest.json').version; } catch (e) { /* manifest not readable */ }\n        return {\n            name: 'notification-center', version: ver, apiVersion: 1,\n            base: '/plugins/notification-center/api/',\n            auth: 'Same as the rest of Vetro: no key with pairing off; with pairing on, other devices send \"Authorization: Bearer <key>\". Shards on the same TV call http://127.0.0.1:8099 and need no key.',\n            enums: { level: Object.keys(LEVELS), mode: Object.keys(MODES), sound: Object.keys(rules.SOUNDS) },\n            limits: { title: MAX_TITLE, message: MAX_MESSAGE, queue: MAX_QUEUE, recent: MAX_RECENT, durationSeconds: [MIN_DURATION, MAX_DURATION], queueSeconds: [MIN_SECONDS, MAX_SECONDS], image: '3 MB, png/jpeg/gif/webp/bmp, http(s) URL up to 290 characters', relaunchAfterSeconds: MIN_RELAUNCH_MS / 1000 },\n            fields: {\n                message: { type: 'string', required: true, max: MAX_MESSAGE, note: 'The text of the notification.' },\n                title: { type: 'string', max: MAX_TITLE },\n                level: { type: 'string', enum: Object.keys(LEVELS), default: 'info', note: 'Colours the card and the panel; the native banner shows the level emoji.' },\n                mode: { type: 'string', enum: Object.keys(MODES), default: 'banner', note: 'banner = native Samsung banner over the running app (no app switch); full = full-screen card; both = card and banner.' },\n                duration: { type: 'integer', min: MIN_DURATION, max: MAX_DURATION, default: DEFAULT_DURATION, note: 'Seconds on screen.' },\n                icon: { type: 'string', max: MAX_ICON, note: 'One emoji (or an emoji sequence) in front of the title; default by level. Cut at whole emoji, never in the middle of one.' },\n                image: { type: 'url', note: 'http/https picture under the message on the full-screen card. The Shard fetches it.' },\n                wallpaper: { type: 'url', note: 'http/https full-screen background behind the card. The Shard fetches it.' },\n                seconds: { type: 'integer', min: MIN_SECONDS, max: MAX_SECONDS, default: DEFAULT_SECONDS, note: 'How long it waits in the queue (always at least duration + 20).' },\n                open: { type: 'boolean', default: true, note: 'false only queues it, without launching the app or its service.' },\n                sound: { type: 'string', enum: Object.keys(rules.SOUNDS), note: 'Plays one of the TV system sounds with the notification. Empty = no sound; one sound at most every 0.8 s. Not played for a notification held back by quiet hours or merged as a repeat.' },\n                volume: { type: 'integer', min: 10, max: 100, default: 100, note: 'Volume of the sound, in percent.' },\n                group: { type: 'boolean', default: true, note: 'false = never merge this notification with an identical recent one (the panel sends false for Resend and the test buttons). Merging only happens while the setting groupSeconds is above 0.' },\n                source: { type: 'string', max: 32, note: 'Who is sending (a-z, 0-9, . _ -), or the header X-NC-Source. If a profile with that name exists, its icon, level, mode and duration fill in what you leave out, and its key (header X-NC-Key), enabled flag and rate limit apply.' }\n            },\n            endpoints: [\n                { method: 'POST', path: 'notify', summary: 'Send a notification (JSON body with the fields above). With quiet hours it may answer {ok, id, suppressed}; a repeat inside the grouping window answers {ok, id, merged:true, count}.', returns: '{ok, id, open, sound}' },\n                { method: 'POST', path: 'ntfy', summary: 'ntfy-compatible publish: body = message; headers Title, Priority (5 alert, 4 warning), Tags; or JSON {message,title,priority,tags}.', returns: '{ok, id, open}' },\n                { method: 'GET', path: 'notifications', summary: 'The active queue (used by the app and its service); add ?js=1 for the script form.', returns: '{lang, notifications:[...]}' },\n                { method: 'GET', path: 'recent', summary: 'The last notifications sent.', returns: '{recent:[...]}' },\n                { method: 'GET', path: 'img?id=<id>[&kind=wallpaper][&info=1]', summary: 'The picture of a queued notification, fetched and served by the Shard; info=1 returns {ok,type,bytes}.', returns: 'image bytes or JSON' },\n                { method: 'GET', path: 'status', summary: 'Installation status: companion app, its service, Vetro pairing, Shard version.', returns: '{version, app, appVersion, service, pairing, sound}' },\n                { method: 'GET', path: 'lang', summary: 'Display language (en or pt).', returns: '{lang}' },\n                { method: 'POST', path: 'lang', summary: 'Set the display language.', body: '{lang: \"en\"|\"pt\"}', returns: '{lang}' },\n                { method: 'GET', path: 'profiles', summary: 'The sources (profiles): defaults per sender. Keys are never returned, only hasKey.', returns: '{profiles:{<source>:{enabled,icon,level,mode,duration,rate,hasKey}}, max}' },\n                { method: 'POST', path: 'profiles', summary: 'Create, change or delete a source.', body: '{source, icon?, level?, mode?, duration?, rate? (per minute, 0 = no limit), enabled?, key? (\"\" clears), genKey? (true returns a new key once), delete?}', returns: '{ok, source, profile, key?}' },\n                { method: 'GET', path: 'settings', summary: 'Quiet hours, grouping of repeats and strict mode.', returns: '{settings:{quiet:{enabled,from,to,allow},groupSeconds,strict,soundVolume,soundDelayMs}}' },\n                { method: 'POST', path: 'settings', summary: 'Change those settings (send only what changes).', body: '{quiet?:{enabled,from:\"22:00\",to:\"07:00\",allow:\"alert\"|\"warn\"|\"none\"}, groupSeconds? (0 = off), strict? (true rejects unknown sources), soundVolume? (10-100 %, the volume of every sound, default 100), soundDelayMs? (0-10000, how long after the request the sound starts, default 3000)}', returns: '{ok, settings}' },\n                { method: 'GET', path: 'hooks', summary: 'The webhooks (templates that turn any JSON into a notification).', returns: '{hooks, max, base}' },\n                { method: 'POST', path: 'hooks', summary: 'Create, change or delete a webhook.', body: '{name, message (template), title?, level?, icon?, mode?, duration?, source?, delete?}; templates use {{a.b.0.c}} from the posted JSON', returns: '{ok, name, hook, url}' },\n                { method: 'POST', path: 'hook/<name>', summary: 'Send any JSON (up to 64 KB) to a webhook; its templates build the notification. Non-JSON bodies are available as {{text}}.', returns: 'same as notify' },\n                { method: 'POST', path: 'play', summary: 'Play one of the sounds without a notification, or a 10-second tune made of them (song). The sound volume setting applies. Answers 429 if another sound was played less than 0.8 s ago.', body: '{sound, volume?} or {song:\"rock\"|\"fate\"|\"stop\"}', returns: '{ok, sound:\"requested\"} or {ok, song:\"playing\"}' },\n                { method: 'GET', path: 'sounds', summary: 'The sounds a request can choose, whether this Shard can play sounds (exec granted), the volume and timing settings, the timing of the last banner sound (trace) and the result of the last attempt.', returns: '{sounds:[...], songs:[{name,title}], available, volume, delayMs, trace, last}' },\n                { method: 'GET', path: 'emoji', summary: 'The bundled emoji list used by the icon picker.', returns: '{source, groups, list}' },\n                { method: 'GET', path: 'api', summary: 'This description.', returns: 'JSON' }\n            ],\n            docs: 'API.md in the Shard folder'\n        };\n    }\n\n    // Hands the queue to the banner service through a file (world-readable: the service runs as another user). Written before the service is launched.\n    // Written under a new name with 'wx' (fails if the name exists, never follows a planted symlink) and then renamed over the target,\n    // so a symlink left at the target path is replaced, not written through.\n    function writeQueueFile() {\n        var tmp = queueFile + '.' + process.pid + '.' + Date.now().toString(36) + '.tmp';\n        try {\n            fs.writeFileSync(tmp, JSON.stringify({ at: Date.now(), notifications: queue.map(function (n) {\n                return { id: n.id, title: n.title, message: n.message, level: n.level, mode: n.mode, duration: n.duration, icon: n.icon, expires: n.expires };\n            }) }), { mode: 420, flag: 'wx' });\n            fs.renameSync(tmp, queueFile);\n        } catch (e) {\n            try { fs.unlinkSync(tmp); } catch (e2) { /* nothing to remove */ }\n            /* /tmp not writable: the service falls back to asking the Shard over the network */\n        }\n    }\n\n    // An emoji or emoji sequence of at most MAX_ICON UTF-16 units. It is cut only between whole characters (never inside a surrogate pair) and never\n    // left ending on a joiner or variation selector that belonged to a sequence that did not fit.\n    function cleanIcon(v) {\n        var t = str(v).replace(/[\\x00-\\x1f]/g, '').replace(/^\\s+|\\s+$/g, ''), out = '', i = 0, step, c;\n        while (i < t.length) {\n            c = t.charCodeAt(i);\n            step = (c >= 0xD800 && c <= 0xDBFF && i + 1 < t.length) ? 2 : 1;\n            if (out.length + step > MAX_ICON) { break; }\n            out += t.substr(i, step);\n            i += step;\n        }\n        if (i < t.length) {\n            while (out.length && /[\\u200D\\uFE0F]$/.test(out)) { out = out.slice(0, -1); }\n        }\n        return out;\n    }\n\n    // Image for the full-screen card: an http(s) URL only.\n    function cleanUrl(u) { u = str(u).trim(); return /^https?:\\/\\/[^\\s\"'<>]{4,290}$/.test(u) ? u : ''; }\n\n    // ntfy-compatible publish: POST .../ntfy with the message as the body (headers Title, Priority, Tags) or JSON {message,title,priority,tags}.\n    var NTFY_TAGS = { warning: '\\u26A0\\uFE0F', rotating_light: '\\uD83D\\uDEA8', white_check_mark: '\\u2705', heavy_check_mark: '\\u2714\\uFE0F', tada: '\\uD83C\\uDF89',\n        fire: '\\uD83D\\uDD25', soccer: '\\u26BD', bell: '\\uD83D\\uDD14', skull: '\\uD83D\\uDC80', house: '\\uD83C\\uDFE0', package: '\\uD83D\\uDCE6', sunny: '\\u2600\\uFE0F' };\n    function handleNtfy(req, res) {\n        readBody(req, guard(res, function (raw) {\n            var b = {}, h = req.headers || {}, j = null, i, t;\n            if (/json/i.test(str(h['content-type']))) { try { j = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); } }\n            if (rules.isObj(j)) { b.message = j.message; b.title = j.title; } else { b.message = raw; j = null; }\n            b.title = b.title || h.title || h.t;\n            var p = j ? num(j.priority) : NaN, tags;\n            if (!(p >= 0)) { p = num(str(h.priority || h.p)); }\n            tags = j && j.tags != null ? j.tags : (h.tags || h.ta || '');\n            // Never loop over something the sender controls: only a real array, or a comma list, and at most 10 entries.\n            tags = (Array.isArray(tags) ? tags : str(tags).split(',')).slice(0, 10);\n            b.level = p >= 5 ? 'alert' : p === 4 ? 'warn' : 'info';\n            for (i = 0; i < tags.length; i++) {\n                t = str(tags[i]).trim().toLowerCase();\n                if (has(NTFY_TAGS, t)) {\n                    b.icon = NTFY_TAGS[t];\n                    if (t === 'rotating_light' || t === 'skull') { b.level = 'alert'; }\n                    else if (t === 'warning' && b.level === 'info') { b.level = 'warn'; }\n                    else if ((t === 'white_check_mark' || t === 'heavy_check_mark' || t === 'tada') && b.level === 'info') { b.level = 'ok'; }\n                    break;\n                }\n            }\n            b.sound = j ? j.sound : h.sound; b.volume = j ? j.volume : h.volume;\n            submit(b, h, res);\n        }));\n    }\n\n    function handleNotify(req, res) {\n        readBody(req, guard(res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            submit(b, req.headers || {}, res);\n        }));\n    }\n\n    // Play a sound without a notification (the panel's sound tests; any app can use it too). Only names from the closed list.\n    function handlePlay(req, res) {\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            b = rules.isObj(b) ? b : {};\n            if (b.song !== undefined) {\n                if (b.song === 'stop') { stopSong(); return sendJson(res, 200, { ok: true, song: 'stopped' }); }\n                if (!has(SONGS, b.song)) { return sendJson(res, 400, { error: 'song must be one of: ' + Object.keys(SONGS).join(', ') + ', stop' }); }\n                var played = playSong(b.song);\n                return sendJson(res, played === 'busy' ? 409 : 200, played === 'busy' ? { ok: false, error: 'a song is already playing (song: \"stop\" stops it)' } : { ok: true, song: played });\n            }\n            if (!has(rules.SOUNDS, b.sound)) { return sendJson(res, 400, { error: 'sound must be one of: ' + Object.keys(rules.SOUNDS).join(', ') }); }\n            var st = playSound(b.sound, soundVolume(b.volume));\n            sendJson(res, st === 'skipped' ? 429 : 200, st === 'skipped' ? { ok: false, error: 'too soon: one sound every 0.8 s' } : { ok: true, sound: st });\n        });\n    }\n\n    // Webhook: POST hook/<name> with any JSON. The hook's templates turn it into a notification ({{a.b}} = that value of the posted JSON).\n    function handleHook(req, res, rawName) {\n        var name = rules.cleanHookName(rawName), hooks = cfgGet().hooks || {}, hook = name && has(hooks, name) ? hooks[name] : null;\n        if (!hook) { return sendJson(res, 404, { error: 'no such hook' }); }\n        readBody(req, guard(res, function (raw) {\n            var data;\n            try { data = JSON.parse(raw); } catch (e) { data = { text: raw }; }\n            if (!data || typeof data !== 'object') { data = { text: raw }; }\n            submit(rules.buildFromHook(hook, data), req.headers || {}, res, hook.source || name);\n        }), MAX_HOOK_BODY);\n    }\n\n    // The one way into the queue: applies the source's profile (key, enabled, rate, defaults), then validates, then quiet hours and grouping.\n    function submit(b, headers, res, forcedSource) {\n        b = rules.isObj(b) ? b : {};\n        {\n            var settings = settingsNow(), profiles = cfgGet().profiles || {};\n            var source = forcedSource || rules.cleanSource(b.source || headers['x-nc-source']);\n            var profile = source && has(profiles, source) ? profiles[source] : null;\n            if (settings.strict && !profile) { return sendJson(res, 403, { error: source ? 'unknown source' : 'source is required' }); }\n            if (profile) {\n                if (profile.enabled === false) { return sendJson(res, 403, { error: 'source is disabled' }); }\n                if (profile.key && !rules.sameKey(headers['x-nc-key'] || b.key, profile.key)) { return sendJson(res, 403, { error: 'invalid key for this source' }); }\n                if (!limiter(source, profile.rate, Date.now())) { return sendJson(res, 429, { error: 'rate limit for this source' }); }\n            }\n            b = rules.applyProfile(b, profile);\n            var message = clean(b.message, MAX_MESSAGE);\n            if (!message) { return sendJson(res, 400, { error: 'message is required' }); }\n            var secs = num(b.seconds);\n            if (!(secs >= MIN_SECONDS)) { secs = DEFAULT_SECONDS; }\n            if (secs > MAX_SECONDS) { secs = MAX_SECONDS; }\n            // duration = how long the notification stays on the TV screen (the app shows it, then returns to the previous app).\n            var dur = num(b.duration);\n            if (!(dur >= MIN_DURATION)) { dur = DEFAULT_DURATION; }\n            if (dur > MAX_DURATION) { dur = MAX_DURATION; }\n            if (secs < dur + 20) { secs = dur + 20; }\n            prune();\n            seq += 1;\n            var note = {\n                id: seq + '-' + Date.now().toString(36),\n                title: clean(b.title, MAX_TITLE),\n                icon: cleanIcon(b.icon),\n                image: cleanUrl(b.image),\n                wallpaper: cleanUrl(b.wallpaper),\n                message: message,\n                level: has(LEVELS, b.level) ? b.level : 'info',\n                mode: has(MODES, b.mode) ? b.mode : 'banner',\n                duration: dur,\n                source: source,\n                sound: has(rules.SOUNDS, b.sound) ? b.sound : '',\n                volume: soundVolume(b.volume),\n                expires: Date.now() + secs * 1000\n            };\n            var entry = { id: note.id, title: note.title, message: note.message, level: note.level, mode: note.mode, duration: note.duration, icon: note.icon, image: note.image, wallpaper: note.wallpaper, source: source, sound: note.sound, volume: note.volume, at: Date.now() };\n            // Quiet hours: below the allowed level the notification is only recorded, never shown.\n            if (rules.isQuiet(settings, note.level, new Date())) {\n                entry.suppressed = true;\n                recent.unshift(entry); if (recent.length > MAX_RECENT) { recent.pop(); } saveRecent();\n                return sendJson(res, 200, { ok: true, id: note.id, suppressed: 'quiet hours' });\n            }\n            // Grouping: the same source, title, message and level within the window is counted, not shown again. It is skipped when it is off\n            // (groupSeconds 0) and for a request that says group:false (the panel's Resend and test buttons). The map only holds entries younger than the window.\n            if (settings.groupSeconds && b.group !== false) {\n                var sig = [source, note.title, note.message, note.level].join(String.fromCharCode(1)), nowMs = Date.now(), g = has(groups, sig) ? groups[sig] : null, r;\n                if (g && nowMs - g.at < settings.groupSeconds * 1000) {\n                    g.count += 1;\n                    for (r = 0; r < recent.length; r++) { if (recent[r].id === g.id) { recent[r].count = g.count; } }\n                    saveRecent();\n                    return sendJson(res, 200, { ok: true, id: g.id, merged: true, count: g.count });\n                }\n                groups[sig] = { at: nowMs, id: note.id, count: 1 };\n                pruneGroups(nowMs, settings.groupSeconds * 1000);\n            }\n            queue.push(note);\n            if (queue.length > MAX_QUEUE) { queue.shift(); }\n            writeQueueFile();\n            recent.unshift(entry);\n            if (recent.length > MAX_RECENT) { recent.pop(); }\n            saveRecent();\n            var opened = b.open === false ? 'not requested' : openApp(note.mode === 'banner');\n            // The sound is asked for only now: not for a notification held back by quiet hours or merged as a repeat.\n            var soundState = 'none';\n            if (note.sound) {\n                if (b.open === false || soundWaitMs <= 0) { soundState = playSound(note.sound, note.volume); } else { soundState = scheduleSound(note) ? 'requested' : 'skipped'; }\n            }\n            sendJson(res, 200, { ok: true, id: note.id, open: opened, sound: soundState });\n        }\n    }\n\n    // Sources (profiles), settings (quiet hours, grouping, strict) and webhooks are kept in ctx.config. Keys are never returned.\n    function saveCfg(mut) { var c = cfgGet(); mut(c); ctx.config.set(c); }\n    function handleProfiles(req, res) {\n        if (req.method === 'GET') {\n            var out = {}, ps = cfgGet().profiles || {};\n            Object.keys(ps).forEach(function (k) { out[k] = rules.publicProfile(ps[k]); });\n            return sendJson(res, 200, { profiles: out, max: rules.MAX_SOURCES });\n        }\n        readBodyG(req, res, function (raw) {\n            var b, source, ps, p, genKey = '';\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            source = rules.cleanSource(b && b.source);\n            if (!source) { return sendJson(res, 400, { error: 'source must be 1-32 characters: a-z, 0-9, . _ -' }); }\n            ps = cfgGet().profiles || {};\n            if (b.delete === true) { saveCfg(function (c) { c.profiles = c.profiles || {}; delete c.profiles[source]; }); return sendJson(res, 200, { ok: true, deleted: source }); }\n            if (!has(ps, source) && Object.keys(ps).length >= rules.MAX_SOURCES) { return sendJson(res, 400, { error: 'at most ' + rules.MAX_SOURCES + ' sources' }); }\n            if (b.genKey === true) { genKey = require('crypto').randomBytes(16).toString('hex'); b.key = genKey; }\n            p = rules.sanitizeProfile(b, cleanIcon, has(ps, source) ? ps[source] : null);\n            if (p.error) { return sendJson(res, 400, { error: p.error }); }\n            saveCfg(function (c) { c.profiles = c.profiles || {}; c.profiles[source] = p; });\n            sendJson(res, 200, genKey ? { ok: true, source: source, profile: rules.publicProfile(p), key: genKey } : { ok: true, source: source, profile: rules.publicProfile(p) });\n        });\n    }\n    function handleSettings(req, res) {\n        if (req.method === 'GET') { return sendJson(res, 200, { settings: settingsNow() }); }\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            var s = rules.sanitizeSettings(b && b.settings || b, settingsNow());\n            saveCfg(function (c) { c.settings = s; });\n            sendJson(res, 200, { ok: true, settings: s });\n        });\n    }\n    function handleHooks(req, res) {\n        if (req.method === 'GET') { return sendJson(res, 200, { hooks: cfgGet().hooks || {}, max: rules.MAX_HOOKS, base: 'hook/<name>' }); }\n        readBodyG(req, res, function (raw) {\n            var b, name, hs;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            name = rules.cleanHookName(b && b.name);\n            if (!name) { return sendJson(res, 400, { error: 'name must be 1-24 characters: a-z, 0-9, -' }); }\n            hs = cfgGet().hooks || {};\n            if (b.delete === true) { saveCfg(function (c) { c.hooks = c.hooks || {}; delete c.hooks[name]; }); return sendJson(res, 200, { ok: true, deleted: name }); }\n            if (!has(hs, name) && Object.keys(hs).length >= rules.MAX_HOOKS) { return sendJson(res, 400, { error: 'at most ' + rules.MAX_HOOKS + ' hooks' }); }\n            var h = rules.sanitizeHook(b);\n            if (!h.message) { return sendJson(res, 400, { error: 'message template is required' }); }\n            saveCfg(function (c) { c.hooks = c.hooks || {}; c.hooks[name] = h; });\n            sendJson(res, 200, { ok: true, name: name, hook: h, url: 'hook/' + name });\n        });\n    }\n\n    function sendFile(res, name, type) {\n        fs.readFile(path.join(__dirname, name), 'utf8', function (err, text) {\n            if (err) { return sendJson(res, 500, { error: name + ' is missing' }); }\n            send(res, 200, type, text);\n        });\n    }\n\n    return {\n        start: function () {},\n        stop: function () { abortFetches(); cancelSounds(); stopSong(); queue = []; writeQueueFile(); },\n        status: function () { prune(); return { queued: queue.length, appId: appId() }; },\n        route: function (req, res, sub) {\n            sub = String(sub || '').split('?')[0].replace(/^\\/+|\\/+$/g, '');\n            try {\n            if (sub === 'ui' && req.method === 'GET') { sendFile(res, 'ui.html', 'text/html; charset=utf-8'); return true; }\n            if (sub === 'api' && req.method === 'GET') { sendJson(res, 200, describe()); return true; }\n            if (sub === 'status' && req.method === 'GET') { statusInfo(function (o) { sendJson(res, 200, o); }); return true; }\n            if (sub === 'img' && req.method === 'GET') { serveImage(req, res); return true; }\n            if (sub === 'ntfy' && req.method === 'POST') { handleNtfy(req, res); return true; }\n            if (sub === 'play' && req.method === 'POST') { handlePlay(req, res); return true; }\n            if (sub === 'sounds' && req.method === 'GET') { sendJson(res, 200, { sounds: Object.keys(rules.SOUNDS), songs: Object.keys(SONGS).map(function (k) { return { name: k, title: SONGS[k].title }; }), available: soundAvailable(), volume: settingsNow().soundVolume, delayMs: settingsNow().soundDelayMs, trace: soundTrace, last: soundLast }); return true; }\n            if (sub === 'profiles' && (req.method === 'GET' || req.method === 'POST')) { handleProfiles(req, res); return true; }\n            if (sub === 'settings' && (req.method === 'GET' || req.method === 'POST')) { handleSettings(req, res); return true; }\n            if (sub === 'hooks' && (req.method === 'GET' || req.method === 'POST')) { handleHooks(req, res); return true; }\n            if (/^hook\\/[^\\/]+$/.test(sub) && req.method === 'POST') { handleHook(req, res, sub.slice(5)); return true; }\n            if (sub === 'emoji' && req.method === 'GET') { sendFile(res, 'emoji.json', 'application/json; charset=utf-8'); return true; }\n            if (sub === 'nt.js' && req.method === 'GET') { sendFile(res, 'nt.js', 'application/javascript; charset=utf-8'); return true; }\n            if (sub === 'notify' && req.method === 'POST') { handleNotify(req, res); return true; }\n            if (sub === 'notifications' && req.method === 'GET') {\n                if (/[?&]src=app(&|$)/.test(String(req.url || ''))) {\n                    appPoll = /[?&]bye=1(&|$)/.test(String(req.url || '')) ? 0 : Date.now();\n                    if (appPoll) { queue.forEach(function (n) { if (n.mode !== 'banner' && has(waitingSounds, n.id)) { waitingSounds[n.id].fire(); } }); }\n                }\n                prune();\n                var now = Date.now();\n                var out = { lang: getLang(), notifications: queue.map(function (n) {\n                    return { id: n.id, title: n.title, message: n.message, level: n.level, mode: n.mode, duration: n.duration, icon: n.icon, image: n.image, wallpaper: n.wallpaper, seconds: Math.ceil((n.expires - now) / 1000) };\n                }) };\n                if (wantsScript(req)) { sendScript(res, out); } else { sendJson(res, 200, out); }\n                return true;\n            }\n            if (sub === 'lang' && req.method === 'GET') { sendJson(res, 200, { lang: getLang() }); return true; }\n            if (sub === 'lang' && req.method === 'POST') {\n                readBodyG(req, res, function (raw) {\n                    var b;\n                    try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n                    if (!b || (b.lang !== 'en' && b.lang !== 'pt')) { return sendJson(res, 400, { error: 'lang must be en or pt' }); }\n                    var c = ctx.config.get() || {};\n                    c.lang = b.lang;\n                    ctx.config.set(c);\n                    sendJson(res, 200, { lang: b.lang });\n                });\n                return true;\n            }\n            if (sub === 'recent' && req.method === 'GET') { sendJson(res, 200, { recent: recent }); return true; }\n            return false;\n            } catch (e) { try { sendJson(res, 500, { error: 'internal error' }); } catch (e2) { /* the answer was already sent */ } return true; }\n        }\n    };\n};\n","nt.js":"// Logic of the companion web app, served by the Shard (the app on the TV is only a thin loader, see README).\n// It runs inside the app, with the app's `notification` privilege. Plain ES5.\n(function () {\n  'use strict';\n  if (window.__ncLoaded) { return; }\n  window.__ncLoaded = true;\n\n  var BASES = ['http://127.0.0.1:8099'];\n  // Also try the address this script was loaded from (the loader may have reached the Shard over the LAN).\n  try {\n    var me = document.currentScript && document.currentScript.src, o = me && /^(https?:\\/\\/[^\\/]+)\\/plugins\\//.exec(me);\n    if (o && BASES.indexOf(o[1]) < 0) { BASES.push(o[1]); }\n  } catch (e) { /* ignore */ }\n  var NOTES_PATH = '/plugins/notification-center/api/notifications';\n  var SEEN_KEY = 'nc_seen', WATCH_MS = 2000;\n  var logEl = document.getElementById('log');\n  var apiGood = null, busy = false;\n\n\n  // Screen shown while the app is open: a One UI style card (EN/PT by the TV language). The banner itself is the TV's native one.\n  // The language is a Shard setting (default English); it is applied as soon as the first answer from the Shard arrives.\n  var DICT = {\n    en: { wait: 'Notification Center', ready: 'Waiting for notifications', sent: 'Notification sent', back: 'Returning to the previous app in', err: 'Cannot reach the Shard' },\n    pt: { wait: 'Centro de Notifica\\u00E7\\u00F5es', ready: '\\u00C0 espera de avisos', sent: 'Aviso enviado', back: 'A voltar \\u00E0 aplica\\u00E7\\u00E3o anterior em', err: 'Sem liga\\u00E7\\u00E3o ao Shard' }\n  };\n  var TX = DICT.en;\n  var EMO = { info: '\\u2139\\uFE0F', ok: '\\u2705', warn: '\\u26A0\\uFE0F', alert: '\\uD83D\\uDD34' };\n  var COL = { info: '#2f7bff', ok: '#2fc28b', warn: '#f5a524', alert: '#f0506e' };\n  // One UI style line icons (24x24, round caps): info, done, warning, alert.\n  var ICON_BODY = {\n    info: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 11v6\"/><circle cx=\"12\" cy=\"7.6\" r=\"0.6\" fill=\"#fff\"/>',\n    ok: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M7.6 12.6l3 3 5.8-6.4\"/>',\n    warn: '<path d=\"M12 3.8L21.2 20H2.8z\"/><path d=\"M12 10v4.6\"/><circle cx=\"12\" cy=\"17.4\" r=\"0.6\" fill=\"#fff\"/>',\n    alert: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 7v6\"/><circle cx=\"12\" cy=\"16.6\" r=\"0.6\" fill=\"#fff\"/>'\n  };\n  function iconSvg(level, size) {\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[level] || ICON_BODY.info) + '</svg>';\n  }\n  var cardEl = null;\n  (function buildUi() {\n    var st = document.createElement('style');\n    st.textContent = 'body{margin:0;background:radial-gradient(circle at 30% 20%,#17203a,#07090f);color:#eef2f9;font-family:SamsungOne,\"Segoe UI\",sans-serif}' +\n      '#nc{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:1100px;max-width:90%;text-align:center}' +\n      '#nc h1{font-size:44px;font-weight:600;margin:0 0 8px}#nc p{font-size:28px;color:#8b96ab;margin:0 0 40px}' +\n      '#nc .card{display:flex;gap:28px;align-items:center;text-align:left;background:rgba(255,255,255,.08);border-radius:36px;padding:34px 42px;border-left:12px solid var(--c);margin-top:24px}' +\n      '#nc .ic{width:96px;height:96px;border-radius:50%;background:var(--c);display:grid;place-items:center;flex:none}' +\n      '#nc .t{font-size:38px;font-weight:600}#nc .m{font-size:30px;color:#c4cde0;margin-top:6px}#log{display:none}';\n    document.head.appendChild(st);\n    cardEl = document.createElement('div'); cardEl.id = 'nc';\n    cardEl.innerHTML = '<h1></h1><p></p><div id=\"ncl\"></div>';\n    document.body.appendChild(cardEl);\n    applyLang('en');\n  })();\n  function applyLang(l) {\n    TX = DICT[l] || DICT.en;\n    if (!cardEl) { return; }\n    cardEl.getElementsByTagName('h1')[0].textContent = '\\uD83D\\uDD14 ' + TX.wait;\n    if (!document.getElementById('ncl').firstChild) { cardEl.getElementsByTagName('p')[0].textContent = TX.ready; }\n  }\n  function showCard(n) {\n    if (!cardEl) { return; }\n    var c = COL[n.level] || COL.info, d = document.createElement('div');\n    d.className = 'card'; d.style.setProperty('--c', c);\n    var ic = document.createElement('div'); ic.className = 'ic'; if (n.icon) { ic.textContent = n.icon; ic.style.fontSize = '48px'; } else { ic.innerHTML = iconSvg(n.level, 56); }\n    var b = document.createElement('div'), t = document.createElement('div'), m = document.createElement('div');\n    t.className = 't'; t.textContent = n.title || ''; m.className = 'm'; m.textContent = n.message || '';\n    b.appendChild(t); b.appendChild(m);\n    if (n.image) {   // optional picture: the Shard fetches it and serves it from its own address (the app may only load declared origins)\n      var im = document.createElement('img'), cap = document.createElement('div');\n      im.alt = '';\n      im.style.cssText = 'max-height:260px;max-width:100%;border-radius:24px;margin-top:16px;display:block';\n      cap.style.cssText = 'font-size:18px;color:#8b96ab;margin-top:8px;word-break:break-all';\n      cap.textContent = 'Image: ' + n.image + ' (fetched by the Shard)';\n      im.onload = function () { cap.textContent += ' - loaded ' + im.naturalWidth + 'x' + im.naturalHeight; };\n      im.onerror = function () { cap.textContent += ' - FAILED to load'; };\n      im.src = (apiGood || BASES[0]) + '/plugins/notification-center/api/img?id=' + encodeURIComponent(n.id);\n      b.appendChild(im); b.appendChild(cap);\n    }\n    if (n.wallpaper) {   // optional full-screen wallpaper behind the card, darkened so the text stays readable\n      var wsrc = (apiGood || BASES[0]) + '/plugins/notification-center/api/img?kind=wallpaper&id=' + encodeURIComponent(n.id), wcap = document.createElement('div'), pre = new Image();\n      wcap.style.cssText = 'font-size:18px;color:#8b96ab;margin-top:8px;word-break:break-all';\n      wcap.textContent = 'Wallpaper: ' + n.wallpaper + ' (fetched by the Shard)';\n      pre.onload = function () {\n        document.body.style.background = 'linear-gradient(rgba(7,9,15,.5),rgba(7,9,15,.72)), url(\"' + wsrc + '\") center / cover no-repeat fixed';\n        wcap.textContent += ' - loaded ' + pre.naturalWidth + 'x' + pre.naturalHeight;\n      };\n      pre.onerror = function () { wcap.textContent += ' - FAILED to load'; };\n      pre.src = wsrc;\n      b.appendChild(wcap);\n    }\n    d.appendChild(ic); d.appendChild(b);\n    var host = document.getElementById('ncl'); host.appendChild(d);\n    cardEl.getElementsByTagName('p')[0].textContent = TX.sent;\n  }\n\n  function now() { var d = new Date(); function p(n) { return (n < 10 ? '0' : '') + n; } return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()); }\n  function log(cls, text) {\n    if (!logEl) { return; }\n    var line = document.createElement('div');\n    line.className = cls; line.textContent = now() + '  ' + text;\n    logEl.appendChild(line);\n    while (logEl.childNodes.length > 14) { logEl.removeChild(logEl.firstChild); }\n  }\n\n  function xhrGet(base, cb) {\n    var x = new XMLHttpRequest(), done = false;\n    function end(err, text) { if (!done) { done = true; cb(err, text); } }\n    try {\n      x.open('GET', base + NOTES_PATH + '?src=app'); x.timeout = 4000;\n      x.onload = function () { if (x.status === 200) { end(null, x.responseText); } else { end('http ' + x.status); } };\n      x.onerror = function () { end('network'); };\n      x.ontimeout = function () { end('timeout'); };\n      x.send();\n    } catch (e) { end('blocked'); }\n  }\n  function scriptGet(base, cb) {\n    var s = document.createElement('script'), done = false, t;\n    function end(err, data) {\n      if (done) { return; }\n      done = true; clearTimeout(t); window.__ncNotes = undefined;\n      if (s.parentNode) { s.parentNode.removeChild(s); }\n      cb(err, data);\n    }\n    window.__ncNotes = function (d) { end(null, d); };\n    s.onerror = function () { end('network'); };\n    t = setTimeout(function () { end('timeout'); }, 5000);\n    s.src = base + NOTES_PATH + '?js=1&src=app&t=' + new Date().getTime();\n    (document.head || document.documentElement).appendChild(s);\n  }\n  function fetchQueue(done) {\n    var list = apiGood ? [apiGood] : BASES, i = 0, errors = [];\n    (function next() {\n      if (i >= list.length) { return done(errors.join('; ') || 'no address'); }\n      var base = list[i++];\n      xhrGet(base, function (err, text) {\n        if (!err) { try { apiGood = base; var jd = JSON.parse(text); applyLang(jd.lang); return done(null, jd.notifications || []); } catch (e) { err = 'json'; } }\n        scriptGet(base, function (err2, data) {\n          if (!err2) { apiGood = base; applyLang(data && data.lang); return done(null, (data && data.notifications) || []); }\n          errors.push(base + ' xhr:' + err + ' script:' + err2); next();\n        });\n      });\n    })();\n  }\n\n  function post(title, body, cb) {\n    try {\n      if (!window.Notification) { return cb('window.Notification is missing'); }\n      var show = function () { try { new Notification(title, { body: body }); cb(null); } catch (e) { cb('new Notification: ' + e.message); } };\n      if (Notification.permission === 'granted') { return show(); }\n      var r = Notification.requestPermission(function (p) { if (p === 'granted') { show(); } else { cb('permission ' + p); } });\n      if (r && r.then) { r.then(function (p) { if (p === 'granted') { show(); } else { cb('permission ' + p); } }); }\n    } catch (e) { cb(e.message); }\n  }\n\n  // Leaving: tell the Shard first (so the next notification launches the app again at once), then exit.\n  function leave() {\n    var done = false;\n    function go() { if (!done) { done = true; try { tizen.application.getCurrentApplication().exit(); } catch (x) { /* not on a TV */ } } }\n    try { var im = new Image(); im.onload = go; im.onerror = go; im.src = (apiGood || BASES[0]) + NOTES_PATH + '?src=app&bye=1&t=' + new Date().getTime(); } catch (e) { go(); }\n    setTimeout(go, 600);\n  }\n  // A notification that arrives while the app is open extends the stay instead of being cut short by the first one's exit timer.\n  var exitTimer = null, exitAt = 0;\n  function scheduleExit(ms) {\n    var at = new Date().getTime() + ms;\n    if (at > exitAt) { exitAt = at; clearTimeout(exitTimer); exitTimer = setTimeout(leave, ms); }\n  }\n  var cdTimer = null, cdEl = null;\n  function countdown(sec) {\n    if (!cardEl) { return; }\n    clearTimeout(cdTimer);\n    if (cdEl && cdEl.parentNode) { cdEl.parentNode.removeChild(cdEl); }\n    var el = cdEl = document.createElement('div');\n    el.style.cssText = 'margin-top:48px;color:#8b96ab;font-size:34px';\n    cardEl.appendChild(el);\n    (function tick() {\n      el.innerHTML = '';\n      var lbl = document.createElement('div'), num = document.createElement('div');\n      lbl.textContent = TX.back;\n      num.textContent = String(sec);\n      num.style.cssText = 'font-size:220px;font-weight:700;line-height:1.05;color:#fff';\n      el.appendChild(lbl); el.appendChild(num);\n      if (sec <= 0) { return; }\n      sec -= 1; cdTimer = setTimeout(tick, 1000);\n    })();\n  }\n\n  // On start, on resume and every few seconds while visible: post what is new, stay open while the banner shows, then exit.\n  function check(why) {\n    if (busy) { return; }\n    busy = true;\n    fetchQueue(function (err, list) {\n      if (err) { busy = false; return log('err', why + ': Shard unreachable (' + err + ')'); }\n      var seen = {}; try { seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '{}'); } catch (e) { seen = {}; }\n      var fresh = list.filter(function (n) { return !seen[n.id]; });\n      if (!fresh.length) { busy = false; return log('inf', why + ': nothing new'); }\n      var pending = fresh.length;\n      // mode: 'banner' = native Samsung banner only, 'full' = full-screen card only, anything else = both.\n      // How long to stay on screen: the longest duration asked (default 8 s), exactly as requested.\n      var stayMs = 0;\n      fresh.forEach(function (n) { var d = parseInt(n.duration, 10) || 8; if (d * 1000 > stayMs) { stayMs = d * 1000; } });\n      var onlyBanner = fresh.every(function (n) { return n.mode === 'banner'; });\n      if (cardEl) { cardEl.style.display = onlyBanner ? 'none' : ''; }\n      fresh.forEach(function (n) {\n        seen[n.id] = 1;\n        if (n.mode !== 'banner') { showCard(n); }\n        (n.mode === 'full' ? function (t, b, cb) { cb(null); } : post)(((n.icon || EMO[n.level] || '') + ' ' + (n.title || 'Notification')).replace(/^ /, ''), n.message || '', function (e) {\n          log(e ? 'err' : 'ok', (n.title || 'Notification') + ': ' + (e || 'posted'));\n          pending -= 1;\n          if (pending) { return; }\n          try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (x) { /* storage unavailable */ }\n          busy = false;\n          // Leaving too early hides the banner: stay open while it is on screen.\n          scheduleExit(stayMs);\n          countdown(Math.max(1, Math.round((exitAt - new Date().getTime()) / 1000)));\n        });\n      });\n    });\n  }\n\n  check('start');\n  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') { check('resume'); } });\n  setInterval(function () { if (document.visibilityState !== 'hidden') { check('watch'); } }, WATCH_MS);\n  document.addEventListener('keydown', function (e) {\n    if (e.keyCode === 10009 || e.keyCode === 27) { leave(); }\n  });\n})();\n","rules.js":"'use strict';\n// Rules of the Notification Center that do not touch the network: sources (profiles), quiet hours, grouping of repeats and webhook templates.\n// Pure functions, plain ES5 (older TVs run Node 4.4), so they can be tested on their own.\n// Everything here receives raw JSON from the LAN: values are never passed to String() or parseInt() before their type is checked\n// (String({toString: 1}) throws), and names are looked up with hasOwnProperty (so \"__proto__\" and \"constructor\" are not levels or modes).\nvar LEVEL_RANK = { info: 0, ok: 0, warn: 1, alert: 2 };\nvar LEVELS = { info: 1, ok: 1, warn: 1, alert: 1 };\nvar MODES = { both: 1, banner: 1, full: 1 };\n// The sounds of the notification-sound Shard (a closed list: a request can only pick one of these names, never a file).\nvar SOUNDS = { chime: 1, soft: 1, reward: 1, success: 1, alert: 1, rotation: 1, open: 1, poweron: 1 };\nvar SOURCE_RE = /^[a-z0-9][a-z0-9._-]{0,31}$/;\nvar HOOK_RE = /^[a-z0-9][a-z0-9-]{0,23}$/;\nvar KEY_RE = /^[A-Za-z0-9._~-]{8,64}$/;\nvar MAX_SOURCES = 20, MAX_HOOKS = 10, MAX_TEMPLATE = 200, MAX_RATE = 600;\n\n// Text from the outside: only strings, numbers and booleans are accepted; objects, arrays and null become ''.\nfunction str(v) {\n    var t = typeof v;\n    return t === 'string' ? v : (t === 'number' || t === 'boolean') ? String(v) : '';\n}\n// An integer from the outside: numbers as they are, strings parsed, anything else NaN.\nfunction num(v) {\n    var t = typeof v;\n    if (t === 'number') { return v === v && v !== Infinity && v !== -Infinity ? Math.floor(v) : NaN; }\n    return t === 'string' ? parseInt(v, 10) : NaN;\n}\n// A volume from the outside: a number (or numeric text) is clamped to 10-100, so `volume: 0` or `5` means \"as quiet as allowed\", never \"full\".\n// Missing, empty or not a number means \"not given\" (0), and the default (100) applies later.\nfunction clampVolume(v) { var n = num(v); if (n !== n) { return 0; } return n < 10 ? 10 : (n > 100 ? 100 : n); }\n// The default volume stored for a source or a webhook: the same, except that 0 or empty clears it.\nfunction storedVolume(v) { var n = num(v); return n === 0 || n !== n ? 0 : clampVolume(n); }\nfunction has(o, k) { return o !== null && typeof o === 'object' && typeof k === 'string' && Object.prototype.hasOwnProperty.call(o, k); }\nfunction isObj(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }\n\nfunction cleanSource(v) {\n    var s = str(v).trim().toLowerCase();\n    return SOURCE_RE.test(s) ? s : '';\n}\nfunction cleanHookName(v) {\n    var s = str(v).trim().toLowerCase();\n    return HOOK_RE.test(s) ? s : '';\n}\nfunction clampInt(v, lo, hi, def) {\n    var n = num(v);\n    if (!(n >= lo)) { return def; }\n    return n > hi ? hi : n;\n}\n\n// Compares two keys without stopping at the first different character.\nfunction sameKey(a, b) {\n    a = str(a); b = str(b);\n    var d = a.length ^ b.length, i, n = a.length > b.length ? a.length : b.length;\n    for (i = 0; i < n; i++) { d |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0); }\n    return d === 0;\n}\n\n// A stored profile. Only known fields are kept. `key` is kept as given (set by the Shard or by the user), never returned by GET.\n// icon: cleaned by the caller (cleanIcon lives next to the emoji rules in index.js).\nfunction sanitizeProfile(p, cleanIcon, old) {\n    p = isObj(p) ? p : {}; old = isObj(old) ? old : {};\n    var out = {\n        enabled: p.enabled === false ? false : (p.enabled === true ? true : old.enabled !== false),\n        icon: has(p, 'icon') ? cleanIcon(p.icon) : (old.icon || ''),\n        level: has(LEVELS, p.level) ? p.level : (has(p, 'level') && !p.level ? '' : (old.level || '')),\n        mode: has(MODES, p.mode) ? p.mode : (has(p, 'mode') && !p.mode ? '' : (old.mode || '')),\n        duration: has(p, 'duration') ? clampInt(p.duration, 1, 60, 0) : (old.duration || 0),\n        rate: has(p, 'rate') ? clampInt(p.rate, 0, MAX_RATE, 0) : (old.rate || 0),\n        sound: has(p, 'sound') ? (has(SOUNDS, p.sound) ? p.sound : '') : (old.sound || ''),\n        volume: has(p, 'volume') ? storedVolume(p.volume) : (old.volume || 0),\n        key: old.key || ''\n    };\n    if (has(p, 'key')) {\n        if (!p.key) { out.key = ''; }\n        else if (typeof p.key === 'string' && KEY_RE.test(p.key)) { out.key = p.key; }\n        else { out.error = 'key must be 8-64 characters: letters, digits and . _ ~ -'; }\n    }\n    return out;\n}\n// What GET returns: everything except the key itself.\nfunction publicProfile(p) {\n    return { enabled: p.enabled !== false, icon: p.icon || '', level: p.level || '', mode: p.mode || '', duration: p.duration || 0, rate: p.rate || 0, sound: p.sound || '', volume: p.volume || 0, hasKey: !!p.key };\n}\n// Fills in what the sender left out with the source's defaults. The sender's own values always win.\nfunction applyProfile(body, p) {\n    var out = {}, k;\n    for (k in body) { if (has(body, k) && k !== '__proto__') { out[k] = body[k]; } }\n    if (!p) { return out; }\n    if ((out.icon == null || out.icon === '') && p.icon) { out.icon = p.icon; }\n    if (!out.level && p.level) { out.level = p.level; }\n    if (!out.mode && p.mode) { out.mode = p.mode; }\n    if ((out.duration == null || out.duration === '') && p.duration) { out.duration = p.duration; }\n    if ((out.sound == null || out.sound === '') && p.sound) { out.sound = p.sound; }\n    if ((out.volume == null || out.volume === '') && p.volume) { out.volume = p.volume; }\n    return out;\n}\n\n// Sliding one-minute window per source: returns true when another notification is allowed.\nfunction makeLimiter() {\n    var hits = {};\n    return function allow(source, rate, now) {\n        if (!rate) { return true; }\n        var list = (has(hits, source) ? hits[source] : []).filter(function (t) { return now - t < 60000; });\n        if (list.length >= rate) { hits[source] = list; return false; }\n        list.push(now);\n        hits[source] = list;\n        return true;\n    };\n}\n\nfunction minutes(hhmm) {\n    var m = /^([01]?\\d|2[0-3]):([0-5]\\d)$/.exec(str(hhmm));\n    return m ? parseInt(m[1], 10) * 60 + parseInt(m[2], 10) : -1;\n}\n// settings.quiet = { enabled, from: \"22:00\", to: \"07:00\", allow: \"alert\" | \"warn\" | \"none\" }: levels at or above `allow` still get through.\nfunction sanitizeSettings(s, old) {\n    s = isObj(s) ? s : {}; old = isObj(old) ? old : {};\n    var q = isObj(s.quiet) ? s.quiet : {}, oq = isObj(old.quiet) ? old.quiet : {};\n    var from = minutes(q.from) >= 0 ? q.from : (oq.from || '22:00'), to = minutes(q.to) >= 0 ? q.to : (oq.to || '07:00');\n    var allow = q.allow === 'warn' || q.allow === 'alert' || q.allow === 'none' ? q.allow : (oq.allow || 'alert');\n    return {\n        quiet: { enabled: has(q, 'enabled') ? q.enabled === true : oq.enabled === true, from: from, to: to, allow: allow },\n        groupSeconds: has(s, 'groupSeconds') ? clampInt(s.groupSeconds, 0, 3600, 0) : (has(old, 'groupSeconds') ? old.groupSeconds : 60),\n        strict: has(s, 'strict') ? s.strict === true : old.strict === true,\n        soundVolume: has(s, 'soundVolume') && !isNaN(num(s.soundVolume)) ? clampVolume(s.soundVolume) : (has(old, 'soundVolume') ? clampInt(old.soundVolume, 10, 100, 100) : 100),\n        soundDelayMs: has(s, 'soundDelayMs') ? clampInt(s.soundDelayMs, 0, 10000, has(old, 'soundDelayMs') ? clampInt(old.soundDelayMs, 0, 10000, 3000) : 3000) : (has(old, 'soundDelayMs') ? clampInt(old.soundDelayMs, 0, 10000, 3000) : 3000)\n    };\n}\nfunction defaultSettings() { return sanitizeSettings({}, {}); }\n// `now` is a Date in the TV's local time.\nfunction isQuiet(settings, level, now) {\n    var q = settings && settings.quiet;\n    if (!q || !q.enabled) { return false; }\n    var a = minutes(q.from), b = minutes(q.to), t = now.getHours() * 60 + now.getMinutes(), inside;\n    if (a < 0 || b < 0 || a === b) { return false; }\n    inside = a < b ? (t >= a && t < b) : (t >= a || t < b);\n    if (!inside) { return false; }\n    if (q.allow === 'none') { return true; }\n    return (has(LEVEL_RANK, level) ? LEVEL_RANK[level] : 0) < (q.allow === 'warn' ? 1 : 2);\n}\n\n// Webhook templates: \"{{a.b.0.c}}\" is replaced by that value of the JSON the sender posted. Plain text replacement, nothing is evaluated.\nfunction lookup(data, pathText) {\n    var parts = pathText.split('.'), cur = data, i;\n    for (i = 0; i < parts.length; i++) {\n        if (cur === null || typeof cur !== 'object' || !has(cur, parts[i])) { return ''; }\n        cur = cur[parts[i]];\n    }\n    if (cur === null || cur === undefined) { return ''; }\n    return typeof cur === 'object' ? JSON.stringify(cur) : str(cur);\n}\nfunction render(tpl, data) {\n    return str(tpl).replace(/\\{\\{\\s*([A-Za-z0-9_.-]{1,60})\\s*\\}\\}/g, function (m, p) { return lookup(data, p); });\n}\nfunction sanitizeHook(h) {\n    h = isObj(h) ? h : {};\n    var t = function (v, max) { return str(v).replace(/[\\x00-\\x1f]/g, ' ').slice(0, max || MAX_TEMPLATE); };\n    return {\n        title: t(h.title), message: t(h.message), level: t(h.level, 40), icon: t(h.icon, 40),\n        mode: has(MODES, h.mode) ? h.mode : '', duration: clampInt(h.duration, 1, 60, 0), source: cleanSource(h.source),\n        sound: has(SOUNDS, h.sound) ? h.sound : '', volume: storedVolume(h.volume)\n    };\n}\n// Builds the notify body from a hook definition and the posted data.\nfunction buildFromHook(hook, data) {\n    var level = render(hook.level, data).trim().toLowerCase();\n    var b = { title: render(hook.title, data), message: render(hook.message, data), icon: render(hook.icon, data) };\n    if (has(LEVELS, level)) { b.level = level; }\n    if (hook.mode) { b.mode = hook.mode; }\n    if (hook.duration) { b.duration = hook.duration; }\n    if (hook.sound) { b.sound = hook.sound; }\n    if (hook.volume) { b.volume = hook.volume; }\n    return b;\n}\n\nmodule.exports = {\n    clampVolume: clampVolume, storedVolume: storedVolume,\n    LEVEL_RANK: LEVEL_RANK, LEVELS: LEVELS, MODES: MODES, SOUNDS: SOUNDS, MAX_SOURCES: MAX_SOURCES, MAX_HOOKS: MAX_HOOKS, MAX_TEMPLATE: MAX_TEMPLATE, MAX_RATE: MAX_RATE,\n    str: str, num: num, has: has, isObj: isObj,\n    cleanSource: cleanSource, cleanHookName: cleanHookName, sameKey: sameKey, KEY_RE: KEY_RE,\n    sanitizeProfile: sanitizeProfile, publicProfile: publicProfile, applyProfile: applyProfile, makeLimiter: makeLimiter,\n    sanitizeSettings: sanitizeSettings, defaultSettings: defaultSettings, isQuiet: isQuiet,\n    render: render, sanitizeHook: sanitizeHook, buildFromHook: buildFromHook\n};\n","ui.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<title>Notification Center</title>\n<style>\n:root { --bg: #0a0d12; --s1: #10151e; --s2: #151b27; --s3: #1c2434; --line: #222b3d; --line2: #2f3a52; --txt: #e8edf6; --dim: #8794ab; --acc: #3d8bff; --ok: #34c78f; --warn: #f1a73a; --alert: #ee5a74; --info: #3d8bff; --r: 14px; }\n* { box-sizing: border-box; scrollbar-width: none; -ms-overflow-style: none; }\n*::-webkit-scrollbar { width: 0; height: 0; display: none; }\nhtml { color-scheme: dark; }\nbody { margin: 0; background: var(--bg); color: var(--txt); font: 14px/1.5 \"Segoe UI\", \"SamsungOne\", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n.app { max-width: 1240px; margin: 0 auto; padding: 20px 24px 44px; }\nh1 { font-size: 18px; font-weight: 600; margin: 0; letter-spacing: -.01em; }\nh2 { font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--dim); font-weight: 600; margin: 0 0 12px; }\nh3 { font-size: 13px; font-weight: 600; margin: 0 0 8px; }\np { margin: 0; }\nul { list-style: none; margin: 0; padding: 0; }\ncode, pre { font-family: \"Cascadia Mono\", Consolas, monospace; }\ncode { background: var(--s2); border-radius: 5px; padding: 1px 5px; font-size: 12px; }\npre { background: #090c11; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 12px; line-height: 1.55; white-space: pre-wrap; word-break: break-all; margin: 0; color: #b9c6df; }\n\n/* header */\n.top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }\n.brand { display: flex; align-items: center; gap: 14px; }\n.logo { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(145deg, #3d8bff, #6b5bff); display: grid; place-items: center; box-shadow: 0 6px 18px rgba(61, 139, 255, .32); }\n.sub { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 5px; min-height: 22px; }\n.chip { font-size: 11px; font-weight: 600; padding: 2px 10px; border-radius: 999px; background: var(--s2); border: 1px solid var(--line); color: var(--dim); }\n.chip::before { content: \"\"; display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 6px; background: var(--dim); }\n.chip.g::before { background: var(--ok); } .chip.r::before { background: var(--alert); } .chip.y::before { background: var(--warn); }\n.lang { display: flex; background: var(--s1); border: 1px solid var(--line); border-radius: 999px; padding: 2px; }\n.lang button { border: 0; background: none; color: var(--dim); padding: 5px 14px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 12px; }\n.lang button.on { background: var(--acc); color: #fff; }\n\n/* layout: three columns (message and look, pictures and send, preview with recent); everything flows down the page, no inner scrollbars */\n.layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: start; }\n.col, .dev { background: var(--s1); border: 1px solid var(--line); border-radius: var(--r); }\n.sec { padding: 18px 20px; border-bottom: 1px solid var(--line); }\n.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n.stack input { margin-bottom: 8px; }\n.stack input:last-child { margin-bottom: 0; }\ninput, select, button { font: inherit; color: inherit; }\ninput[type=text], select { width: 100%; background: var(--s2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; margin-bottom: 8px; transition: border-color .15s, box-shadow .15s; }\ninput[type=text]::placeholder { color: #5f6b82; }\ninput[type=text]:focus, select:focus { outline: 0; border-color: var(--acc); box-shadow: 0 0 0 3px rgba(61, 139, 255, .18); }\n.row > input[type=text] { margin-bottom: 0; }\n\n/* level and mode pickers (built by the script) */\n.levels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 10px; }\n.lv { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--s2); color: var(--dim); cursor: pointer; font-size: 13px; transition: border-color .15s, color .15s; }\n.lv:hover { border-color: var(--line2); }\n.lv i { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; flex: none; margin: 0; }\n.lv i svg { width: 14px; height: 14px; }\n.lv.on { color: var(--txt); border-color: var(--c); box-shadow: inset 0 0 0 1px var(--c); background: var(--s3); }\n.modes { display: flex; background: var(--s2); border: 1px solid var(--line); border-radius: 12px; padding: 3px; gap: 2px; }\n.md { flex: 1; border: 0; background: none; color: var(--dim); padding: 7px 8px; border-radius: 9px; cursor: pointer; font-size: 13px; font-weight: 500; transition: background .15s, color .15s; }\n.md.on { background: var(--s3); color: var(--txt); box-shadow: 0 1px 0 rgba(255, 255, 255, .05) inset, 0 1px 6px rgba(0, 0, 0, .3); }\n\n/* buttons */\nbutton { transition: transform .08s, background .2s, opacity .2s, border-color .2s; }\nbutton:active { transform: scale(.95); }\n.ghost { background: none; border: 1px solid var(--line2); color: var(--dim); border-radius: 999px; padding: 5px 13px; font-size: 12px; font-weight: 600; cursor: pointer; margin: 0; }\n.ghost:hover { color: var(--txt); border-color: var(--acc); }\n.send { background: var(--acc); color: #fff; border: 0; border-radius: 12px; padding: 12px 28px; font-weight: 600; cursor: pointer; box-shadow: 0 6px 18px rgba(61, 139, 255, .3); }\n.send:hover { background: #5499ff; }\nbutton.busy { opacity: .65; pointer-events: none; }\nbutton.busy::after { content: \"\"; display: inline-block; width: 10px; height: 10px; margin-left: 8px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: sp .7s linear infinite; vertical-align: -1px; }\nbutton.done { background: var(--ok) !important; border-color: var(--ok) !important; color: #06251a !important; }\nbutton.fail { background: var(--alert) !important; border-color: var(--alert) !important; color: #fff !important; }\n@keyframes sp { to { transform: rotate(360deg); } }\nbutton:focus-visible, .tab:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }\n\n/* footer of the composer */\n.foot { display: flex; flex-direction: column; align-items: stretch; gap: 16px; padding: 18px 20px; background: var(--s2); border-top: 1px solid var(--line); border-radius: 0 0 var(--r) var(--r); }\n.dur { display: flex; align-items: center; gap: 12px; min-width: 0; color: var(--dim); font-size: 12px; }\n.dur input { flex: 1; accent-color: var(--acc); margin: 0; }\n.dur b { color: var(--txt); min-width: 36px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }\n.chk { display: flex; align-items: center; gap: 8px; color: var(--dim); font-size: 13px; cursor: pointer; }\n.msg { min-height: 20px; font-size: 13px; color: var(--dim); }\n.col > .msg { padding: 10px 20px 14px; }\n.ok { color: var(--ok); } .err { color: var(--alert); }\n\n/* stage */\n.stage { display: flex; flex-direction: column; gap: 12px; }\n.tv { background: #04060a; border: 1px solid var(--line2); border-radius: 16px; padding: 9px; box-shadow: 0 14px 38px rgba(0, 0, 0, .5), 0 0 0 1px rgba(255, 255, 255, .03) inset; }\n.scene { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 7px; background: #0a1120; }\n.note { color: var(--dim); font-size: 12px; }\n.rhead { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }\n.rhead h2 { margin: 0; }\n#recent li { display: flex; gap: 10px; align-items: center; padding: 9px 2px; border-bottom: 1px solid var(--line); }\n#recent li:last-child { border: 0; }\n#recent li div { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n#recent li small { display: block; color: var(--dim); font-size: 11px; }\n.dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--c); }\n.empty { color: var(--dim); text-align: center; padding: 16px 0; }\n@keyframes ncSlide { 0% { opacity: 0; transform: translateX(90px); } 14%, 84% { opacity: 1; transform: translateX(0); } 100% { opacity: 0; transform: translateX(90px); } }\n@keyframes ncFade { 0%, 4% { opacity: 0; } 14%, 84% { opacity: 1; } 96%, 100% { opacity: 0; } }\n.sc-banner { animation: ncSlide 6s ease-in-out infinite; }\n.sc-card { animation: ncFade 6s ease-in-out infinite; }\n\n/* icon picker */\n.picker { background: var(--s2); border: 1px solid var(--line); border-radius: 12px; padding: 10px; margin-top: 10px; }\n.picker[hidden] { display: none; }\n.picker input[type=text] { margin-bottom: 0; background: var(--s1); }\n.ecats { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }\n.ecats button { border: 1px solid var(--line); background: none; color: var(--dim); border-radius: 999px; padding: 3px 10px; font-size: 12px; cursor: pointer; }\n.ecats button.on { color: #fff; border-color: var(--acc); }\n.egrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(38px, 1fr)); gap: 4px; margin-top: 8px; }\n.egrid button { font-size: 22px; background: none; border: 0; border-radius: 8px; cursor: pointer; padding: 4px; }\n.egrid button:hover { background: var(--s3); }\n\n/* icon popup */\n.modal { position: fixed; inset: 0; background: rgba(4, 6, 10, .74); display: grid; place-items: center; padding: 20px; z-index: 50; }\n.dlg { background: var(--s1); border: 1px solid var(--line2); border-radius: 16px; padding: 18px; width: min(760px, 100%); max-height: 90vh; overflow: auto; box-shadow: 0 24px 60px rgba(0, 0, 0, .6); }\n.dhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }\n.dhead h2 { margin: 0; }\n.egrid { grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); }\n.egrid button { font-size: 26px; padding: 6px; }\n\n/* developer area */\n.dev { margin-top: 0; }\n[hidden] { display: none !important; }\n.dtabs { display: flex; gap: 4px; flex-wrap: wrap; padding: 0; margin-bottom: 18px; border-bottom: 1px solid var(--line); }\n.dtabs button { background: none; border: 0; color: var(--dim); padding: 13px 14px; font-weight: 600; font-size: 13px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }\n.dtabs button.on { color: var(--txt); border-bottom-color: var(--acc); }\n.pane { padding: 18px 20px; }\n.pane[hidden] { display: none; }\n.rl { cursor: pointer; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 6px; background: var(--s2); }\n.rl:hover { border-color: var(--acc); }\n.rl small { display: block; color: var(--dim); font-size: 12px; }\n.rulesgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.rulesgrid > * { min-width: 0; }\n.lab { font-size: 12px; color: var(--dim); margin: 0 0 3px; }\n.tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }\n.tab { border: 1px solid var(--line); background: none; color: var(--dim); border-radius: 999px; padding: 4px 13px; font-size: 12px; font-weight: 600; cursor: pointer; }\n.tab.on { color: #fff; border-color: var(--acc); background: rgba(61, 139, 255, .12); }\ntable.api { width: 100%; border-collapse: collapse; font-size: 13px; margin: 4px 0 12px; }\ntable.api th, table.api td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }\ntable.api th { color: var(--dim); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }\n#apiroutes li { padding: 4px 0; color: var(--dim); font-size: 13px; }\n.apiform { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; margin-bottom: 12px; }\n.af { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--dim); }\n.af input, .af select { margin: 0; }\n.appcols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }\n#statuslist li { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); }\n#statuslist li:last-child { border: 0; }\n#statuslist small { display: block; color: var(--dim); font-size: 12px; }\n.dotc { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-top: 7px; flex: none; }\n.dotc.g { background: var(--ok); } .dotc.r { background: var(--alert); } .dotc.y { background: var(--warn); }\n@media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } .appcols { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header class=\"top\">\n    <div class=\"brand\">\n      <div class=\"logo\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9a6 6 0 0 1 12 0c0 6 2 7 2 7H4s2-1 2-7\"/><path d=\"M10 19a2 2 0 0 0 4 0\"/></svg></div>\n      <div>\n        <h1 data-t=\"title\">Notification Center</h1>\n        <div class=\"sub\" id=\"chips\"></div>\n      </div>\n    </div>\n    <div class=\"lang\"><button type=\"button\" id=\"l-en\">EN</button><button type=\"button\" id=\"l-pt\">PT</button></div>\n  </header>\n\n  <nav class=\"dtabs\">\n    <button type=\"button\" class=\"on\" data-pane=\"p-main\" data-t=\"tab_main\">Notifications</button>\n    <button type=\"button\" data-pane=\"p-rules\" data-t=\"rules_tab\">Sources and rules</button>\n    <button type=\"button\" data-pane=\"p-test\" data-t=\"test_tab\">Testing</button>\n    <button type=\"button\" data-pane=\"p-req\" data-t=\"rq_title\">Request for other apps and Shards</button>\n    <button type=\"button\" data-pane=\"p-api\" data-t=\"api_title\">API</button>\n    <button type=\"button\" data-pane=\"p-app\" data-t=\"app\">Companion app</button>\n  </nav>\n\n  <main class=\"layout\" id=\"p-main\">\n    <section class=\"col\">\n      <div class=\"sec\">\n        <h2 data-t=\"send\">Send a notification</h2>\n        <div class=\"levels\" id=\"levels\"></div>\n        <div class=\"modes\" id=\"modes\"></div>\n        <div class=\"row\" style=\"margin-top:12px\"><span class=\"lab\" style=\"margin:0\" data-t=\"f_sound\">Sound</span><select id=\"sound\" style=\"width:auto;margin:0\"></select><span class=\"lab\" style=\"margin:0 0 0 14px\" data-t=\"f_mvol\">Sound volume (%)</span><input type=\"range\" id=\"mvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"width:140px\"><b id=\"mvolv\">100%</b></div>\n      </div>\n      <div class=\"sec\">\n        <h2 data-t=\"sec_msg\">Message</h2>\n        <input type=\"text\" id=\"title\" maxlength=\"40\" data-p=\"ph_title\">\n        <input type=\"text\" id=\"message\" maxlength=\"200\" data-p=\"ph_msg\">\n        <input type=\"text\" id=\"icon\" maxlength=\"16\" data-p=\"ph_icon\">\n      </div>\n    </section>\n    <section class=\"col\">\n      <div class=\"sec\">\n        <h2 data-t=\"sec_pics\">Pictures for the full-screen card</h2>\n        <div class=\"stack\"><input type=\"text\" id=\"image\" maxlength=\"290\" data-p=\"ph_image\"><input type=\"text\" id=\"wallpaper\" maxlength=\"290\" data-p=\"ph_wall\"></div>\n      </div>\n      <div class=\"foot\">\n        <div class=\"dur\"><span data-t=\"secs\">Show for (s)</span><input type=\"range\" id=\"secs\" min=\"1\" max=\"60\" value=\"8\"><b id=\"secsv\">8 s</b></div>\n        <label class=\"chk\"><input type=\"checkbox\" id=\"open\" checked> <span data-t=\"open\">Show on TV now</span></label>\n        <button class=\"send\" id=\"send\" type=\"button\" data-t=\"btn\">Send</button>\n      </div>\n      <div class=\"msg\" id=\"result\"></div>\n    </section>\n\n    <aside class=\"stage\">\n      <div class=\"tv\"><svg id=\"scene\" class=\"scene\" viewBox=\"0 0 1920 1080\" role=\"img\" font-family=\"SamsungOneUI, system-ui, Segoe UI, sans-serif\" font-weight=\"500\">\n      <defs>\n        <linearGradient id=\"tvSky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#101c3f\"/><stop offset=\".45\" stop-color=\"#553b73\"/><stop offset=\".72\" stop-color=\"#d9707a\"/><stop offset=\"1\" stop-color=\"#f6b26b\"/></linearGradient>\n        <radialGradient id=\"tvSun\" cx=\".5\" cy=\".5\" r=\".5\"><stop offset=\"0\" stop-color=\"#fff2cf\" stop-opacity=\".95\"/><stop offset=\".35\" stop-color=\"#ffc58a\" stop-opacity=\".5\"/><stop offset=\"1\" stop-color=\"#ffc58a\" stop-opacity=\"0\"/></radialGradient>\n        <linearGradient id=\"tvWater\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f0a26c\"/><stop offset=\"1\" stop-color=\"#1a2547\"/></linearGradient>\n      </defs>\n      <rect width=\"1920\" height=\"1080\" fill=\"url(#tvSky)\"/><circle cx=\"1330\" cy=\"640\" r=\"420\" fill=\"url(#tvSun)\"/><circle cx=\"1330\" cy=\"640\" r=\"64\" fill=\"#fff0c9\"/>\n      <path d=\"M0 690 220 520 420 640 640 470 880 650 1080 560 1290 690 1500 540 1740 660 1920 590V760H0z\" fill=\"#42375f\"/>\n      <path d=\"M0 760 180 640 400 740 640 620 900 760 1160 650 1420 770 1680 670 1920 740V800H0z\" fill=\"#26274a\"/>\n      <rect y=\"780\" width=\"1920\" height=\"300\" fill=\"url(#tvWater)\"/>\n      <rect x=\"1250\" y=\"790\" width=\"160\" height=\"6\" rx=\"3\" fill=\"#ffe3b3\" opacity=\".7\"/><rect x=\"1280\" y=\"820\" width=\"100\" height=\"5\" rx=\"2\" fill=\"#ffe3b3\" opacity=\".45\"/><rect x=\"1300\" y=\"850\" width=\"60\" height=\"4\" rx=\"2\" fill=\"#ffe3b3\" opacity=\".3\"/>\n      <path d=\"M0 900 0 1080H1920V920C1700 880 1500 930 1250 900 900 860 600 930 0 900z\" fill=\"#0d1530\" opacity=\".55\"/>\n      <g id=\"dyn\"></g>\n    </svg></div>\n      <p class=\"note\" data-t=\"prevnote\">The TV shows its own native banner; this is only an approximation.</p>\n      <div class=\"rhead\"><h2 data-t=\"recent\">Recently sent</h2><button class=\"ghost\" id=\"refresh\" type=\"button\" data-t=\"refresh\">Refresh</button></div>\n      <ul id=\"recent\"></ul>\n    </aside>\n  </main>\n\n  <section class=\"dev\" id=\"devwrap\" hidden>\n    <div class=\"pane\" id=\"p-rules\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"src_title\">Sources</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"src_note\">One entry per sender. Its defaults fill in what a request leaves out; a key makes it require the header X-NC-Key.</div>\n          <ul id=\"srclist\"></ul>\n          <div class=\"rulesgrid\" style=\"margin-top:10px\">\n            <div><div class=\"lab\" data-t=\"f_name\">Name</div><input type=\"text\" id=\"s_name\" maxlength=\"32\" placeholder=\"doorbell\"></div>\n            <div><div class=\"lab\" data-t=\"f_icon\">Icon</div><input type=\"text\" id=\"s_icon\" maxlength=\"16\"></div>\n            <div><div class=\"lab\" data-t=\"f_level\">Level</div><select id=\"s_level\"><option value=\"\"></option><option>info</option><option>ok</option><option>warn</option><option>alert</option></select></div>\n            <div><div class=\"lab\" data-t=\"f_mode\">Show as</div><select id=\"s_mode\"><option value=\"\"></option><option>banner</option><option>full</option><option>both</option></select></div>\n            <div><div class=\"lab\" data-t=\"f_dur\">Duration (s)</div><input type=\"text\" id=\"s_dur\" maxlength=\"2\"></div>\n            <div><div class=\"lab\" data-t=\"f_rate\">Max per minute (0 = no limit)</div><input type=\"text\" id=\"s_rate\" maxlength=\"3\"></div>\n            <div><div class=\"lab\" data-t=\"f_sound\">Sound</div><select id=\"s_sound\"></select></div>\n            <div><div class=\"lab\" data-t=\"f_vol\">Volume (%)</div><input type=\"text\" id=\"s_vol\" maxlength=\"3\"></div>\n          </div>\n          <label class=\"chk\" style=\"margin-bottom:10px\"><input type=\"checkbox\" id=\"s_on\" checked> <span data-t=\"f_enabled\">Enabled</span></label>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"s_save\" data-t=\"save\">Save</button><button type=\"button\" class=\"ghost\" id=\"s_key\" data-t=\"gen_key\">New key</button><button type=\"button\" class=\"ghost\" id=\"s_clearkey\" data-t=\"clear_key\">Remove key</button><button type=\"button\" class=\"ghost\" id=\"s_del\" data-t=\"del\">Delete</button></div>\n          <div class=\"msg\" id=\"srcmsg\" style=\"padding:8px 0 0\"></div>\n          <pre id=\"srckey\" hidden></pre>\n        </div>\n        <div>\n          <h3 data-t=\"q_title\">Quiet hours and repeats</h3>\n          <label class=\"chk\" style=\"margin-bottom:8px\"><input type=\"checkbox\" id=\"q_on\"> <span data-t=\"q_on\">Quiet hours</span></label>\n          <div class=\"rulesgrid\">\n            <div><div class=\"lab\" data-t=\"q_from\">From (HH:MM)</div><input type=\"text\" id=\"q_from\" maxlength=\"5\"></div>\n            <div><div class=\"lab\" data-t=\"q_to\">To (HH:MM)</div><input type=\"text\" id=\"q_to\" maxlength=\"5\"></div>\n          </div>\n          <div class=\"lab\" data-t=\"q_allow\">Still show</div>\n          <select id=\"q_allow\"><option value=\"alert\">alert</option><option value=\"warn\">warn + alert</option><option value=\"none\">nothing</option></select>\n          <div class=\"lab\" data-t=\"g_secs\">Count repeats inside (s, 0 = off)</div>\n          <input type=\"text\" id=\"g_secs\" maxlength=\"4\">\n          <label class=\"chk\" style=\"margin-bottom:10px\"><input type=\"checkbox\" id=\"g_strict\"> <span data-t=\"g_strict\">Refuse senders that have no source entry</span></label>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"q_save\" data-t=\"save\">Save</button></div>\n          <div class=\"msg\" id=\"qmsg\" style=\"padding:8px 0 0\"></div>\n\n          <h3 style=\"margin-top:22px\" data-t=\"h_title\">Webhooks</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"h_note\">Turn any JSON a service already sends into a notification. Use {{path.to.value}} from the JSON in the texts.</div>\n          <ul id=\"hooklist\"></ul>\n          <div class=\"rulesgrid\" style=\"margin-top:10px\">\n            <div><div class=\"lab\" data-t=\"f_name\">Name</div><input type=\"text\" id=\"h_name\" maxlength=\"24\" placeholder=\"github\"></div>\n            <div><div class=\"lab\" data-t=\"f_icon\">Icon</div><input type=\"text\" id=\"h_icon\" maxlength=\"16\"></div>\n          </div>\n          <div class=\"lab\" data-t=\"h_ttl\">Title template</div><input type=\"text\" id=\"h_ttl\" maxlength=\"200\" placeholder=\"{{repository.name}}\">\n          <div class=\"lab\" data-t=\"h_msg\">Message template (required)</div><input type=\"text\" id=\"h_msg\" maxlength=\"200\" placeholder=\"{{pusher.name}} pushed {{head_commit.message}}\">\n          <div class=\"rulesgrid\">\n            <div><div class=\"lab\" data-t=\"f_level\">Level</div><input type=\"text\" id=\"h_level\" maxlength=\"40\" placeholder=\"info\"></div>\n            <div><div class=\"lab\" data-t=\"h_src\">Source (default: the name)</div><input type=\"text\" id=\"h_src\" maxlength=\"32\"></div>\n            <div><div class=\"lab\" data-t=\"f_sound\">Sound</div><select id=\"h_sound\"></select></div>\n          </div>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"h_save\" data-t=\"save\">Save</button><button type=\"button\" class=\"ghost\" id=\"h_del\" data-t=\"del\">Delete</button></div>\n          <div class=\"msg\" id=\"hmsg\" style=\"padding:8px 0 0\"></div>\n          <pre id=\"hurl\" hidden></pre>\n        </div>\n      </div>\n    </div>\n    <div class=\"pane\" id=\"p-test\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"t_show\">Test on the TV</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"t_show_note\">Each button sends a real test notification to the TV.</div>\n          <div class=\"row\"><button type=\"button\" class=\"ghost\" data-stm=\"banner\" data-t=\"st_tb\">Test banner</button><button type=\"button\" class=\"ghost\" data-stm=\"full\" data-t=\"st_tc\">Test card</button><button type=\"button\" class=\"ghost\" data-stm=\"both\" data-t=\"st_tboth\">Test both</button></div>\n          <div class=\"msg\" id=\"stmsg\" style=\"padding:8px 0 0\"></div>\n\n          <h3 style=\"margin-top:22px\" data-t=\"t_sound\">Sounds</h3>\n          <div class=\"msg\" id=\"tsoundnote\" style=\"padding:0 0 8px\"></div>\n          <div class=\"row\" id=\"tsounds\"></div>\n          <div class=\"lab\" style=\"margin-top:12px\" data-t=\"f_mvol\">Sound volume (%)</div>\n          <div class=\"row\"><input type=\"range\" id=\"tmvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"flex:1\"><b id=\"tmvolv\">100%</b></div>\n          <div class=\"lab\" style=\"margin-top:12px\" data-t=\"f_delay\">The sound starts this long after the notification is sent (ms)</div>\n          <div class=\"row\"><input type=\"range\" id=\"tdelay\" min=\"0\" max=\"10000\" step=\"100\" value=\"3000\" style=\"flex:1\"><b id=\"tdelayv\">3000 ms</b></div>\n          <div class=\"msg\" style=\"padding:4px 0 0\" data-t=\"f_delay_note\">The banner appears a few seconds after the request. Press \"Send a notification with this sound\" below and move this slider until the sound and the banner arrive together.</div>\n          <div class=\"lab\" style=\"margin-top:12px\" data-t=\"f_vol\">Volume (%)</div>\n          <div class=\"row\"><input type=\"range\" id=\"tvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"flex:1\"><b id=\"tvolv\">100%</b></div>\n          <div class=\"row\" style=\"margin-top:12px\"><button type=\"button\" class=\"send\" id=\"tsend\" data-t=\"t_send_sound\">Send a notification with this sound</button></div>\n          <div class=\"msg\" id=\"tsmsg\" style=\"padding:8px 0 0\"></div>\n\n          <h3 style=\"margin-top:22px\" data-t=\"t_goodie\">Goodie</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"t_goodie_note\">About 10 seconds of a well-known tune, played only with the notification sounds (you recognise it by the rhythm).</div>\n          <div class=\"row\"><span id=\"tsongs\" class=\"row\"></span><button type=\"button\" class=\"ghost\" id=\"tsongstop\" data-t=\"t_stop\">Stop</button></div>\n        </div>\n        <div>\n          <h3 data-t=\"api_try\">Try the API</h3>\n          <div id=\"apiform\" class=\"apiform\"></div>\n          <div class=\"row\" style=\"margin-bottom:10px\"><button type=\"button\" class=\"send\" id=\"apitry\" data-t=\"send_btn\">Send</button></div>\n          <pre id=\"apiout\"></pre>\n        </div>\n      </div>\n    </div>\n    <div class=\"pane\" id=\"p-req\" hidden>\n      <div class=\"tabs\" id=\"reqtabs\"></div>\n      <pre id=\"reqcode\"></pre>\n      <div class=\"row\" style=\"margin-top:10px\"><button type=\"button\" class=\"ghost\" id=\"reqcopy\" data-t=\"copy\">Copy</button></div>\n    </div>\n    <div class=\"pane\" id=\"p-api\" hidden>\n      <div class=\"msg\" id=\"apiver\" style=\"padding:0 0 8px\"></div>\n      <table class=\"api\"><thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Meaning</th></tr></thead><tbody id=\"apifields\"></tbody></table>\n      <ul id=\"apiroutes\"></ul>\n      <div class=\"msg\" style=\"padding:8px 0 0\">API.md</div>\n    </div>\n    <div class=\"pane\" id=\"p-app\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"st_title\">Status</h3>\n          <ul id=\"statuslist\"></ul>\n        </div>\n        <div>\n          <h3 data-t=\"app\">Companion app</h3>\n          <div class=\"msg\" style=\"padding:0 0 10px\" data-t=\"appnote\">Launches NotifCtr01.NotifCenter (fixed id). It must be installed on the TV, see the README.</div>\n          <h3 data-t=\"curl\">Send from another device</h3>\n          <pre id=\"curl\"></pre>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n<div class=\"modal\" id=\"picker\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"dhead\"><h2 data-t=\"pick_title\">Choose an icon</h2><button type=\"button\" class=\"ghost\" id=\"pclose\" data-t=\"close\">Close</button></div>\n    <input type=\"text\" id=\"esearch\" data-p=\"ph_search\">\n    <div class=\"ecats\" id=\"ecats\"></div>\n    <div class=\"egrid\" id=\"egrid\"></div>\n    <div class=\"msg\" id=\"esrc\" style=\"padding:8px 0 0\"></div>\n  </div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n  var $ = function (id) { return document.getElementById(id); };\n  var T = {\n    en: { title: \"Notification Center\", send: \"Send a notification\", secs: \"Show for (s)\", open: \"Show on TV now\", btn: \"Send\", preview: \"Preview\",\n      prevnote: \"The TV shows its own native banner; this is only an approximation.\", recent: \"Recently sent\", refresh: \"Refresh\", app: \"Companion app\",\n      appnote: \"Launches NotifCtr01.NotifCenter (fixed id). It must be installed on the TV, see the README.\", curl: \"Send from another device\",\n      ph_title: \"Title (optional)\", ph_msg: \"Message\", st_title: \"Status\", ph_auto: \"\\u00cdcone autom\\u00e1tico:\", pick_title: \"Escolher um \\u00edcone\", close: \"Fechar\", tab_main: \"Notifications\", pick_title: \"Choose an icon\", close: \"Close\", ph_auto: \"Automatic icon:\", sec_msg: \"Message\", sec_pics: \"Pictures for the full-screen card\", c_app: \"App\", c_svc: \"Banner service\", c_pair_on: \"Pairing on\", c_pair_off: \"Pairing off\", st_shard: \"Notification Center Shard\", st_app: \"Companion app installed\", st_appfix: \"Install the .wgt with Apps2Samsung or TV-Store\", st_svc: \"Banner service installed\", st_svcfix: \"Reinstall the app (version 0.2 or newer)\", st_pair: \"Vetro pairing\", st_pair_on: \"On: other devices need a key\", st_pair_off: \"Off: any device on the network can send\", st_pair_unknown: \"Could not tell\", st_tb: \"Test banner\", st_tc: \"Test card\", st_tboth: \"Test both\", rq_title: \"Request for other apps and Shards\", copy: \"Copy\", api_title: \"API\", api_try: \"Try it\", send_btn: \"Send\", sent_ok: \"Sent.\",\n      ph_wall: \"Wallpaper URL, full-screen background (optional)\", ph_image: \"Image URL for the full-screen card (optional)\", ph_icon: \"Icon (emoji, optional; default by level)\", pick: \"Choose icon\", noicon: \"Level icon\", ph_search: \"Search icons...\", groups: \"Smileys,People,Animals,Food,Travel,Activities,Objects,Symbols,Flags\", sending: \"Sending...\", queued: \"Sent to the TV\", queuedq: \"Queued (TV not launched)\", none: \"Nothing sent yet.\", notitle: \"Notification\",\n      info: \"Info\", ok: \"Done\", warn: \"Warning\", alert: \"Alert\", sample: \"Your message appears here\", back: \"Returning to the previous app in\",\n      mode: \"Show as\", m_both: \"Both\", m_banner: \"Samsung banner\", m_full: \"Full screen\", resend: \"Resend\", resent: \"Sent again\" },\n    pt: { title: \"Centro de Notifica\\u00E7\\u00F5es\", send: \"Enviar notifica\\u00E7\\u00E3o\", secs: \"Mostrar durante (s)\", open: \"Mostrar na TV agora\", btn: \"Enviar\", preview: \"Pr\\u00E9-visualiza\\u00E7\\u00E3o\",\n      prevnote: \"A TV mostra o seu pr\\u00F3prio aviso nativo; isto \\u00E9 s\\u00F3 uma aproxima\\u00E7\\u00E3o.\", recent: \"Enviadas recentemente\", refresh: \"Atualizar\", app: \"App companheira\",\n      appnote: \"Lan\\u00E7a NotifCtr01.NotifCenter (id fixo). Tem de estar instalada na TV, ver o README.\", curl: \"Enviar a partir de outro dispositivo\",\n      ph_title: \"T\\u00EDtulo (opcional)\", ph_msg: \"Mensagem\", st_title: \"Estado\", tab_main: \"Notifica\\u00e7\\u00f5es\", sec_msg: \"Mensagem\", sec_pics: \"Imagens para o cart\\u00e3o de ecr\\u00e3 inteiro\", c_app: \"App\", c_svc: \"Servi\\u00e7o\", c_pair_on: \"Emparelhamento ligado\", c_pair_off: \"Emparelhamento desligado\", st_shard: \"Shard Notification Center\", st_app: \"App companheira instalada\", st_appfix: \"Instala o .wgt com o Apps2Samsung ou o TV-Store\", st_svc: \"Servi\\u00E7o de banners instalado\", st_svcfix: \"Reinstala a app (vers\\u00E3o 0.2 ou mais recente)\", st_pair: \"Emparelhamento do Vetro\", st_pair_on: \"Ligado: os outros dispositivos precisam de chave\", st_pair_off: \"Desligado: qualquer dispositivo da rede pode enviar\", st_pair_unknown: \"N\\u00E3o consegui saber\", st_tb: \"Testar banner\", st_tc: \"Testar cart\\u00E3o\", st_tboth: \"Testar ambos\", rq_title: \"Pedido para outras apps e Shards\", copy: \"Copiar\", api_title: \"API\", api_try: \"Experimentar\", send_btn: \"Enviar\", sent_ok: \"Enviado.\",\n      ph_wall: \"URL do wallpaper de fundo em ecr\\u00E3 inteiro (opcional)\", ph_image: \"URL da imagem para o cart\\u00E3o de ecr\\u00E3 inteiro (opcional)\", ph_icon: \"\\u00CDcone (emoji, opcional; por defeito pelo n\\u00EDvel)\", pick: \"Escolher \\u00EDcone\", noicon: \"\\u00CDcone do n\\u00EDvel\", ph_search: \"Pesquisar \\u00EDcones...\", groups: \"Smileys,Pessoas,Animais,Comida,Viagens,Atividades,Objetos,S\\u00EDmbolos,Bandeiras\", sending: \"A enviar...\", queued: \"Enviada para a TV\", queuedq: \"Em fila (TV n\\u00E3o lan\\u00E7ada)\", none: \"Ainda nada enviado.\", notitle: \"Notifica\\u00E7\\u00E3o\",\n      info: \"Info\", ok: \"Conclu\\u00EDdo\", warn: \"Aviso\", alert: \"Alerta\", sample: \"A sua mensagem aparece aqui\", back: \"A voltar \\u00E0 aplica\\u00E7\\u00E3o anterior em\",\n      mode: \"Mostrar como\", m_both: \"Ambos\", m_banner: \"Aviso Samsung\", m_full: \"Ecr\\u00E3 inteiro\", resend: \"Reenviar\", resent: \"Enviada de novo\" }\n  };\n  var LEVELS = [\"info\", \"ok\", \"warn\", \"alert\"];\n  // One UI style line icons (24x24, round caps): info, done, warning, alert.\n  var ICON_BODY = {\n    info: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 11v6\"/><circle cx=\"12\" cy=\"7.6\" r=\"0.6\" fill=\"#fff\"/>',\n    ok: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M7.6 12.6l3 3 5.8-6.4\"/>',\n    warn: '<path d=\"M12 3.8L21.2 20H2.8z\"/><path d=\"M12 10v4.6\"/><circle cx=\"12\" cy=\"17.4\" r=\"0.6\" fill=\"#fff\"/>',\n    alert: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 7v6\"/><circle cx=\"12\" cy=\"16.6\" r=\"0.6\" fill=\"#fff\"/>'\n  };\n  function iconSvg(level, size) {\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[level] || ICON_BODY.info) + '</svg>';\n  }\n  var LEVEL_EMOJI = { info: \"\\u2139\\uFE0F\", ok: \"\\u2705\", warn: \"\\u26A0\\uFE0F\", alert: \"\\uD83D\\uDD34\" };\n  var COLORS = { info: \"#2f7bff\", ok: \"#2fc28b\", warn: \"#f5a524\", alert: \"#f0506e\" };\n  var lang = \"en\", level = \"info\", mode = \"banner\", lastRecent = [];\n  function tr(k) { return T[lang][k] || T.en[k] || k; }\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) { return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]; }); }\n  function say(text, cls) { $(\"result\").textContent = text || \"\"; $(\"result\").className = \"msg \" + (cls || \"\"); }\n  function api(path, body) {\n    var opt = body ? { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) } : {};\n    return fetch(path, opt).then(function (r) { return r.json().then(function (j) { if (!r.ok) { throw new Error(j.error || \"error \" + r.status); } return j; }); });\n  }\n  function icon(l) { return iconSvg(l, 24); }\n  function paintLevels() {\n    var custom = $(\"icon\").value, shown = [\"info\", \"warn\", \"alert\"];\n    $(\"levels\").innerHTML = shown.map(function (l) {\n      return '<button type=\"button\" class=\"lv' + (l === level ? \" on\" : \"\") + '\" data-l=\"' + l + '\" style=\"--c:' + COLORS[l] + '\"><i style=\"background:' + COLORS[l] + '\">' + iconSvg(l, 22) + \"</i>\" + esc(tr(l)) + \"</button>\";\n    }).join(\"\") + '<button type=\"button\" class=\"lv' + (custom ? \" on\" : \"\") + '\" id=\"lvpick\" style=\"--c:#8fa3c8\"><i style=\"background:' + (custom ? \"transparent\" : \"#2a3550\") + '\">' +\n      (custom ? '<span style=\"font-size:15px\">' + esc(custom) + \"</span>\" : '<svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"#fff\"><rect x=\"1\" y=\"1\" width=\"5\" height=\"5\" rx=\"1.5\"/><rect x=\"8\" y=\"1\" width=\"5\" height=\"5\" rx=\"1.5\"/><rect x=\"1\" y=\"8\" width=\"5\" height=\"5\" rx=\"1.5\"/><rect x=\"8\" y=\"8\" width=\"5\" height=\"5\" rx=\"1.5\"/></svg>') + \"</i>\" + esc(tr(\"pick\")) + \"</button>\";\n    var b = $(\"levels\").getElementsByTagName(\"button\"), i;\n    for (i = 0; i < b.length; i++) {\n      b[i].addEventListener(\"click\", function () {\n        if (this.id === \"lvpick\") { openPicker(); return; }\n        level = this.getAttribute(\"data-l\"); paintLevels(); preview();\n      });\n    }\n  }\n  function paintModes() {\n    var MODES = [\"banner\", \"full\", \"both\"];\n    $(\"modes\").innerHTML = MODES.map(function (m) {\n      return '<button type=\"button\" class=\"md' + (m === mode ? \" on\" : \"\") + '\" data-m=\"' + m + '\">' + esc(tr(\"m_\" + m)) + \"</button>\";\n    }).join(\"\");\n    var b = $(\"modes\").getElementsByTagName(\"button\"), i;\n    for (i = 0; i < b.length; i++) { b[i].addEventListener(\"click\", function () { mode = this.getAttribute(\"data-m\"); paintModes(); preview(); }); }\n  }\n  function cut(t, n) { t = String(t || \"\"); return t.length > n ? t.slice(0, n - 1) + \"\\u2026\" : t; }\n  function iconAt(l, x, y, size) {\n    return '<svg x=\"' + x + '\" y=\"' + y + '\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[l] || ICON_BODY.info) + \"</svg>\";\n  }\n  function glyph(cx, cy, size) {\n    var e = $(\"icon\").value;\n    if (e) { return '<text x=\"' + cx + '\" y=\"' + (cy + Math.round(size * 0.35)) + '\" text-anchor=\"middle\" font-size=\"' + size + '\">' + esc(e) + \"</text>\"; }\n    return iconAt(level, cx - size / 2, cy - size / 2, size);\n  }\n  // Preview drawn like the Vetro UI overview: the same sunset scene as the TV, with the notification on top.\n  function preview() {\n    var c = COLORS[level], ttl = $(\"title\").value || tr(\"notitle\"), msg = $(\"message\").value || tr(\"sample\");\n    var dur = parseInt($(\"secs\").value, 10) || 8, h = \"\";\n    var wall = urlOk($(\"wallpaper\").value), pic = urlOk($(\"image\").value);\n    var bhead = $(\"icon\").value || LEVEL_EMOJI[level];\n    $(\"icon\").placeholder = tr(\"ph_auto\") + \" \" + LEVEL_EMOJI[level];   // the icon follows the level by itself; type or pick one only to override\n    if (mode !== \"banner\") {\n      h += '<g class=\"sc-card\">' + (wall ? '<image x=\"0\" y=\"0\" width=\"1920\" height=\"1080\" preserveAspectRatio=\"xMidYMid slice\" href=\"' + esc(/^https?:\\/\\/[^\\s\"'<>]+$/.test(wall) ? wall : \"\") + '\"/>' : \"\") +\n        '<rect width=\"1920\" height=\"1080\" fill=\"#07090f\" fill-opacity=\"' + (wall ? \".6\" : \".55\") + '\"/>' +\n        '<rect x=\"360\" y=\"330\" width=\"1200\" height=\"310\" rx=\"64\" fill=\"#fff\" fill-opacity=\".1\"/><rect x=\"360\" y=\"330\" width=\"18\" height=\"310\" rx=\"9\" fill=\"' + c + '\"/>' +\n        '<circle cx=\"520\" cy=\"485\" r=\"74\" fill=\"' + c + '\"/>' + glyph(520, 485, 88) +\n        '<text x=\"640\" y=\"470\" font-size=\"54\" font-weight=\"600\" fill=\"#fff\">' + esc(cut(ttl, 30)) + '</text>' +\n        '<text x=\"640\" y=\"540\" font-size=\"38\" fill=\"#c4cde0\">' + esc(cut(msg, pic ? 30 : 52)) + \"</text>\" +\n        (pic ? '<image x=\"1120\" y=\"350\" width=\"400\" height=\"270\" preserveAspectRatio=\"xMidYMid meet\" href=\"' + esc(/^https?:\\/\\/[^\\s\"'<>]+$/.test(pic) ? pic : \"\") + '\"/>' : \"\") +\n        '<text x=\"960\" y=\"745\" text-anchor=\"middle\" font-size=\"36\" fill=\"#8b96ab\">' + esc(tr(\"back\")) + '</text>' +\n        '<text x=\"960\" y=\"900\" text-anchor=\"middle\" font-size=\"160\" font-weight=\"700\" fill=\"#fff\">' + dur + \"</text></g>\";\n    }\n    if (mode !== \"full\") {\n      h += '<g class=\"sc-banner\"><rect x=\"1236\" y=\"60\" width=\"628\" height=\"196\" rx=\"44\" fill=\"#fff\" fill-opacity=\".22\"/><rect x=\"1238\" y=\"62\" width=\"624\" height=\"192\" rx=\"42\" fill=\"#243448\" fill-opacity=\".94\"/>' +\n        '<rect x=\"1268\" y=\"96\" width=\"88\" height=\"88\" rx=\"24\" fill=\"#4a6cf7\"/><text x=\"1312\" y=\"154\" text-anchor=\"middle\" font-size=\"52\">\\uD83D\\uDD14</text>' +\n        '<text x=\"1380\" y=\"132\" font-size=\"32\" font-weight=\"600\" fill=\"#fff\">' + esc(cut(bhead + \" \" + ttl, 24)) + \"</text>\" +\n        '<text x=\"1380\" y=\"172\" font-size=\"26\" fill=\"#fff\" fill-opacity=\".75\">' + esc(cut(msg, 30)) + \"</text>\" +\n        '<text x=\"1380\" y=\"226\" font-size=\"24\" font-weight=\"600\" fill=\"#8fbaff\">OK</text><text x=\"1470\" y=\"226\" font-size=\"24\" fill=\"#8fbaff\">View history</text></g>';\n    }\n    $(\"dyn\").innerHTML = h;\n    paintReq();\n  }\n\n  // Visible feedback on action buttons: spinner while it runs (at least 0.45 s), then green (done) or red (failed) for a moment.\n  function act(btn, p) {\n    var t0 = Date.now();\n    btn.classList.add(\"busy\");\n    function end(cls) {\n      setTimeout(function () {\n        btn.classList.remove(\"busy\"); btn.classList.add(cls);\n        setTimeout(function () { btn.classList.remove(cls); }, 1300);\n      }, Math.max(0, 450 - (Date.now() - t0)));\n    }\n    p.then(function () { end(\"done\"); }, function () { end(\"fail\"); });\n  }\n  function recent() {\n    return api(\"recent\").then(function (d) {\n      lastRecent = d.recent;\n      $(\"recent\").innerHTML = d.recent.length ? d.recent.map(function (n, i) {\n        return '<li style=\"--c:' + (COLORS[n.level] || COLORS.info) + '\"><span class=\"dot\"></span><div><b>' + esc(n.title || tr(\"notitle\")) + \"</b> \" + esc(n.message) +\n          \"<small>\" + new Date(n.at).toLocaleTimeString() + \"</small></div>\" +\n          '<button type=\"button\" class=\"ghost rs\" data-i=\"' + i + '\">' + esc(tr(\"resend\")) + \"</button></li>\";\n      }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"none\")) + \"</li>\";\n      var rb = $(\"recent\").getElementsByClassName(\"rs\"), k;\n      for (k = 0; k < rb.length; k++) {\n        rb[k].addEventListener(\"click\", function () {\n          var n = lastRecent[parseInt(this.getAttribute(\"data-i\"), 10)];\n          if (!n) { return; }\n          act(this, api(\"notify\", { title: n.title, message: n.message, level: n.level, icon: n.icon, image: n.image, wallpaper: n.wallpaper, mode: n.mode, sound: n.sound, volume: n.volume, group: false, duration: parseInt($(\"secs\").value, 10) || 8, open: $(\"open\").checked })\n            .then(function () { say(tr(\"resent\"), \"ok\"); recent(); })\n            .catch(function (e) { say(e.message, \"err\"); throw e; }));\n        });\n      }\n    }).catch(function (e) { say(e.message, \"err\"); throw e; });\n  }\n  function applyLang() {\n    document.documentElement.lang = lang;\n    var els = document.querySelectorAll(\"[data-t]\"), i;\n    for (i = 0; i < els.length; i++) { els[i].textContent = tr(els[i].getAttribute(\"data-t\")); }\n    els = document.querySelectorAll(\"[data-p]\");\n    for (i = 0; i < els.length; i++) { els[i].placeholder = tr(els[i].getAttribute(\"data-p\")); }\n    $(\"l-en\").className = lang === \"en\" ? \"on\" : \"\"; $(\"l-pt\").className = lang === \"pt\" ? \"on\" : \"\";\n    paintLevels(); paintModes(); preview(); recent().catch(function () {});\n  }\n  // Icon picker: emoji list from the Unicode CLDR data (bundled with the Shard, no network), with search in English and Portuguese.\n  var EMOJI = null, ecat = 0;\n  function eRender() {\n    if (!EMOJI) { return; }\n    var q = $(\"esearch\").value.toLowerCase().trim(), names = tr(\"groups\").split(\",\"), i, out = [];\n    $(\"ecats\").innerHTML = names.map(function (n, k) { return '<button type=\"button\" data-g=\"' + k + '\"' + (k === ecat && !q ? ' class=\"on\"' : \"\") + \">\" + esc(n) + \"</button>\"; }).join(\"\");\n    for (i = 0; i < EMOJI.list.length && out.length < 160; i++) {\n      var e = EMOJI.list[i];\n      if (q ? (e[2] + \" \" + e[3] + \" \" + e[4]).toLowerCase().indexOf(q) >= 0 : e[1] === ecat) { out.push(e); }\n    }\n    $(\"egrid\").innerHTML = out.map(function (e) { return '<button type=\"button\" data-c=\"' + esc(e[0]) + '\" title=\"' + esc(lang === \"pt\" ? e[3] : e[2]) + '\">' + e[0] + \"</button>\"; }).join(\"\");\n    var cb = $(\"ecats\").getElementsByTagName(\"button\"), gb = $(\"egrid\").getElementsByTagName(\"button\"), j;\n    for (j = 0; j < cb.length; j++) { cb[j].addEventListener(\"click\", function () { ecat = parseInt(this.getAttribute(\"data-g\"), 10); $(\"esearch\").value = \"\"; eRender(); }); }\n    for (j = 0; j < gb.length; j++) { gb[j].addEventListener(\"click\", function () { $(\"icon\").value = this.getAttribute(\"data-c\"); $(\"picker\").hidden = true; paintLevels(); preview(); }); }\n  }\n  function openPicker() {\n    $(\"picker\").hidden = false;\n    if (EMOJI) { eRender(); $(\"esearch\").focus(); return; }\n    api(\"emoji\").then(function (d) { EMOJI = d; $(\"esrc\").textContent = d.source; eRender(); $(\"esearch\").focus(); }).catch(function (e) { say(e.message, \"err\"); });\n  }\n  $(\"pclose\").addEventListener(\"click\", function () { $(\"picker\").hidden = true; });\n  $(\"picker\").addEventListener(\"click\", function (e) { if (e.target === this) { this.hidden = true; } });\n  document.addEventListener(\"keydown\", function (e) { if (e.key === \"Escape\") { $(\"picker\").hidden = true; } });\n  $(\"esearch\").addEventListener(\"input\", eRender);\n  // The language is a Shard setting (default English); it also decides the language of the app screen on the TV.\n  function setLang(l) { lang = l; applyLang(); api(\"lang\", { lang: l }).catch(function (e) { say(e.message, \"err\"); }); }\n  // The dashboard frame has no allow-forms: use buttons and the Enter key, not <form>.\n  $(\"send\").addEventListener(\"click\", function () {\n    say(tr(\"sending\"));\n    act(this, api(\"notify\", { title: $(\"title\").value, message: $(\"message\").value, level: level, icon: $(\"icon\").value, image: $(\"image\").value, wallpaper: $(\"wallpaper\").value, mode: mode, duration: parseInt($(\"secs\").value, 10) || 8, open: $(\"open\").checked, sound: $(\"sound\").value, group: false })\n      .then(function (r) { say(r.open === \"not requested\" ? tr(\"queuedq\") : tr(\"queued\"), \"ok\"); $(\"message\").value = \"\"; preview(); recent().catch(function () {}); })\n      .catch(function (e) { say(e.message, \"err\"); throw e; }));\n  });\n  $(\"message\").addEventListener(\"keydown\", function (e) { if (e.key === \"Enter\") { $(\"send\").click(); } });\n  $(\"message\").addEventListener(\"input\", preview); $(\"icon\").addEventListener(\"input\", function () { paintLevels(); preview(); }); $(\"title\").addEventListener(\"input\", preview);\n  $(\"secs\").addEventListener(\"input\", function () { $(\"secsv\").textContent = this.value + \" s\"; preview(); });\n  $(\"refresh\").addEventListener(\"click\", function () { act(this, recent()); });\n  $(\"l-en\").addEventListener(\"click\", function () { setLang(\"en\"); });\n  $(\"l-pt\").addEventListener(\"click\", function () { setLang(\"pt\"); });\n  $(\"curl\").textContent = 'curl -X POST http://<TV-IP>:8099/plugins/notification-center/api/notify \\\\\\n  -H \"Content-Type: application/json\" \\\\\\n  -d \\'{\"title\":\"Oven\",\"message\":\"Dinner is ready\",\"level\":\"ok\",\"seconds\":30}\\'';\n  // ---- The panel as a client of the API: request generator, API explorer and installation status ----\n  function urlOk(u) { u = String(u || \"\").trim(); return /^https?:\\/\\/\\S{4,290}$/.test(u) ? u : \"\"; }\n  var REQ_TABS = [\"curl\", \"json\", \"shard\", \"ha\", \"ntfy\"], reqTab = \"curl\", laterT = null;\n  function baseUrl() { var h = \"\"; try { h = location.host; } catch (e) { h = \"\"; } return h ? \"http://\" + h : \"http://<TV-IP>:8099\"; }\n  function reqFields() {\n    var o = {}, v;\n    v = $(\"title\").value; if (v) { o.title = v; }\n    o.message = $(\"message\").value || \"Hello\";\n    if (level !== \"info\") { o.level = level; }\n    if (mode !== \"banner\") { o.mode = mode; }\n    v = $(\"icon\").value; if (v) { o.icon = v; }\n    v = urlOk($(\"image\").value); if (v) { o.image = v; }\n    v = urlOk($(\"wallpaper\").value); if (v) { o.wallpaper = v; }\n    v = parseInt($(\"secs\").value, 10); if (v && v !== 8) { o.duration = v; }\n    return o;\n  }\n  function reqText() {\n    var f = reqFields(), j = JSON.stringify(f), u = baseUrl() + \"/plugins/notification-center/api/\", t;\n    if (reqTab === \"json\") { return JSON.stringify(f, null, 2); }\n    if (reqTab === \"shard\") {\n      return \"var http = require('http');\\nvar body = JSON.stringify(\" + j + \");\\nvar rq = http.request({ host: '127.0.0.1', port: 8099, method: 'POST', path: '/plugins/notification-center/api/notify',\\n  headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) } }, function (r) { r.resume(); });\\nrq.on('error', function () {});\\nrq.end(body);\";\n    }\n    if (reqTab === \"ha\") { return \"rest_command:\\n  tv_notify:\\n    url: \\\"\" + u + \"notify\\\"\\n    method: post\\n    content_type: \\\"application/json\\\"\\n    payload: '\" + j.replace(/'/g, \"''\") + \"'\"; }\n    if (reqTab === \"ntfy\") {\n      t = \"curl -X POST \" + u + \"ntfy\";\n      if (f.title) { t += \" -H \\\"Title: \" + f.title + \"\\\"\"; }\n      if (level === \"alert\") { t += \" -H \\\"Priority: 5\\\"\"; } else if (level === \"warn\") { t += \" -H \\\"Priority: 4\\\"\"; }\n      return t + \" -d \\\"\" + f.message + \"\\\"\\n# ntfy has no image, wallpaper, mode or duration: use the JSON route for those\";\n    }\n    return \"curl -X POST \" + u + \"notify -H \\\"Content-Type: application/json\\\" -d '\" + j.replace(/'/g, \"'\\\\''\") + \"'\";\n  }\n  function paintReq() {\n    $(\"reqtabs\").innerHTML = REQ_TABS.map(function (t) { return '<button type=\"button\" class=\"tab' + (t === reqTab ? \" on\" : \"\") + '\" data-rt=\"' + t + '\">' + t.toUpperCase() + \"</button>\"; }).join(\"\");\n    var b = $(\"reqtabs\").getElementsByTagName(\"button\"), i;\n    for (i = 0; i < b.length; i++) { b[i].addEventListener(\"click\", function () { reqTab = this.getAttribute(\"data-rt\"); paintReq(); }); }\n    $(\"reqcode\").textContent = reqText();\n  }\n  $(\"reqcopy\").addEventListener(\"click\", function () {\n    var text = reqText();\n    act(this, new Promise(function (ok, no) { try { navigator.clipboard.writeText(text).then(ok, function () { no(new Error(\"copy not available\")); }); } catch (e) { no(new Error(\"copy not available\")); } }));\n  });\n  $(\"image\").addEventListener(\"input\", function () { clearTimeout(laterT); laterT = setTimeout(preview, 600); });\n  $(\"wallpaper\").addEventListener(\"input\", function () { clearTimeout(laterT); laterT = setTimeout(preview, 600); });\n\n  function loadApi() {\n    api(\"api\").then(function (d) {\n      $(\"apiver\").textContent = d.name + \" \" + d.version + \" (API v\" + d.apiVersion + \")\";\n      $(\"apifields\").innerHTML = Object.keys(d.fields).map(function (k) {\n        var f = d.fields[k];\n        return \"<tr><td><code>\" + esc(k) + \"</code>\" + (f.required ? \" *\" : \"\") + \"</td><td>\" + esc(f.type + (f[\"enum\"] ? \": \" + f[\"enum\"].join(\" | \") : \"\")) + \"</td><td>\" + esc(f[\"default\"] == null ? \"\" : f[\"default\"]) + \"</td><td>\" + esc(f.note || \"\") + \"</td></tr>\";\n      }).join(\"\");\n      $(\"apiroutes\").innerHTML = d.endpoints.map(function (e) { return \"<li><code>\" + esc(e.method + \" \" + e.path) + \"</code> \" + esc(e.summary) + \"</li>\"; }).join(\"\");\n      $(\"apiform\").innerHTML = Object.keys(d.fields).map(function (k) {\n        var f = d.fields[k], input;\n        if (f[\"enum\"]) { input = '<select data-k=\"' + k + '\"><option value=\"\"></option>' + f[\"enum\"].map(function (v) { return \"<option>\" + esc(v) + \"</option>\"; }).join(\"\") + \"</select>\"; }\n        else if (f.type === \"boolean\") { input = '<select data-k=\"' + k + '\"><option value=\"\"></option><option>true</option><option>false</option></select>'; }\n        else { input = '<input type=\"text\" data-k=\"' + k + '\" placeholder=\"' + esc(f.type) + '\">'; }\n        return '<label class=\"af\"><span>' + esc(k) + \"</span>\" + input + \"</label>\";\n      }).join(\"\");\n    }).catch(function (e) { $(\"apiver\").textContent = e.message; });\n  }\n  $(\"apitry\").addEventListener(\"click\", function () {\n    var els = $(\"apiform\").querySelectorAll(\"[data-k]\"), body = {}, i, v, k;\n    for (i = 0; i < els.length; i++) {\n      v = els[i].value; k = els[i].getAttribute(\"data-k\");\n      if (v === \"\") { continue; }\n      if (v === \"true\") { body[k] = true; } else if (v === \"false\") { body[k] = false; } else if (/^\\d+$/.test(v) && (k === \"duration\" || k === \"seconds\")) { body[k] = parseInt(v, 10); } else { body[k] = v; }\n    }\n    act(this, api(\"notify\", body).then(function (r) { $(\"apiout\").textContent = JSON.stringify(r, null, 2); }, function (e) { $(\"apiout\").textContent = e.message; throw e; }));\n  });\n\n  function loadStatus() {\n    return api(\"status\").then(function (s) {\n      function row(ok, label, extra) { return '<li><span class=\"dotc ' + (ok === true ? \"g\" : ok === false ? \"r\" : \"y\") + '\"></span><div><b>' + esc(label) + \"</b>\" + (extra ? \"<small>\" + esc(extra) + \"</small>\" : \"\") + \"</div></li>\"; }\n      $(\"statuslist\").innerHTML = row(true, tr(\"st_shard\"), \"v\" + s.version) + row(s.app, tr(\"st_app\"), s.app ? \"v\" + s.appVersion : tr(\"st_appfix\")) +\n        row(s.service, tr(\"st_svc\"), s.service ? \"\" : tr(\"st_svcfix\")) + row(s.pairing === \"on\" ? true : null, tr(\"st_pair\"), tr(\"st_pair_\" + s.pairing));\n      function chip(ok, t) { return '<span class=\"chip ' + (ok === true ? \"g\" : ok === false ? \"r\" : \"y\") + '\">' + esc(t) + \"</span>\"; }\n      $(\"chips\").innerHTML = chip(s.app, tr(\"c_app\")) + chip(s.service, tr(\"c_svc\")) + chip(s.pairing === \"on\" ? true : null, tr(s.pairing === \"on\" ? \"c_pair_on\" : \"c_pair_off\"));\n    }).catch(function (e) { $(\"statuslist\").innerHTML = '<li class=\"empty\">' + esc(e.message) + \"</li>\"; });\n  }\n  (function () {\n    var b = document.querySelectorAll(\"[data-stm]\"), i;\n    for (i = 0; i < b.length; i++) {\n      b[i].addEventListener(\"click\", function () {\n        var m = this.getAttribute(\"data-stm\");\n        act(this, api(\"notify\", { title: \"Test\", message: \"Notification Center test (\" + m + \")\", level: \"ok\", mode: m, duration: 8, group: false }).then(function () { $(\"stmsg\").textContent = tr(\"sent_ok\"); $(\"stmsg\").className = \"msg ok\"; }));\n      });\n    }\n  })();\n\n  (function () {\n    var tb = document.querySelectorAll(\"[data-pane]\"), i;\n    for (i = 0; i < tb.length; i++) {\n      tb[i].addEventListener(\"click\", function () {\n        var id = this.getAttribute(\"data-pane\"), j, p;\n        for (j = 0; j < tb.length; j++) { tb[j].className = tb[j] === this ? \"on\" : \"\"; p = $(tb[j].getAttribute(\"data-pane\")); p.hidden = tb[j] !== this; }\n        $(\"devwrap\").hidden = id === \"p-main\";\n      });\n    }\n  })();\n\n  // Sources and rules: sources (profiles with keys), quiet hours, grouping and webhooks. Every control calls the documented API (API.md).\n  (function () {\n    var X = {\n      en: { rules_tab: \"Sources and rules\", src_title: \"Sources\", src_note: \"One entry per sender. Its defaults fill in what a request leaves out; a key makes it require the header X-NC-Key.\",\n        f_name: \"Name\", f_icon: \"Icon\", f_level: \"Level\", f_mode: \"Show as\", f_dur: \"Duration (s)\", f_rate: \"Max per minute (0 = no limit)\", f_enabled: \"Enabled\", save: \"Save\", gen_key: \"New key\", clear_key: \"Remove key\", del: \"Delete\",\n        q_title: \"Quiet hours and repeats\", q_on: \"Quiet hours\", q_from: \"From (HH:MM)\", q_to: \"To (HH:MM)\", q_allow: \"Still show\", g_secs: \"Count repeats inside (s, 0 = off)\", g_strict: \"Refuse senders that have no source entry\",\n        h_title: \"Webhooks\", h_note: \"Turn any JSON a service already sends into a notification. Use {{path.to.value}} from the JSON in the texts.\", h_ttl: \"Title template\", h_msg: \"Message template (required)\", h_src: \"Source (default: the name)\",\n        off: \"off\", haskey: \"key\", saved: \"Saved\", deleted: \"Deleted\", keynote: \"Copy this key now, it is shown only once. Senders send it in the header X-NC-Key:\", hookurl: \"Send any JSON to:\", needname: \"Type a name first\" },\n      pt: { rules_tab: \"Origens e regras\", src_title: \"Origens\", src_note: \"Uma entrada por emissor. Os valores por defeito preenchem o que o pedido não traz; com chave, o emissor tem de enviar o cabeçalho X-NC-Key.\",\n        f_name: \"Nome\", f_icon: \"Ícone\", f_level: \"Nível\", f_mode: \"Mostrar como\", f_dur: \"Duração (s)\", f_rate: \"Máximo por minuto (0 = sem limite)\", f_enabled: \"Ativa\", save: \"Guardar\", gen_key: \"Nova chave\", clear_key: \"Remover chave\", del: \"Apagar\",\n        q_title: \"Silêncio e repetições\", q_on: \"Horas de silêncio\", q_from: \"De (HH:MM)\", q_to: \"Até (HH:MM)\", q_allow: \"Mostrar mesmo assim\", g_secs: \"Contar repetições dentro de (s, 0 = desligado)\", g_strict: \"Recusar emissores sem entrada nas origens\",\n        h_title: \"Webhooks\", h_note: \"Transforma o JSON que um serviço já envia numa notificação. Use {{caminho.do.valor}} do JSON nos textos.\", h_ttl: \"Modelo do título\", h_msg: \"Modelo da mensagem (obrigatório)\", h_src: \"Origem (por defeito: o nome)\",\n        off: \"desligada\", haskey: \"chave\", saved: \"Guardado\", deleted: \"Apagado\", keynote: \"Copie esta chave agora, só aparece uma vez. Os emissores enviam-na no cabeçalho X-NC-Key:\", hookurl: \"Envie qualquer JSON para:\", needname: \"Escreva primeiro um nome\" }\n    }, k;\n    for (k in X.en) { T.en[k] = X.en[k]; }\n    for (k in X.pt) { T.pt[k] = X.pt[k]; }\n    function note(id, text, cls) { $(id).textContent = text || \"\"; $(id).className = \"msg \" + (cls || \"\"); }\n    function fail(id) { return function (e) { note(id, e.message, \"err\"); throw e; }; }\n    function num(id) { return parseInt($(id).value, 10) || 0; }\n    var BASE = \"http://<TV-IP>:8099/plugins/notification-center/api/\";\n\n    var SRC = {}, HOOKS = {};\n    function loadSources() {\n      return api(\"profiles\").then(function (d) {\n        SRC = d.profiles;\n        var names = Object.keys(SRC);\n        $(\"srclist\").innerHTML = names.length ? names.map(function (n) {\n          var p = SRC[n];\n          return '<li class=\"rl\" data-n=\"' + esc(n) + '\"><b>' + esc(n) + \"</b><small>\" + esc([p.enabled ? \"\" : tr(\"off\"), p.icon, p.level, p.mode, p.duration ? p.duration + \" s\" : \"\", p.rate ? p.rate + \"/min\" : \"\", p.sound ? \"\\u266A \" + p.sound : \"\", p.hasKey ? tr(\"haskey\") : \"\"].filter(Boolean).join(\" · \")) + \"</small></li>\";\n        }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"none\")) + \"</li>\";\n        var li = $(\"srclist\").getElementsByClassName(\"rl\"), i;\n        for (i = 0; i < li.length; i++) {\n          li[i].addEventListener(\"click\", function () {\n            var n = this.getAttribute(\"data-n\"), p = SRC[n];\n            $(\"s_name\").value = n; $(\"s_icon\").value = p.icon; $(\"s_level\").value = p.level; $(\"s_mode\").value = p.mode;\n            $(\"s_dur\").value = p.duration || \"\"; $(\"s_rate\").value = p.rate || \"\"; $(\"s_sound\").value = p.sound || \"\"; $(\"s_vol\").value = p.volume || \"\"; $(\"s_on\").checked = p.enabled; $(\"srckey\").hidden = true;\n          });\n        }\n      }).catch(function (e) { note(\"srcmsg\", e.message, \"err\"); });\n    }\n    function srcName() { return $(\"s_name\").value.trim().toLowerCase(); }\n    $(\"s_save\").addEventListener(\"click\", function () {\n      act(this, api(\"profiles\", { source: srcName(), icon: $(\"s_icon\").value, level: $(\"s_level\").value, mode: $(\"s_mode\").value, duration: num(\"s_dur\"), rate: num(\"s_rate\"), sound: $(\"s_sound\").value, volume: num(\"s_vol\"), enabled: $(\"s_on\").checked })\n        .then(function () { note(\"srcmsg\", tr(\"saved\"), \"ok\"); return loadSources(); }, fail(\"srcmsg\")));\n    });\n    $(\"s_key\").addEventListener(\"click\", function () {\n      if (!srcName()) { note(\"srcmsg\", tr(\"needname\"), \"err\"); return; }\n      act(this, api(\"profiles\", { source: srcName(), genKey: true }).then(function (r) {\n        $(\"srckey\").hidden = false; $(\"srckey\").textContent = tr(\"keynote\") + \"\\n\" + r.key; note(\"srcmsg\", \"\", \"\"); return loadSources();\n      }, fail(\"srcmsg\")));\n    });\n    $(\"s_clearkey\").addEventListener(\"click\", function () {\n      act(this, api(\"profiles\", { source: srcName(), key: \"\" }).then(function () { $(\"srckey\").hidden = true; note(\"srcmsg\", tr(\"saved\"), \"ok\"); return loadSources(); }, fail(\"srcmsg\")));\n    });\n    $(\"s_del\").addEventListener(\"click\", function () {\n      act(this, api(\"profiles\", { source: srcName(), delete: true }).then(function () { note(\"srcmsg\", tr(\"deleted\"), \"ok\"); $(\"s_name\").value = \"\"; return loadSources(); }, fail(\"srcmsg\")));\n    });\n\n    function loadSettings() {\n      return api(\"settings\").then(function (d) {\n        var s = d.settings;\n        $(\"q_on\").checked = s.quiet.enabled; $(\"q_from\").value = s.quiet.from; $(\"q_to\").value = s.quiet.to; $(\"q_allow\").value = s.quiet.allow;\n        $(\"g_secs\").value = s.groupSeconds; $(\"g_strict\").checked = s.strict;\n      }).catch(function (e) { note(\"qmsg\", e.message, \"err\"); });\n    }\n    $(\"q_save\").addEventListener(\"click\", function () {\n      act(this, api(\"settings\", { quiet: { enabled: $(\"q_on\").checked, from: $(\"q_from\").value, to: $(\"q_to\").value, allow: $(\"q_allow\").value }, groupSeconds: num(\"g_secs\"), strict: $(\"g_strict\").checked })\n        .then(function (r) { note(\"qmsg\", tr(\"saved\"), \"ok\"); $(\"q_from\").value = r.settings.quiet.from; $(\"q_to\").value = r.settings.quiet.to; }, fail(\"qmsg\")));\n    });\n\n    function loadHooks() {\n      return api(\"hooks\").then(function (d) {\n        HOOKS = d.hooks;\n        var names = Object.keys(HOOKS);\n        $(\"hooklist\").innerHTML = names.length ? names.map(function (n) {\n          return '<li class=\"rl\" data-n=\"' + esc(n) + '\"><b>' + esc(n) + \"</b><small>\" + esc(HOOKS[n].message) + \"</small></li>\";\n        }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"none\")) + \"</li>\";\n        var li = $(\"hooklist\").getElementsByClassName(\"rl\"), i;\n        for (i = 0; i < li.length; i++) {\n          li[i].addEventListener(\"click\", function () {\n            var n = this.getAttribute(\"data-n\"), h = HOOKS[n];\n            $(\"h_name\").value = n; $(\"h_icon\").value = h.icon; $(\"h_ttl\").value = h.title; $(\"h_msg\").value = h.message; $(\"h_level\").value = h.level; $(\"h_src\").value = h.source; $(\"h_sound\").value = h.sound || \"\";\n            $(\"hurl\").hidden = false; $(\"hurl\").textContent = tr(\"hookurl\") + \"\\n\" + BASE + \"hook/\" + n;\n          });\n        }\n      }).catch(function (e) { note(\"hmsg\", e.message, \"err\"); });\n    }\n    function hookName() { return $(\"h_name\").value.trim().toLowerCase(); }\n    $(\"h_save\").addEventListener(\"click\", function () {\n      act(this, api(\"hooks\", { name: hookName(), icon: $(\"h_icon\").value, title: $(\"h_ttl\").value, message: $(\"h_msg\").value, level: $(\"h_level\").value, source: $(\"h_src\").value, sound: $(\"h_sound\").value })\n        .then(function (r) { note(\"hmsg\", tr(\"saved\"), \"ok\"); $(\"hurl\").hidden = false; $(\"hurl\").textContent = tr(\"hookurl\") + \"\\n\" + BASE + r.url; return loadHooks(); }, fail(\"hmsg\")));\n    });\n    $(\"h_del\").addEventListener(\"click\", function () {\n      act(this, api(\"hooks\", { name: hookName(), delete: true }).then(function () { note(\"hmsg\", tr(\"deleted\"), \"ok\"); $(\"hurl\").hidden = true; $(\"h_name\").value = \"\"; return loadHooks(); }, fail(\"hmsg\")));\n    });\n    loadSources(); loadSettings(); loadHooks();\n  })();\n\n  // Sounds: the list comes from the Shard (GET sounds); this Shard plays them with one fixed paplay command. Used by the send form, the source and webhook\n  // forms and the Testing tab.\n  (function () {\n    var X = {\n      en: { test_tab: \"Testing\", t_show: \"Test on the TV\", t_show_note: \"Each button sends a real test notification to the TV.\", t_sound: \"Sounds\", f_mvol: \"Sound volume (%)\", f_delay: \"The sound starts this long after the notification is sent (ms)\", f_delay_note: \"The banner appears a few seconds after the request. Press the button \\\"Send a notification with this sound\\\" below and move this slider until the sound and the banner arrive together.\", t_goodie: \"Goodie\", t_goodie_note: \"About 10 seconds of a well-known tune, played only with the notification sounds (you recognise it by the rhythm).\", t_stop: \"Stop\", f_sound: \"Sound\", f_vol: \"Volume (%)\", no_sound: \"No sound\",\n        t_send_sound: \"Send a notification with this sound\", t_pick: \"Tapping a sound plays it. Then press Send to try it in a notification.\", t_missing: \"This Shard cannot play sounds (the exec permission was not granted).\",\n        t_ready: \"Sound Shard found.\", t_sent: \"Sent\", t_none: \"Pick a sound first\" },\n      pt: { test_tab: \"Testes\", t_show: \"Testar na TV\", t_show_note: \"Cada botão envia uma notificação de teste real para a TV.\", t_sound: \"Sons\", f_mvol: \"Volume do som (%)\", f_delay: \"O som começa este tempo depois de a notificação ser enviada (ms)\", f_delay_note: \"O banner aparece alguns segundos depois do pedido. Carregue no botão \\\"Enviar uma notificação com este som\\\" e mexa neste controlo até o som e o banner chegarem juntos.\", t_goodie: \"Surpresa\", t_goodie_note: \"Cerca de 10 segundos de uma música conhecida, tocada só com os sons de notificação (reconhece-se pelo ritmo).\", t_stop: \"Parar\", f_sound: \"Som\", f_vol: \"Volume (%)\", no_sound: \"Sem som\",\n        t_send_sound: \"Enviar uma notificação com este som\", t_pick: \"Escolha um som e carregue em Enviar. Tocar num som também o reproduz.\", t_missing: \"Este Shard não pode tocar sons (a permissão exec não foi concedida).\",\n        t_ready: \"Shard de som encontrado.\", t_sent: \"Enviado\", t_none: \"Escolha primeiro um som\" }\n    }, k, names = [], installed = null, chosen = \"\";\n    for (k in X.en) { T.en[k] = X.en[k]; }\n    for (k in X.pt) { T.pt[k] = X.pt[k]; }\n    function options(current) {\n      return '<option value=\"\">' + esc(tr(\"no_sound\")) + \"</option>\" + names.map(function (n) { return '<option value=\"' + esc(n) + '\"' + (n === current ? \" selected\" : \"\") + \">\" + esc(n) + \"</option>\"; }).join(\"\");\n    }\n    function paintSounds() {\n      [\"sound\", \"s_sound\", \"h_sound\"].forEach(function (id) { var cur = $(id).value; $(id).innerHTML = options(cur); });\n      $(\"tsounds\").innerHTML = names.map(function (n) { return '<button type=\"button\" class=\"ghost' + (n === chosen ? \" on\" : \"\") + '\" data-snd=\"' + esc(n) + '\">' + esc(n) + \"</button>\"; }).join(\"\");\n      $(\"tsoundnote\").textContent = installed === false ? tr(\"t_missing\") : (installed ? tr(\"t_pick\") : \"\");\n      $(\"tsoundnote\").className = \"msg\" + (installed === false ? \" err\" : \"\");\n      var b = $(\"tsounds\").getElementsByTagName(\"button\"), i;\n      for (i = 0; i < b.length; i++) {\n        b[i].addEventListener(\"click\", function () {\n          chosen = this.getAttribute(\"data-snd\"); paintSounds();\n          api(\"play\", { sound: chosen, volume: parseInt($(\"tvol\").value, 10) }).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; });\n        });\n      }\n    }\n    var songs = [];\n    function paintSongs() {\n      $(\"tsongs\").innerHTML = songs.map(function (s) { return '<button type=\"button\" class=\"ghost\" data-song=\"' + esc(s.name) + '\">♪ ' + esc(s.title) + \"</button>\"; }).join(\"\");\n      var b = $(\"tsongs\").getElementsByTagName(\"button\"), i;\n      for (i = 0; i < b.length; i++) {\n        b[i].addEventListener(\"click\", function () {\n          var btn = this;\n          act(btn, api(\"play\", { song: btn.getAttribute(\"data-song\") }).then(function () { $(\"tsmsg\").textContent = \"\"; }, function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; throw e; }));\n        });\n      }\n    }\n    // The volume and the timing are Shard settings (POST settings). The two volume sliders (send form and Testing tab) show the same value.\n    function showVolume(v) { [\"mvol\", \"tmvol\"].forEach(function (id) { $(id).value = v; }); $(\"mvolv\").textContent = v + \"%\"; $(\"tmvolv\").textContent = v + \"%\"; }\n    function loadSounds() {\n      return api(\"sounds\").then(function (d) {\n        names = d.sounds; installed = d.available; songs = d.songs || [];\n        showVolume(d.volume); $(\"tdelay\").value = d.delayMs; $(\"tdelayv\").textContent = d.delayMs + \" ms\";\n        paintSounds(); paintSongs();\n      }).catch(function () { /* keep the lists empty */ });\n    }\n    $(\"tvol\").addEventListener(\"input\", function () { $(\"tvolv\").textContent = this.value + \"%\"; });\n    [\"mvol\", \"tmvol\"].forEach(function (id) {\n      $(id).addEventListener(\"input\", function () { showVolume(this.value); });\n      $(id).addEventListener(\"change\", function () { api(\"settings\", { soundVolume: parseInt(this.value, 10) }).then(function (r) { showVolume(r.settings.soundVolume); }).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; }); });\n    });\n    $(\"tdelay\").addEventListener(\"input\", function () { $(\"tdelayv\").textContent = this.value + \" ms\"; });\n    $(\"tdelay\").addEventListener(\"change\", function () { api(\"settings\", { soundDelayMs: parseInt(this.value, 10) }).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; }); });\n    $(\"tsongstop\").addEventListener(\"click\", function () { act(this, api(\"play\", { song: \"stop\" })); });\n    $(\"tsend\").addEventListener(\"click\", function () {\n      if (!chosen) { $(\"tsmsg\").textContent = tr(\"t_none\"); $(\"tsmsg\").className = \"msg err\"; return; }\n      act(this, api(\"notify\", { title: \"Sound test\", message: \"Sound: \" + chosen, level: \"info\", mode: \"banner\", duration: 6, group: false, sound: chosen, volume: parseInt($(\"tvol\").value, 10) })\n        .then(function () { $(\"tsmsg\").textContent = tr(\"t_sent\"); $(\"tsmsg\").className = \"msg ok\"; }, function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; throw e; }));\n    });\n    var baseApplyLang = applyLang;\n    applyLang = function () { baseApplyLang(); paintSounds(); };\n    loadSounds();\n  })();\n\n  applyLang();\n  loadStatus(); loadApi();\n  api(\"lang\").then(function (d) { if (T[d.lang] && d.lang !== lang) { lang = d.lang; applyLang(); } }).catch(function () { /* keep English */ });\n})();\n</script>\n</body>\n</html>\n"}}
