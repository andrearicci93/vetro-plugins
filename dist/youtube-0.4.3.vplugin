;\n        };\n        d.on('finish', function () { try { if (!sock.destroyed) sock.end(); } catch (e) { /* closed */ } });\n        d.on('close', function () { closed = true; closeEmitted = true; drop(sock); });\n        sock.on('data', function (chunk) { if (!closed && !d.push(chunk)) sock.pause(); });\n        sock.on('end', function () { if (!closed) pushEof(); });\n        sock.on('error', function (e) { if (!closed) d.emit('error', e); });\n        sock.on('close', function () {\n            if (closed) return;\n            closed = true;\n            if (typeof origDestroy === 'function') origDestroy.call(d);\n            else finishClose();\n        });\n        d.push(head);\n        return d;\n    }\n    function replyErrorAndClose(sock, statusLine) {\n        try {\n            if (sock && !sock.destroyed && sock.writable) {\n                sock.end(statusLine + '\\r\\nconnection: close\\r\\ncontent-length: 0\\r\\n\\r\\n');\n                var t = setTimeout(function () { drop(sock); }, 250);\n                if (t && t.unref) t.unref();\n            } else {\n                drop(sock);\n            }\n        } catch (e) { drop(sock); }\n    }\n    function track(sock, count, skipTimeout) {\n        if (count) live++;\n        var gone = false, id = nextId++;\n        socks[id] = sock;\n        sock.on('close', function () { if (!gone) { gone = true; if (count) live--; delete socks[id]; } });\n        sock.on('error', function () { /* the close that follows is handled */ });\n        if (!skipTimeout) sock.setTimeout(IDLE_MS, function () { drop(sock); });\n    }\n\n    function handle(req, res) {\n        var abortUpstream = null, cleanupPipe = null, gone = false;\n        function teardown() {\n            gone = true;\n            if (cleanupPipe) { cleanupPipe(); cleanupPipe = null; }\n            if (abortUpstream) { abortUpstream(); abortUpstream = null; }\n        }\n        res.on('error', teardown);\n        req.on('error', teardown);\n        res.on('close', teardown);\n        var fail = function () {\n            try {\n                if (!res.headersSent) res.writeHead(502, { 'content-length': 0 });\n                if (!res.finished) res.end();\n            } catch (e) { drop(res.socket || req.socket); }\n        };\n\n        var host = String(req.headers.host || '').replace(/:\\d+$/, '').toLowerCase();\n        if (!inject.MITM_HOSTS[host]) { res.writeHead(421, { 'content-length': 0 }); res.end(); return; }\n        if (req.url.split('?')[0] === inject.PRELUDE_PATH) {\n            var ps = opts.script();\n            if (req.method !== 'GET' || !ps) { res.writeHead(404, { 'content-length': 0 }); res.end(); return; }\n            res.writeHead(200, { 'content-type': 'application/javascript; charset=utf-8', 'content-length': PRELUDE_BUF.length, 'cache-control': 'no-store' });\n            res.end(PRELUDE_BUF);\n            return;\n        }\n        if (req.url.split('?')[0] === inject.SCRIPT_PATH) {\n            var s = opts.script();\n            if (req.method !== 'GET' || !s) { res.writeHead(404, { 'content-length': 0 }); res.end(); return; }\n            res.writeHead(200, { 'content-type': 'application/javascript; charset=utf-8', 'content-length': s.body.length, 'cache-control': 'no-store' });\n            res.end(s.body);\n            return;\n        }\n        var tv = req.method === 'GET' && inject.isTvPage(req.url) && !!opts.script();\n        var chunks = [], size = 0, over = false;\n        req.on('data', function (c) {\n            if (over || gone) return;\n            size += c.length;\n            if (size > MAX_BODY) {\n                over = true;\n                chunks = [];\n                if (req.resume) req.resume();\n                if (!res.headersSent) {\n                    res.writeHead(413, { 'content-length': 0, 'connection': 'close' });\n                    res.end(function () { drop(req.socket); });\n                    var closeTimer = setTimeout(function () { drop(req.socket); }, 250);\n                    if (closeTimer && closeTimer.unref) closeTimer.unref();\n                } else {\n                    drop(req.socket);\n                }\n                return;\n            }\n            chunks.push(c);\n        });\n        req.on('end', guard(function () {\n            if (over || gone || res.finished) return;\n            var h = client.request({ host: host, method: req.method, path: req.url, headers: req.headers, identity: tv, noCache: tv }, Buffer.concat(chunks), guard(function (err, r) {\n                if (gone || res.finished) return;\n                if (err) { opts.log('upstream ' + host + ' failed: ' + err.message); fail(); return; }\n                var type = String(r.headers['content-type'] || '').toLowerCase();\n                if (!tv || r.status !== 200 || type.indexOf('text/html') < 0) {\n                    res.writeHead(r.status, inject.passHeaders(r.headers));\n                    cleanupPipe = function () { try { r.body.unpipe(res); } catch (e) { /* closed */ } };\n                    r.body.on('error', function () { if (cleanupPipe) cleanupPipe(); drop(res.socket); });\n                    r.body.pipe(res);\n                    return;\n                }\n                var parts = [], total = 0, bodyFailed = false;\n                r.body.on('data', function (c) { total += c.length; if (total <= MAX_BODY) parts.push(c); });\n                r.body.on('error', function () {\n                    if (bodyFailed || gone) return;\n                    bodyFailed = true;\n                    fail();\n                });\n                r.body.on('end', guard(function () {\n                    if (bodyFailed || gone || res.headersSent) return;\n                    if (total > MAX_BODY) { fail(); return; }\n                    var raw = Buffer.concat(parts);\n                    var s2 = opts.script();\n                    if (!s2) {\n                        res.writeHead(200, inject.passHeaders(r.headers));\n                        res.end(raw);\n                        return;\n                    }\n                    var dec = decompressBody(raw, r.headers['content-encoding']);\n                    if (!dec.ok || dec.buf.length > MAX_BODY) {\n                        opts.log('TV page not rewritten (' + (dec.ok ? 'decompressed body too large' : dec.error.message) + ')');\n                        res.writeHead(200, inject.passHeaders(r.headers));\n                        res.end(raw);\n                        return;\n                    }\n                    var page = inject.rewritePage(dec.buf.toString('utf8'), inject.scriptTag(s2.version), inject.preludeTag(s2.version));\n                    var out = Buffer.from && Buffer.from !== Uint8Array.from ? Buffer.from(page.html, 'utf8') : new Buffer(page.html, 'utf8');\n                    res.writeHead(200, inject.pageHeaders(r.headers, out.length));\n                    res.end(out);\n                    opts.log('TV page rewritten (' + out.length + ' bytes' + (page.injected ? '' : ', no </body>: tag appended') + ')');\n                    if (opts.onPage) opts.onPage({ injected: true, bytes: out.length });\n                }, fail));\n            }, fail));\n            abortUpstream = function () { h.abort(); };\n        }, fail));\n    }\n\n    // One shared TLS and HTTP server for every opened connection; rebuilt when the certificate changes.\n    function ensureTls() {\n        var leaf = opts.leaf();\n        if (!leaf) return null;\n        if (tlsServer && leafCert === leaf.cert) return tlsServer;\n        try {\n            var nextHttp = typeof http.maxHeaderSize === 'number'\n                ? http.createServer({ maxHeaderSize: MAX_HEADER_BYTES }, guard(handle, null))\n                : http.createServer(guard(handle, null));\n            nextHttp.keepAliveTimeout = KEEP_ALIVE_MS;\n            nextHttp.headersTimeout = HEADERS_MS;\n            nextHttp.requestTimeout = 0;\n            nextHttp.on('clientError', function (e, sock) {\n                if (!(e && e.code === 'ERR_HTTP_REQUEST_TIMEOUT' && (!sock || !sock.bytesRead))) {\n                    opts.log('client error: ' + (e && e.code || e));\n                }\n                drop(sock);\n            });\n            var nextTls = tls.createServer({ key: leaf.key, cert: leaf.cert });\n            nextTls.on('secureConnection', guard(function (s) { track(s, false, false); nextHttp.emit('connection', s); }));\n            nextTls.on('tlsClientError', function (e) { opts.log('TLS refused by the app: ' + (e && e.message)); });\n            nextTls.on('error', function () { /* per connection errors are on the sockets */ });\n            httpServer = nextHttp;\n            tlsServer = nextTls;\n            leafCert = leaf.cert;\n            return tlsServer;\n        } catch (e) {\n            opts.log('TLS cert load failed: ' + (e && e.message));\n            return tlsServer;\n        }\n    }\n\n    var HEAD_MAX = 8192;\n\n    function onConnection(c) {\n        if (opts.allow && !opts.allow(c.remoteAddress)) {\n            if (!foreign++) opts.log('refused a connection from outside the TV');\n            c.on('error', function () { /* closed */ });\n            drop(c); return;\n        }\n        if (live >= cap) {\n            refused++;\n            c.on('error', function () { /* closed */ });\n            replyErrorAndClose(c, 'HTTP/1.1 502 Bad Gateway');\n            return;\n        }\n        accepted++;\n        if (!loggedFirst) { loggedFirst = true; opts.log('first connection from the app, from ' + c.remoteAddress); }\n        track(c, true, false);\n        var buf = Buffer.alloc ? Buffer.alloc(0) : new Buffer(0), started = false;\n        c.on('data', guard(function onData(d) {\n            if (started) return;\n            buf = Buffer.concat([buf, d]);\n            var end = buf.indexOf('\\r\\n\\r\\n');\n            if (end < 0) {\n                if (buf.length > HEAD_MAX) { started = true; replyErrorAndClose(c, 'HTTP/1.1 400 Bad Request'); }\n                return;                                    // the rest of the request has not arrived yet\n            }\n            started = true;\n            c.removeListener('data', onData);\n            c.pause();\n            var rest = buf.slice(end + 4);\n            var head = buf.slice(0, end).toString('binary');\n            connect(c, head.split('\\r\\n')[0], rest, head);\n        }, function () { drop(c); }));\n    }\n\n    // The YouTube app also sends plain requests to the TV's own web server through the proxy (it posts the cast data to\n    // http://localhost:8080/ws/apps/YouTube/dial_data, which the phone reads to match the cast target with the app).\n    // Only that server is reachable this way: loopback, port 8080, one request per connection. Anything else is refused.\n    var LOCAL_PORT = opts.localPort || 8080;           // opts.localPort is for tests only\n    function relayLocal(c, head, rest) {\n        var lines = head.split('\\r\\n');\n        var m = /^([A-Z]{3,7}) http:\\/\\/(?:localhost|127\\.0\\.0\\.1):(\\d{1,5})(\\/[^ ]*) HTTP\\/1\\.[01]$/.exec(lines[0]);\n        if (!m || parseInt(m[2], 10) !== LOCAL_PORT) return false;\n        var kept = lines.slice(1).filter(function (l) { return !/^(proxy-)?connection:/i.test(l); });\n        var out = [m[1] + ' ' + m[3] + ' HTTP/1.1'].concat(kept, ['Connection: close', '', '']).join('\\r\\n');\n        relayed++;\n        if (relayed === 1) opts.log('relaying the app\\u2019s requests to the TV\\u2019s web server (port ' + LOCAL_PORT + ')');\n        var established = false;\n        var up = net.connect(LOCAL_PORT, '127.0.0.1');\n        track(up, false, true);\n        function cleanup() {\n            try { c.unpipe(up); } catch (e) { /* closed */ }\n            try { up.unpipe(c); } catch (e) { /* closed */ }\n            drop(up);\n            drop(c);\n        }\n        function failRelay() {\n            if (established) { cleanup(); return; }\n            established = true;\n            drop(up);\n            replyErrorAndClose(c, 'HTTP/1.1 502 Bad Gateway');\n        }\n        up.setTimeout(CONNECT_MS, guard(function () {\n            if (!established) failRelay();\n            else cleanup();\n        }, cleanup));\n        up.on('connect', guard(function () {\n            if (established) { drop(up); return; }\n            established = true;\n            up.setTimeout(IDLE_MS);\n            up.write(out, 'binary');\n            if (rest.length) up.write(rest);\n            c.pipe(up); up.pipe(c);\n            c.resume();\n        }, cleanup));\n        up.on('error', failRelay);\n        c.on('error', cleanup);\n        c.on('close', function () { established = true; cleanup(); });\n        up.on('close', function () {\n            if (!established) { failRelay(); return; }\n            try { c.end(); } catch (e) { drop(c); }\n        });\n        return true;\n    }\n\n    function connect(c, line, rest, head) {\n        var m = /^CONNECT (?:\\[([0-9a-fA-F:]+)\\]|([^ :\\[\\]]+)):(\\d{1,5}) HTTP\\/1\\.[01]$/.exec(line);\n        if (!m && head && relayLocal(c, head, rest)) return;\n        if (!m) { if (!loggedOdd) { loggedOdd = true; opts.log('not a CONNECT request: ' + line.slice(0, 60)); } replyErrorAndClose(c, 'HTTP/1.1 502 Bad Gateway'); return; }\n        if (m[1] && net.isIP(m[1]) !== 6) { replyErrorAndClose(c, 'HTTP/1.1 400 Bad Request'); return; }\n        var host = (m[1] || m[2]).toLowerCase(), port = parseInt(m[3], 10);\n        if (port < 1 || port > 65535) { replyErrorAndClose(c, 'HTTP/1.1 400 Bad Request'); return; }\n        if (port === 443 && inject.MITM_HOSTS[host] && opts.script() && (!rest.length || canWrapDuplex)) {\n            var t = ensureTls();\n            if (t) {\n                opened++;\n                c.write('HTTP/1.1 200 Connection Established\\r\\n\\r\\n');\n                if (rest.length) {\n                    t.emit('connection', prependSocket(c, rest));\n                } else {\n                    t.emit('connection', c);\n                }\n                c.resume();\n                return;\n            }\n        }\n        tunnels++;\n        var established = false, failed = false;\n        var connectOpts = { host: host, port: port };\n        if (HAS_AUTO_FAMILY) connectOpts.autoSelectFamily = true;\n        var up = net.connect(connectOpts);\n        track(up, false, true);\n        function cleanup() {\n            try { c.unpipe(up); } catch (e) { /* closed */ }\n            try { up.unpipe(c); } catch (e) { /* closed */ }\n            drop(up);\n            drop(c);\n        }\n        function failConnect() {\n            if (established) { cleanup(); return; }\n            if (failed) return;\n            failed = true;\n            established = true;\n            drop(up);\n            replyErrorAndClose(c, 'HTTP/1.1 502 Bad Gateway');\n        }\n        up.setTimeout(CONNECT_MS, guard(function () {\n            if (!established) failConnect();\n            else cleanup();\n        }, cleanup));\n        up.on('connect', guard(function () {\n            if (established) { drop(up); return; }\n            established = true;\n            up.setTimeout(IDLE_MS);\n            c.write('HTTP/1.1 200 Connection Established\\r\\n\\r\\n');\n            if (rest.length) up.write(rest);\n            c.pipe(up); up.pipe(c);\n            c.resume();\n        }, cleanup));\n        up.on('error', failConnect);\n        c.on('error', cleanup);\n        c.on('close', function () { established = true; cleanup(); });\n        up.on('close', function () { if (failed) return; if (established) cleanup(); else failConnect(); });\n    }\n\n    return {\n        listen: function (cb) {\n            if (server) { if (ready) cb(null); else waiters.push(cb); return; }\n            var s = net.createServer(guard(onConnection)), done = false;\n            server = s; ready = false;\n            s.on('error', function (e) { if (!done) { done = true; cb(e); waiters.splice(0).forEach(function (w) { w(e); }); } else opts.log('proxy error: ' + e.message); if (server === s) { server = null; ready = false; } });\n            s.on('close', function () { if (server === s) { server = null; ready = false; } });\n            s.listen(opts.port, opts.host, function () { if (!done && server === s) { done = true; ready = true; cb(null); waiters.splice(0).forEach(function (w) { w(null); }); } else if (!done) { done = true; try { s.close(); } catch (e) { /* closed */ } var err = new Error('closed while starting'); cb(err); waiters.splice(0).forEach(function (w) { w(err); }); } });\n        },\n        // Stops listening. Connections that are already open are left to finish on their own (a YouTube that is running keeps\n        // working), unless `hard` is set: then they are cut as well.\n        close: function (hard) {\n            var s = server;\n            server = null; ready = false;\n            if (s) { try { s.close(); } catch (e) { /* closed */ } }\n            tlsServer = null; httpServer = null; leafCert = null;\n            if (hard) Object.keys(socks).forEach(function (id) { drop(socks[id]); });\n        },\n        listening: function () { return !!server && ready; },\n        stats: function () { return { tunnels: tunnels, relayed: relayed, opened: opened, live: live, refused: refused, accepted: accepted, foreign: foreign }; }\n    };\n}\n\nmodule.exports = { createProxy: createProxy, MAX_CONNECTIONS: MAX_CONNECTIONS };\n","setup.js":"'use strict';\n// Shell pieces run as root through ctx.execute: the certificate setup, starting and closing the YouTube app, and cleanup.\n// Everything the plugin keeps outside its own folder is under DIR.\n\nvar DIR = '/opt/usr/home/owner/share/vetro-youtube';\nvar CACHE = DIR + '/cache';\n// The copy of the YouTube app's content folder. Its path is kept very short on purpose: Samsung's own tile passes the app at most\n// 127 characters of flags, and Samsung's flags already take about 50 of them.\nvar CONTENT = '/opt/usr/home/owner/share/vyt';\nvar COBALT = '/usr/apps/com.samsung.tv.cobalt/content/app/cobalt';\nvar APP = 'com.samsung.tv.cobalt-yt';       // Samsung's YouTube\nvar USER = 5001;\n\nfunction toBase64(text) { return (Buffer.from && Buffer.from !== Uint8Array.from ? Buffer.from(text) : new Buffer(text)).toString('base64'); }\nfunction wrap(script) { return 'echo ' + toBase64(script) + ' | base64 -d | sh'; }\n\n// Makes (once, and again when something expires or Samsung's YouTube changed) three things in DIR:\n//  - a certificate authority of its own (ca.key stays root-only) and a certificate for youtube.com signed by it (leaf.*);\n//  - CONTENT, a copy of the YouTube app's content folder with that authority added to its trust store. The app is started with\n//    --content pointing here, so the authority is trusted by that app alone, never by the TV.\n// Prints one word: ready | nocobalt.\nfunction setupScript() {\n    return [\n        'set -e',\n        'umask 022',\n        \"D='\" + DIR + \"'\",\n        \"C='\" + CONTENT + \"'\",\n        \"SRC='\" + COBALT + \"/content'\",\n        \"LIB='\" + COBALT + \"/lib/libcobalt.so'\",\n        '[ -d \"$SRC/ssl/certs\" ] || { echo nocobalt; exit 0; }',\n        // DIR belongs to root: the user the TV apps run as cannot swap a file for a link that a root command below would follow.\n        // Only cache/ is theirs (the downloaded script, verified by hash on every read).\n        '[ -L \"$D\" ] && rm -f \"$D\"; mkdir -p \"$D\"; chown root:root \"$D\"; chmod 755 \"$D\"; cd \"$D\"',\n        'for f in ca.key ca.crt ca.key.tmp ca.crt.tmp ca.cnf ca.srl leaf.key leaf.crt leaf.key.tmp leaf.crt.tmp leaf.csr leaf.ext content.stamp content.stamp.tmp cache \"$C\" \"$C.tmp\" \"$C.old\"; do [ -L \"$f\" ] && rm -f \"$f\"; done',\n        'if [ -f ca.key ] && [ ! -O ca.key ]; then rm -rf ca.key ca.crt leaf.key leaf.crt leaf.csr ca.srl \"$C\" content.stamp; fi',\n        'rm -rf content',                                     // where the copy used to be (before the path had to be short)\n        '[ -d cache ] || mkdir cache; chown owner:users cache; chmod 755 cache',\n        'if [ ! -f ca.key ] || [ ! -f ca.crt ] || ! openssl x509 -in ca.crt -noout -checkend 2592000 >/dev/null 2>&1; then',\n        '  rm -rf ca.key.tmp ca.crt.tmp leaf.csr ca.srl',\n        \"  printf '%s\\\\n' '[req]' 'distinguished_name=dn' 'x509_extensions=v3' 'prompt=no' '[dn]' 'CN=Vetro YouTube Local CA' '[v3]' 'basicConstraints=critical,CA:TRUE' 'keyUsage=critical,keyCertSign,cRLSign' 'subjectKeyIdentifier=hash' > ca.cnf\",\n        '  openssl req -x509 -newkey rsa:2048 -nodes -keyout ca.key.tmp -out ca.crt.tmp -days 3650 -sha256 -config ca.cnf >/dev/null 2>&1',\n        '  chown root:root ca.key.tmp; chown owner:users ca.crt.tmp; chmod 600 ca.key.tmp; chmod 644 ca.crt.tmp',\n        '  mv ca.key.tmp ca.key; mv ca.crt.tmp ca.crt',\n        'fi',\n        'STAMP=\"v3-$(stat -c %Y \"$LIB\" 2>/dev/null)-$(openssl x509 -in ca.crt -noout -fingerprint -sha256)\"',\n        'if [ ! -d \"$C\" ] || [ ! -O \"$C\" ] || [ \"$(cat content.stamp 2>/dev/null)\" != \"$STAMP\" ]; then',\n        '  rm -rf \"$C.tmp\" \"$C.old\"; cp -R \"$SRC\" \"$C.tmp\"',\n        '  cp ca.crt \"$C.tmp/ssl/certs/$(openssl x509 -in ca.crt -noout -subject_hash).0\"',\n        '  cp ca.crt \"$C.tmp/ssl/certs/$(openssl x509 -in ca.crt -noout -subject_hash_old).0\"',\n        '  if [ -e \"$C\" ]; then mv \"$C\" \"$C.old\"; fi',\n        '  mv \"$C.tmp\" \"$C\"; rm -rf \"$C.old\"',\n        '  echo \"$STAMP\" > content.stamp.tmp && mv content.stamp.tmp content.stamp',\n        'fi',\n        'if [ ! -f leaf.crt ] || [ ! -f leaf.key ] || ! openssl x509 -in leaf.crt -noout -checkend 2592000 >/dev/null 2>&1 || ! openssl verify -CAfile ca.crt leaf.crt >/dev/null 2>&1; then',\n        '  rm -f leaf.key.tmp leaf.crt.tmp leaf.csr',\n        '  openssl req -new -newkey rsa:2048 -nodes -keyout leaf.key.tmp -subj /CN=www.youtube.com -out leaf.csr >/dev/null 2>&1',\n        \"  printf '%s\\\\n' 'subjectAltName=DNS:www.youtube.com,DNS:youtube.com' 'basicConstraints=CA:FALSE' 'keyUsage=digitalSignature,keyEncipherment' 'extendedKeyUsage=serverAuth' > leaf.ext\",\n        '  openssl x509 -req -in leaf.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out leaf.crt.tmp -days 397 -sha256 -extfile leaf.ext >/dev/null 2>&1',\n        '  chown owner:users leaf.key.tmp leaf.crt.tmp; chmod 600 leaf.key.tmp; chmod 644 leaf.crt.tmp',\n        '  mv leaf.key.tmp leaf.key; mv leaf.crt.tmp leaf.crt',\n        'fi',\n        'chown root:root ca.key; chown owner:users leaf.key leaf.crt ca.crt; chmod 600 ca.key leaf.key; chmod 644 ca.crt leaf.crt',\n        'echo ready'\n    ].join('\\n');\n}\n\n// What Samsung's own tile passes to the YouTube app (metadata native.userdata of 9Ur5IzDKqV.TizenYouTube), plus the proxy and\n// the content folder. The proxy list ends in direct://: if the proxy is down the app connects directly (unpatched) instead of\n// showing a network error. The value of USERDATA starts with a space on purpose: without it app_launcher reads the value as one\n// of its own options.\nvar SAMSUNG_ARGS = '--base_url=https://www.youtube.com/tv --dial_name=YouTube --use_eden --start_frag=#start';\n\n// No http:// in front of the proxy address (it is the default) and a short content path: see CONTENT.\nfunction proxyArgs(proxyHost, proxyPort) { return '--proxy=' + proxyHost + ':' + proxyPort + ',direct:// --content=' + CONTENT; }\n\nfunction launchScript(proxyHost, proxyPort, opts) {\n    opts = opts || {};\n    var lastPageUnix = typeof opts.lastPageUnix === 'number' && opts.lastPageUnix > 0 ? Math.floor(opts.lastPageUnix) : 0;\n    var forceRestart = !!opts.forceRestart || lastPageUnix <= 0;\n    var args = ' ' + SAMSUNG_ARGS + ' ' + proxyArgs(proxyHost, proxyPort);\n    var targetProxy = proxyHost + ':' + proxyPort;\n    var appPattern = '(^|[ =])[' + APP.charAt(0) + ']' + APP.slice(1).replace(/\\./g, '\\\\.') + '($| )';\n    return [\n        \"P='\" + targetProxy + \"'\",\n        'LP=' + lastPageUnix,\n        'FR=' + (forceRestart ? 1 : 0),\n        'has_fresh_page() {',\n        '  PT=$(stat -c %Y \"$1\" 2>/dev/null || echo 0)',\n        '  case \"$PT\" in \\'\\'|*[!0-9]*) PT=0;; esac',\n        '  [ \"$LP\" -gt 0 ] && [ \"$PT\" -gt 0 ] && [ \"$PT\" -le \"$LP\" ]',\n        '}',\n        'yt_unpatched() {',\n        '  for f in $(grep -al \"[c]obalt\" /proc/[0-9]*/cmdline 2>/dev/null); do',\n        '    p=${f%/cmdline}',\n        '    [ \"$p\" = \"/proc/$$\" ] && continue',\n        '    [ -r \"$f\" ] || continue',\n        '    if [ -r \"$p/comm\" ]; then',\n        '      IFS= read -r COMM < \"$p/comm\" 2>/dev/null || COMM=\"\"',\n        '      case \"$COMM\" in sh|ash|dash|bash|busybox|grep|awk|tr|sed|cat|base64|node|dotnet) continue;; esac',\n        '    fi',\n        '    ARGS=$(tr \"\\\\0\" \"\\\\n\" < \"$f\" 2>/dev/null)',\n        '    case \"$ARGS\" in /bin/sh*|sh*|*/sh*|*/ash*|*/dash*|*/bash*) continue;; esac',\n        '    case \"$ARGS\" in /usr/apps/com.samsung.tv.cobalt/bin/cobalt_launcher*)',\n        '      U=$(printf \"%s\\\\n\" \"$ARGS\" | awk \\'prev==\"USERDATA\"{u=$0} {if(NR==4) a4=$0; prev=$0} END{if(u!=\"\") print u; else if(a4!=\"\") print a4}\\')',\n        '      A=$(printf \"%s\\\\n\" \"$ARGS\" | awk \\'prev==\"__AUL_APPID__\"{print; exit} {prev=$0}\\')',\n        '      D=$(printf \"%s\" \"$U\" | base64 -d 2>/dev/null | tr -c \"[:print:]\" \" \")',\n        '      ID=$(printf \"%s\" \"$A\" | base64 -d 2>/dev/null | tr -c \"[:print:]\" \" \")',\n        '      ISYT=0',\n        '      case \" $D \" in *\"dial_name=YouTube \"*) ISYT=1;; esac',\n        '      case \" $ID \" in *\" ' + APP + ' \"*) ISYT=1;; esac',\n        '      if [ \"$ISYT\" = \"1\" ]; then',\n        '        if [ \"$FR\" = \"1\" ]; then return 0; fi',\n        '        case \"$D\" in *\"$P\"*) case \"$D\" in *share/vyt*) has_fresh_page \"$p\" || return 0;; *) return 0;; esac;; *) return 0;; esac',\n        \"      elif printf '%s\\\\n' \\\"$ARGS\\\" | grep -Eq '\" + appPattern + \"'; then\",\n        '        if [ \"$FR\" = \"1\" ]; then return 0; fi',\n        '        case \"$ARGS\" in *\"$P\"*) case \"$ARGS\" in *share/vyt*) has_fresh_page \"$p\" || return 0;; *) return 0;; esac;; *) return 0;; esac',\n        '      fi',\n        '      ;;',\n        '    *)',\n        \"      if printf '%s\\\\n' \\\"$ARGS\\\" | grep -Eq '\" + appPattern + \"'; then\",\n        '        if [ \"$FR\" = \"1\" ]; then return 0; fi',\n        '        case \"$ARGS\" in *\"$P\"*) case \"$ARGS\" in *share/vyt*) has_fresh_page \"$p\" || return 0;; *) return 0;; esac;; *) return 0;; esac',\n        '      fi',\n        '      ;;',\n        '    esac',\n        '  done',\n        '  return 1',\n        '}',\n        'yt_wait() { if command -v usleep >/dev/null 2>&1; then usleep 200000; else sleep 0.2 2>/dev/null || sleep 1; fi; }',\n        'if yt_unpatched; then',\n        '  app_launcher -t ' + APP + ' -u ' + USER + ' >/dev/null 2>&1',\n        '  i=0; while [ $i -lt 15 ] && yt_unpatched; do yt_wait; i=$((i + 1)); done',\n        '  if yt_unpatched; then',\n        '    app_launcher -k ' + APP + ' -u ' + USER + ' >/dev/null 2>&1',\n        '    i=0; while [ $i -lt 5 ] && yt_unpatched; do yt_wait; i=$((i + 1)); done',\n        '  fi',\n        'fi',\n        'app_launcher -s ' + APP + ' -u ' + USER + \" USERDATA '\" + args + \"' 2>&1\"\n    ].join('\\n');\n}\n\n// Prints \"relaunch\" when Samsung's YouTube is running in the foreground without our proxy flags (started by the remote key or\n// a voice command while the TV's own entry for it is missing or not patched yet, which is the case after every boot), \"ok\" when\n// it is running patched, \"bg\" when an unpatched background-preloaded or crash-respawned Cobalt is present while watching TV or\n// another app in the foreground (so watch() never relaunches YouTube over TV or another app), and nothing when not running.\n// Scans all NUL-separated cmdline tokens for USERDATA (falling back to token #4 on older Tizen) and __AUL_APPID__.\nfunction checkScript() {\n    return [\n        'R=',\n        'FULL=$(vconftool get memory/appfw/current_fullscreen_appid 2>/dev/null | sed -n \"s/.*value = \\\\([^ ]*\\\\).*/\\\\1/p\")',\n        'for p in $(pgrep -f \"^/usr/apps/com.samsung.tv.cobalt/bin/cobalt_launcher\"); do',\n        '  [ -r \"/proc/$p/cmdline\" ] || continue',\n        '  ARGS=$(tr \"\\\\0\" \"\\\\n\" < \"/proc/$p/cmdline\" 2>/dev/null)',\n        '  U=$(printf \"%s\\\\n\" \"$ARGS\" | awk \\'prev==\"USERDATA\"{u=$0} {if(NR==4) a4=$0; prev=$0} END{if(u!=\"\") print u; else if(a4!=\"\") print a4}\\')',\n        '  A=$(printf \"%s\\\\n\" \"$ARGS\" | awk \\'prev==\"__AUL_APPID__\"{print; exit} {prev=$0}\\')',\n        '  D=$(printf \"%s\" \"$U\" | base64 -d 2>/dev/null | tr -c \"[:print:]\" \" \")',\n        '  ID=$(printf \"%s\" \"$A\" | base64 -d 2>/dev/null | tr -c \"[:print:]\" \" \")',\n        '  ISYT=0',\n        '  case \" $D \" in *\"dial_name=YouTube \"*) ISYT=1;; esac',\n        '  case \" $ID \" in *\" ' + APP + ' \"*) ISYT=1;; esac',\n        '  if [ \"$ISYT\" = \"1\" ]; then',\n        '    case \"$D\" in',\n        '      *share/vyt*) R=ok;;',\n        '      *)',\n        '        case \"$FULL\" in',\n        '          \"\"|' + APP + '|9Ur5IzDKqV.TizenYouTube) R=relaunch; break;;',\n        '          *) [ \"$R\" = \"ok\" ] || R=bg;;',\n        '        esac',\n        '        ;;',\n        '    esac',\n        '  fi',\n        'done',\n        'echo $R'\n    ].join('\\n');\n}\n\nfunction closeScript() { return 'app_launcher -t ' + APP + ' -u ' + USER + ' 2>&1'; }\n\n// Everything this plugin put on the TV outside its own folder.\nfunction cleanupScript() { return closeScript() + '; rm -rf \"' + DIR + '\" \"' + CONTENT + '\" \"' + CONTENT + '.tmp\" \"' + CONTENT + '.old\"; echo removed'; }\n\nmodule.exports = { DIR: DIR, CACHE: CACHE, CONTENT: CONTENT, APP: APP, SAMSUNG_ARGS: SAMSUNG_ARGS, proxyArgs: proxyArgs, wrap: wrap, setupScript: setupScript, launchScript: launchScript, checkScript: checkScript, closeScript: closeScript, cleanupScript: cleanupScript };\n","tile.js":"'use strict';\n// Makes Samsung's YouTube button (Home tile, remote key, voice, casting) open the patched app.\n//\n// All of them start the wrapper app 9Ur5IzDKqV.TizenYouTube, which starts the YouTube app with the flags kept in one row of the\n// web app service's database (/opt/dbspace/.webappservice.db, table widgetinfo, column reserved_string_6; the same text is also\n// in the app's config.xml and in the package database, but neither is read when the app starts - checked on a Q80A, fw 2310.0).\n// This module appends the proxy and content flags to that column and takes them off again. The change is a suffix, so undoing it needs no saved copy: it cuts the suffix off.\n//\n// Safety rules, in order of importance:\n//  - The proxy list ends in direct://: with the proxy down YouTube still opens, just unpatched.\n//  - A write is a compare-and-swap (it only happens if the row still holds the value that was read), so a change made by\n//    Samsung or by someone else in between is never overwritten.\n//  - Only that one row of that one app is touched, and only when it holds a plain printable value without quotes.\n//  - Whoever calls apply() decides when the row may be patched (proxy listening, certificate and script ready); this module\n//    only knows how.\n\nvar setup = require('./setup.js');\n\nvar DB = '/opt/dbspace/.webappservice.db';\nvar WRAPPER = '9Ur5IzDKqV.TizenYouTube';      // the row's tizen_id\nvar COLUMN = 'reserved_string_6';\nvar ORIGINAL_START = '--base_url=https://www.youtube.com/tv';      // what Samsung's value starts with: anything else is not ours to edit\n// The most characters the TV passes on to the YouTube app from this value (checked on a Q80A: it cuts at 127, silently, so a longer\n// value loses its last flags and the app starts without --content, and without trusting the plugin's certificate).\nvar MAX_VALUE = 127;\n\n// Samsung's own value already has ORIGINAL_START, which is also what the app does without it (its default address), so there is no\n// room for both that and our flags. Patching takes ORIGINAL_START out and appends ours; un-patching takes ours out and puts\n// ORIGINAL_START back in front. Nothing is saved: the one string that is removed is a constant.\n\n// Our two flags wherever they sit in the value (a firmware that appends its own flag after them must not hide them).\nvar OURS = '--content=' + setup.CONTENT;\nvar SUFFIX_RE = new RegExp(' --proxy=[0-9.]+:\\\\d{1,5},direct:// --content=' + setup.CONTENT.replace(/[^A-Za-z0-9_]/g, '\\\\$&') + '(?= |$)', 'g');\n\n// Printable ASCII only, and none of the characters a shell or SQL string could be broken with.\nfunction plain(v) { return typeof v === 'string' && v.length > 0 && v.length < 600 && /^[\\x20-\\x7e]+$/.test(v) && !/['\"\\\\$`]/.test(v); }\n\nfunction isPatched(value) { SUFFIX_RE.lastIndex = 0; return SUFFIX_RE.test(String(value)); }\n\n// Does the text still carry our flags (even in a form this module will not edit)?\nfunction hasOurs(value) { return String(value).indexOf(OURS) >= 0; }\n\n// The value without our flags and with ORIGINAL_START back in front (a value that is not patched comes back unchanged).\nfunction original(value) {\n    var v = String(value);\n    if (!isPatched(v)) return v;\n    v = v.replace(SUFFIX_RE, '').replace(/^ +/, '');\n    return v.indexOf(ORIGINAL_START) === 0 ? v : ORIGINAL_START + (v ? ' ' + v : '');\n}\n\n// The value that starts the app through the proxy: Samsung's flags without ORIGINAL_START, then ours (an older suffix is\n// replaced, never doubled). Returns null when it would not fit.\nfunction patched(value, proxyHost, proxyPort) {\n    var rest = original(value);\n    if (rest.indexOf(ORIGINAL_START) === 0) rest = rest.slice(ORIGINAL_START.length).replace(/^ +/, '');\n    var out = (rest ? rest + ' ' : '') + setup.proxyArgs(proxyHost, proxyPort);\n    return out.length <= MAX_VALUE ? out : null;\n}\n\nvar WHERE = \"tizen_id='\" + WRAPPER + \"'\";\n\n// Prints the value, or nothing; one line per row (more than one row is reported by the caller as unexpected).\nfunction readScript(db) {\n    var d = db || DB;\n    return '[ -f \"' + d + '\" ] || { echo \"Error: no package database\"; exit 0; }\\n' +\n        'sqlite3 -cmd \".timeout 8000\" \"' + d + '\" \"select ' + COLUMN + ' from widgetinfo where ' + WHERE + ';\" 2>&1';\n}\n\n// Compare-and-swap. Prints swapped | changed (the row no longer held `from`) | failed.\nfunction swapScript(from, to, db) {\n    if (!plain(from) || !plain(to)) throw new Error('refusing to write a value that is not plain printable text');\n    var d = db || DB;\n    return [\n        'DB=\"' + d + '\"',\n        '[ -f \"$DB\" ] || { echo failed; exit 0; }',\n        'OWN=$(stat -c %u:%g \"$DB\" 2>/dev/null)',\n        'N=$(sqlite3 -cmd \".timeout 8000\" \"$DB\" \"update widgetinfo set ' + COLUMN + \"='\" + to + \"' where \" + WHERE + ' and ' + COLUMN + \"='\" + from + \"'; select changes();\\\" 2>/dev/null) || { echo failed; exit 0; }\",\n        'if [ \"$N\" = \"1\" ]; then',\n        '  [ -n \"$OWN\" ] && chown \"$OWN\" \"$DB\" \"$DB-journal\" 2>/dev/null; echo swapped',\n        'else echo changed; fi'\n    ].join('\\n');\n}\n\n// state: 'original' | 'patched' | 'absent' (no such row: another firmware) | 'foreign' (a value this module will not edit, without our flags)\n// | 'stuck' (our flags are in a value this module will not edit) | 'error'\nfunction classify(output) {\n    var text = String(output || '').replace(/\\r/g, '');\n    var lines = text.split('\\n').filter(function (l) { return l.length; });\n    if (!lines.length) return { state: 'absent', value: null };\n    if (lines.length > 1 || /^(Error|sqlite3:|Parse error)/i.test(lines[0]) || /database is locked/i.test(text)) return { state: 'error', value: null, detail: lines[0].slice(0, 120) };\n    var v = lines[0];\n    if (!plain(v)) return hasOurs(v) ? { state: 'stuck', value: null } : { state: 'foreign', value: null };\n    if (isPatched(v)) return { state: 'patched', value: v, valid: v.indexOf(ORIGINAL_START) === 0 || v.indexOf('--base_url=') < 0 };\n    if (hasOurs(v)) return { state: 'stuck', value: null };\n    return v.indexOf(ORIGINAL_START) === 0 ? { state: 'original', value: v } : { state: 'foreign', value: null };\n}\n\n// execute(shellText, timeoutMs) -> Promise<{stdout}>, already wrapped for the TV by the caller.\nfunction read(execute, db) {\n    return execute(readScript(db), 15000).then(function (r) { return classify(r && r.stdout); });\n}\n\nfunction swap(execute, from, to, db) {\n    return execute(swapScript(from, to, db), 20000).then(function (r) {\n        var out = String((r && r.stdout) || '');\n        return /^swapped$/m.test(out) ? 'swapped' : /^changed$/m.test(out) ? 'changed' : 'failed';\n    });\n}\n\n// Makes the row hold the patched value for this proxy. Resolves to the state afterwards: 'patched' | 'absent' | 'foreign' | 'toolong'\n// (the flags with this address do not fit in what the TV passes on) | 'stuck' | 'error' | 'raced'.\nfunction apply(execute, proxyHost, proxyPort, db) {\n    return read(execute, db).then(function (cur) {\n        if (cur.state !== 'original' && cur.state !== 'patched') return cur.state;\n        if (cur.valid === false) return 'foreign';\n        var want = patched(cur.value, proxyHost, proxyPort);\n        if (want === null) return 'toolong';                        // would not fit in what the TV passes on\n        if (want === cur.value) return 'patched';\n        return swap(execute, cur.value, want, db).then(function (r) { return r === 'swapped' ? 'patched' : r === 'changed' ? 'raced' : 'error'; });\n    });\n}\n\n// Takes the suffix off. Resolves to 'original' | 'absent' | 'foreign' | 'stuck' | 'error' | 'raced'. Only 'original', 'absent' and 'foreign' mean no flag of ours is left.\nfunction restore(execute, db) {\n    return read(execute, db).then(function (cur) {\n        if (cur.state === 'original') return 'original';\n        if (cur.state !== 'patched') return cur.state;\n        return swap(execute, cur.value, original(cur.value), db).then(function (r) { return r === 'swapped' ? 'original' : r === 'changed' ? 'raced' : 'error'; });\n    });\n}\n\nmodule.exports = { MAX_VALUE: MAX_VALUE, hasOurs: hasOurs, DB: DB, WRAPPER: WRAPPER, COLUMN: COLUMN, plain: plain, isPatched: isPatched, original: original, patched: patched,\n    readScript: readScript, swapScript: swapScript, classify: classify, read: read, apply: apply, restore: restore };\n","tls-client.js":"'use strict';\n// A small HTTPS client for the proxy. Node 12.4 on the TV cannot raise its HTTP header limit (the option arrived in\n// 12.17), and YouTube's response headers are bigger than the default 8 KB, so http.request fails with\n// HPE_HEADER_OVERFLOW. This one reads the response head by hand. Plain ES5.\n\nvar net = require('net');\nvar tls = require('tls');\nvar PassThrough = require('stream').PassThrough;\n\nvar HAS_AUTO_FAMILY = typeof net.setDefaultAutoSelectFamily === 'function';\nvar CHUNK_SIZE_RE = /^[0-9a-fA-F]{1,16}[ \\t]*(?:;[^\\r\\n]*)?$/;\nvar NO_CACHE_HEADERS = { 'if-none-match': 1, 'if-modified-since': 1, 'if-match': 1, 'if-unmodified-since': 1, 'range': 1 };\nvar RETRYABLE_CODES = {\n    ECONNRESET: 1, ECONNREFUSED: 1, EPIPE: 1, ETIMEDOUT: 1,\n    EHOSTUNREACH: 1, ENETUNREACH: 1, EAI_AGAIN: 1, ENOTFOUND: 1, ERR_SOCKET_CLOSED: 1\n};\n\nfunction bytes(n) { return Buffer.alloc ? Buffer.alloc(n) : new Buffer(n); }\n\n// Turns a chunked body into plain bytes written to `out`. Feed it with write(buffer).\nfunction Dechunk(out) {\n    var buf = bytes(0), state = 'size', left = 0;\n    this.complete = function () { return state === 'done'; };\n    this.write = function (d) {\n        buf = Buffer.concat([buf, d]);\n        for (;;) {\n            if (state === 'size') {\n                var i = buf.indexOf('\\r\\n');\n                if (i < 0) {\n                    if (buf.length > 1024) { state = 'bad'; if (out.abort) out.abort(new Error('chunk header too long')); }\n                    return;\n                }\n                var line = buf.slice(0, i).toString('binary');\n                buf = buf.slice(i + 2);\n                if (!CHUNK_SIZE_RE.test(line)) { state = 'bad'; if (out.abort) out.abort(new Error('bad chunk size')); return; }\n                left = parseInt(line.split(';')[0], 16);\n                if (left !== left || left < 0) { state = 'bad'; if (out.abort) out.abort(new Error('bad chunk size')); return; }\n                if (left === 0) { state = 'done'; if (!out.destroyed && out.writable) out.end(); return; }\n                state = 'data';\n            } else if (state === 'data') {\n                if (!buf.length) return;\n                var n = Math.min(left, buf.length);\n                if (!out.destroyed && out.writable) out.write(buf.slice(0, n));\n                buf = buf.slice(n);\n                left -= n;\n                if (left === 0) state = 'crlf';\n            } else if (state === 'crlf') {\n                if (buf.length < 2) return;\n                if (buf[0] !== 13 || buf[1] !== 10) { state = 'bad'; if (out.abort) out.abort(new Error('bad chunk delimiter')); return; }\n                buf = buf.slice(2);\n                state = 'size';\n            } else return;\n        }\n    };\n}\n\n// Headers that describe one hop, not the message: never forwarded in either direction.\nvar HOP = { 'connection': 1, 'proxy-connection': 1, 'keep-alive': 1, 'te': 1, 'upgrade': 1, 'transfer-encoding': 1,\n    'content-length': 1, 'proxy-authorization': 1, 'proxy-authenticate': 1, 'trailer': 1 };\n\n// Header names listed in a Connection header describe this hop only.\nfunction nominated(value) {\n    var out = {};\n    String(value || '').split(',').forEach(function (t) { t = t.trim().toLowerCase(); if (t) out[t] = 1; });\n    return out;\n}\n\n// \"HTTP/1.1 200 OK\\r\\nA: b\" -> {status, headers, chunked, length}. Header names are lower case, repeated ones become arrays.\n// A chunked body is reported with chunked:true and without its transfer-encoding and content-length headers. `length` is the\n// declared body length, or -1 when there is none to rely on.\nfunction parseHead(text) {\n    var lines = text.split('\\r\\n'), m = /^HTTP\\/1\\.[01] (\\d{3})/.exec(lines[0]);\n    var out = { status: m ? parseInt(m[1], 10) : 0, headers: {}, chunked: false, length: -1 }, hop = {};\n    for (var i = 1; i < lines.length; i++) {\n        var j = lines[i].indexOf(':');\n        if (j < 1) continue;\n        var k = lines[i].slice(0, j).toLowerCase(), v = lines[i].slice(j + 1).replace(/^\\s+/, '').replace(/\\s+$/, '');\n        if (k === 'transfer-encoding') { if (/chunked/i.test(v)) out.chunked = true; continue; }\n        if (k === 'connection') { var n = nominated(v); Object.keys(n).forEach(function (t) { hop[t] = 1; }); continue; }\n        if (k === 'keep-alive' || k === 'proxy-connection') continue;\n        if (out.headers[k] === undefined) out.headers[k] = v;\n        else if (Array.isArray(out.headers[k])) out.headers[k].push(v);\n        else out.headers[k] = [out.headers[k], v];\n    }\n    Object.keys(hop).forEach(function (t) { delete out.headers[t]; });\n    var cl = out.headers['content-length'];\n    if (cl !== undefined) {\n        var vals = Array.isArray(cl) ? cl : [cl], ok = vals.every(function (x) { return /^\\d{1,15}$/.test(x) && x === vals[0]; });\n        if (ok && !out.chunked) { out.length = parseInt(vals[0], 10); out.headers['content-length'] = vals[0]; }\n        if (out.chunked || !ok) delete out.headers['content-length'];\n    }\n    return out;\n}\n\n// The request head as bytes. `headers` is a Node-style object (lower case names). The body length is always declared.\nfunction buildRequest(opts, bodyLength) {\n    var lines = [opts.method + ' ' + opts.path + ' HTTP/1.1'], hop = {};\n    Object.keys(opts.headers || {}).forEach(function (k) { if (k.toLowerCase() === 'connection') { var v = opts.headers[k]; hop = nominated(Array.isArray(v) ? v.join(',') : v); } });\n    Object.keys(opts.headers || {}).forEach(function (k) {\n        var key = k.toLowerCase();\n        if (HOP[key] || hop[key]) return;\n        if (key === 'accept-encoding' && opts.identity) return;\n        if (opts.noCache && NO_CACHE_HEADERS[key]) return;\n        var v = opts.headers[k];\n        (Array.isArray(v) ? v : [v]).forEach(function (x) {\n            if (/[\\r\\n]/.test(String(x))) return;           // never let a value start a second header\n            lines.push(key + ': ' + x);\n        });\n    });\n    if (opts.identity) lines.push('accept-encoding: identity');\n    if (bodyLength || (opts.method !== 'GET' && opts.method !== 'HEAD')) lines.push('content-length: ' + bodyLength);\n    lines.push('connection: close');\n    return lines.join('\\r\\n') + '\\r\\n\\r\\n';\n}\n\nfunction isRetryableError(err) {\n    if (!err) return false;\n    if (err.code && RETRYABLE_CODES[err.code]) return true;\n    return err.message === 'closed before a response';\n}\n\n// request({host, port, method, path, headers, identity, noCache, timeout, retries}, bodyBuffer, cb)\n// cb(err) once, or cb(null, {status, headers, body}) where body is a readable stream of the decoded payload.\n// The stream ends normally only when the whole body arrived (declared length reached, last chunk seen, or a close for a body\n// with neither); anything shorter ends with an 'error' event, never with a quiet 'end'. A slow reader pauses the socket.\n// Returns {abort()}: closes the connection (used when whoever asked has gone away).\n// Nothing here may throw out of an event handler: this runs inside Vetro's process.\nfunction request(opts, body, cb) {\n    body = body || bytes(0);\n    var timeoutMs = opts.timeout || 30000;\n    var retriesLeft = typeof opts.retries === 'number' ? opts.retries : ((opts.method === 'GET' || opts.method === 'HEAD') ? 1 : 0);\n    var sock = null, retryTimer = null, aborted = false, settled = false, ended = false;\n    var payload = new PassThrough();\n    payload.on('error', function () { /* the reader went away */ });\n\n    var paused = false, blocked = false;\n    payload.on('drain', function () {\n        blocked = false;\n        if (paused) {\n            paused = false;\n            try { if (sock) { sock.setTimeout(timeoutMs); sock.resume(); } } catch (e) { /* closed */ }\n        }\n    });\n\n    function kill() { try { if (sock) sock.destroy(); } catch (x) { /* closed */ } }\n    function complete() { if (ended) return; ended = true; try { payload.end(); } catch (e) { /* closed */ } }\n    function broken(e) {\n        if (ended) return;\n        ended = true;\n        try { payload.emit('error', e); } catch (x) { /* nobody listens */ }\n        try { if (typeof payload.destroy === 'function') payload.destroy(); } catch (y) { /* closed */ }\n    }\n\n    function attempt() {\n        if (aborted || settled) return;\n        var cur = null, head = bytes(0), headDone = false, dech = null;\n        var expect = -1, got = 0, bodyless = false, curFailed = false;\n        paused = false; blocked = false;\n        var sink = {\n            writable: true, destroyed: false,\n            end: function () { complete(); kill(); },\n            abort: function (e) { broken(e); kill(); },\n            write: function (d) { if (!ended && !payload.write(d)) blocked = true; }\n        };\n        function fail(e) {\n            if (curFailed) return;\n            curFailed = true;\n            var err = e instanceof Error ? e : new Error(String(e));\n            if (aborted) { kill(); return; }\n            if (settled) { broken(err); kill(); return; }\n            kill();\n            if (!headDone && retriesLeft > 0 && isRetryableError(err)) {\n                retriesLeft--;\n                retryTimer = setTimeout(function () { retryTimer = null; attempt(); }, 50);\n                if (retryTimer && retryTimer.unref) retryTimer.unref();\n                return;\n            }\n            settled = true;\n            cb(err);\n        }\n        function guard(fn) { return function () { if (sock !== cur) return; try { return fn.apply(this, arguments); } catch (e) { fail(e); } }; }\n        function feed(d) {\n            if (bodyless || ended) return;\n            if (dech) dech.write(d);\n            else if (expect >= 0) {\n                var n = Math.min(d.length, expect - got);\n                if (n > 0) sink.write(n === d.length ? d : d.slice(0, n));\n                got += n;\n                if (got >= expect) { complete(); kill(); return; }\n            } else sink.write(d);\n            if (blocked && !paused && !ended) { paused = true; try { cur.setTimeout(0); cur.pause(); } catch (e) { /* closed */ } }\n        }\n        function closed() {\n            if (!headDone) { fail(new Error('closed before a response')); return; }\n            if (ended) return;\n            if (dech || expect >= 0) broken(new Error('response cut short'));\n            else complete();\n        }\n        var tlsOpts = { host: opts.host, port: opts.port || 443, servername: opts.host };\n        if (HAS_AUTO_FAMILY) tlsOpts.autoSelectFamily = true;\n        try { cur = tls.connect(tlsOpts); sock = cur; }\n        catch (e) { setImmediate(function () { fail(e); }); return; }\n        cur.setTimeout(timeoutMs, guard(function () {\n            if (paused) return;                                  // waiting for the reader, not for the server\n            fail(new Error('timeout talking to ' + opts.host));\n        }));\n        cur.on('error', guard(fail));\n        cur.on('secureConnect', guard(function () {\n            cur.write(buildRequest(opts, body.length));\n            if (body.length) cur.write(body);\n        }));\n        cur.on('data', guard(function (d) {\n            if (headDone) { feed(d); return; }\n            head = Buffer.concat([head, d]);\n            var parsed = null, rest = null;\n            for (;;) {\n                var i = head.indexOf('\\r\\n\\r\\n');\n                if (i < 0) { if (head.length > 4 * 1024 * 1024) fail(new Error('response head too large')); return; }\n                parsed = parseHead(head.slice(0, i).toString('binary'));\n                rest = head.slice(i + 4);\n                if (parsed.status < 100 || parsed.status > 599) { fail(new Error('not an HTTP response')); return; }\n                if (parsed.status === 101) { fail(new Error('unexpected protocol switch')); return; }\n                if (parsed.status < 200) { head = rest; continue; }       // 100 Continue, 103 Early Hints: not the answer yet\n                break;\n            }\n            headDone = true;\n            bodyless = opts.method === 'HEAD' || parsed.status === 204 || parsed.status === 304;\n            if (parsed.chunked) dech = new Dechunk(sink);\n            else expect = parsed.length;\n            settled = true;\n            cb(null, { status: parsed.status, headers: parsed.headers, body: payload });\n            if (bodyless || expect === 0) { complete(); kill(); return; }\n            if (rest.length) feed(rest);\n        }));\n        cur.on('end', guard(closed));\n        cur.on('close', guard(closed));\n    }\n\n    attempt();\n    return {\n        abort: function () {\n            aborted = true;\n            settled = true;\n            if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }\n            kill();\n            broken(new Error('aborted'));\n        }\n    };   // whoever asked has gone: no callback\n}\n\n// GET host/path and collect the body (at most maxBytes). cb(err, buffer, status)\nfunction fetchBuffer(host, path, maxBytes, cb) {\n    var done = false, req = null;\n    function finish(e, parts, status) {\n        if (done) return;\n        done = true;\n        if (e && req) req.abort();\n        if (e) cb(e); else cb(null, Buffer.concat(parts), status);\n    }\n    req = request({ host: host, method: 'GET', path: path, headers: { host: host, 'user-agent': 'vetro-youtube-plugin' }, identity: true }, null, function (err, r) {\n        if (err) return finish(err);\n        var parts = [], size = 0;\n        r.body.on('data', function (c) { size += c.length; if (size > maxBytes) { finish(new Error('response too large')); return; } parts.push(c); });\n        r.body.on('end', function () { finish(null, parts, r.status); });\n        r.body.on('error', finish);\n    });\n}\n\nmodule.exports = { Dechunk: Dechunk, parseHead: parseHead, buildRequest: buildRequest, request: request, fetchBuffer: fetchBuffer, HOP: HOP };\n","userscript.js":"'use strict';\n// The script that is added to YouTube: TizenTube (https://github.com/reisxd/TizenTube, GPL-3.0). It blocks ads, hides Shorts,\n// skips sponsor segments with SponsorBlock's public database (https://sponsor.ajay.app) and can show DeArrow titles.\n//\n// It is NOT part of this plugin. One exact release is downloaded from npm's CDN on first use and used only when its SHA-256\n// matches the value below, so the CDN cannot change what runs inside your YouTube session. A newer release is a new\n// version of this plugin. The file is kept in the plugin’s cache folder, so it is downloaded once.\n\nvar fs = require('fs');\nvar path = require('path');\nvar crypto = require('crypto');\nvar client = require('./tls-client.js');\n\nvar VERSION = '1.15.2';\nvar SHA256 = '7a092351e0e348507ef9c97da8833d5f6717de628517f5299053b3c2073f1d69';\nvar HOST = 'cdn.jsdelivr.net';\nvar URL_PATH = '/npm/@foxreis/tizentube@' + VERSION + '/dist/userScript.js';\nvar MAX_BYTES = 3 * 1024 * 1024;\n\nfunction sha256(buf) { return crypto.createHash('sha256').update(buf).digest('hex'); }\n\nfunction UserScript(dir) {\n    var file = path.join(dir, 'userscript-' + VERSION + '.js'), cached = null, waiters = null;\n\n    // The verified bytes, or null. Checked again on every read from disk.\n    this.load = function () {\n        if (cached) return cached;\n        try {\n            var buf = fs.readFileSync(file);\n            if (sha256(buf) === SHA256) cached = { body: buf, version: VERSION };\n        } catch (e) { /* not downloaded yet */ }\n        return cached;\n    };\n\n    // cb(err, {body, version})\n    this.ensure = function (cb) {\n        var have = this.load();\n        if (have) return cb(null, have);\n        if (waiters) { waiters.push(cb); return; }\n        waiters = [cb];\n        function done(err, val) {\n            var list = waiters || [];\n            waiters = null;\n            list.forEach(function (fn) { fn(err, val); });\n        }\n        client.fetchBuffer(HOST, URL_PATH, MAX_BYTES, function (err, buf, status) {\n            if (err) return done(err);\n            if (status !== 200) return done(new Error('The script download answered HTTP ' + status));\n            if (sha256(buf) !== SHA256) return done(new Error('The downloaded script does not match the expected SHA-256: not used'));\n            var tmp = file + '.' + process.pid + '.' + Date.now() + '.tmp';\n            try {\n                fs.writeFileSync(tmp, buf, { mode: 420 });\n                fs.renameSync(tmp, file);\n            } catch (e) {\n                try { fs.unlinkSync(tmp); } catch (ignored) { /* best effort */ }\n                return done(new Error('Could not save the script: ' + e.message));\n            }\n            cached = { body: buf, version: VERSION };\n            done(null, cached);\n        });\n    };\n    this.forget = function () { cached = null; };\n}\n\nmodule.exports = { UserScript: UserScript, VERSION: VERSION, SHA256: SHA256, HOST: HOST, URL_PATH: URL_PATH, sha256: sha256 };\n","watch.js":"'use strict';\n// Notices, without a root command, when Samsung's YouTube may have been started without our flags. Plain ES5.\n//\n// Vetro's process can list /proc but, on Tizen, usually cannot read the files of another app's processes (no Smack rule from one\n// app to another). So the gate watches for new processes: one it can read is looked at directly (the Cobalt app's command line\n// says whether it carries our flags); one it cannot read is \"something that is not ours started\", and only if it is still there\n// at the next scan (so the root agent's own short-lived commands never count) it asks for one root check. Each process is tried\n// once in its life, which keeps the TV's Smack log to one line per such process. The once-a-minute check in index.js covers\n// anything this misses.\n\nvar fs = require('fs');\n\nvar COBALT_BIN = '/usr/apps/com.samsung.tv.cobalt/bin/cobalt_launcher';\n\nfunction fromBase64(text) { return Buffer.from && Buffer.from !== Uint8Array.from ? Buffer.from(text, 'base64') : new Buffer(text, 'base64'); }\n\nfunction decodeAul(b64) {\n    if (!b64) return '';\n    try { return fromBase64(b64).toString('binary').replace(/[^\\x20-\\x7e]/g, ' '); } catch (e) { return ''; }\n}\n\n// The same decision as setup.checkScript(), from one process's /proc/<pid>/cmdline: 'ok' (YouTube with our flags), 'relaunch'\n// (YouTube without them), or null (not Samsung's YouTube). Scans all NUL-separated AUL tokens for USERDATA (falling back to\n// args[3] on older Tizen) and __AUL_APPID__ (for bare launches without USERDATA).\nfunction classify(cmdline) {\n    var args = String(cmdline || '').split('\\0');\n    if (args[0].indexOf(COBALT_BIN) !== 0) return null;\n    var ud = null, appId = null;\n    for (var i = 1; i < args.length - 1; i++) {\n        if (args[i] === 'USERDATA' && ud === null) ud = args[i + 1];\n        else if (args[i] === '__AUL_APPID__' && appId === null) appId = args[i + 1];\n    }\n    var text = decodeAul(ud || args[3]);\n    var isYt = (' ' + text + ' ').indexOf('dial_name=YouTube ') >= 0;\n    if (!isYt && appId) {\n        var idText = decodeAul(appId);\n        if (/(?:^| )com\\.samsung\\.tv\\.cobalt-yt(?: |$)/.test(idText)) isYt = true;\n    }\n    if (!isYt) return null;\n    return text.indexOf('share/vyt') >= 0 ? 'ok' : 'relaunch';\n}\n\n// opts: { proc: '/proc', fs: (for tests) }\nfunction Gate(opts) {\n    opts = opts || {};\n    this.proc = opts.proc || '/proc';\n    this.fs = opts.fs || fs;\n    this.seen = null;            // pid -> 'base' (there before, never tried) | 'read' | 'new' (unreadable, seen once) | 'done'\n}\n\n// Forget what was seen: the next scan only takes note of what is running.\nGate.prototype.reset = function () { this.seen = null; };\n\n// quiet: true while the patched app is running (the proxy has connections): new processes are noted, not tried.\n// Returns { blind: true } when /proc cannot be listed, else { verdict: 'relaunch' | 'ok' | null, check: boolean }.\nGate.prototype.scan = function (quiet) {\n    var names;\n    try { names = this.fs.readdirSync(this.proc); } catch (e) { return { blind: true, error: e.message }; }\n    var first = !this.seen, old = this.seen || {}, now = {}, verdict = null, check = false;\n    for (var i = 0; i < names.length; i++) {\n        var pid = names[i];\n        if (!/^\\d+$/.test(pid)) continue;\n        var was = old[pid];\n        if (was === 'new') { now[pid] = 'done'; check = true; continue; }\n        if (was) { now[pid] = was; continue; }\n        if (first || quiet) { now[pid] = 'base'; continue; }\n        var cmdline;\n        try { cmdline = this.fs.readFileSync(this.proc + '/' + pid + '/cmdline', 'binary'); }\n        catch (e) {\n            if (e.code === 'ENOENT' || e.code === 'ESRCH') continue;          // already gone\n            now[pid] = 'new';                                                  // EACCES / EPERM: not ours to read\n            continue;\n        }\n        now[pid] = 'read';\n        var v = classify(cmdline);\n        if (v === 'relaunch' || (v === 'ok' && !verdict)) verdict = v;\n    }\n    this.seen = now;\n    return { verdict: verdict, check: check };\n};\n\n// When to look, without the side effects: index.js calls step() every SCAN_MS and runs what it answers.\n// A root check is asked for at most every CHECK_MS when something new started (or a check failed, or the patched app just\n// closed), and every BACKSTOP_MS anyway, except while the patched app is open. Blind (no /proc): every CHECK_MS, as before.\nvar SCAN_MS = 3000, CHECK_MS = 6000, BACKSTOP_MS = 60 * 1000;\n\nfunction Watcher(opts) {\n    this.gate = new Gate(opts);\n    this.blind = false;\n    this.want = true;            // the first step after a start checks as root: an app already running is in the first scan\n    this.last = -Infinity;\n    this.wasQuiet = false;\n}\n// The watch cannot act (the proxy or the certificate is not ready): start over, and check as soon as it can.\nWatcher.prototype.blocked = function () { this.gate.reset(); this.want = true; };\n// A root check failed (no root agent yet, the TV busy): try again after CHECK_MS, not a minute later.\nWatcher.prototype.failed = function () { this.want = true; };\n// now: ms; quiet: the proxy has connections (the patched app is open); canAct: false while relaunches are rate-limited.\n// Returns { blind: <error, once>, relaunch: true } or { check: 'check' | 'backstop' } (or neither).\nWatcher.prototype.step = function (now, quiet, canAct) {\n    var out = {}, r = this.blind ? null : this.gate.scan(quiet);\n    if (r && r.blind) { this.blind = true; out.blind = r.error; r = null; }\n    if (r && r.check) this.want = true;\n    if (this.wasQuiet && !quiet) this.want = true;      // it just closed: what started meanwhile was only noted\n    this.wasQuiet = quiet;\n    if (!canAct) return out;\n    if (r && r.verdict === 'relaunch') { out.relaunch = true; return out; }\n    var kind = null;\n    if (this.blind || this.want) { if (now - this.last >= CHECK_MS) kind = 'check'; }\n    else if (!quiet && now - this.last >= BACKSTOP_MS) kind = 'backstop';\n    if (kind) { this.want = false; this.last = now; out.check = kind; }\n    return out;\n};\n\nmodule.exports = { Gate: Gate, Watcher: Watcher, classify: classify, COBALT_BIN: COBALT_BIN, SCAN_MS: SCAN_MS, CHECK_MS: CHECK_MS, BACKSTOP_MS: BACKSTOP_MS };\n"}}
