p(wp.minutes, 30, 180, dwp.minutes),\r\n            rain: wp.rain !== false, wind: wp.wind !== false,\r\n            heat: wp.heat !== false, storm: wp.storm !== false,\r\n            rainPct: clamp(wp.rainPct, 10, 100, dwp.rainPct),\r\n            windKmh: clamp(wp.windKmh, 10, 120, dwp.windKmh),\r\n            heatC: clamp(wp.heatC, 20, 50, dwp.heatC),\r\n            stormCode: clamp(wp.stormCode, 80, 99, dwp.stormCode)\r\n        };\r\n\r\n        o.news.feeds = [];\r\n        var feeds = Array.isArray(n.feeds) ? n.feeds : (n.feed ? [n.feed] : d.news.feeds);\r\n        for (i = 0; i < feeds.length && o.news.feeds.length < MAX_FEEDS; i++) {\r\n            if (byId(FEEDS, String(feeds[i])) && o.news.feeds.indexOf(String(feeds[i])) < 0) { o.news.feeds.push(String(feeds[i])); }\r\n        }\r\n        if (!o.news.feeds.length) { o.news.feeds = d.news.feeds.slice(0); }\r\n        o.news.interval = clamp(n.interval, 5, 240, d.news.interval);\r\n        o.news.seconds = clamp(n.seconds, 3, 30, d.news.seconds);\r\n        o.news.quiet = !(n.quiet === false);\r\n        o.news.count = clamp(n.count, 1, 3, d.news.count);\r\n        o.news.sound = n.sound === true;\r\n        o.news.mode = byId(MODES, n.mode) ? n.mode : d.news.mode;\r\n        o.news.volume = clamp(n.volume, 10, 100, d.news.volume);\r\n        return o;\r\n    }\r\n    function publicCfg() {\r\n        var o = cfg(), keys = rawCfg().keys || {};\r\n        o.version = VERSION;\r\n        o.maxClubs = MAX_CLUBS;\r\n        o.maxPicks = MAX_PICKS;\r\n        o.hasKey = !!keys.apifootball;\r\n        o.providers = Object.keys(PROVIDERS).map(function (k) { return { id: k, label: PROVIDERS[k].label, needsKey: PROVIDERS[k].needsKey }; });\r\n        o.otherSports = Object.keys(OTHER).map(function (k) { return { id: k, label: OTHER[k].label, teams: OTHER[k].teams }; });\r\n        o.comps = COMPS;\r\n        o.clubLeagues = CLUB_LEAGUES.map(function (id) { var c = byId(COMPS, id); return { id: id, name: c ? c.name : id }; });\r\n        o.places = allPlaces(o);\r\n        o.civAreas = CIV_AREAS;\r\n        o.weatherProviders = WEATHER_PROVIDERS;\r\n        o.weatherWhen = WEATHER_WHEN;\r\n        o.feeds = FEEDS;\r\n        o.modes = MODES;\r\n        return o;\r\n    }\r\n    // Public, read-only view of the last known state. Only status lines and match baselines:\r\n    // event dedupe keys, ctx.config, the API key and the saved history of other modules stay out.\r\n    function publicLast() {\r\n        var out = {}, k, v;\r\n        for (k in last) {\r\n            if (!last.hasOwnProperty(k)) { continue; }\r\n            v = last[k] || {};\r\n            out[k] = { at: v.at || 0, state: v.state || '', desc: v.desc || '', our: v.our || 0, opp: v.opp || 0 };\r\n        }\r\n        return out;\r\n    }\r\n\r\n    // ---- watches: one per club and per other-sport pick ----------------------------------------------------------------\r\n    function buildWatches(c) {\r\n        var out = [], i, cl, p, sp;\r\n        for (i = 0; i < c.football.clubs.length; i++) {\r\n            cl = c.football.clubs[i];\r\n            out.push({\r\n                key: 'club:' + cl.id, kind: 'club', provider: c.football.provider, sport: 'soccer',\r\n                league: cl.league, comps: cl.comps, teamId: cl.id, name: cl.name,\r\n                alerts: cl.alerts || c.football.alerts, goalSeconds: c.football.goalSeconds,\r\n                otherSeconds: c.football.otherSeconds, sound: c.football.sound,\r\n                mode: c.football.mode, lang: c.lang, volume: c.football.volume,\r\n                logo: logoFor('club', c.football.provider, 'soccer', cl.id)\r\n            });\r\n        }\r\n        for (i = 0; i < c.others.picks.length; i++) {\r\n            p = c.others.picks[i];\r\n            sp = OTHER[p.sport];\r\n            out.push({\r\n                // One watch per pick, even for two teams of the same sport. Race picks have no\r\n                // team id, so use the (unique) name instead of the shared \"all\" key.\r\n                key: 'other:' + p.sport + ':' + (p.teamId || clean(p.name, 30)), kind: 'other', provider: 'espn',\r\n                sport: p.sport, league: p.league, comps: [sp.espn], teamId: p.teamId, name: p.name,\r\n                alerts: c.others.alerts, goalSeconds: c.others.seconds,\r\n                otherSeconds: c.others.seconds, sound: c.others.sound,\r\n                mode: c.others.mode, lang: c.lang, volume: c.others.volume,\r\n                logo: logoFor('other', 'espn', p.sport, p.teamId)\r\n            });\r\n        }\r\n        return out;\r\n    }\r\n    // ---- kick-off labels -------------------------------------------------------------------------------------------------------\r\n    function fmtKick(ms, lang) {\r\n        var d = new Date(ms), now = new Date();\r\n        var a = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();\r\n        var b = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();\r\n        var diff = Math.round((a - b) / 86400000), day;\r\n        if (diff === 0) { day = TXT[lang].today; }\r\n        else if (diff === 1) { day = TXT[lang].tomorrow; }\r\n        else {\r\n            var en = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\r\n            var pt = ['domingo', 'segunda', 'ter\\u00E7a', 'quarta', 'quinta', 'sexta', 's\\u00E1bado'];\r\n            day = (lang === 'pt' ? pt : en)[d.getDay()];\r\n        }\r\n        return day + ' ' + ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);\r\n    }\r\n\r\n    // ---- persisted warnings and next-fixture hints -----------------------------------------------------------------------------\r\n    // The warning must survive a Shard or TV restart: keep the already-warned fixture ids in\r\n    // ctx.config (memory-only used to repeat the banner inside the pre-kick-off window).\r\n    function persistNextWarned() {\r\n        var store = rawCfg(), prev = store.nextNotified || {}, keys = Object.keys(nextWarned);\r\n        var out = {}, i, list;\r\n        for (i = 0; i < keys.length; i++) { out[keys[i]] = prev[keys[i]] || Date.now(); }\r\n        list = Object.keys(out);\r\n        if (list.length > 20) {\r\n            list.sort(function (a, b) { return out[b] - out[a]; });\r\n            out = {};\r\n            for (i = 0; i < 20; i++) { out[list[i]] = prev[list[i]] || Date.now(); }\r\n        }\r\n        store.nextNotified = out;\r\n        try { ctx.config.set(store); }\r\n        catch (e) { addLog('sport', 'error', 'persist warning: ' + String(e && e.message || e)); }\r\n    }\r\n    function persistWeatherWarned() {\r\n        var store = rawCfg(), prev = store.weatherNotified || {}, keys = Object.keys(weatherWarned);\r\n        var out = {}, i, list;\r\n        for (i = 0; i < keys.length; i++) { out[keys[i]] = prev[keys[i]] || Date.now(); }\r\n        list = Object.keys(out);\r\n        if (list.length > 60) {\r\n            list.sort(function (a, b) { return out[b] - out[a]; });\r\n            out = {};\r\n            for (i = 0; i < 60; i++) { out[list[i]] = prev[list[i]] || Date.now(); }\r\n        }\r\n        store.weatherNotified = out;\r\n        try { ctx.config.set(store); }\r\n        catch (e) { addLog('weather', 'error', 'persist alert: ' + String(e && e.message || e)); }\r\n    }\r\n    function loadWeatherWarned() {\r\n        var saved = rawCfg().weatherNotified || {}, k;\r\n        for (k in saved) { if (saved.hasOwnProperty(k)) { weatherWarned[k] = true; } }\r\n    }\r\n    function persistNextHints() {\r\n        var store = rawCfg(), keys = Object.keys(espn.hints()), out = {}, i, trimmed, hints;\r\n        hints = espn.hints();\r\n        if (keys.length > 20) {\r\n            // Keep the most recently used hints, not whatever happened to be inserted last.\r\n            keys.sort(function (a, b) { return (hints[b] && hints[b].at || 0) - (hints[a] && hints[a].at || 0); });\r\n            keys = keys.slice(0, 20);\r\n            trimmed = {};\r\n            for (i = 0; i < keys.length; i++) { trimmed[keys[i]] = hints[keys[i]]; }\r\n            espn.setHints(trimmed);\r\n            hints = espn.hints();\r\n        }\r\n        for (i = 0; i < keys.length; i++) { out[keys[i]] = hints[keys[i]]; }\r\n        store.nextHints = out;\r\n        try { ctx.config.set(store); }\r\n        catch (e) { addLog('sport', 'error', 'persist next hints: ' + String(e && e.message || e)); }\r\n    }\r\n    function loadNextHints() {\r\n        var saved = rawCfg().nextHints || {};\r\n        espn.setHints(saved && typeof saved === 'object' ? saved : {});\r\n    }\r\n    function warnIfDue(w, g, minutes) {\r\n        if (!g || !(minutes > 0) || nextWarned[g.id]) { return; }\r\n        var left = g.dateMs - Date.now();\r\n        if (left <= 0 || left > minutes * 60000) { return; }\r\n        nextWarned[g.id] = true;\r\n        persistNextWarned();\r\n        var msg = g.home + ' \\u00D7 ' + g.away + ' \\u00B7 ' + g.line;\r\n        banner(TITLE_PRE, msg, 'info', E.whistle, w.otherSeconds,\r\n            { sound: w.sound ? 'reward' : '', group: false, mode: w.mode, image: w.logo || '', volume: w.volume });\r\n        addLog('sport', 'next', msg);\r\n    }\r\n    function checkNext(ws) {\r\n        var c = cfg(), ng = c.football.nextGame;\r\n        if (!ng.enabled || c.football.provider !== 'espn') { return; }\r\n        var clubs = ws.filter(function (w) { return w.kind === 'club'; }), i;\r\n        for (i = 0; i < clubs.length; i++) {\r\n            (function (w) {\r\n                var hit = nextGame[w.key];\r\n                if (hit && Date.now() - hit.at < 3600000) { return warnIfDue(w, hit.game, ng.minutes); }\r\n                scanNext(w, function (g) {\r\n                    nextGame[w.key] = { at: Date.now(), game: g };\r\n                    if (g) {\r\n                        var hints = espn.hints();\r\n                        hints[w.key] = { date: ymd(new Date(g.dateMs)), at: Date.now() };\r\n                        persistNextHints();\r\n                    }\r\n                    warnIfDue(w, g, ng.minutes);\r\n                });\r\n            })(clubs[i]);\r\n        }\r\n    }\r\n    function nextList() {\r\n        var out = [], k, hit;\r\n        for (k in nextGame) {\r\n            if (nextGame.hasOwnProperty(k)) {\r\n                hit = nextGame[k];\r\n                if (hit && hit.game) { out.push(hit.game); }\r\n            }\r\n        }\r\n        out.sort(function (a, b) { return a.dateMs - b.dateMs; });\r\n        return out;\r\n    }\r\n\r\n    // ---- sport analysis -------------------------------------------------------------------------------------------------------\r\n    function evKey(ev) {\r\n        return (ev.kind || '') + '|' + (ev.teamId || '') + '|' + (ev.minute || '') + '|' + clean(ev.player || '', 30).toLowerCase();\r\n    }\r\n    function announceEvent(ev, w, m) {\r\n        var side = ev.teamId === m.home.id ? m.home : m.away;\r\n        var mine = ev.teamId === w.teamId;\r\n        var team = mine ? w.name : side.short;\r\n        var ex = { player: ev.player, minute: ev.minute, detail: ev.detail, team: team };\r\n        if (ev.kind === 'goal') {\r\n            if (!once('ev|' + m.id + '|' + evKey(ev))) { return; }\r\n            announce(mine ? 'goal' : 'against', w, m, ex); return;\r\n        }\r\n        if (ev.kind === 'cardY' || ev.kind === 'cardR') {\r\n            if (w.alerts.card && once('ev|' + m.id + '|' + evKey(ev))) { announce(ev.kind, w, m, ex); }\r\n            return;\r\n        }\r\n        if (ev.kind === 'penalty' || ev.kind === 'penMiss') {\r\n            // A saved/missed penalty has no goal, so it used to be silent. Announce the outcome\r\n            // (and the taker) for either team, deduped like every other event.\r\n            if (w.alerts[ev.kind] && once('ev|' + m.id + '|' + evKey(ev))) { announce(ev.kind, w, m, ex); }\r\n            return;\r\n        }\r\n        if (ev.kind === 'sub' && w.alerts.sub && mine && once('ev|' + m.id + '|' + evKey(ev))) {\r\n            announce('sub', w, m, ex);\r\n        }\r\n    }\r\n    // ESPN describes the two halves as \"First Half\" / \"Second Half\": those are playing time,\r\n    // not the break. Only the real interval (\"Halftime\", \"Half Time\", \"HT\", \"Intervalo\") counts,\r\n    // otherwise a kick-off announced \"Intervalo\" together with \"Come\\u00E7ou o jogo\".\r\n    function isHalfTime(m) {\r\n        var d = String(m.desc || '').replace(/^\\s+|\\s+$/g, '');\r\n        return m.state === 'in' && /^(half[\\s-]?time|ht|intervalo|descanso)\\b/i.test(d);\r\n    }\r\n    function analyse(m, w) {\r\n        var key = w.key + '|' + m.id, prev = last[key], keys = {}, i, ev, fresh = [], goals = [], us, them;\r\n        // A baseline written by an older version may lack `keys`. Treat it as an empty one instead\r\n        // of throwing inside an async provider callback (which used to stall sport polling forever).\r\n        if (prev && !prev.keys) { prev = { keys: {}, our: 0, opp: 0, state: prev.state || '' }; }\r\n        watchStatus[w.key] = { line: lineOf(m), state: m.desc, at: Date.now(), error: '' };\r\n        if (m.state === 'in' || m.state === 'post') {\r\n            nextGame[w.key] = null;\r\n            if (espn.clearHint(w.key)) { persistNextHints(); }\r\n        }\r\n        if (m.race) {\r\n            last[key] = { at: Date.now(), state: m.state, desc: m.desc, our: 0, opp: 0, keys: {} };\r\n            if (prev && m.state === 'post' && prev.state !== 'post' && w.alerts.end && once('st|' + m.id + '|end')) {\r\n                banner(TXT[w.lang].win + ': ' + m.home.name, lineOf(m), 'ok', E.flag, w.goalSeconds,\r\n                    { sound: w.sound ? 'success' : '', group: false, mode: w.mode, volume: w.volume });\r\n                addLog('sport', 'race', m.home.name + ' - ' + m.desc);\r\n            }\r\n            return;\r\n        }\r\n        us = m.home.id === w.teamId ? m.home : m.away;\r\n        them = us === m.home ? m.away : m.home;\r\n        for (i = 0; i < m.events.length; i++) { keys[evKey(m.events[i])] = true; }\r\n        last[key] = { at: Date.now(), state: m.state, desc: m.desc, our: us.score, opp: them.score, keys: keys };\r\n        if (!prev) { return; }                              // first sight: baseline only\r\n\r\n        for (i = 0; i < m.events.length; i++) {\r\n            ev = m.events[i];\r\n            if (!prev.keys[evKey(ev)]) {\r\n                fresh.push(ev);\r\n                if (ev.kind === 'goal') { goals.push(ev); }\r\n            }\r\n        }\r\n        // Two goals between polls: announce every new one, not just the first. The baseline is\r\n        // already advanced above, so anything not announced here would be lost for good.\r\n        for (i = 0; i < goals.length; i++) {\r\n            ev = goals[i];\r\n            if (ev.teamId === w.teamId ? w.alerts.goal : w.alerts.against) { announceEvent(ev, w, m); }\r\n        }\r\n        if (!goals.length && us.score > prev.our && w.alerts.goal && once('st|' + m.id + '|goal')) {\r\n            // The scoreboard changed before the event details arrived: reuse a goal with a scorer\r\n            // from the summary if one is already known, so the banner still says who scored.\r\n            var sg = null, si;\r\n            for (si = 0; si < m.events.length; si++) {\r\n                if (m.events[si].kind === 'goal' && m.events[si].player) { sg = m.events[si]; break; }\r\n            }\r\n            announce('goal', w, m, sg ? { player: sg.player, minute: sg.minute } : {});\r\n        } else if (!goals.length && them.score > prev.opp && w.alerts.against && once('st|' + m.id + '|against')) {\r\n            var so = null, sj;\r\n            for (sj = 0; sj < m.events.length; sj++) {\r\n                if (m.events[sj].kind === 'goal' && m.events[sj].player) { so = m.events[sj]; break; }\r\n            }\r\n            announce('against', w, m, { team: them.short, player: so ? so.player : '', minute: so ? so.minute : '' });\r\n        }\r\n        if ((us.score < prev.our || them.score < prev.opp) && w.alerts.varNo && once('st|' + m.id + '|var')) {\r\n            announce('var', w, m);\r\n        }\r\n        for (i = 0; i < fresh.length; i++) {\r\n            if (fresh[i].kind !== 'goal') { announceEvent(fresh[i], w, m); }\r\n        }\r\n        if (w.kind === 'other' && w.alerts.score && (us.score !== prev.our || them.score !== prev.opp) && !goals.length && once('st|' + m.id + '|score')) {\r\n            announce('score', w, m);\r\n        }\r\n        if (prev.state === 'pre' && m.state === 'in' && w.alerts.start && once('st|' + m.id + '|start')) { announce('start', w, m); }\r\n        if (isHalfTime(m) && !isHalfTime(prev) && w.alerts.half && once('st|' + m.id + '|half')) { announce('half', w, m); }\r\n        if (prev.state === 'in' && m.state === 'post' && w.alerts.end && once('st|' + m.id + '|end')) { announce('end', w, m); }\r\n    }\r\n\r\n    // ---- sport polling --------------------------------------------------------------------------------------------------------\r\n    function pollEspn(ws, done) {\r\n        var paths = [], i, j, p;\r\n        for (i = 0; i < ws.length; i++) {\r\n            if (ws[i].kind === 'club') {\r\n                for (j = 0; j < ws[i].comps.length; j++) {\r\n                    p = sportPath(ws[i], ws[i].comps[j]);\r\n                    if (paths.indexOf(p) < 0) { paths.push(p); }\r\n                }\r\n            } else {\r\n                p = sportPath(ws[i]);\r\n                if (paths.indexOf(p) < 0) { paths.push(p); }\r\n            }\r\n        }\r\n        var idx = 0, errs = [], ok = 0;\r\n        function step() {\r\n            if (idx >= paths.length) {\r\n                // One bad competition must not hide the clubs playing in the good ones. Only a\r\n                // complete failure is reported as an error for the whole module.\r\n                if (errs.length && !ok) { return done(errs[0], 0); }\r\n                var wait = 0, k, w, hit, m, raw, found, usedComp;\r\n                for (k = 0; k < ws.length; k++) {\r\n                    w = ws[k];\r\n                    found = null; usedComp = '';\r\n                    if (w.kind === 'club') {\r\n                        for (j = 0; j < w.comps.length && !found; j++) {\r\n                            hit = espn.cache(sportPath(w, w.comps[j]));\r\n                            if (hit) {\r\n                                found = findMatch(hit.events, 'soccer', w.teamId);\r\n                                if (found) { usedComp = w.comps[j]; }\r\n                            }\r\n                        }\r\n                    } else {\r\n                        hit = espn.cache(sportPath(w));\r\n                        if (hit) { found = findMatch(hit.events, w.sport, w.teamId, w.name); }\r\n                    }\r\n                    if (!found) { watchStatus[w.key] = { line: '', state: '', at: Date.now(), error: '' }; continue; }\r\n                    m = found.m; raw = found.raw;\r\n                    // Hard guard: only a match with one of my teams may ever reach the screen.\r\n                    if (!m.race && m.home.id !== w.teamId && m.away.id !== w.teamId) { continue; }\r\n                    withSummary(sportPath(w, usedComp), raw, m, (function (mm, ww) {\r\n                        return function () {\r\n                            try { analyse(mm, ww); }\r\n                            catch (e) { addLog('sport', 'error', 'analyse: ' + String(e && e.message || e)); }\r\n                        };\r\n                    })(m, w));\r\n                    var w2 = m.state === 'in' ? 20000 : (m.state === 'pre' ? 30000 : 120000);\r\n                    wait = wait ? Math.min(wait, w2) : w2;\r\n                }\r\n                return done(null, wait || 180000);\r\n            }\r\n            var cur = paths[idx++];\r\n            compEvents(cur, function (err, evs) {\r\n                if (err) {\r\n                    errs.push(cur + ': ' + err);\r\n                    addLog('sport', 'error', cur + ': ' + err);\r\n                    // A failed competition gets a short cache so it is retried in 2 min, without\r\n                    // holding back the clubs that were analysed successfully this cycle.\r\n                    espn.cacheFail(cur);\r\n                } else { ok++; }\r\n                step();\r\n            });\r\n        }\r\n        step();\r\n    }\r\n    function pollAf(ws, done) {\r\n        var af = afApi.state();\r\n        var clubs = ws.filter(function (w) { return w.kind === 'club'; }), now = Date.now(), i;\r\n        if (!clubs.length) { return done(null, 180000); }\r\n        if (af.live) {\r\n            return afGet('/fixtures?live=all', function (err, list) {\r\n                if (err) { return done(err, 0); }\r\n                var any = false;\r\n                for (i = 0; i < clubs.length; i++) {\r\n                    var f = null, j;\r\n                    for (j = 0; j < (list || []).length && !f; j++) {\r\n                        if (String(list[j].teams.home.id) === clubs[i].teamId || String(list[j].teams.away.id) === clubs[i].teamId) { f = list[j]; }\r\n                    }\r\n                    if (f) { any = true; analyse(afNorm(f), clubs[i]); }\r\n                    else { watchStatus[clubs[i].key] = { line: '', state: '', at: now, error: '' }; }\r\n                }\r\n                af.live = any;\r\n                done(null, any ? 100000 : 120000);\r\n            });\r\n        }\r\n        // Nothing live: ask each club for its next fixture, at most once every two hours per club.\r\n        var idx = 0, wait = 7200000;\r\n        function step() {\r\n            if (idx >= clubs.length) { return done(null, wait); }\r\n            var cl = clubs[idx++];\r\n            if (af.nextKick[cl.key] && now < af.nextKick[cl.key] - 300000) {\r\n                wait = Math.min(wait, Math.max(af.nextKick[cl.key] - 300000 - now, 60000));\r\n                return step();\r\n            }\r\n            afGet('/fixtures?team=' + cl.teamId + '&next=1', function (err, list) {\r\n                if (err) { return done(err, 0); }\r\n                var f = list && list[0], mm;\r\n                af.nextKick[cl.key] = f ? new Date(f.fixture.date).getTime() : now + 7200000;\r\n                if (f) {\r\n                    mm = afNorm(f);\r\n                    nextGame[cl.key] = { at: now, game: {\r\n                        key: cl.key, id: mm.id, club: cl.name, comp: cl.league,\r\n                        home: mm.home.name, away: mm.away.name,\r\n                        date: f.fixture.date, dateMs: af.nextKick[cl.key], line: fmtKick(af.nextKick[cl.key], cl.lang)\r\n                    } };\r\n                    if (cfg().football.nextGame.enabled) { warnIfDue(cl, nextGame[cl.key].game, cfg().football.nextGame.minutes); }\r\n                    if (af.nextKick[cl.key] - now < 300000) { af.live = true; }\r\n                }\r\n                wait = Math.min(wait, Math.max(af.nextKick[cl.key] - 300000 - Date.now(), 60000));\r\n                step();\r\n            });\r\n        }\r\n        step();\r\n    }\r\n    function pollSport() {\r\n        var c = cfg(), ws = buildWatches(c);\r\n        if (!ws.length) {\r\n            status.sport.at = Date.now(); status.sport.error = ''; status.sport.line = ''; status.sport.state = '';\r\n            addLog('sport', 'idle', 'no club or sport selected');\r\n            return schedule('sport', 300000);\r\n        }\r\n        var runner = c.football.provider === 'apifootball' ? pollAf : pollEspn;\r\n        runner(ws, function (err, wait) {\r\n            status.sport.at = Date.now();\r\n            if (err) {\r\n                status.sport.error = String(err); addLog('sport', 'error', String(err));\r\n                return schedule('sport', 120000);\r\n            }\r\n            status.sport.error = '';\r\n            var i, k, best = '';\r\n            for (k in watchStatus) {\r\n                if (watchStatus.hasOwnProperty(k) && watchStatus[k].line && !best) { best = watchStatus[k].line; }\r\n            }\r\n            status.sport.line = best;\r\n            status.sport.state = ws.length + (c.lang === 'pt' ? (ws.length === 1 ? ' acompanhado' : ' acompanhados') : (ws.length === 1 ? ' watch' : ' watches'));\r\n            // The next fixture is fetched at most once an hour per competition (shared cache), so\r\n            // this adds no work to the 20 s live poll and keeps the panel useful between matches.\r\n            checkNext(ws);\r\n            persistHistory(false);\r\n            schedule('sport', wait || 120000);\r\n        });\r\n    }\r\n\r\n    // ---- civil protection: IPMA warnings + ANEPC notices + filtered breaking news ------------------------------------------------\r\n    // Include the level and the notice title/url: an orange warning upgraded to red (or a second\r\n    // ANEPC notice on the same day) is a different alert and must be announced again.\r\n    function civKey(a) {\r\n        return a.source + '|' + a.area + '|' + a.type + '|' + a.startsAt + '|' + a.level + '|' + clean(a.title || a.url || '', 60);\r\n    }\r\n    function parseEuroDate(s) {\r\n        var m = /^(\\d{2})\\.(\\d{2})\\.(\\d{4})$/.exec(String(s || '').trim());\r\n        return m ? new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1])).getTime() : 0;\r\n    }\r\n    function civLevelName(l) {\r\n        return l === 'red' ? 'Vermelho' : (l === 'orange' ? 'Laranja' : (l === 'yellow' ? 'Amarelo' : 'Verde'));\r\n    }\r\n    function ipmaAlerts(c, cb) {\r\n        getJson('api.ipma.pt', '/open-data/forecast/warnings/warnings_www.json', {}, function (err, list) {\r\n            if (err) { addLog('civ', 'error', 'IPMA: ' + err); return cb([]); }\r\n            var out = [], i, w, lv, end;\r\n            for (i = 0; i < (list || []).length; i++) {\r\n                w = list[i] || {};\r\n                if (w.idAreaAviso !== c.civ.district) { continue; }\r\n                lv = String(w.awarenessLevelID || '').toLowerCase();\r\n                if (lv !== 'yellow' && lv !== 'orange' && lv !== 'red') { continue; }\r\n                end = new Date(w.endTime).getTime();\r\n                if (end && end < Date.now() - 3600000) { continue; }\r\n                out.push({\r\n                    id: '', source: 'IPMA', area: w.idAreaAviso, type: String(w.awarenessTypeName || ''),\r\n                    level: lv, title: civLevelName(lv) + ' \\u00B7 ' + String(w.awarenessTypeName || ''),\r\n                    message: String(w.text || ''), startsAt: w.startTime || '', endsAt: w.endTime || '',\r\n                    url: 'https://www.ipma.pt/'\r\n                });\r\n            }\r\n            cb(out);\r\n        });\r\n    }\r\n    function anepcAlerts(c, cb) {\r\n        if (!c.civ.anepc) { return cb([]); }\r\n        getRaw('prociv.gov.pt', '/pt/avisos-a-populacao/', {}, false, function (err, html) {\r\n            if (err) { addLog('civ', 'error', 'ANEPC: ' + err); return cb([]); }\r\n            var parts = String(html || '').split('<div class=\"box-avisos\">'), out = [], i, p, href, when, title, day;\r\n            for (i = 1; i < parts.length && out.length < 8; i++) {\r\n                p = parts[i];\r\n                if (!/Ativo/.test(p.slice(0, 600))) { continue; }\r\n                href = /window\\.location\\.href='([^']+)'/.exec(p);\r\n                when = /<div class=\"fs-14\">([^<]+)<\\/div>/.exec(p);\r\n                title = /<p class=h3-style[^>]*>([\\s\\S]*?)<\\/p>/.exec(p);\r\n                if (!href) { continue; }\r\n                day = when ? clean(when[1], 20) : '';\r\n                // The ANEPC page still marks some very old notices as \"Ativo\"; keep the last 30 days.\r\n                if (day && parseEuroDate(day) && Date.now() - parseEuroDate(day) > 30 * 86400000) { continue; }\r\n                title = title ? clean(stripTags(title[1]), 100) : '';\r\n                if (!title) {\r\n                    // Some older cards have no <p> title; a slug would look ugly on the TV.\r\n                    title = 'Aviso ANEPC' + (day ? ' \\u00B7 ' + day : '');\r\n                }\r\n                out.push({\r\n                    id: '', source: 'ANEPC', area: '', type: 'Aviso \\u00E0 popula\\u00E7\\u00E3o',\r\n                    level: 'warn', title: title, message: 'Publicado a ' + day + '. Siga as orienta\\u00E7\\u00F5es oficiais.',\r\n                    startsAt: day, endsAt: '', url: /^https?:\\/\\//.test(href[1]) ? href[1] : ('https://prociv.gov.pt' + (href[1].charAt(0) === '/' ? '' : '/') + href[1])\r\n                });\r\n            }\r\n            cb(out);\r\n        });\r\n    }\r\n    function civNewsAlerts(c, cb) {\r\n        if (!c.civ.news) { return cb([]); }\r\n        getUrl('https://www.noticiasaominuto.com/rss/ultima-hora', {}, false, function (err, xml) {\r\n            if (err) { addLog('civ', 'error', 'RSS: ' + err); return cb([]); }\r\n            var items = rssItems(xml, 30), words = c.civ.keywords.toLowerCase().split(','), out = [], i, j, title, hit;\r\n            for (i = 0; i < items.length && out.length < 6; i++) {\r\n                title = String(items[i].title || '');\r\n                hit = false;\r\n                for (j = 0; j < words.length; j++) {\r\n                    if (words[j].trim() && title.toLowerCase().indexOf(words[j].trim()) >= 0) { hit = true; }\r\n                }\r\n                if (!hit) { continue; }\r\n                out.push({\r\n                    id: '', source: 'Not\\u00EDcias ao Minuto', area: '', type: 'Ultima hora',\r\n                    level: 'warn', title: clean(title, 140), message: '',\r\n                    startsAt: String(items[i].date || ''), endsAt: '', url: String(items[i].key || '')\r\n                });\r\n            }\r\n            cb(out);\r\n        });\r\n    }\r\n    function civAnnounce(a, c) {\r\n        var lv = a.level, icon = (lv === 'red') ? E.no : E.warn;\r\n        var level = (lv === 'red') ? 'alert' : (lv === 'orange' ? 'warn' : 'info');\r\n        var mode = (lv === 'yellow') ? 'banner' : c.civ.mode;\r\n        var snd = (lv === 'yellow') ? '' : (c.civ.sound ? 'alert' : '');\r\n        var title = icon + ' ' + (a.source === 'IPMA' ? 'Prote\\u00E7\\u00E3o Civil' : a.source) + ' \\u00B7 ' + a.title;\r\n        var msg = (a.message || a.type) + (a.endsAt ? ' \\u00B7 at\\u00E9 ' + clean(String(a.endsAt).slice(0, 16), 16) : '');\r\n        // Civil-protection warnings are not routine: NC 0.13+ shows high priority even in quiet hours.\r\n        banner(title, msg, level, icon, c.civ.seconds,\r\n            { sound: snd, group: false, mode: mode, priority: (lv === 'yellow') ? '' : 'high', volume: c.civ.volume });\r\n        addLog('civ', lv, title + ' - ' + msg);\r\n    }\r\n    function pollCiv(manual) {\r\n        var c = cfg();\r\n        status.civ.at = Date.now();\r\n        status.civ.error = '';\r\n        // A manual test must still show something when the module is switched off.\r\n        if (!c.civ.enabled && !manual) { status.civ.line = ''; status.civ.state = ''; return schedule('civ', 300000); }\r\n        ipmaAlerts(c, function (ipma) {\r\n            anepcAlerts(c, function (anepc) {\r\n                civNewsAlerts(c, function (news) {\r\n                    var all = ipma.concat(anepc).concat(news), i, a, order = { red: 0, warn: 1, orange: 1, yellow: 2 };\r\n                    for (i = 0; i < all.length; i++) {\r\n                        a = all[i];\r\n                        a.id = civKey(a);\r\n                        if (order[a.level] == null) { order[a.level] = 3; }\r\n                    }\r\n                    all.sort(function (x, y) { return (order[x.level] - order[y.level]); });\r\n                    civAlerts = all.slice(0, 8);\r\n                    status.civ.line = civAlerts.length ? civAlerts[0].title : '';\r\n                    status.civ.state = civAlerts.length + (c.lang === 'pt' ? ' avisos' : ' alerts');\r\n                    var first = civSeen.__init !== true, sent = 0;\r\n                    civSeen.__init = true;\r\n                    for (i = 0; i < civAlerts.length; i++) {\r\n                        a = civAlerts[i];\r\n                        if (!c.civ.levels[a.level] && a.level !== 'warn') { continue; }\r\n                        if (!civSeen[a.id]) {\r\n                            civSeen[a.id] = true;\r\n                            if (!first || manual) { civAnnounce(a, c); sent++; }\r\n                        }\r\n                    }\r\n                    if (manual && !sent) {\r\n                        // Unlike the real poll, the Test button must always produce a banner even\r\n                        // when every active warning was already announced (or none is active).\r\n                        var sample = null, sj;\r\n                        for (sj = 0; sj < civAlerts.length; sj++) {\r\n                            if (c.civ.levels[civAlerts[sj].level] || civAlerts[sj].level === 'warn') { sample = civAlerts[sj]; break; }\r\n                        }\r\n                        if (!sample) {\r\n                            sample = {\r\n                                level: 'orange', source: 'IPMA', type: c.lang === 'pt' ? 'Aviso de teste' : 'Test warning',\r\n                                title: c.lang === 'pt' ? 'Teste de prote\\u00E7\\u00E3o civil' : 'Civil protection test',\r\n                                message: c.lang === 'pt' ? 'Isto \\u00E9 apenas um teste.' : 'This is only a test.', endsAt: ''\r\n                            };\r\n                        }\r\n                        civAnnounce(sample, c);\r\n                        sent++;\r\n                        addLog('test', 'civ', sample.title);\r\n                    }\r\n                    if (Object.keys(civSeen).length > 120) { civSeen = { __init: true }; }\r\n                    addLog('civ', 'poll', civAlerts.length + ' alerts, ' + sent + ' sent');\r\n                    schedule('civ', c.civ.interval * 60000);\r\n                });\r\n            });\r\n        });\r\n    }\r\n\r\n    // ---- weather -------------------------------------------------------------------------------------------------------------\r\n    function wxText(code, lang) {\r\n        var n = parseInt(code, 10) || 0, pt = lang === 'pt';\r\n        if (n === 0) { return pt ? 'C\\u00E9u limpo' : 'Clear sky'; }\r\n        if (n <= 2) { return pt ? 'Algumas nuvens' : 'Partly cloudy'; }\r\n        if (n === 3) { return pt ? 'Nublado' : 'Cloudy'; }\r\n        if (n === 45 || n === 48) { return pt ? 'Nevoeiro' : 'Fog'; }\r\n        if (n >= 51 && n <= 57) { return pt ? 'Garoa' : 'Drizzle'; }\r\n        if (n >= 61 && n <= 67) { return pt ? 'Chuva' : 'Rain'; }\r\n        if (n >= 71 && n <= 77) { return pt ? 'Neve' : 'Snow'; }\r\n        if (n >= 80 && n <= 82) { return pt ? 'Chuva forte' : 'Showers'; }\r\n        if (n >= 95) { return pt ? 'Trovoada' : 'Thunderstorm'; }\r\n        return pt ? 'Tempo vari\\u00E1vel' : 'Changeable';\r\n    }\r\n    var ipmaMeta = null, ipmaMetaAt = 0, ipmaTypes = null;\r\n    function ipmaWeatherData(cb) {\r\n        if (ipmaMeta && ipmaTypes && Date.now() - ipmaMetaAt < 86400000) { return cb(null); }\r\n        getJson('api.ipma.pt', '/open-data/distrits-islands.json', {}, function (e1, d1) {\r\n            if (e1) { return cb(String(e1)); }\r\n            ipmaMeta = (d1 && d1.data) || [];\r\n            getJson('api.ipma.pt', '/open-data/weather-type-classe.json', {}, function (e2, d2) {\r\n                if (e2) { return cb(String(e2)); }\r\n                ipmaTypes = {};\r\n                var i, x;\r\n                for (i = 0; i < ((d2 && d2.data) || []).length; i++) {\r\n                    x = d2.data[i] || {};\r\n                    ipmaTypes[String(x.idWeatherType)] = clean(x.descWeatherTypePT || '', 40);\r\n                }\r\n                ipmaMetaAt = Date.now();\r\n                cb(null);\r\n            });\r\n        });\r\n    }\r\n    function ipmaFindPlace(place) {\r\n        var name = String(place.name || '').replace(/\\s*\\([^)]*\\)$/, '').trim().toLowerCase();\r\n        var i, m, dlat, dlon, d, best = null, bd = 1e9;\r\n        for (i = 0; i < ipmaMeta.length; i++) {\r\n            m = ipmaMeta[i] || {};\r\n            if (String(m.local || '').toLowerCase() === name) { return m; }\r\n            dlat = parseFloat(m.latitude) - place.lat; dlon = parseFloat(m.longitude) - place.lon;\r\n            d = dlat * dlat + dlon * dlon;\r\n            if (d < bd) { bd = d; best = m; }\r\n        }\r\n        return best;\r\n    }\r\n    function openMeteoWeather(place, tomorrow, lang, cb) {\r\n        var idx = tomorrow ? 1 : 0;\r\n        var q = '/v1/forecast?latitude=' + place.lat + '&longitude=' + place.lon +\r\n            '&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m' +\r\n            '&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code' +\r\n            '&hourly=temperature_2m,precipitation_probability,weather_code,wind_speed_10m' +\r\n            '&timezone=auto&forecast_days=2';\r\n        getJson('api.open-meteo.com', q, {}, function (err, d) {\r\n            if (err) { return cb(String(err)); }\r\n            var cur = d.current || {}, daily = d.daily || {}, t = TXT[lang];\r\n            var hi = Math.round(parseFloat((daily.temperature_2m_max || [])[idx]) || 0);\r\n            var lo = Math.round(parseFloat((daily.temperature_2m_min || [])[idx]) || 0);\r\n            var rain = parseInt((daily.precipitation_probability_max || [])[idx], 10) || 0;\r\n            var code = tomorrow ? parseInt((daily.weather_code || [])[idx], 10) : parseInt(cur.weather_code, 10);\r\n            var temp = Math.round(parseFloat(cur.temperature_2m) || 0);\r\n            var line = place.name + ': ' + (tomorrow ? t.tomorrow + ' ' : temp + '\\u00B0C, ') + wxText(code, lang) +\r\n                '. Max ' + hi + '\\u00B0 / Min ' + lo + '\\u00B0. ' + t.rain + ' ' + rain + '%';\r\n            var icon = (code >= 51) ? E.rain : ((code || 0) <= 1 ? E.sun : E.cloud);\r\n            cb(null, { line: line, state: wxText(code, lang), icon: icon, rain: rain }, d);\r\n        });\r\n    }\r\n    function ipmaWeather(place, tomorrow, lang, cb) {\r\n        ipmaWeatherData(function (err) {\r\n            if (err) { return cb(String(err)); }\r\n            var loc = ipmaFindPlace(place);\r\n            if (!loc) { return cb('no IPMA location for ' + place.name); }\r\n            getJson('api.ipma.pt', '/open-data/forecast/meteorology/cities/daily/' + loc.globalIdLocal + '.json', {}, function (e, d) {\r\n                if (e) { return cb(String(e)); }\r\n                var data = (d && d.data) || [], row = data[0], i, key, now = new Date(Date.now()), day;\r\n                if (tomorrow) {\r\n                    day = new Date(now.getTime() + 86400000);\r\n                    key = day.getFullYear() + '-' + ('0' + (day.getMonth() + 1)).slice(-2) + '-' + ('0' + day.getDate()).slice(-2);\r\n                    for (i = 0; i < data.length; i++) { if (data[i] && data[i].forecastDate === key) { row = data[i]; break; } }\r\n                    if (!row || row.forecastDate !== key) { row = data[1] || data[0]; }\r\n                }\r\n                if (!row) { return cb('no IPMA forecast'); }\r\n                var rain = parseInt(row.precipitaProb, 10) || 0;\r\n                var desc = ipmaTypes[String(row.idWeatherType)] || wxText(3, lang);\r\n                var line = place.name + ': ' + (tomorrow ? TXT[lang].tomorrow + ' ' : '') + 'Max ' +\r\n                    Math.round(parseFloat(row.tMax) || 0) + '\\u00B0 / Min ' + Math.round(parseFloat(row.tMin) || 0) +\r\n                    '\\u00B0. ' + desc + '. ' + TXT[lang].rain + ' ' + rain + '%';\r\n                var icon = (rain >= 60) ? E.rain : E.cloud;\r\n                cb(null, { line: line, state: desc, icon: icon, rain: rain }, d);\r\n            });\r\n        });\r\n    }\r\n    // Proactive warnings from the hourly forecast: rain/wind/heat/storm before they start.\r\n    // Only Open-Meteo provides hourly data; IPMA's public daily feed does not.\r\n    function checkProactive(raw, place, c, w, manual, skip) {\r\n        var p = w.proactive;\r\n        if (!p || !p.enabled || !raw || !raw.hourly) { return; }\r\n        // Advance warnings obey the same \"when to notify\" window as the regular weather banner.\r\n        if (skip || (!manual && w.quiet && quietNow())) { return; }\r\n        var h = raw.hourly, times = h.time || [], i, t, now = Date.now(), end = now + p.minutes * 60000;\r\n        var found = {}, order = [];\r\n        function add(kind, label, msg, icon, at, slot, severity) {\r\n            var e = { kind: kind, label: label, msg: msg, icon: icon, at: at, slot: slot, severity: severity }, j;\r\n            for (j = 0; j < order.length; j++) { if (order[j].kind === kind) { break; } }\r\n            // Keep the strongest occurrence of each phenomenon in the window, not just the first.\r\n            if (j < order.length && order[j].severity >= severity) { return; }\r\n            if (j < order.length) { order[j] = e; } else { order.push(e); }\r\n        }\r\n        for (i = 0; i < times.length; i++) {\r\n            t = new Date(times[i]).getTime();\r\n            if (!(t >= now - 1800000 && t <= end)) { continue; }\r\n            var d = new Date(t), when = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);\r\n            var slot = String(times[i] || '').slice(0, 13);   // Open-Meteo returns local time here\r\n            var prob = parseInt((h.precipitation_probability || [])[i], 10) || 0;\r\n            var wind = parseFloat((h.wind_speed_10m || [])[i]) || 0;\r\n            var temp = parseFloat((h.temperature_2m || [])[i]) || 0;\r\n            var code = parseInt((h.weather_code || [])[i], 10) || 0;\r\n            if (p.rain && prob >= p.rainPct) {\r\n                add('rain', TXT[c.lang].wRain, TXT[c.lang].wRain + ' ' + when + ' \\u00B7 ' + prob + '%', E.rain, t, slot, prob);\r\n            }\r\n            if (p.wind && wind >= p.windKmh) {\r\n                add('wind', TXT[c.lang].wWind, TXT[c.lang].wWind + ' ' + when + ' \\u00B7 ' + Math.round(wind) + ' km/h', E.cloud, t, slot, wind);\r\n            }\r\n            if (p.heat && temp >= p.heatC) {\r\n                add('heat', TXT[c.lang].wHeat, TXT[c.lang].wHeat + ' ' + when + ' \\u00B7 ' + Math.round(temp) + '\\u00B0C', E.sun, t, slot, temp);\r\n            }\r\n            if (p.storm && code >= p.stormCode) {\r\n                add('storm', TXT[c.lang].wStorm, TXT[c.lang].wStorm + ' ' + when, E.storm, t, slot, code);\r\n            }\r\n        }\r\n        for (i = 0; i < order.length; i++) {\r\n            var a = order[i], key = w.place + '|' + a.kind + '|' + (a.slot || new Date(a.at).toISOString().slice(0, 13));\r\n            if (weatherWarned[key]) { continue; }\r\n            weatherWarned[key] = true;\r\n            persistWeatherWarned();\r\n            banner(E.warn + ' ' + TXT[c.lang].weatherSoon + ' \\u00B7 ' + a.label, a.msg, 'warn', a.icon, w.seconds,\r\n                { sound: '', mode: w.mode, volume: w.volume, group: false });\r\n            addLog('weather', 'ahead', a.msg);\r\n        }\r\n    }\r\n    function pollWeather(manual) {\r\n        var c = cfg(), w = c.weather, place = byId(allPlaces(c), w.place) || PLACES[0];\r\n        var hour = new Date(Date.now()).getHours(), tomorrow = (w.when === 'night');\r\n        // \" morning\": only up to 10h, today's forecast. \"night\": only after 18h, tomorrow's forecast.\r\n        var skip = !manual && ((w.when === 'morning' && hour >= 10) || (w.when === 'night' && hour < 18));\r\n        function done(err, wx, raw) {\r\n            status.weather.at = Date.now();\r\n            if (err) {\r\n                status.weather.error = String(err); addLog('weather', 'error', String(err));\r\n                return schedule('weather', 300000);\r\n            }\r\n            status.weather.error = ''; status.weather.line = wx.line; status.weather.state = wx.state;\r\n            checkProactive(raw, place, c, w, manual, skip);\r\n            if (skip) { addLog('weather', 'skip', w.when + ': ' + wx.line); }\r\n            else if (!manual && w.quiet && quietNow()) { addLog('weather', 'quiet', wx.line); }\r\n            else {\r\n                // NC limits the title to 40 characters: drop the region a custom place carries in\r\n                // its name, keep the full name in the message line.\r\n                var short = place.name.replace(/\\s*\\([^)]*\\)$/, '');\r\n                banner(wx.icon + ' ' + TXT[c.lang].weather + ' \\u00B7 ' + short, wx.line,\r\n                    (wx.rain >= 60 ? 'warn' : 'info'), wx.icon, w.seconds,\r\n                    { sound: w.sound ? 'soft' : '', mode: w.mode, volume: w.volume });\r\n                addLog('weather', 'weather', wx.line);\r\n            }\r\n            schedule('weather', w.interval * 60000);\r\n        }\r\n        if (w.provider === 'ipma') { ipmaWeather(place, tomorrow, c.lang, done); }\r\n        else { openMeteoWeather(place, tomorrow, c.lang, done); }\r\n    }\r\n\r\n    // ---- scheduler -----------------------------------------------------------------------------------------------------------\r\n    function schedule(name, ms) {\r\n        busy[name] = false;\r\n        if (!running) { return; }\r\n        status[name].next = Date.now() + ms;\r\n        clearTimeout(timers[name]);\r\n        timers[name] = setTimeout(function () { poll(name); }, ms);\r\n    }\r\n    function poll(name, manual) {\r\n        if (!running) { return; }\r\n        if (name === 'all') { poll('sport'); poll('civ'); poll('weather'); poll('news'); return; }\r\n        // A disabled module must not be polled again: \"Check now\" used to restart the timers of every\r\n        // module, including the ones switched off. Manual tests are the exception: they must work\r\n        // even when the module is off, but still go through the busy[] guard below.\r\n        if (!manual && (name === 'civ' ? !cfg().civ.enabled : !cfg().modules[name])) { status[name].next = 0; return; }\r\n        // One poll at a time per module: \"Check now\" plus the timer used to run two requests and\r\n        // two banners for the same goal.\r\n        if (busy[name]) { return; }\r\n        busy[name] = true;\r\n        clearTimeout(timers[name]);\r\n        try {\r\n            if (name === 'sport') { pollSport(); }\r\n            else if (name === 'civ') { pollCiv(!!manual); }\r\n            else if (name === 'weather') { pollWeather(!!manual); }\r\n            else { pollNews(!!manual); }\r\n        } catch (e) {\r\n            busy[name] = false;\r\n            addLog(name, 'error', String(e && e.message || e));\r\n            schedule(name, 120000);\r\n        }\r\n    }\r\n    function kick(name, delay) {\r\n        clearTimeout(timers[name]);\r\n        if (!running || (name === 'civ' ? !cfg().civ.enabled : !cfg().modules[name])) { status[name].next = 0; return; }\r\n        timers[name] = setTimeout(function () { poll(name); }, delay);\r\n    }\r\n\r\n    function sendFile(res, name, type) {\r\n        fs.readFile(path.join(__dirname, name), 'utf8', function (err, text) {\r\n            if (err) { return sendJson(res, 500, { error: name + ' is missing' }); }\r\n            res.writeHead(200, { 'Content-Type': type, 'Cache-Control': 'no-store' });\r\n            res.end(text);\r\n        });\r\n    }\r\n    function teams(sport, league, provider, cb) {\r\n        var key = provider + '|' + sport + '|' + league, hit = teamsCache[key];\r\n        if (hit && Date.now() - hit.at < 86400000) { return cb(null, hit.list); }\r\n        function store(err, list) {\r\n            if (err) { return cb(err); }\r\n            list.sort(function (a, b) { return a.name < b.name ? -1 : 1; });\r\n            teamsCache[key] = { at: Date.now(), list: list };\r\n            cb(null, list);\r\n        }\r\n        if (provider === 'apifootball') { return afTeams(league, store); }\r\n        espnTeams(sport, league, store);\r\n    }\r\n    // Baselines and dedupe keys live in ctx.config so a restart (or a TV reboot) does not re-announce\r\n    // yesterday's news or lose a goal that happened while the Shard was down.\r\n    function loadHistory() {\r\n        var h = rawCfg().history || {};\r\n        newsApi.load(h.newsSeen);\r\n        last = h.last && typeof h.last === 'object' ? h.last : {};\r\n        seenEvent = h.seenEvent && typeof h.seenEvent === 'object' ? h.seenEvent : {};\r\n        historyAt = h.at || 0;\r\n    }\r\n    function persistHistory(force) {\r\n        if (!force && Date.now() - historyAt < 60000) { return; }\r\n        historyAt = Date.now();\r\n        var store = rawCfg(), i, lk, ek;\r\n        // Keep it small: 40 seen keys per feed (news module), 40 match baselines, 300 event keys.\r\n        lk = Object.keys(last);\r\n        if (lk.length > 40) {\r\n            lk.sort(function (a, b) { return (last[b].at || 0) - (last[a].at || 0); });\r\n            for (i = 40; i < lk.length; i++) { delete last[lk[i]]; }\r\n        }\r\n        ek = Object.keys(seenEvent);\r\n        if (ek.length > 300) {\r\n            ek.sort(function (a, b) { return seenEvent[b] - seenEvent[a]; });\r\n            for (i = 300; i < ek.length; i++) { delete seenEvent[ek[i]]; }\r\n        }\r\n        store.history = { newsSeen: newsApi.trim(), last: last, seenEvent: seenEvent, at: historyAt };\r\n        try { ctx.config.set(store); }\r\n        catch (e) { addLog('sport', 'error', 'persist history: ' + String(e && e.message || e)); }\r\n    }\r\n    function resetSport() {\r\n        last = {}; watchStatus = {}; seenEvent = {}; nextGame = {};\r\n        espn.reset(); afApi.reset();\r\n    }\r\n\r\n    return {\r\n        start: function () {\r\n            running = true; stopped = false;\r\n            bannerQueue.length = 0; sendTimes.length = 0;\r\n            busy = { sport: false, weather: false, news: false, civ: false };\r\n            loadHistory();\r\n            loadWeatherWarned();\r\n            loadNextHints();\r\n            // Restore the ids already warned before a restart/TV reboot.\r\n            var saved = rawCfg().nextNotified || {}, wk;\r\n            for (wk in saved) { if (saved.hasOwnProperty(wk)) { nextWarned[wk] = true; } }\r\n            refreshSounds();\r\n            clearInterval(soundTimer);\r\n            soundTimer = setInterval(refreshSounds, 600000);\r\n            kick('sport', 3000); kick('civ', 5000); kick('weather', 8000); kick('news', 13000);\r\n        },\r\n        stop: function () {\r\n            running = false; stopped = true;\r\n            // Nothing queued before shutdown may be delivered later.\r\n            bannerQueue.length = 0; sendTimes.length = 0;\r\n            clearInterval(soundTimer); soundTimer = null;\r\n            clearTimeout(bannerTimer); bannerTimer = null;\r\n            Object.keys(timers).forEach(function (k) { clearTimeout(timers[k]); });\r\n            busy = { sport: false, weather: false, news: false, civ: false };\r\n            persistHistory(true);\r\n            newsApi.clear(); civSeen = {}; resetSport();\r\n        },\r\n        status: function () {\r\n            var s = status.sport, hk = Object.keys(providerHealth), hs = [], i, h;\r\n            for (i = 0; i < hk.length; i++) {\r\n                h = providerHealth[hk[i]];\r\n                hs.push(hk[i] + ':' + (h.fails ? ('fail/' + h.fails) : 'ok'));\r\n            }\r\n            return {\r\n                sport: s.line || null, weather: status.weather.line || null, news: status.news.line || null,\r\n                civ: status.civ.line || null, error: s.error || null, health: hs.length ? hs.join(' ') : null\r\n            };\r\n        },\r\n        // One card in the launcher's Control center (Vetro 0.7+): quick \"Check now\" actions\r\n        // plus the current status lines. No extra permissions, no drawing on the TV.\r\n        card: function () {\r\n            var c = cfg(), next = nextList()[0], rows = [\r\n                { id: 'check-sport', label: c.lang === 'pt' ? 'Verificar desporto' : 'Check sport', value: status.sport.line || (c.lang === 'pt' ? 'parado' : 'idle') },\r\n                { id: 'check-weather', label: c.lang === 'pt' ? 'Verificar tempo' : 'Check weather', value: status.weather.line || (c.lang === 'pt' ? 'parado' : 'idle') },\r\n                { id: 'check-news', label: c.lang === 'pt' ? 'Verificar noticias' : 'Check news', value: status.news.line || (c.lang === 'pt' ? 'parado' : 'idle') },\r\n                { id: 'check-civ', label: c.lang === 'pt' ? 'Verificar proteccao civil' : 'Check civil protection', value: status.civ.line || (c.lang === 'pt' ? 'parado' : 'idle') }\r\n            ];\r\n            if (next) { rows.push({ id: 'next-game', label: c.lang === 'pt' ? 'Proximo jogo' : 'Next match', value: next.home + ' - ' + next.away + ' ' + next.line }); }\r\n            return { rows: rows.slice(0, 7), note: c.lang === 'pt' ? 'Acoes rapidas' : 'Quick actions', choosable: true };\r\n        },\r\n        cardSelect: function (rowId) {\r\n            if (!running) { return { ok: false, note: 'offline' }; }\r\n            var names = { 'check-sport': 'sport', 'check-weather': 'weather', 'check-news': 'news', 'check-civ': 'civ' };\r\n            if (names[rowId]) { poll(names[rowId], true); return { ok: true }; }\r\n            return { ok: false, note: 'unknown action' };\r\n        },\r\n        route: function (req, res, sub) {\r\n            // Vetro passes only the path in `sub`; the query string is in req.url.\r\n            var full = String((req && req.url) || ''), qs = '', qi = full.indexOf('?');\r\n            if (qi >= 0) { qs = full.slice(qi + 1); }\r\n            else { qi = String(sub || '').indexOf('?'); if (qi >= 0) { qs = String(sub).slice(qi + 1); } }\r\n            sub = String(sub || '').split('?')[0].replace(/^\\/+|\\/+$/g, '');\r\n            if (sub === 'ui' && req.method === 'GET') { sendFile(res, 'ui.html', 'text/html; charset=utf-8'); return true; }\r\n            if (sub === 'clearlog' && req.method === 'POST') { log.length = 0; sendJson(res, 200, { ok: true }); return true; }\r\n            if (sub === 'state' && req.method === 'GET') {\r\n                sendJson(res, 200, { config: publicCfg(), status: status, watches: watchStatus, next: nextList(), civ: civAlerts,\r\n                    notify: { queued: bannerQueue.length, sentMinute: sendTimes.length }, health: providerHealth, log: log });\r\n                return true;\r\n            }\r\n            // Public endpoint for widgets / a mini-site. Unlike /state it carries no config,\r\n            // no key flag, no feeds list and no log text beyond the last few lines.\r\n            if (sub === 'last' && (req.method === 'GET' || req.method === 'OPTIONS')) {\r\n                sendPublicJson(res, 200, {\r\n                    version: VERSION, at: Date.now(), historyAt: historyAt,\r\n                    status: status, watches: watchStatus, next: nextList(),\r\n                    civ: civAlerts, last: publicLast(),\r\n                    notify: { queued: bannerQueue.length, sentMinute: sendTimes.length }, health: providerHealth,\r\n                    log: log.slice(0, 10)\r\n                });\r\n                return true;\r\n            }\r\n            if (sub === 'teams' && (req.method === 'GET' || req.method === 'POST')) {\r\n                var p = {}, parts = qs.split('&'), i, kv;\r\n                for (i = 0; i < parts.length; i++) {\r\n                    kv = parts[i].split('=');\r\n                    if (kv[0]) { p[dec(kv[0])] = dec(kv[1] || ''); }\r\n                }\r\n                var answer = function () {\r\n                    var sport = p.sport || 'soccer', league = p.league || 'por.1';\r\n                    var prov = p.provider || cfg().football.provider;\r\n                    teams(sport, league, prov, function (err, list) {\r\n                        sendJson(res, err ? 502 : 200, err ? { error: String(err) } : { teams: list });\r\n                    });\r\n                };\r\n                // POST keeps the arguments out of the URL: the Vetro frame does not always forward\r\n                // the query string to the Shard.\r\n                if (req.method === 'POST') {\r\n                    readBody(req, function (raw) {\r\n                        var b = {}; try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\r\n                        if (b.sport) { p.sport = String(b.sport); }\r\n                        if (b.league) { p.league = String(b.league); }\r\n                        if (b.provider) { p.provider = String(b.provider); }\r\n                        answer();\r\n                    });\r\n                } else { answer(); }\r\n                return true;\r\n            }\r\n            // Upcoming F1 races for the \"Other sports\" picker. Each pick stores the ESPN event id\r\n            // so two races can be followed at once instead of both showing evs[0].\r\n            if (sub === 'races' && (req.method === 'GET' || req.method === 'POST')) {\r\n                var fallback = function () {\r\n                    compEvents('racing/f1', function (err2, cur) {\r\n                        if (err2) { return sendJson(res, 502, { error: String(err2) }); }\r\n                        sendJson(res, 200, { races: raceRows(cur), season: false });\r\n                    });\r\n                };\r\n                espnRaces(function (err, evs) {\r\n                    if (err || !evs || !evs.length) { return fallback(); }\r\n                    sendJson(res, 200, { races: raceRows(evs), season: true });\r\n                });\r\n                return true;\r\n            }\r\n            // Search a place by name: the user types \"Caldas da Rainha\" and the panel gets the\r\n            // coordinates from Open-Meteo. POST is the reliable form in the Vetro panel frame.\r\n            if (sub === 'geocode' && (req.method === 'GET' || req.method === 'POST')) {\r\n                var gp = {}, gparts = qs.split('&'), gi, gkv;\r\n                for (gi = 0; gi < gparts.length; gi++) {\r\n                    gkv = gparts[gi].split('=');\r\n                    if (gkv[0]) { gp[dec(gkv[0])] = dec(gkv[1] || ''); }\r\n                }\r\n                function search() {\r\n                    var name = clean(gp.name || '', 80).trim();\r\n                    if (name.length < 2) { return sendJson(res, 400, { error: 'type a place name' }); }\r\n                    var lang = cfg().lang === 'pt' ? 'pt' : 'en';\r\n                    var q = '/v1/search?name=' + encodeURIComponent(name) + '&count=8&language=' + lang + '&format=json';\r\n                    getJson('geocoding-api.open-meteo.com', q, {}, function (err, d) {\r\n                        if (err) { return sendJson(res, 502, { error: String(err) }); }\r\n                        var out = [], i, r, lat, lon, nm, region;\r\n                        var list = (d && d.results) || [];\r\n                        for (i = 0; i < list.length; i++) {\r\n                            r = list[i] || {};\r\n                            lat = parseFloat(r.latitude); lon = parseFloat(r.longitude);\r\n                            nm = clean(r.name || '', 50).trim();\r\n                            if (!nm || !(lat >= -90 && lat <= 90) || !(lon >= -180 && lon <= 180)) { continue; }\r\n                            region = clean(r.admin1 || '', 40);\r\n                            if (r.country) { region += (region ? ', ' : '') + clean(r.country, 30); }\r\n                            out.push({\r\n                                id: 'c' + String(r.id || (Date.now() + i)),\r\n                                name: nm + (region ? ' (' + region + ')' : ''),\r\n                                lat: lat, lon: lon\r\n                            });\r\n                        }\r\n                        sendJson(res, 200, { places: out });\r\n                    });\r\n                }\r\n                if (req.method === 'POST') {\r\n                    readBody(req, function (raw) {\r\n                        var b = {}; try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\r\n                        if (b.name) { gp.name = String(b.name); }\r\n                        search();\r\n                    });\r\n                } else { search(); }\r\n                return true;\r\n            }\r\n            if (sub === 'poll' && req.method === 'POST') {\r\n                readBody(req, function (raw) {\r\n                    var b = {}; try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\r\n                    if (b.module === 'sport' || b.module === 'civ' || b.module === 'weather' || b.module === 'news') { poll(b.module); }\r\n                    else { poll('all'); }\r\n                    sendJson(res, 200, { ok: true });\r\n                });\r\n                return true;\r\n            }\r\n            if (sub === 'keycheck' && req.method === 'POST') {\r\n                afGet('/status', function (err, d) {\r\n                    if (err) { return sendJson(res, 502, { error: String(err) }); }\r\n                    var r = d && d.response || {}, q = r.requests || {}, s2 = r.subscription || {};\r\n                    var limit = parseInt(q.limit_day, 10) || 0, used = parseInt(q.current, 10) || 0;\r\n                    sendJson(res, 200, { ok: true, plan: s2.plan || '', limit: limit, used: used, remaining: Math.max(0, limit - used) });\r\n                });\r\n                return true;\r\n            }\r\n            if (sub === 'config' && req.method === 'POST') {\r\n                readBody(req, function (raw) {\r\n                    var b = {}, store = rawCfg(), c = cfg();\r\n                    var rawBefore = JSON.parse(JSON.stringify(store));\r\n                    var before = {\r\n                        clubs: JSON.stringify(c.football.clubs), prov: c.football.provider,\r\n                        feeds: c.news.feeds.join(','), place: c.weather.place,\r\n                        custom: JSON.stringify(c.weather.custom),\r\n                        wprov: c.weather.provider, wwhen: c.weather.when,\r\n                        civ: JSON.stringify(c.civ),\r\n                        mods: { sport: c.modules.sport, weather: c.modules.weather, news: c.modules.news }\r\n                    };\r\n                    try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\r\n                    b = b || {};\r\n                    // Wrong types must be refused instead of silently clamped to a default.\r\n                    var numeric = [\r\n                        ['weather', 'interval'], ['weather', 'seconds'], ['weather', 'volume'],\r\n                        ['weather', 'proactive', 'minutes'], ['weather', 'proactive', 'rainPct'],\r\n                        ['weather', 'proactive', 'windKmh'], ['weather', 'proactive', 'heatC'], ['weather', 'proactive', 'stormCode'],\r\n                        ['news', 'interval'], ['news', 'seconds'], ['news', 'count'], ['news', 'volume'],\r\n                        ['civ', 'interval'], ['civ', 'seconds'], ['civ', 'volume'],\r\n                        ['football', 'goalSeconds'], ['football', 'otherSeconds'], ['football', 'volume'],\r\n                        ['others', 'seconds'], ['others', 'volume']\r\n                    ];\r\n                    for (var np = 0; np < numeric.length; np++) {\r\n                        var node = b, ni;\r\n                        for (ni = 0; ni < numeric[np].length && node; ni++) { node = node[numeric[np][ni]]; }\r\n                        if (node !== undefined && typeof node !== 'number') {\r\n                            return sendJson(res, 400, { error: 'expected a number: ' + numeric[np].join('.') });\r\n                        }\r\n                    }\r\n                    var f = b.football || {}, ob = b.others || {}, we = b.weather || {}, ne = b.news || {}, mo = b.modules || {}, cv = b.civ || {}, sv = b.sim || {};\r\n                    if (b.lang === 'en' || b.lang === 'pt') { c.lang = b.lang; }\r\n                    Object.keys(c.modules).forEach(function (k) { if (typeof mo[k] === 'boolean') { c.modules[k] = mo[k]; } });\r\n\r\n                    if (f.provider !== undefined) {\r\n                        if (!PROVIDERS.hasOwnProperty(f.provider)) { return sendJson(res, 400, { error: 'unknown provider' }); }\r\n                        c.football.provider = f.provider;\r\n                    }\r\n                    if (f.clubs !== undefined) {\r\n                        if (!Array.isArray(f.clubs)) { return sendJson(res, 400, { error: 'clubs must be a list' }); }\r\n                        if (f.clubs.length > MAX_CLUBS) { return sendJson(res, 400, { error: 'too many clubs' }); }\r\n                        var i, cl, list = [];\r\n                        for (i = 0; i < f.clubs.length; i++) {\r\n                            cl = normClub(f.clubs[i], c.lang);\r\n                            if (!cl) { return sendJson(res, 400, { error: 'bad club' }); }\r\n                            if (!byId(list, cl.id)) { list.push(cl); }\r\n                        }\r\n                        c.football.clubs = list;\r\n                    }\r\n                    if (f.alerts && typeof f.alerts === 'object') {\r\n                        Object.keys(c.football.alerts).forEach(function (k) { if (typeof f.alerts[k] === 'boolean') { c.football.alerts[k] = f.alerts[k]; } });\r\n                    }\r\n                    if (f.goalSeconds !== undefined) { c.football.goalSeconds = clamp(f.goalSeconds, 5, 60, c.football.goalSeconds); }\r\n                    if (f.otherSeconds !== undefined) { c.football.otherSeconds = clamp(f.otherSeconds, 3, 30, c.football.otherSeconds); }\r\n                    if (typeof f.sound === 'boolean') { c.football.sound = f.sound; }\r\n                    if (f.mode !== undefined) { if (byId(MODES, f.mode)) { c.football.mode = f.mode; } }\r\n                    if (f.volume !== undefined) { c.football.volume = clamp(f.volume, 10, 100, c.football.volume); }\r\n                    if (f.nextGame && typeof f.nextGame === 'object') {\r\n                        if (typeof f.nextGame.enabled === 'boolean') { c.football.nextGame.enabled = f.nextGame.enabled; }\r\n                        if (f.nextGame.minutes !== undefined) {\r\n                            c.football.nextGame.minutes = clamp(f.nextGame.minutes, 0, 120, c.football.nextGame.minutes);\r\n                        }\r\n                    }\r\n\r\n                    if (ob.picks !== undefined) {\r\n                        if (!Array.isArray(ob.picks)) { return sendJson(res, 400, { error: 'picks must be a list' }); }\r\n                        if (ob.picks.length > MAX_PICKS) { return sendJson(res, 400, { error: 'too many picks' }); }\r\n                        var j, pk, picks = [], seen = {};\r\n                        for (j = 0; j < ob.picks.length; j++) {\r\n                            pk = normPick(ob.picks[j]);\r\n                            if (!pk) { return sendJson(res, 400, { error: 'bad pick' }); }\r\n                            var pk2 = pickKey(pk);\r\n                            if (!seen[pk2]) { seen[pk2] = true; picks.push(pk); }\r\n                        }\r\n                        c.others.picks = picks;\r\n                    }\r\n                    if (ob.alerts && typeof ob.alerts === 'object') {\r\n                        Object.keys(c.others.alerts).forEach(function (k) { if (typeof ob.alerts[k] === 'boolean') { c.others.alerts[k] = ob.alerts[k]; } });\r\n                    }\r\n                    if (ob.seconds !== undefined) { c.others.seconds = clamp(ob.seconds, 3, 30, c.others.seconds); }\r\n                    if (typeof ob.sound === 'boolean') { c.others.sound = ob.sound; }\r\n                    if (ob.mode !== undefined) { if (byId(MODES, ob.mode)) { c.others.mode = ob.mode; } }\r\n                    if (ob.volume !== undefined) { c.others.volume = clamp(ob.volume, 10, 100, c.others.volume); }\r\n\r\n                    if (we.custom !== undefined) {\r\n                        if (!Array.isArray(we.custom)) { return sendJson(res, 400, { error: 'custom must be a list' }); }\r\n                        if (we.custom.length > MAX_PLACES) { return sendJson(res, 400, { error: 'too many places' }); }\r\n                        var cpl = [], cseen = {}, cj, cn;\r\n                        for (cj = 0; cj < we.custom.length; cj++) {\r\n                            cn = normPlace(we.custom[cj]);\r\n                            if (!cn) { return sendJson(res, 400, { error: 'bad place' }); }\r\n                            if (!cseen[cn.id]) { cseen[cn.id] = true; cpl.push(cn); }\r\n                        }\r\n                        c.weather.custom = cpl;\r\n                        // The place that was removed cannot stay selected.\r\n                        if (c.weather.place && c.weather.place.charAt(0) === 'c' && !byId(cpl, c.weather.place)) {\r\n                            c.weather.place = DEFAULTS.weather.place;\r\n                        }\r\n                    }\r\n                    if (typeof cv.enabled === 'boolean') { c.civ.enabled = cv.enabled; }\r\n                    if (cv.district !== undefined) {\r\n                        if (!byId(CIV_AREAS, cv.district)) { return sendJson(res, 400, { error: 'unknown district' }); }\r\n                        c.civ.district = cv.district;\r\n                    }\r\n                    if (cv.levels && typeof cv.levels === 'object') {\r\n                        Object.keys(c.civ.levels).forEach(function (k) {\r\n                            if (typeof cv.levels[k] === 'boolean') { c.civ.levels[k] = cv.levels[k]; }\r\n                        });\r\n                    }\r\n                    if (typeof cv.anepc === 'boolean') { c.civ.anepc = cv.anepc; }\r\n                    if (typeof cv.news === 'boolean') { c.civ.news = cv.news; }\r\n                    if (cv.keywords !== undefined) { c.civ.keywords = clean(cv.keywords, 220); }\r\n                    if (cv.interval !== undefined) { c.civ.interval = clamp(cv.interval, 5, 240, c.civ.interval); }\r\n                    if (cv.seconds !== undefined) { c.civ.seconds = clamp(cv.seconds, 3, 60, c.civ.seconds); }\r\n                    if (typeof cv.sound === 'boolean') { c.civ.sound = cv.sound; }\r\n                    if (cv.mode !== undefined) { if (byId(MODES, cv.mode)) { c.civ.mode = cv.mode; } }\r\n                    if (cv.volume !== undefined) { c.civ.volume = clamp(cv.volume, 10, 100, c.civ.volume); }\r\n\r\n                    if (sv.clubs !== undefined) {\r\n                        if (!Array.isArray(sv.clubs)) { return sendJson(res, 400, { error: 'clubs must be a list' }); }\r\n                        if (sv.clubs.length > 10) { return sendJson(res, 400, { error: 'too many test clubs' }); }\r\n                        var scl = [], sn, si;\r\n                        for (si = 0; si < sv.clubs.length; si++) {\r\n                            sn = normSimClub(sv.clubs[si]);\r\n                            if (!sn) { return sendJson(res, 400, { error: 'bad test club' }); }\r\n                            scl.push(sn);\r\n                        }\r\n                        c.sim.clubs = scl;\r\n                    }\r\n\r\n                    if (we.place !== undefined) {\r\n                        if (!byId(allPlaces(c), we.place)) { return sendJson(res, 400, { error: 'unknown place' }); }\r\n                        c.weather.place = we.place;\r\n                    }\r\n                    if (we.interval !== undefined) { c.weather.interval = clamp(we.interval, 5, 240, c.weather.interval); }\r\n                    if (we.seconds !== undefined) { c.weather.seconds = clamp(we.seconds, 3, 30, c.weather.seconds); }\r\n                    if (typeof we.quiet === 'boolean') { c.weather.quiet = we.quiet; }\r\n                    if (typeof we.sound === 'boolean') { c.weather.sound = we.sound; }\r\n                    if (we.mode !== undefined) { if (byId(MODES, we.mode)) { c.weather.mode = we.mode; } }\r\n                    if (we.volume !== undefined) { c.weather.volume = clamp(we.volume, 10, 100, c.weather.volume); }\r\n                    if (we.provider !== undefined) {\r\n                        if (!byId(WEATHER_PROVIDERS, we.provider)) { return sendJson(res, 400, { error: 'unknown weather provider' }); }\r\n                        c.weather.provider = we.provider;\r\n                    }\r\n                    if (we.when !== undefined) {\r\n                        if (!byId(WEATHER_WHEN, we.when)) { return sendJson(res, 400, { error: 'unknown weather schedule' }); }\r\n                        c.weather.when = we.when;\r\n                    }\r\n                    if (we.proactive && typeof we.proactive === 'object') {\r\n                        var wpa = we.proactive;\r\n                        if (typeof wpa.enabled === 'boolean') { c.weather.proactive.enabled = wpa.enabled; }\r\n                        if (wpa.minutes !== undefined) { c.weather.proactive.minutes = clamp(wpa.minutes, 30, 180, c.weather.proactive.minutes); }\r\n                        if (typeof wpa.rain === 'boolean') { c.weather.proactive.rain = wpa.rain; }\r\n                        if (typeof wpa.wind === 'boolean') { c.weather.proactive.wind = wpa.wind; }\r\n                        if (typeof wpa.heat === 'boolean') { c.weather.proactive.heat = wpa.heat; }\r\n                        if (typeof wpa.storm === 'boolean') { c.weather.proactive.storm = wpa.storm; }\r\n                        if (wpa.rainPct !== undefined) { c.weather.proactive.rainPct = clamp(wpa.rainPct, 10, 100, c.weather.proactive.rainPct); }\r\n                        if (wpa.windKmh !== undefined) { c.weather.proactive.windKmh = clamp(wpa.windKmh, 10, 120, c.weather.proactive.windKmh); }\r\n                        if (wpa.heatC !== undefined) { c.weather.proactive.heatC = clamp(wpa.heatC, 20, 50, c.weather.proactive.heatC); }\r\n                        if (wpa.stormCode !== undefined) { c.weather.proactive.stormCode = clamp(wpa.stormCode, 80, 99, c.weather.proactive.stormCode); }\r\n                    }\r\n\r\n                    if (ne.feeds !== undefined) {\r\n                        if (!Array.isArray(ne.feeds)) { return sendJson(res, 400, { error: 'feeds must be a list' }); }\r\n                        var k2, fl = [];\r\n                        for (k2 = 0; k2 < ne.feeds.length && fl.length < MAX_FEEDS; k2++) {\r\n                            if (!byId(FEEDS, String(ne.feeds[k2]))) { return sendJson(res, 400, { error: 'unknown feed' }); }\r\n                            if (fl.indexOf(String(ne.feeds[k2])) < 0) { fl.push(String(ne.feeds[k2])); }\r\n                        }\r\n                        if (!fl.length) { return sendJson(res, 400, { error: 'choose at least one feed' }); }\r\n                        c.news.feeds = fl;\r\n                    }\r\n                    if (ne.interval !== undefined) { c.news.interval = clamp(ne.interval, 5, 240, c.news.interval); }\r\n                    if (ne.seconds !== undefined) { c.news.seconds = clamp(ne.seconds, 3, 30, c.news.seconds); }\r\n                    if (typeof ne.quiet === 'boolean') { c.news.quiet = ne.quiet; }\r\n                    if (ne.count !== undefined) { c.news.count = clamp(ne.count, 1, 3, c.news.count); }\r\n                    if (typeof ne.sound === 'boolean') { c.news.sound = ne.sound; }\r\n                    if (ne.mode !== undefined) { if (byId(MODES, ne.mode)) { c.news.mode = ne.mode; } }\r\n                    if (ne.volume !== undefined) { c.news.volume = clamp(ne.volume, 10, 100, c.news.volume); }\r\n\r\n                    if (b.apiKey !== undefined) {\r\n                        var key = String(b.apiKey).trim();\r\n                        if (key && !/^[A-Za-z0-9_-]{8,80}$/.test(key)) { return sendJson(res, 400, { error: 'that does not look like an API key' }); }\r\n                        store.keys = store.keys || {};\r\n                        if (key) { store.keys.apifootball = key; } else { delete store.keys.apifootball; }\r\n                    }\r\n                    store.lang = c.lang; store.modules = c.modules;\r\n                    store.football = c.football; store.others = c.others;\r\n                    store.weather = c.weather; store.news = c.news; store.civ = c.civ; store.sim = c.sim;\r\n                    delete store.sport;                       // migrated into football\r\n                    ctx.config.set(store);\r\n                    // Only restart what actually changed: saving anything used to reset the news\r\n                    // baseline and re-poll every module, repeating the same banner.\r\n                    var sportReset = before.clubs !== JSON.stringify(c.football.clubs) || before.prov !== c.football.provider;\r\n                    if (sportReset) { resetSport(); }\r\n                    if (before.feeds !== c.news.feeds.join(',')) { newsApi.clear(); }\r\n                    if (before.civ !== JSON.stringify(c.civ)) { civSeen = {}; }\r\n                    sendJson(res, 200, { config: publicCfg() });\r\n                    if (sportReset || (!rawBefore.modules || !rawBefore.modules.sport) && c.modules.sport) { kick('sport', 1000); }\r\n                    if (before.place !== c.weather.place || before.custom !== JSON.stringify(c.weather.custom) ||\r\n                        before.wprov !== c.weather.provider || before.wwhen !== c.weather.when ||\r\n                        (!rawBefore.modules || !rawBefore.modules.weather) && c.modules.weather) { kick('weather', 2000); }\r\n                    if (before.feeds !== c.news.feeds.join(',') || (!rawBefore.modules || !rawBefore.modules.news) && c.modules.news) { kick('news', 3000); }\r\n                    if (before.civ !== JSON.stringify(c.civ) || (!rawBefore.civ && c.civ.enabled)) { kick('civ', 4000); }\r\n                });\r\n                return true;\r\n            }\r\n            // Goal simulation buttons: same notify path as real goals, but silent and without\r\n            // touching the clubs the Shard actually follows.\r\n            if (sub === 'test-club' && req.method === 'POST') {\r\n                readBody(req, function (raw) {\r\n                    var b = {}, c = cfg();\r\n                    try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\r\n                    var cl = byId(c.sim.clubs, String(b.id || ''));\r\n                    if (!cl) { return sendJson(res, 400, { error: 'unknown test club' }); }\r\n                    var title = 'Golo! ' + cl.name, msg = cl.msg || ('Golo do ' + cl.name);\r\n                    banner(title, msg, cl.level, '', 8, {\r\n                        mode: 'overlay', theme: 'sport', image: cl.logo, group: false\r\n                    });\r\n                    addLog('test', 'goalSim', title + ' - ' + msg);\r\n                    sendJson(res, 200, { ok: true, title: title, message: msg });\r\n                });\r\n                return true;\r\n            }\r\n            if (sub === 'test' && req.method === 'POST') {\r\n                readBody(req, function (raw) {\r\n                    var b = {}, c = cfg(), t = TXT[c.lang];\r\n                    try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\r\n                    var kind = b.kind || 'goal';\r\n                    var club = byId(c.football.clubs, String(b.club || '')) || c.football.clubs[0];\r\n                    if (kind === 'next') {\r\n                        // Test the kick-off warning without consuming the real one (nextWarned untouched).\r\n                        var ng = nextList()[0];\r\n                        var title = TITLE_PRE;\r\n                        var msg = ng ? (ng.home + ' \\u00D7 ' + ng.away + ' \\u00B7 ' + ng.line) :\r\n                            (t.team + ' \\u00D7 ' + t.test + ' \\u00B7 ' + t.today + ' 20:30');\r\n                        banner(title, msg, 'info', E.whistle, c.football.otherSeconds,\r\n                            { sound: c.football.sound ? 'reward' : '', group: false, mode: c.football.mode,\r\n                              image: logoFor('club', c.football.provider, 'soccer', club ? club.id : ''),\r\n                              volume: c.football.volume });\r\n                        addLog('test', 'next', msg);\r\n                        sendJson(res, 200, { ok: true });\r\n                        return;\r\n                    }\r\n                    if (kind === 'weather' || kind === 'news' || kind === 'civ') {\r\n                        sendJson(res, 200, { ok: true });\r\n                        if (kind === 'weather') { poll('weather', true); }\r\n                        else if (kind === 'news') { poll('news', true); }\r\n                        else { poll('civ', true); }\r\n                        return;\r\n                    }\r\n                    var w = {\r\n                        key: 'test', kind: 'club', name: club ? club.name : t.team, teamId: club ? club.id : '0',\r\n                        alerts: club && club.alerts ? club.alerts : c.football.alerts,\r\n                        goalSeconds: c.football.goalSeconds,\r\n                        otherSeconds: c.football.otherSeconds, sound: c.football.sound,\r\n                        mode: c.football.mode, lang: c.lang, volume: c.football.volume,\r\n                        logo: logoFor('club', c.football.provider, 'soccer', club ? club.id : '')\r\n                    };\r\n                    if (kind === 'score') {\r\n                        w = { key: 'test', kind: 'other', name: t.team, teamId: '0', alerts: c.others.alerts,\r\n                            goalSeconds: c.others.seconds, otherSeconds: c.others.seconds,\r\n                            sound: c.others.sound, mode: c.others.mode, lang: c.lang, volume: c.others.volume };\r\n                    }\r\n                    var known = { goal: 1, against: 1, cardY: 1, cardR: 1, sub: 1, var: 1, penalty: 1, penMiss: 1, start: 1, half: 1, end: 1, score: 1 };\r\n                    if (kind === 'card') { kind = 'cardY'; }\r\n                    var line = status.sport.line || (w.name + ' 1-0 ' + t.test);\r\n                    var m = {\r\n                        id: 'test', state: 'in', desc: t.test, clock: \"22'\",\r\n                        home: { name: w.name, short: w.name, score: 1, id: w.teamId },\r\n                        away: { name: t.test, short: t.test, score: 0, id: '0' }\r\n                    };\r\n                    announce(known[kind] ? kind : 'goal', w, m, { player: t.test, minute: \"22'\", detail: t.test, team: t.test });\r\n                    addLog('test', kind, line);\r\n                    sendJson(res, 200, { ok: true });\r\n                });\r\n                return true;\r\n            }\r\n            return false;\r\n        }\r\n    };\r\n};\r\n","news.js":"'use strict';\n// News module: public RSS feeds plus one Google News search per club with news enabled.\n// Plain ES5. The Shard injects the HTTP client, config, status, scheduler and the one notify path.\nmodule.exports = function (env) {\n    var getUrl = env.getUrl, clean = env.clean, stripTags = env.stripTags, byId = env.byId;\n    var FEEDS = env.FEEDS, GN = env.GN, MAX_FEEDS = env.MAX_FEEDS, MAX_CLUBS = env.MAX_CLUBS;\n    var quietNow = env.quietNow, TXT = env.TXT, E = env.E;\n    var banner = env.banner, addLog = env.addLog, cfg = env.cfg;\n    var status = env.status, schedule = env.schedule, persistHistory = env.persistHistory;\n    var newsSeen = {};             // feed id -> last seen item keys (persisted by the Shard)\n\n    function rssTag(block, name) {\n        var re = new RegExp('<' + name + '(?:\\\\s[^>]*)?>([\\\\s\\\\S]*?)</' + name + '>', 'i');\n        var m = re.exec(block);\n        return m ? clean(stripTags(m[1]), 180) : '';\n    }\n    function rssItems(xml, max) {\n        var blocks = (String(xml || '').match(/<item[\\s\\S]*?<\\/item>/gi) || []), out = [], i;\n        for (i = 0; i < blocks.length && out.length < max; i++) {\n            out.push({ key: rssTag(blocks[i], 'link') || rssTag(blocks[i], 'title'), title: rssTag(blocks[i], 'title'), date: rssTag(blocks[i], 'pubDate') });\n        }\n        return out;\n    }\n    function googleNewsUrl(name, lang) {\n        var q = encodeURIComponent('\"' + name + '\"');\n        return GN + q + (lang === 'pt' ? '&hl=pt-PT&gl=PT&ceid=PT:pt-150' : '&hl=en-US&gl=US&ceid=US:en');\n    }\n    // Selected feeds plus one Google News feed per club that has \"club news\" on.\n    function feedList(c) {\n        var out = [], i, f;\n        for (i = 0; i < c.news.feeds.length; i++) {\n            f = byId(FEEDS, c.news.feeds[i]);\n            if (f) { out.push(f); }\n        }\n        for (i = 0; i < c.football.clubs.length; i++) {\n            if (c.football.clubs[i].news) {\n                out.push({\n                    id: 'club:' + c.football.clubs[i].id,\n                    name: c.football.clubs[i].name,\n                    url: googleNewsUrl(c.football.clubs[i].name, c.lang)\n                });\n            }\n        }\n        return out.slice(0, MAX_FEEDS + MAX_CLUBS);\n    }\n\n    var NEWS_MAX_PER_POLL = 4, NEWS_MIN_GAP = 1000;\n    function sendNews(items, feed, c, budget, cb) {\n        var i = 0, sent = 0;\n        function step() {\n            if (i >= items.length || budget.left <= 0) { return cb(sent); }\n            var item = items[i++];\n            var delay = Math.max(0, NEWS_MIN_GAP - (Date.now() - budget.lastAt));\n            function fire() {\n                if (env.isRunning && !env.isRunning()) { return cb(sent); }\n                banner(E.news + ' ' + TXT[c.lang].news + ' \\u00B7 ' + feed.name, item.title, 'info', E.news, c.news.seconds,\n                    { sound: c.news.sound ? 'soft' : '', mode: c.news.mode, volume: c.news.volume });\n                addLog('news', 'news', item.title);\n                budget.left--; sent++;\n                budget.lastAt = Date.now();\n                step();\n            }\n            if (delay > 0) { setTimeout(fire, delay); } else { fire(); }\n        }\n        step();\n    }\n    function fetchFeed(feed, c, manual, budget, cb) {\n        getUrl(feed.url, {}, false, function (err, xml) {\n            if (err) { addLog('news', 'error', feed.name + ': ' + err); return cb(0); }\n            var items = rssItems(xml, 5), seen = newsSeen[feed.id], i, fresh = [], keys;\n            if (!items.length) { return cb(0); }\n            if (!status.news.line) { status.news.line = items[0].title; status.news.state = feed.name; }\n            keys = items.map(function (x) { return x.key; });\n            if (!seen) {\n                // First read of a feed is a baseline: the headlines already there are marked as seen\n                // and not announced, so a restart (or a new install) does not repeat yesterday's news.\n                newsSeen[feed.id] = keys;\n                seen = keys;\n                addLog('news', 'base', feed.name + ': baseline ' + items.length);\n                if (!manual) { return cb(0); }\n                if (items[0]) { fresh.push(items[0]); }\n            } else {\n                for (i = 0; i < items.length; i++) {\n                    if (items[i].key && seen.indexOf(items[i].key) < 0) { fresh.push(items[i]); }\n                }\n            }\n            if (!fresh.length) {\n                // A test must show something even when nothing changed: fall back to the newest\n                // headline of the feed. Only one banner per test, so it never floods the screen.\n                if (manual && items[0]) { fresh.push(items[0]); }\n                else { return cb(0); }\n            }\n            if (!manual && c.news.quiet && quietNow()) {\n                newsSeen[feed.id] = keys.concat(seen).slice(0, 40);\n                addLog('news', 'quiet', feed.name + ': ' + fresh[0].title);\n                return cb(0);\n            }\n            // One global budget per poll, shared by every feed (and club news). Headlines that do\n            // not fit are NOT marked as seen, so they are announced in the next poll instead of\n            // being lost. sendNews spaces them at least one second apart.\n            var take = Math.min(fresh.length, c.news.count, budget.left);\n            var chosen = fresh.slice(0, take);\n            newsSeen[feed.id] = chosen.map(function (x) { return x.key; }).concat(seen).slice(0, 40);\n            sendNews(chosen, feed, c, budget, cb);\n        });\n    }\n    function pollNews(manual) {\n        var c = cfg(), list = feedList(c);\n        status.news.at = Date.now();\n        status.news.error = '';\n        status.news.line = ''; status.news.state = '';   // do not keep the previous source on screen\n        if (!list.length) { status.news.line = ''; status.news.state = ''; return schedule('news', 300000); }\n        var i = 0, sentDone = false, budget = { left: manual ? 1 : NEWS_MAX_PER_POLL, lastAt: 0 };\n        function step() {\n            if (sentDone || i >= list.length) { persistHistory(false); return schedule('news', c.news.interval * 60000); }\n            var f = list[i++];\n            fetchFeed(f, c, manual, budget, function (n) {\n                if (manual && n > 0) { sentDone = true; }\n                step();\n            });\n        }\n        step();\n    }\n\n    return {\n        rssTag: rssTag, rssItems: rssItems, feedList: feedList, pollNews: pollNews,\n        load: function (h) { newsSeen = h && typeof h === 'object' ? h : {}; },\n        seen: function () { return newsSeen; },\n        clear: function () { newsSeen = {}; },\n        // Keep the persisted history small: at most 40 seen keys per feed.\n        trim: function () {\n            var keys = Object.keys(newsSeen), i;\n            for (i = 0; i < keys.length; i++) {\n                if (Array.isArray(newsSeen[keys[i]]) && newsSeen[keys[i]].length > 40) {\n                    newsSeen[keys[i]] = newsSeen[keys[i]].slice(-40);\n                }\n            }\n            return newsSeen;\n        }\n    };\n};\n","providers/af.js":"'use strict';\n// Optional API-Football provider (football only). No key is shipped: the Shard injects getKey()\n// so the secret stays in ctx.config and never appears in a route response or in this file.\nmodule.exports = function (env) {\n    var getJson = env.getJson, clean = env.clean, byId = env.byId;\n    var COMPS = env.COMPS, getKey = env.getKey;\n    var af = { live: false, nextKick: {} };\n\n    function afGet(p, cb) {\n        var key = getKey();\n        if (!key) { return cb('no API-Football key set'); }\n        getJson('v3.football.api-sports.io', p, { 'x-apisports-key': key }, function (err, d) {\n            if (err) { return cb(err); }\n            var e = d && d.errors;\n            if (e && ((Array.isArray(e) && e.length) || (!Array.isArray(e) && Object.keys(e).length))) {\n                return cb('API-Football: ' + clean(JSON.stringify(e), 120));\n            }\n            cb(null, d && d.response);\n        });\n    }\n    function afEvents(items) {\n        var out = [], i, d, kind = '', extra = '';\n        for (i = 0; i < (items || []).length; i++) {\n            d = items[i]; kind = String(d.type || ''); extra = String(d.detail || '');\n            if (/missed/i.test(extra)) { continue; }\n            if (/card/i.test(kind) || /card/i.test(extra)) {\n                kind = /red/i.test(extra) ? 'cardR' : 'cardY';\n            } else if (/penalty/i.test(kind) || /penalty/i.test(extra)) {\n                kind = /scored|goal/i.test(extra) ? 'goal' :\n                    (/miss|save|post|wide|over/i.test(extra) ? 'penMiss' : 'penalty');\n            } else if (/goal/i.test(kind)) { kind = 'goal'; }\n            else if (/subst/i.test(kind)) { kind = 'sub'; }\n            else { continue; }\n            out.push({\n                kind: kind, teamId: String((d.team && d.team.id) || ''),\n                minute: (d.time && d.time.elapsed) ? String(d.time.elapsed) + \"'\" : '',\n                player: String((d.player && d.player.name) || ''),\n                detail: String((d.assist && d.assist.name) || extra),\n                text: extra || kind\n            });\n        }\n        return out;\n    }\n    function afNorm(f) {\n        var s = f.fixture && f.fixture.status && f.fixture.status.short || 'NS';\n        var st = (s === 'NS' || s === 'TBD' || s === 'PST') ? 'pre' :\n            (/^(FT|AET|PEN|CANC|ABD|AWD|WO)$/.test(s) ? 'post' : 'in');\n        return {\n            id: 'af-' + f.fixture.id, state: st,\n            desc: s === 'HT' ? 'Halftime' : String((f.fixture.status && f.fixture.status.long) || s),\n            clock: f.fixture.status && f.fixture.status.elapsed ? f.fixture.status.elapsed + \"'\" : '',\n            date: f.fixture.date,\n            home: { id: String(f.teams.home.id), name: f.teams.home.name, short: f.teams.home.name, score: f.goals && f.goals.home || 0 },\n            away: { id: String(f.teams.away.id), name: f.teams.away.name, short: f.teams.away.name, score: f.goals && f.goals.away || 0 },\n            events: afEvents(f.events)\n        };\n    }\n    function afTeams(league, cb) {\n        var d = new Date(), season = d.getMonth() < 6 ? d.getFullYear() - 1 : d.getFullYear();\n        var lg = byId(COMPS, league);\n        afGet('/teams?league=' + ((lg && lg.af) || 94) + '&season=' + season, function (err, list) {\n            if (err) { return cb(err); }\n            cb(null, (list || []).map(function (t) { return { id: String(t.team.id), name: t.team.name }; }));\n        });\n    }\n\n    return {\n        afGet: afGet, afEvents: afEvents, afNorm: afNorm, afTeams: afTeams,\n        state: function () { return af; },\n        reset: function () { af = { live: false, nextKick: {} }; }\n    };\n};\n","providers/espn.js":"'use strict';\n// ESPN public scoreboard: teams, matches, summaries, next-fixture scan and normalization.\n// Plain ES5 (the TV runs Node 4.4). No network or notification code lives here: the Shard injects\n// getJson/clean/addLog/fmtKick and owns the local HTTP client and the notify path.\nmodule.exports = function (env) {\n    var getJson = env.getJson, clean = env.clean, addLog = env.addLog;\n    var fmtKick = env.fmtKick, OTHER = env.OTHER;\n    var compCache = {};            // \"soccer/por.1\" -> { at, nextAt, events }\n    var sumCache = {};             // event id -> { at, events } (summary: scorer, cards, subs)\n    var sumPending = {}, sumWait = {}; // one in-flight summary per match, shared by all my clubs in it\n    var dayCache = {};             // \"soccer/<comp>|YYYYMMDD\" -> { at, events }, shared by every club\n    var seasonCache = {};          // \"racing/f1|2026\" -> { at, nextAt, events } for the season picker\n    var nextHint = {};             // watch key -> { date: YYYYMMDD } of the last found fixture\n\n    function espnSide(c) {\n        var t = c.team || c.athlete || {};\n        return {\n            id: String(t.id || c.id || ''),\n            name: String(t.displayName || t.fullName || t.name || ''),\n            short: String(t.shortDisplayName || t.shortName || t.name || t.displayName || ''),\n            score: parseInt(c.score, 10) || 0\n        };\n    }\n    function espnEvent(d) {\n        var typ = (d.type && d.type.text) || '', tl = typ.toLowerCase();\n        var kind = '';\n        if (d.scoringPlay || /goal|penalty - scored|own goal/.test(tl)) { kind = 'goal'; }\n        // ESPN reports a saved/missed penalty as \"Penalty - Saved\" with scoringPlay=false, so it\n        // used to be dropped entirely: no goal and no banner. Announce it as its own event.\n        else if (/penalty/.test(tl)) { kind = /award/.test(tl) ? 'penalty' : 'penMiss'; }\n        else if (/yellow card/.test(tl)) { kind = 'cardY'; }\n        else if (/red card/.test(tl)) { kind = 'cardR'; }\n        else if (/substitution/.test(tl)) { kind = 'sub'; }\n        else { return null; }\n        var parts = d.participants || [], i, p = null, q = null, role;\n        // ESPN key events mark the scorer/assist explicitly in some feeds and only order them in\n        // others. Prefer the explicit role, then the first athlete involved, then the first player.\n        for (i = 0; i < parts.length; i++) {\n            role = String(parts[i].type || '');\n            if (!p && /scor|goal/i.test(role)) { p = parts[i].athlete || parts[i]; }\n            else if (!q && /assist/i.test(role)) { q = parts[i].athlete || parts[i]; }\n        }\n        if (!p) { p = (d.athletesInvolved && d.athletesInvolved[0]) || (parts[0] && parts[0].athlete) || null; }\n        if (!q) { q = (parts[1] && parts[1].athlete) || null; }\n        p = p || {}; q = q || {};\n        var player = String(p.displayName || p.fullName || p.shortName || '');\n        if (!player && kind === 'goal') {\n            // Last resort: the scorer is named in the event text but has no athlete object.\n            var txt = String(d.text || typ);\n            var g1 = /(?:scored\\s+by|goal\\s+by|golo\\s+de)\\s+([A-Za-z\\u00C0-\\u024F][^,.!?]+)/i.exec(txt);\n            var g2 = /^([A-Za-z\\u00C0-\\u024F][^,.!?]+?)\\s+(?:scores?|goals?|marca)/i.exec(txt);\n            player = g1 ? clean(g1[1], 40) : (g2 ? clean(g2[1], 40) : '');\n        }\n        return {\n            kind: kind, teamId: String((d.team && d.team.id) || ''),\n            minute: (d.clock && d.clock.displayValue) || '',\n            player: player,\n            detail: String(q.displayName || q.fullName || q.shortName || ''),\n            text: String(d.text || typ)\n        };\n    }\n    function espnEvents(items) {\n        var out = [], i, ev;\n        for (i = 0; i < items.length; i++) { ev = espnEvent(items[i]); if (ev) { out.push(ev); } }\n        return out;\n    }\n    function espnNorm(e) {\n        var comp = (e.competitions && e.competitions[0]) || {}, cs = comp.competitors || [], i;\n        var home = null, away = null, st = (e.status && e.status.type) || {};\n        for (i = 0; i < cs.length; i++) {\n            if (cs[i].homeAway === 'home') { home = espnSide(cs[i]); }\n            else { away = espnSide(cs[i]); }\n        }\n        if (!home || !away) { return null; }\n        return {\n            id: 'espn-' + e.id, state: st.state || '', desc: st.description || '',\n            clock: (e.status && e.status.displayClock) || '', date: e.date,\n            home: home, away: away, events: espnEvents(comp.details || [])\n        };\n    }\n    // Racing has no home/away: competitors are drivers with an `order` (the position). Only the\n    // leader and the runner-up are kept, which is all a banner needs.\n    function espnRaceNorm(e) {\n        var comp = (e.competitions && e.competitions[0]) || {}, cs = comp.competitors || [], i, list = [];\n        for (i = 0; i < cs.length; i++) {\n            var t = cs[i].athlete || cs[i].team || {};\n            var name = String(t.displayName || t.fullName || t.name || '');\n            if (name) { list.push({ order: parseInt(cs[i].order, 10) || 99, id: String(t.id || ''), name: name }); }\n        }\n        if (!list.length) { return null; }\n        list.sort(function (a, b) { return a.order - b.order; });\n        var st = (e.status && e.status.type) || {};\n        return {\n            id: 'espn-' + e.id, state: st.state || '', desc: String(e.name || st.description || ''),\n            clock: '', date: e.date, race: true,\n            home: { id: list[0].id, name: list[0].name, short: list[0].name, score: 0 },\n            away: { id: list[1] ? list[1].id : '', name: list[1] ? list[1].name : '', short: list[1] ? list[1].name : '', score: 0 },\n            events: []\n        };\n    }\n    function espnTeams(sport, league, cb) {\n        var p = sport === 'soccer' ? 'soccer/' + league : ((OTHER[sport] || OTHER.basketball).espn);\n        getJson('site.api.espn.com', '/apis/site/v2/sports/' + p + '/teams', {}, function (err, d) {\n            if (err) { return cb(err); }\n            var list = [];\n            try {\n                d.sports[0].leagues[0].teams.forEach(function (t) {\n                    var side = espnSide({ team: t.team || t, score: 0 });\n                    if (side.id && side.name) { list.push({ id: side.id, name: side.name }); }\n                });\n            } catch (e) { return cb('unexpected answer'); }\n            cb(null, list);\n        });\n    }\n    // One scoreboard per competition, cached: 20 s while a match is live or about to start (within\n    // 30 min), 2 min otherwise and 5 min when it is empty. Five competitions = five fetches, not one\n    // per club; two picks of the same sport share that one fetch but keep their own baselines.\n    function compEvents(sportPath, cb) {\n        var hit = compCache[sportPath];\n        if (hit && Date.now() < hit.nextAt) { return cb(null, hit.events); }\n        getJson('site.api.espn.com', '/apis/site/v2/sports/' + sportPath + '/scoreboard', {}, function (err, data) {\n            if (err) { return cb(err); }\n            var evs = (data && data.events) || [], live = false, soon = false, i, st, kick;\n            for (i = 0; i < evs.length; i++) {\n                st = (evs[i].status || {}).type || {};\n                if (st.state === 'in') { live = true; }\n                if (st.state === 'pre') {\n                    kick = new Date(evs[i].date).getTime();\n                    if (kick - Date.now() < 1800000) { soon = true; }\n                }\n            }\n            var ttl = (live || soon) ? 20000 : (evs.length ? 120000 : 300000);\n            compCache[sportPath] = { at: Date.now(), events: evs, nextAt: Date.now() + ttl };\n            cb(null, evs);\n        });\n    }\n    // The plain scoreboard only carries the current race. ESPN accepts one ?dates=YYYY per request\n    // and answers with every event of that season, which is what the F1 picker needs.\n    function seasonRaces(sportPath, cb) {\n        var year = String(new Date().getFullYear()), key = sportPath + '|' + year, hit = seasonCache[key];\n        if (hit && Date.now() < hit.nextAt) { return cb(null, hit.events); }\n        getJson('site.api.espn.com', '/apis/site/v2/sports/' + sportPath + '/scoreboard?dates=' + year, {}, function (err, data) {\n            if (err) { return cb(err); }\n            var evs = (data && data.events) || [];\n            if (!evs.length) { return cb('empty season'); }\n            seasonCache[key] = { at: Date.now(), events: evs, nextAt: Date.now() + 21600000 }; // 6 h\n            cb(null, evs);\n        });\n    }\n    // Compare a race label with an ESPN event name ignoring common words and punctuation.\n    function raceKey(s) {\n        return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ')\n            .replace(/\\b(grand|prix|formula|f1|1|race|the|of|20\\d\\d)\\b/g, ' ')\n            .replace(/\\s+/g, ' ').trim();\n    }\n    function findMatch(evs, sport, teamId, name) {\n        var i, j, m, want, label, ev = null;\n        if (sport === 'f1') {\n            // A race pick carries the ESPN event id in `teamId`; older configs had only a label.\n            // Match the id first, then a distinctive name. Never fall back to evs[0] for an explicit\n            // pick: a stale id/name would silently follow a different Grand Prix and announce its\n            // winner. Only the legacy generic pick (no id, no distinctive name) uses evs[0].\n            if (teamId) {\n                for (i = 0; i < evs.length; i++) {\n                    if (String(evs[i].id) === String(teamId)) { ev = evs[i]; break; }\n                }\n            }\n            want = raceKey(name);\n            if (!ev && want.length >= 3) {\n                for (i = 0; i < evs.length && !ev; i++) {\n                    label = raceKey(evs[i].name || evs[i].shortName || evs[i].shortDisplayName || evs[i].displayName || '');\n                    if (label.length >= 3 && (label === want || label.indexOf(want) > -1 || want.indexOf(label) > -1)) { ev = evs[i]; }\n                }\n            }\n            if (!ev) {\n                if (teamId || want.length >= 3) { return null; }\n                ev = evs[0];\n            }\n            return ev ? { m: espnRaceNorm(ev), raw: ev } : null;\n        }\n        for (i = 0; i < evs.length; i++) {\n            var cs = ((evs[i].competitions || [])[0] || {}).competitors || [];\n            for (j = 0; j < cs.length; j++) {\n                if (espnSide(cs[j]).id === teamId) {\n                    m = espnNorm(evs[i]);\n                    if (m) { return { m: m, raw: evs[i] }; }\n                }\n            }\n        }\n        return null;\n    }\n    // The summary adds scorer and substitutions. It is kept after the final whistle too: going back\n    // to the scoreboard details at \"post\" made the last goal look new and repeat.\n    function withSummary(sportPath, raw, m, cb) {\n        if (m.race || m.state === 'pre' || sportPath.indexOf('soccer') !== 0) { return cb(); }\n        var id = raw.id, hit = sumCache[id], ttl = m.state === 'post' ? 600000 : 60000;\n        if (hit && Date.now() - hit.at < ttl) { m.events = hit.events; return cb(); }\n        function finish() { if (sumCache[id]) { m.events = sumCache[id].events; } cb(); }\n        // Two of my clubs in the same match used to fire two identical summary requests before\n        // either filled the cache. Queue the second caller and give it the same result.\n        if (sumPending[id]) {\n            sumWait[id] = sumWait[id] || [];\n            sumWait[id].push(finish);\n            return;\n        }\n        sumPending[id] = true;\n        getJson('site.api.espn.com', '/apis/site/v2/sports/' + sportPath + '/summary?event=' + id, {}, function (e2, sum) {\n            if (!e2 && sum && sum.keyEvents) {\n                if (Object.keys(sumCache).length > 60) { sumCache = {}; }\n                sumCache[id] = { at: Date.now(), events: espnEvents(sum.keyEvents) };\n            } else if (hit) { sumCache[id] = hit; }\n            delete sumPending[id];\n            var q = sumWait[id] || [], i;\n            delete sumWait[id];\n            for (i = 0; i < q.length; i++) { q[i](); }\n            finish();\n        });\n    }\n\n    // ---- next fixture: day-by-day scoreboard scan, shared by every club of a competition ---------\n    function ymd(d) {\n        return String(d.getFullYear()) + ('0' + (d.getMonth() + 1)).slice(-2) + ('0' + d.getDate()).slice(-2);\n    }\n    function dayEvents(path, day, cb) {\n        var key = path + '|' + ymd(day), hit = dayCache[key];\n        if (hit && Date.now() - hit.at < 3600000) { return cb(null, hit.events); }\n        getJson('site.api.espn.com', '/apis/site/v2/sports/' + path + '/scoreboard?dates=' + ymd(day), {}, function (err, data) {\n            if (err) { return cb(err); }\n            var evs = (data && data.events) || [];\n            dayCache[key] = { at: Date.now(), events: evs };\n            if (Object.keys(dayCache).length > 80) {\n                Object.keys(dayCache).forEach(function (k) {\n                    if (Date.now() - dayCache[k].at > 7200000) { delete dayCache[k]; }\n                });\n            }\n            cb(null, evs);\n        });\n    }\n    function dateFromYmd(s) {\n        var m = /^(\\d{4})(\\d{2})(\\d{2})$/.exec(String(s || ''));\n        return m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : null;\n    }\n    // The ESPN scoreboard accepts one date at a time (a date range returns 400). Scan day by day,\n    // but start at the day of the last found fixture: normally fixtures do not move earlier, so\n    // following 5 competitions costs one request instead of 5 x 5.\n    function scanNext(w, cb) {\n        var now = Date.now(), day = new Date(), hd, diff;\n        day.setHours(0, 0, 0, 0);\n        var hint = nextHint[w.key], dnum = 0, found = null;\n        if (hint && (hd = dateFromYmd(hint.date))) {\n            diff = Math.round((hd.getTime() - day.getTime()) / 86400000);\n            if (diff >= 0 && diff <= 7) { dnum = diff; }\n        }\n        function nextDay() {\n            if (found || dnum > 7) { return cb(found); }\n            var d = new Date(day.getTime() + dnum * 86400000), comps = w.comps, ci = 0;\n            function nextComp() {\n                if (ci >= comps.length) { dnum++; return nextDay(); }\n                var path = 'soccer/' + comps[ci++];\n                // Today's scoreboard is already in compCache from the normal poll: reuse it.\n                if (dnum === 0) {\n                    var hit0 = compCache[path];\n                    if (hit0 && Date.now() - hit0.at < 120000) { return use(hit0.events, nextComp); }\n                }\n                dayEvents(path, d, function (err, evs) { use(err ? [] : evs, nextComp); });\n            }\n            function use(evs, next) {\n                var i, j, cs, m, t, comp = comps[ci - 1];\n                for (i = 0; i < evs.length; i++) {\n                    if (((evs[i].status || {}).type || {}).state !== 'pre') { continue; }\n                    t = new Date(evs[i].date).getTime();\n                    if (!(t > now - 1800000)) { continue; }\n                    cs = ((evs[i].competitions || [])[0] || {}).competitors || [];\n                    for (j = 0; j < cs.length; j++) {\n                        if (espnSide(cs[j]).id !== w.teamId) { continue; }\n                        m = espnNorm(evs[i]);\n                        if (!m) { break; }\n                        var g = {\n                            key: w.key, id: m.id, club: w.name, comp: comp,\n                            home: m.home.name, away: m.away.name,\n                            date: evs[i].date, dateMs: t, line: fmtKick(t, w.lang)\n                        };\n                        if (!found || t < found.dateMs) { found = g; }\n                        break;\n                    }\n                }\n                next();\n            }\n            nextComp();\n        }\n        nextDay();\n    }\n    function sportPath(w, comp) {\n        if (w.kind === 'club') { return 'soccer/' + comp; }\n        return (OTHER[w.sport] || OTHER.basketball).espn;\n    }\n    // ESPN serves team crests as PNGs. Verify with a HEAD request before using a new sport path:\n    // soccer/nba/nhl/nfl work; mlb/500/<id>.png is 404 for some ids, so it is simply left empty.\n    function logoFor(kind, provider, sport, teamId) {\n        if (!teamId || !/^\\d{1,8}$/.test(String(teamId))) { return ''; }\n        if (kind === 'club') {\n            return provider === 'espn' ? 'https://a.espncdn.com/i/teamlogos/soccer/500/' + teamId + '.png' : '';\n        }\n        var map = { basketball: 'nba', baseball: 'mlb', hockey: 'nhl', nfl: 'nfl' };\n        return map[sport] ? 'https://a.espncdn.com/i/teamlogos/' + map[sport] + '/500/' + teamId + '.png' : '';\n    }\n\n    return {\n        espnSide: espnSide, espnEvent: espnEvent, espnEvents: espnEvents,\n        espnNorm: espnNorm, espnRaceNorm: espnRaceNorm, espnTeams: espnTeams,\n        compEvents: compEvents, seasonRaces: seasonRaces, findMatch: findMatch, withSummary: withSummary,\n        ymd: ymd, dayEvents: dayEvents, scanNext: scanNext,\n        sportPath: sportPath, logoFor: logoFor,\n        cache: function (path) { return compCache[path]; },\n        // A failed competition gets a short cache so it is retried in 2 min without holding back\n        // the clubs whose competitions were analysed successfully.\n        cacheFail: function (path) { compCache[path] = { at: Date.now(), events: [], nextAt: Date.now() + 120000 }; },\n        hints: function () { return nextHint; },\n        setHints: function (h) { nextHint = h && typeof h === 'object' ? h : {}; },\n        clearHint: function (key) { if (!nextHint[key]) { return false; } delete nextHint[key]; return true; },\n        cacheForTest: function (path) { return compCache[path]; },\n        reset: function () {\n            compCache = {}; sumCache = {}; sumPending = {}; sumWait = {}; dayCache = {}; nextHint = {};\n        }\n    };\n};\n","ui.html":"<!DOCTYPE html>\r\n<html lang=\"pt\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<meta name=\"color-scheme\" content=\"light dark\">\r\n<title>NEWS</title>\r\n<style>\r\n:root {\r\n  --bg:#12151b; --surface:#1b1f27; --raised:#242b38; --border:#2b3140;\r\n  --text:#e8ecf3; --muted:#9aa4b5; --action:#4c8dff; --focus:#8fbaff;\r\n  --ok:#3fb950; --warn:#d29922; --bad:#f85149;\r\n  --radius:12px; --radius-control:9px;\r\n  --font:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;\r\n  --mono:ui-monospace,SFMono-Regular,Consolas,monospace;\r\n  /* aliases kept so the rest of the stylesheet does not need a rewrite */\r\n  --card:var(--surface); --line:var(--border); --fg:var(--text); --dim:var(--muted); --accent:var(--action);\r\n}\r\n@media (prefers-color-scheme:light) {\r\n  :root {\r\n    --bg:#f3f6fc; --surface:#fff; --raised:#eef2fa; --border:#d5ddeb;\r\n    --text:#0b1530; --muted:#4d5b78; --action:#123bb5; --focus:#0450ef;\r\n    --ok:#137a4b; --warn:#8a5a00; --bad:#b3261e;\r\n  }\r\n}\r\n* { box-sizing:border-box; }\r\nbody { margin:0 auto; max-width:1040px; padding:20px 16px 40px; background:var(--bg); color:var(--text); font:14px/1.45 var(--font); }\r\n:focus-visible { outline:2px solid var(--focus); outline-offset:2px; }\r\n[hidden] { display:none !important; }\r\n.head { display:flex; align-items:center; gap:10px; margin-bottom:12px; }\r\n.logo { width:34px; height:34px; border-radius:9px; background:var(--card); display:flex; align-items:center; justify-content:center; font-size:19px; }\r\nh1 { font-size:19px; margin:0; flex:1; font-weight:600; }\r\n.ver { font-size:12px; font-weight:600; color:var(--dim); background:var(--card); border:1px solid var(--line); border-radius:12px; padding:2px 8px; }\r\n.lang button { background:var(--card); color:var(--dim); border:1px solid var(--line); border-radius:8px; padding:5px 9px; margin-left:5px; cursor:pointer; font-size:12px; }\r\n.lang button.on { color:#fff; border-color:var(--accent); }\r\n.tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; position:sticky; top:0; z-index:10; background:var(--bg); padding:6px 0; }\r\n.tabs button { background:var(--card); color:var(--dim); border:1px solid var(--line); border-radius:9px; padding:8px 14px; cursor:pointer; font-size:13px; font-weight:600; }\r\n.tabs button.on { color:#fff; background:#243044; border-color:var(--accent); }\r\n.tab { display:none; }\r\n.tab.on { display:block; }\r\n.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:12px; }\r\n.stack { display:flex; flex-direction:column; gap:12px; }\r\n.appcols { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:12px; align-items:start; }\r\n.subtabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }\r\n.subtabs button { background:var(--raised); color:var(--muted); border:1px solid var(--border); border-radius:var(--radius-control); padding:7px 12px; cursor:pointer; font-size:12px; font-weight:600; }\r\n.subtabs button.on { color:var(--text); border-color:var(--action); background:var(--surface); }\r\n.subtab { display:none; }\r\n.subtab.on { display:block; }\r\n.card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:12px 14px; }\r\n.card.wide { grid-column:1/-1; }\r\nh2 { font-size:13px; text-transform:uppercase; letter-spacing:.06em; color:var(--dim); margin:0 0 10px; font-weight:700; }\r\nlabel.f { display:block; font-size:12px; color:var(--dim); margin:10px 0 4px; }\r\n/* Vetro-style switch: pill with a sliding knob and an On/Off state label. */\r\nlabel.switch { display:flex; min-height:44px; width:max-content; max-width:100%; align-items:center; gap:10px; padding:2px 0; cursor:pointer; }\r\nlabel.switch input[type=checkbox] { appearance:none; -webkit-appearance:none; width:40px; height:24px; padding:0; margin:0; border:1px solid var(--border); border-radius:999px; background:var(--raised); position:relative; flex-shrink:0; cursor:pointer; transition:background .15s ease; }\r\nlabel.switch input[type=checkbox]:before { content:\"\"; position:absolute; left:3px; top:3px; width:16px; height:16px; border-radius:50%; background:var(--muted); transition:transform .15s ease, background .15s ease; }\r\nlabel.switch input[type=checkbox]:checked { background:var(--action); border-color:var(--action); }\r\nlabel.switch input[type=checkbox]:checked:before { transform:translateX(16px); background:#fff; }\r\nlabel.switch input[type=checkbox]:disabled { opacity:.45; cursor:default; }\r\nlabel.switch span { color:var(--text); }\r\n.sw-state { margin-left:auto; font-size:12px; color:var(--muted); font-weight:600; }\r\n.modgrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:8px 14px; margin-top:10px; }\r\n.modgrid label.switch { width:auto; }\r\nselect, input[type=text], input[type=password] { width:100%; background:var(--raised); color:var(--fg); border:1px solid var(--line); border-radius:8px; padding:8px 9px; font-size:13px; }\r\ninput[type=range] { width:100%; accent-color:var(--accent); }\r\n.dur input[type=number] { flex:1; min-width:70px; background:var(--raised); color:var(--fg); border:1px solid var(--line); border-radius:8px; padding:6px 8px; }\r\n.dur { display:flex; align-items:center; gap:8px; margin-top:8px; font-size:12px; color:var(--dim); }\r\n.dur span { flex:0 0 45%; }\r\n.dur b { flex:0 0 34px; text-align:right; color:var(--fg); }\r\n.row { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }\r\nbutton.p, button.g, button.x { border-radius:var(--radius-control); padding:9px 14px; font-size:13px; font-weight:600; cursor:pointer; border:1px solid var(--border); background:var(--raised); color:var(--text); }\r\nbutton.p { background:var(--action); border-color:var(--action); color:#fff; }\r\nbutton.g { background:var(--raised); border-color:var(--ok); }\r\nbutton.x { padding:5px 9px; font-size:12px; background:var(--surface); border-color:var(--bad); color:var(--bad); }\r\nbutton:disabled { opacity:.55; cursor:default; }\r\nbutton.done { border-color:var(--ok); }\r\nbutton.fail { border-color:var(--bad); }\r\n.msg { font-size:12px; color:var(--dim); min-height:16px; margin-top:8px; }\r\n.msg.ok { color:var(--ok); }\r\n.msg.err { color:var(--bad); }\r\n.live { font-size:15px; font-weight:600; margin-bottom:4px; }\r\n.club { border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:10px; background:var(--surface); }\r\n.club-head { display:flex; align-items:center; gap:8px; }\r\n.club-head b { flex:1; font-size:14px; }\r\n.tag { font-size:11px; color:var(--dim); border:1px solid var(--line); border-radius:10px; padding:1px 7px; }\r\n.comps { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:2px 10px; margin:8px 0 2px; }\r\n.pick { display:flex; align-items:center; gap:8px; border:1px solid var(--line); border-radius:9px; padding:7px 10px; margin-bottom:7px; background:var(--surface); }\r\n.simgrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:10px; margin-top:10px; }\r\n.simbtn { display:flex; align-items:center; gap:12px; text-align:left; padding:10px; border:1px solid var(--line); border-radius:11px; background:var(--surface); color:var(--fg); cursor:pointer; }\r\n.simbtn img { width:40px; height:40px; flex:none; }\r\n.simbtn b { display:block; font-size:14px; }\r\n.simbtn small { display:block; color:var(--dim); font-size:11px; }\r\n.simrow { display:flex; align-items:center; gap:6px; margin-top:8px; }\r\n.simrow select { width:auto; flex:1; }\r\n.pick span { flex:1; font-size:13px; }\r\n.small { font-size:11px; color:var(--dim); }\r\ndetails summary { cursor:pointer; font-size:13px; font-weight:600; color:var(--dim); }\r\n/* Collapsible sections inside a card: the heading doubles as the summary. */\r\ndetails.sec { border-top:1px solid var(--line); padding-top:10px; margin-top:10px; }\r\ndetails.sec:first-child { border-top:0; padding-top:0; margin-top:0; }\r\ndetails.sec > summary { font-size:14px; color:var(--fg); padding:2px 0; }\r\ndetails.sec > summary::marker { color:var(--dim); }\r\ndetails.sec .grid { margin-top:8px; }\r\n.secnote { font-size:11px; color:var(--dim); font-weight:400; }\r\n.tabnav { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:14px; }\r\n#diag-watches div, #diag-log div { margin:2px 0; }\r\npre { white-space:pre-wrap; word-break:break-word; margin:0; font:11px/1.5 var(--mono,monospace); }\r\n.hidden { display:none !important; }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"head\">\r\n  <div class=\"logo\">&#9917;</div>\r\n  <h1 data-t=\"title\">NEWS</h1>\r\n  <span class=\"ver\" id=\"ver\"></span>\r\n  <span class=\"msg\" id=\"save-state\" aria-live=\"polite\"></span>\r\n  <button type=\"button\" class=\"g\" id=\"test-all\" data-t=\"testAll\">Test all</button>\r\n  <button type=\"button\" class=\"p\" id=\"save-all\" data-t=\"saveAll\">Save all</button>\r\n  <div class=\"lang\" role=\"group\" aria-label=\"Language\"><button type=\"button\" id=\"l-en\" aria-label=\"English\">EN</button><button type=\"button\" id=\"l-pt\" aria-label=\"Portugu&#234;s\">PT</button></div>\r\n</div>\r\n\r\n<div class=\"tabs\" role=\"tablist\" aria-label=\"Sections\">\r\n  <button type=\"button\" id=\"tabbtn-setup\" role=\"tab\" aria-selected=\"true\" aria-controls=\"tab-setup\" data-tab=\"setup\" class=\"on\" data-t=\"tabSetup\">SETUP</button>\r\n  <button type=\"button\" id=\"tabbtn-sport\" role=\"tab\" aria-selected=\"false\" aria-controls=\"tab-sport\" data-tab=\"sport\" data-t=\"tabSport\">Sport</button>\r\n  <button type=\"button\" id=\"tabbtn-weather\" role=\"tab\" aria-selected=\"false\" aria-controls=\"tab-weather\" data-tab=\"weather\" data-t=\"tabWeather\">Weather</button>\r\n  <button type=\"button\" id=\"tabbtn-news\" role=\"tab\" aria-selected=\"false\" aria-controls=\"tab-news\" data-tab=\"news\" data-t=\"tabNews\">News</button>\r\n  <button type=\"button\" id=\"tabbtn-tech\" role=\"tab\" aria-selected=\"false\" aria-controls=\"tab-tech\" data-tab=\"tech\" data-t=\"tabTech\">Technical</button>\r\n</div>\r\n\r\n<!-- ============ GENERAL ============ -->\r\n<div class=\"tab on\" id=\"tab-setup\" role=\"tabpanel\" aria-labelledby=\"tabbtn-setup\">\r\n  <div class=\"stack\">\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"modules\">Modules</summary>\r\n        <div class=\"modgrid\">\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"m-sport\"> <span data-t=\"sport\">Sport</span><b class=\"sw-state\">On</b></label>\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"m-weather\"> <span data-t=\"weather\">Weather</span><b class=\"sw-state\">On</b></label>\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"m-news\"> <span data-t=\"news\">News</span><b class=\"sw-state\">On</b></label>\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"m-civ\"> <span data-t=\"tabCiv\">Proteção Civil</span><b class=\"sw-state\">On</b></label>\r\n        </div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"now\">Right now</summary>\r\n        <div class=\"live\" id=\"sport-line\">-</div>\r\n        <div class=\"msg\" id=\"sport-stat\" aria-live=\"polite\"></div>\r\n        <div class=\"msg\" id=\"next-line\" aria-live=\"polite\"></div>\r\n        <div class=\"msg\" id=\"news-line\" aria-live=\"polite\"></div>\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"check\" data-t=\"check\">Check now</button></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n        <div class=\"row\"><button type=\"button\" class=\"p\" id=\"save-mod\" data-t=\"save\">Save</button></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ============ WEATHER ============ -->\r\n<div class=\"tab\" id=\"tab-weather\" role=\"tabpanel\" aria-labelledby=\"tabbtn-weather\" hidden>\r\n  <div class=\"appcols\">\r\n    <div class=\"stack\" id=\"weather-column\">\r\n      <div class=\"card wide\"><div class=\"live\" id=\"weather-line\"></div></div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"weatherCard\">Weather</summary>\r\n        <div class=\"grid\">\r\n          <div>\r\n            <label class=\"f\" data-t=\"place\">Place</label>\r\n            <select id=\"w-place\"></select>\r\n            <label class=\"f\" data-t=\"weatherProvider\">Provider</label>\r\n            <select id=\"w-provider\"></select>\r\n            <label class=\"f\" data-t=\"weatherWhen\">When to notify</label>\r\n            <select id=\"w-when\"></select>\r\n            <div class=\"dur\"><span data-t=\"interval\">Interval (min)</span><input type=\"range\" id=\"w-interval\" min=\"5\" max=\"240\" step=\"5\"><b id=\"w-intervalv\"></b></div>\r\n            <div class=\"dur\"><span data-t=\"seconds\">Banner (s)</span><input type=\"range\" id=\"w-seconds\" min=\"3\" max=\"30\"><b id=\"w-secondsv\"></b></div>\r\n            <div class=\"dur\"><span data-t=\"volume\">Volume</span><input type=\"range\" id=\"w-volume\" min=\"10\" max=\"100\" step=\"5\"><b id=\"w-volumev\"></b></div>\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"mode\">Mode</label>\r\n            <select id=\"w-mode\"></select>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"w-sound\"> <span data-t=\"sound\">Sound</span><b class=\"sw-state\">On</b></label>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"w-quiet\"> <span data-t=\"quiet\">Quiet hours 23h-07h</span><b class=\"sw-state\">On</b></label>\r\n          </div>\r\n        </div>\r\n      </details>\r\n      <details class=\"sec\">\r\n        <summary><span data-t=\"addPlaceTitle\">Add a place</span><span class=\"secnote\"> &middot; <span data-t=\"addPlaceNote\">search by name</span></span></summary>\r\n        <div class=\"row\" style=\"margin-top:8px\">\r\n          <input type=\"text\" id=\"place-search\" placeholder=\"Caldas da Rainha\" style=\"flex:1;min-width:160px\">\r\n          <button type=\"button\" class=\"g\" id=\"place-find\" data-t=\"find\">Find</button>\r\n        </div>\r\n        <select id=\"place-results\" class=\"hidden\" style=\"margin-top:6px\"></select>\r\n        <div class=\"row\" style=\"margin-top:6px\"><button type=\"button\" class=\"g\" id=\"place-add\" data-t=\"addPlace\">Add selected</button></div>\r\n        <div class=\"msg\" id=\"weather-msg\" aria-live=\"polite\"></div>\r\n        <div id=\"custom-places\" class=\"small\"></div>\r\n      </details>\r\n      <details class=\"sec\">\r\n        <summary data-t=\"wpTitle\">Advance warnings</summary>\r\n        <div class=\"grid\">\r\n          <div>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"wp-enabled\"> <span data-t=\"wpEnable\">Enable</span><b class=\"sw-state\">On</b></label>\r\n            <label class=\"f\" data-t=\"wpMinutes\">Look ahead</label>\r\n            <select id=\"wp-minutes\"><option value=\"30\">30 min</option><option value=\"60\">60 min</option><option value=\"120\">120 min</option><option value=\"180\">180 min</option></select>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"wp-rain\"> <span data-t=\"wRain\">Rain</span><b class=\"sw-state\">On</b></label>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"wp-wind\"> <span data-t=\"wWind\">Wind</span><b class=\"sw-state\">On</b></label>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"wp-heat\"> <span data-t=\"wHeat\">Heat</span><b class=\"sw-state\">On</b></label>\r\n            <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"wp-storm\"> <span data-t=\"wStorm\">Thunderstorm</span><b class=\"sw-state\">On</b></label>\r\n          </div>\r\n          <div>\r\n            <div class=\"dur\"><span data-t=\"wpRainPct\">Rain %</span><input type=\"number\" id=\"wp-rainpct\" min=\"10\" max=\"100\" step=\"5\"><b></b></div>\r\n            <div class=\"dur\"><span data-t=\"wpWindKmh\">Wind km/h</span><input type=\"number\" id=\"wp-windkmh\" min=\"10\" max=\"120\" step=\"5\"><b></b></div>\r\n            <div class=\"dur\"><span data-t=\"wpHeatC\">Heat &deg;C</span><input type=\"number\" id=\"wp-heatc\" min=\"20\" max=\"50\"><b></b></div>\r\n            <div class=\"dur\"><span data-t=\"wpStormCode\">Storm code &ge;</span><input type=\"number\" id=\"wp-stormcode\" min=\"80\" max=\"99\"><b></b></div>\r\n          </div>\r\n        </div>\r\n      </details>\r\n      <div class=\"row\"><button type=\"button\" class=\"p\" id=\"save-weather\" data-t=\"save\">Save</button><button type=\"button\" class=\"g\" id=\"t-weather\" data-t=\"test\">Test</button></div>\r\n    </div>\r\n  </div>\r\n<div class=\"stack\" id=\"civ-column\">\r\n    <div class=\"card wide\"><h2 data-t=\"tabCiv\">Proteção Civil</h2></div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"civNow\">Active warnings</summary>\r\n        <div id=\"civ-list\"></div>\r\n        <div class=\"msg\" id=\"civ-status\" aria-live=\"polite\"></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"civSources\">Sources and filters</summary>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-enabled\"> <span data-t=\"enabled\">Enabled</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"f\" data-t=\"district\">District (IPMA)</label>\r\n        <select id=\"civ-district\"></select>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-yellow\"> <span data-t=\"civYellow\">Yellow (discreet)</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-orange\"> <span data-t=\"civOrange\">Orange</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-red\"> <span data-t=\"civRed\">Red</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-anepc\"> <span>ANEPC - Aviso \\u00E0 popula\\u00E7\\u00E3o</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-news\"> <span data-t=\"civNews\">Breaking news (RSS)</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"f\" data-t=\"keywords\">Keywords</label>\r\n        <input type=\"text\" id=\"civ-keywords\">\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"style\">Style</summary>\r\n        <label class=\"f\" data-t=\"mode\">Mode</label>\r\n        <select id=\"civ-mode\"></select>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"civ-sound\"> <span data-t=\"sound\">Sound</span><b class=\"sw-state\">On</b></label>\r\n        <div class=\"dur\"><span data-t=\"interval\">Interval (min)</span><input type=\"range\" id=\"civ-interval\" min=\"5\" max=\"240\" step=\"5\"><b id=\"civ-intervalv\"></b></div>\r\n        <div class=\"dur\"><span data-t=\"seconds\">Banner (s)</span><input type=\"range\" id=\"civ-seconds\" min=\"3\" max=\"60\"><b id=\"civ-secondsv\"></b></div>\r\n        <div class=\"dur\"><span data-t=\"volume\">Volume</span><input type=\"range\" id=\"civ-volume\" min=\"10\" max=\"100\" step=\"5\"><b id=\"civ-volumev\"></b></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <div class=\"row\"><button type=\"button\" class=\"p\" id=\"save-civ\" data-t=\"save\">Save</button><button type=\"button\" class=\"g\" id=\"t-civ\" data-t=\"test\">Test</button></div>\r\n    </div>\r\n  </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ============ NEWS ============ -->\r\n<div class=\"tab\" id=\"tab-news\" role=\"tabpanel\" aria-labelledby=\"tabbtn-news\" hidden>\r\n  <div class=\"stack\">\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"sources\">News sources</summary>\r\n        <div class=\"comps\" id=\"feeds\"></div>\r\n        <div class=\"small\" data-t=\"sourcesNote\">Pick as many as you like. Each source keeps its own history.</div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\">\r\n        <summary data-t=\"newsSettings\">News settings</summary>\r\n        <div class=\"grid\">\r\n        <div>\r\n          <div class=\"dur\"><span data-t=\"interval\">Interval (min)</span><input type=\"range\" id=\"n-interval\" min=\"5\" max=\"240\" step=\"5\"><b id=\"n-intervalv\"></b></div>\r\n          <div class=\"dur\"><span data-t=\"seconds\">Banner (s)</span><input type=\"range\" id=\"n-seconds\" min=\"3\" max=\"30\"><b id=\"n-secondsv\"></b></div>\r\n          <div class=\"dur\"><span data-t=\"volume\">Volume</span><input type=\"range\" id=\"n-volume\" min=\"10\" max=\"100\" step=\"5\"><b id=\"n-volumev\"></b></div>\r\n          <label class=\"f\" data-t=\"headlines\">Headlines per source</label>\r\n          <select id=\"n-count\"><option>1</option><option>2</option><option>3</option></select>\r\n        </div>\r\n        <div>\r\n          <label class=\"f\" data-t=\"mode\">Mode</label>\r\n          <select id=\"n-mode\"></select>\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"n-sound\"> <span data-t=\"sound\">Sound</span><b class=\"sw-state\">On</b></label>\r\n          <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"n-quiet\"> <span data-t=\"quiet\">Quiet hours 23h-07h</span><b class=\"sw-state\">On</b></label>\r\n        </div>\r\n        </div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <div class=\"row\"><button type=\"button\" class=\"p\" id=\"save-news\" data-t=\"save\">Save</button><button type=\"button\" class=\"g\" id=\"t-news\" data-t=\"test\">Test</button></div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ============ FOOTBALL ============ -->\r\n<div class=\"tab\" id=\"tab-sport\" role=\"tabpanel\" aria-labelledby=\"tabbtn-sport\" hidden>\r\n  <div class=\"subtabs\" role=\"tablist\" aria-label=\"Sport sections\">\r\n    <button type=\"button\" id=\"subbtn-football\" role=\"tab\" aria-selected=\"true\" aria-controls=\"subtab-football\" data-subtab=\"football\" data-t=\"tabFootball\">Football</button>\r\n    <button type=\"button\" id=\"subbtn-others\" role=\"tab\" aria-selected=\"false\" aria-controls=\"subtab-others\" data-subtab=\"others\" data-t=\"tabOthers\">Other sports</button>\r\n  </div>\r\n  <div class=\"subtab on\" id=\"subtab-football\">\r\n  <div class=\"stack\">\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"clubs\">Clubs</summary>\r\n        <div id=\"clubs\"></div>\r\n        <div class=\"grid\">\r\n          <div>\r\n            <label class=\"f\" data-t=\"league\">League</label>\r\n            <select id=\"add-league\"></select>\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"team\">Team</label>\r\n            <select id=\"add-team\"></select>\r\n          </div>\r\n        </div>\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"add-club\" data-t=\"addClub\">Add club</button></div>\r\n        <div class=\"msg\" id=\"add-msg\" aria-live=\"polite\"></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"alerts\">Alerts</summary>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"goal\"> <span data-t=\"a_goal\">Goal for my club</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"against\"> <span data-t=\"a_against\">Goal for the opponent</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"card\"> <span data-t=\"a_card\">Cards (both teams)</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"sub\"> <span data-t=\"a_sub\">Substitutions (my club)</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"varNo\"> <span data-t=\"a_var\">Goal disallowed</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"penalty\"> <span data-t=\"a_pen\">Penalty awarded</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"penMiss\"> <span data-t=\"a_penMiss\">Penalty missed or saved</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"start\"> <span data-t=\"a_start\">Kick-off</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"half\"> <span data-t=\"a_half\">Half-time</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-fb=\"end\"> <span data-t=\"a_end\">Full time</span><b class=\"sw-state\">On</b></label>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"style\">Style</summary>\r\n        <label class=\"f\" data-t=\"mode\">Mode</label>\r\n        <select id=\"f-mode\"></select>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"f-sound\"> <span data-t=\"sound\">Sound</span><b class=\"sw-state\">On</b></label>\r\n        <div class=\"dur\"><span data-t=\"goalsec\">Goal banner (s)</span><input type=\"range\" id=\"f-goalsec\" min=\"5\" max=\"60\"><b id=\"f-goalsecv\"></b></div>\r\n        <div class=\"dur\"><span data-t=\"othersec\">Other banners (s)</span><input type=\"range\" id=\"f-othersec\" min=\"3\" max=\"30\"><b id=\"f-othersecv\"></b></div>\r\n        <div class=\"dur\"><span data-t=\"volume\">Volume</span><input type=\"range\" id=\"f-volume\" min=\"10\" max=\"100\" step=\"5\"><b id=\"f-volumev\"></b></div>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"f-next-enabled\"> <span data-t=\"nextWarn\">Warn before kick-off</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"f\" data-t=\"minutesBefore\">Minutes before</label>\r\n        <select id=\"f-next-minutes\"><option value=\"0\">0</option><option value=\"15\">15</option><option value=\"30\">30</option><option value=\"60\">60</option></select>\r\n      </details>\r\n      <details class=\"sec\">\r\n        <summary data-t=\"provider\">Provider</summary>\r\n        <select id=\"f-provider\"></select>\r\n        <label class=\"f\" data-t=\"apikey\">API-Football key (TV only)</label>\r\n        <input type=\"text\" id=\"apikey\" autocomplete=\"off\" placeholder=\"...\">\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"savekey\" data-t=\"savekey\">Save key</button><button type=\"button\" class=\"g\" id=\"checkkey\" data-t=\"checkkey\">Check key</button></div>\r\n        <div class=\"msg\" id=\"keymsg\" aria-live=\"polite\"></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\">\r\n        <summary data-t=\"simTitle\">Goal simulation</summary>\r\n        <div class=\"small\" data-t=\"simNote\">One button per club. Sends a real (silent) notification through Notification Center.</div>\r\n        <div id=\"sim-grid\" class=\"simgrid\"></div>\r\n        <div class=\"msg\" id=\"sim-msg\" aria-live=\"polite\"></div>\r\n      </details>\r\n      <details class=\"sec\">\r\n        <summary data-t=\"simEdit\">Edit the test clubs</summary>\r\n        <div class=\"grid\">\r\n          <div>\r\n            <label class=\"f\" data-t=\"team\">Team</label>\r\n            <input type=\"text\" id=\"sim-name\" placeholder=\"Sporting\">\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"simId\">ESPN id</label>\r\n            <input type=\"text\" id=\"sim-id\" placeholder=\"2250\">\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"simMsg\">Message</label>\r\n            <input type=\"text\" id=\"sim-text\" placeholder=\"Sporting 1-0 Benfica\">\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"simColor\">Stripe colour</label>\r\n            <select id=\"sim-level\"><option value=\"ok\">ok - verde</option><option value=\"info\">info - azul</option><option value=\"warn\">warn - amarelo</option><option value=\"alert\">alert - vermelho</option></select>\r\n          </div>\r\n        </div>\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"sim-add\" data-t=\"addClub\">Add club</button></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <label class=\"f\" data-t=\"testWith\">Test with</label>\r\n      <select id=\"test-club\" style=\"max-width:340px\"></select>\r\n      <div class=\"row\">\r\n        <button type=\"button\" class=\"p\" id=\"save-football\" data-t=\"save\">Save</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-goal\" data-t=\"testgoal\">Test: goal</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-against\" data-t=\"testag\">Test: goal against</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-card\" data-t=\"testcard\">Test: card</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-start\" data-t=\"teststart\">Test: kick-off</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-end\" data-t=\"testend\">Test: full time</button>\r\n        <button type=\"button\" class=\"g\" id=\"t-next\" data-t=\"testNext\">Test: kick-off warning</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ============ OTHER SPORTS ============ -->\r\n<div class=\"subtab\" id=\"subtab-others\" hidden>\r\n  <div class=\"stack\">\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"picks\">Other sports</summary>\r\n        <div id=\"picks\"></div>\r\n        <div class=\"grid\">\r\n          <div>\r\n            <label class=\"f\" data-t=\"sport\">Sport</label>\r\n            <select id=\"add-sport\"></select>\r\n          </div>\r\n          <div>\r\n            <label class=\"f\" data-t=\"pickTarget\">Team / race</label>\r\n            <select id=\"add-team2\"></select>\r\n          </div>\r\n        </div>\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"add-pick\" data-t=\"addPick\">Add</button></div>\r\n        <div class=\"msg\" id=\"pick-msg\" aria-live=\"polite\"></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"alerts\">Alerts</summary>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-ob=\"start\"> <span data-t=\"a_start2\">Start</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-ob=\"half\"> <span data-t=\"a_half2\">Half / period</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-ob=\"end\"> <span data-t=\"a_end2\">End</span><b class=\"sw-state\">On</b></label>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-ob=\"score\"> <span data-t=\"a_score\">Score changes</span><b class=\"sw-state\">On</b></label>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"style\">Style</summary>\r\n        <label class=\"f\" data-t=\"mode\">Mode</label>\r\n        <select id=\"o-mode\"></select>\r\n        <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"o-sound\"> <span data-t=\"sound\">Sound</span><b class=\"sw-state\">On</b></label>\r\n        <div class=\"dur\"><span data-t=\"seconds\">Banner (s)</span><input type=\"range\" id=\"o-seconds\" min=\"3\" max=\"30\"><b id=\"o-secondsv\"></b></div>\r\n        <div class=\"dur\"><span data-t=\"volume\">Volume</span><input type=\"range\" id=\"o-volume\" min=\"10\" max=\"100\" step=\"5\"><b id=\"o-volumev\"></b></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <div class=\"row\"><button type=\"button\" class=\"p\" id=\"save-others\" data-t=\"save\">Save</button><button type=\"button\" class=\"g\" id=\"t-score\" data-t=\"testscore\">Test: score</button></div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n<!-- ============ TECHNICAL ============ -->\r\n<div class=\"tab\" id=\"tab-tech\" role=\"tabpanel\" aria-labelledby=\"tabbtn-tech\" hidden>\r\n  <div class=\"stack\">\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\" open>\r\n        <summary data-t=\"diagTitle\">Diagnostics</summary>\r\n        <div class=\"grid\" style=\"margin-top:10px\">\r\n          <div>\r\n            <div class=\"f\" data-t=\"diagWatches\">Watched</div>\r\n            <div id=\"diag-watches\" class=\"small\"></div>\r\n          </div>\r\n          <div>\r\n            <div class=\"f\" data-t=\"diagLog\">Log</div>\r\n            <div id=\"diag-log\" class=\"small\"></div>\r\n          </div>\r\n          <div>\r\n            <div class=\"f\" data-t=\"diagHealth\">Providers</div>\r\n            <div id=\"diag-health\" class=\"small\"></div>\r\n          </div>\r\n        </div>\r\n        <div class=\"row\"><button type=\"button\" class=\"g\" id=\"clear-log\" data-t=\"clearLog\">Clear log</button></div>\r\n      </details>\r\n    </div>\r\n    <div class=\"card wide\">\r\n      <details class=\"sec\">\r\n        <summary data-t=\"techApi\">API and examples</summary>\r\n        <pre id=\"api-help\" class=\"small\"></pre>\r\n      </details>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"tabnav\" id=\"tabnav\">\r\n  <button type=\"button\" class=\"g\" id=\"tab-prev\" data-t=\"tabPrev\">Previous</button>\r\n  <span class=\"small\" id=\"tabnav-label\"></span>\r\n  <button type=\"button\" class=\"g\" id=\"tab-next\" data-t=\"tabNext\">Next</button>\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  \"use strict\";\r\n  var $ = function (id) { return document.getElementById(id); };\r\n  var T = {\r\n    en: {\r\n      title:\"NEWS\", saveAll:\"Save all\", testAll:\"Test all\", tabPrev:\"Previous\", tabNext:\"Next\", unsaved:\"Unsaved changes\", savedAt:\"Saved at \",\r\n      tabSetup:\"SETUP\", tabSport:\"Sport\", techApi:\"API and examples\", diagTitle:\"Diagnostics\", diagWatches:\"Watched\", diagLog:\"Log\", diagHealth:\"Providers\", clearLog:\"Clear log\", confirmClear:\"Click again: clear log\", noAnswer:\"No answer from the Shard: open the panel again\", tabWeather:\"Weather\", tabNews:\"News\", tabFootball:\"Football\", tabOthers:\"Other sports\", tabTech:\"Technical\",\r\n      modules:\"Modules\", sport:\"Sport\", weather:\"Weather\", news:\"News\", now:\"Right now\",\r\n      weatherCard:\"Weather\", place:\"Place\", interval:\"Interval (min)\", seconds:\"Banner (s)\", mode:\"Mode\",\r\n      quiet:\"Quiet hours 23h-07h\", style:\"Style\", sound:\"Sound\", test:\"Test\", save:\"Save\", savekey:\"Save key\",\r\n      checkkey:\"Check key\", check:\"Check now\", sources:\"News sources\",\r\n      sourcesNote:\"Pick as many as you like. Each source keeps its own history.\",\r\n\r\n      newsSettings:\"News settings\", headlines:\"Headlines per source\",\r\n      clubs:\"Clubs\", league:\"League\", team:\"Team\", addClub:\"Add club\",\r\n      alerts:\"Alerts\", a_goal:\"Goal for my club\", a_against:\"Goal for the opponent\",\r\n      a_card:\"Cards (both teams)\", a_sub:\"Substitutions (my club)\", a_var:\"Goal disallowed\",\r\n      a_pen:\"Penalty awarded\", a_penMiss:\"Penalty missed or saved\",\r\n      a_start:\"Kick-off\", a_half:\"Half-time\", a_end:\"Full time\",\r\n      a_start2:\"Start\", a_half2:\"Half / period\", a_end2:\"End\", a_score:\"Score changes\",\r\n      goalsec:\"Goal banner (s)\", othersec:\"Other banners (s)\", provider:\"Provider\",\r\n      apikey:\"API-Football key (TV only)\", testWith:\"Test with\", testgoal:\"Test: goal\", testag:\"Test: goal against\",\r\n      testcard:\"Test: card\", teststart:\"Test: kick-off\", testend:\"Test: full time\", testscore:\"Test: score\",\r\n      testNext:\"Test: kick-off warning\",\r\n      picks:\"Other sports\", addPick:\"Add\", remove:\"Remove\", noClubs:\"No clubs yet: add one below.\",\r\n      pickTarget:\"Team / race\", noRaces:\"No races available.\",\r\n      noPicks:\"Nothing selected yet.\", pickLimit:\"Maximum picks: \", saved:\"Saved.\", noneyet:\"Nothing yet.\", checked:\"Last check: \",\r\n      err:\"Error: \", sent:\"Test sent.\", loading:\"Loading...\", noTeams:\"No team list for this league.\",\r\n      keyok:\"Key OK - remaining today: \", keynone:\"No key saved yet.\", keyset:\"A key is saved.\",\r\n      onlysoccer:\"API-Football works for football only.\", chooseOne:\"Pick at least one source.\",\r\n      clubNewsShort:\"Club news\", add:\"Add\", mode_banner:\"Banner\", mode_full:\"Full screen\", mode_overlay:\"Bottom toast\",\r\n      addPlaceTitle:\"Add a place\", addPlaceNote:\"search by name\", find:\"Find\", addPlace:\"Add selected\", findFirst:\"Search for a place first.\",\r\n      noPlaces:\"No place found.\", found:\"Found: \", placeAdded:\"Added\", placeRemoved:\"Removed\",\r\n      none:\"None\", noSport:\"Choose a sport first.\",\r\n      savedPlaces:\"Custom places\", typePlace:\"Type at least 2 letters.\", tooManyPlaces:\"Maximum 10 places.\",\r\n      nextWarn:\"Warn before kick-off\", minutesBefore:\"Minutes before\", nextMatch:\"Next match\", noNext:\"No upcoming match found.\",\r\n      maxClubs:\"Maximum \", tabCiv:\"Civil protection\", civNow:\"Active warnings\", civSources:\"Sources and filters\",\r\n      enabled:\"Enabled\", district:\"District (IPMA)\", civYellow:\"Yellow (discreet)\", civOrange:\"Orange\", civRed:\"Red\",\r\n      civNews:\"Breaking news (RSS)\", keywords:\"Keywords\", noCiv:\"No active warnings for this district.\",\r\n      civSource:\"Source\", civUntil:\"until\", civNotice:\"Civil notice\",\r\n      weatherProvider:\"Provider\", weatherWhen:\"When to notify\",\r\n      when_always:\"Always\", when_morning:\"Morning until 10h (today)\", when_night:\"Night after 18h (tomorrow)\",\r\n      wpTitle:\"Advance warnings\", wpEnable:\"Enable\", wpMinutes:\"Look ahead\", wRain:\"Rain\", wWind:\"Wind\", wHeat:\"Heat\", wStorm:\"Thunderstorm\",\r\n      wpRainPct:\"Rain %\", wpWindKmh:\"Wind km/h\", wpHeatC:\"Heat \\u00B0C\", wpStormCode:\"Storm code \\u2265\",\r\n      clubAlertsTitle:\"Alerts for this club\", custom:\"custom\", inherited:\"inherited (global)\", useGlobal:\"Use global\",\r\n      tabSim:\"Test goals\", simTitle:\"Goal simulation\", simNote:\"One button per club. Sends a real (silent) notification through Notification Center.\",\r\n      simEdit:\"Edit the test clubs\", simId:\"ESPN id\", simMsg:\"Message\", simColor:\"Stripe colour\", volume:\"Volume\"\r\n    },\r\n    pt: {\r\n      title:\"NEWS\", saveAll:\"Guardar tudo\", testAll:\"Testar tudo\", tabPrev:\"Anterior\", tabNext:\"Seguinte\", unsaved:\"Altera\\u00E7\\u00F5es por guardar\", savedAt:\"Guardado \\u00E0s \",\r\n      tabSetup:\"SETUP\", tabSport:\"Desporto\", techApi:\"API e exemplos\", diagTitle:\"Diagn\\u00F3stico\", diagWatches:\"Acompanhados\", diagLog:\"Registo\", diagHealth:\"Fornecedores\", clearLog:\"Limpar registo\", confirmClear:\"Clique outra vez: limpar registo\", noAnswer:\"Sem resposta do Shard: abra o painel novamente\", tabWeather:\"Tempo\", tabNews:\"Not\\u00EDcias\", tabFootball:\"Futebol\", tabOthers:\"Outros desportos\", tabTech:\"T\\u00E9cnico\",\r\n      modules:\"M\\u00F3dulos\", sport:\"Desporto\", weather:\"Tempo\", news:\"Not\\u00EDcias\", now:\"Agora\",\r\n      weatherCard:\"Tempo\", place:\"Local\", interval:\"Intervalo (min)\", seconds:\"Banner (s)\", mode:\"Modo\",\r\n      quiet:\"Sil\\u00EAncio 23h-07h\", style:\"Estilo\", sound:\"Som\", test:\"Teste\", save:\"Guardar\", savekey:\"Guardar chave\",\r\n      checkkey:\"Testar chave\", check:\"Verificar agora\", sources:\"Fontes de not\\u00EDcias\",\r\n      sourcesNote:\"Escolha as que quiser. Cada fonte guarda o seu hist\\u00F3rico.\",\r\n\r\n      newsSettings:\"Defini\\u00E7\\u00F5es de not\\u00EDcias\", headlines:\"Manchetes por fonte\",\r\n      clubs:\"Clubes\", league:\"Liga\", team:\"Equipa\", addClub:\"Adicionar clube\",\r\n      alerts:\"Alertas\", a_goal:\"Golo do meu clube\", a_against:\"Golo do advers\\u00E1rio\",\r\n      a_card:\"Cart\\u00F5es (ambas as equipas)\", a_sub:\"Substitui\\u00E7\\u00F5es (meu clube)\", a_var:\"Golo anulado\",\r\n      a_pen:\"Penalty marcado\", a_penMiss:\"Penalty falhado ou defendido\",\r\n      a_start:\"In\\u00EDcio do jogo\", a_half:\"Intervalo\", a_end:\"Fim do jogo\",\r\n      a_start2:\"In\\u00EDcio\", a_half2:\"Intervalo / per\\u00EDodo\", a_end2:\"Fim\", a_score:\"Altera\\u00E7\\u00F5es do resultado\",\r\n      goalsec:\"Banner de golo (s)\", othersec:\"Outros banners (s)\", provider:\"Fornecedor\",\r\n      apikey:\"Chave API-Football (s\\u00F3 na TV)\", testWith:\"Testar com\", testgoal:\"Teste: golo\", testag:\"Teste: golo sofrido\",\r\n      testcard:\"Teste: cart\\u00E3o\", teststart:\"Teste: in\\u00EDcio\", testend:\"Teste: fim\", testscore:\"Teste: resultado\",\r\n      testNext:\"Teste: aviso de jogo\",\r\n      picks:\"Outros desportos\", addPick:\"Adicionar\", remove:\"Remover\", noClubs:\"Ainda sem clubes: adicione abaixo.\",\r\n      pickTarget:\"Equipa / corrida\", noRaces:\"Sem corridas dispon\\u00EDveis.\",\r\n      noPicks:\"Ainda nada escolhido.\", pickLimit:\"M\\u00E1ximo de picks: \", saved:\"Guardado.\", noneyet:\"Ainda nada.\", checked:\"\\u00DAltima verifica\\u00E7\\u00E3o: \",\r\n      err:\"Erro: \", sent:\"Teste enviado.\", loading:\"A carregar...\", noTeams:\"Sem lista de equipas para esta liga.\",\r\n      keyok:\"Chave v\\u00E1lida - restantes hoje: \", keynone:\"Ainda sem chave.\", keyset:\"H\\u00E1 uma chave guardada.\",\r\n      onlysoccer:\"A API-Football s\\u00F3 funciona para futebol.\", chooseOne:\"Escolha pelo menos uma fonte.\",\r\n      clubNewsShort:\"Not\\u00EDcias do clube\", add:\"Adicionar\", mode_banner:\"Banner\", mode_full:\"Ecr\\u00E3 inteiro\", mode_overlay:\"Bottom toast\",\r\n      addPlaceTitle:\"Adicionar local\", addPlaceNote:\"procurar por nome\", find:\"Procurar\", addPlace:\"Adicionar selecionado\", findFirst:\"Primeiro procura um local.\",\r\n      noPlaces:\"Nenhum local encontrado.\", found:\"Encontrados: \", placeAdded:\"Adicionado\", placeRemoved:\"Removido\",\r\n      none:\"Nenhum\", noSport:\"Escolhe primeiro um desporto.\",\r\n      savedPlaces:\"Locais personalizados\", typePlace:\"Escreve pelo menos 2 letras.\", tooManyPlaces:\"M\\u00E1ximo 10 locais.\",\r\n      nextWarn:\"Avisar antes do jogo\", minutesBefore:\"Minutos antes\", nextMatch:\"Pr\\u00F3ximo jogo\", noNext:\"Sem jogo marcado.\",\r\n      maxClubs:\"M\\u00E1ximo \", tabCiv:\"Prote\\u00E7\\u00E3o Civil\", civNow:\"Avisos ativos\", civSources:\"Fontes e filtros\",\r\n      enabled:\"Ativo\", district:\"Distrito (IPMA)\", civYellow:\"Amarelo (discreto)\", civOrange:\"Laranja\", civRed:\"Vermelho\",\r\n      civNews:\"Not\\u00EDcias urgentes (RSS)\", keywords:\"Palavras-chave\", noCiv:\"Sem avisos ativos neste distrito.\",\r\n      civSource:\"Fonte\", civUntil:\"at\\u00E9\", civNotice:\"Aviso \\u00E0 popula\\u00E7\\u00E3o\",\r\n      weatherProvider:\"Fornecedor\", weatherWhen:\"Quando notificar\",\r\n      when_always:\"Sempre\", when_morning:\"Manh\\u00E3 at\\u00E9 \\u00E0s 10h (de hoje)\", when_night:\"Noite depois das 18h (de amanh\\u00E3)\",\r\n      wpTitle:\"Avisos antecipados\", wpEnable:\"Ativar\", wpMinutes:\"Anteced\\u00EAncia\", wRain:\"Chuva\", wWind:\"Vento\", wHeat:\"Calor\", wStorm:\"Trovoada\",\r\n      wpRainPct:\"Chuva %\", wpWindKmh:\"Vento km/h\", wpHeatC:\"Calor \\u00B0C\", wpStormCode:\"C\\u00F3digo trovoada \\u2265\",\r\n      clubAlertsTitle:\"Alertas deste clube\", custom:\"personalizados\", inherited:\"herdados (globais)\", useGlobal:\"Herdar globais\",\r\n      tabSim:\"Simular golos\", simTitle:\"Simula\\u00E7\\u00E3o de golos\", simNote:\"Um bot\\u00E3o por clube. Envia uma notifica\\u00E7\\u00E3o real (sem som) pelo Notification Center.\",\r\n      simEdit:\"Editar clubes de teste\", simId:\"Id ESPN\", simMsg:\"Mensagem\", simColor:\"Cor da faixa\", volume:\"Volume\"\r\n    }\r\n  };\r\n  var lang = \"en\", cfg = null, dirty = false, lastSaveAt = 0;\r\n  function updateSaveState() {\r\n    var e = $(\"save-state\");\r\n    if (!e) { return; }\r\n    if (dirty) { e.textContent = tr(\"unsaved\"); e.className = \"msg err\"; }\r\n    else {\r\n      e.textContent = lastSaveAt ? (tr(\"savedAt\") + new Date(lastSaveAt).toLocaleTimeString()) : \"\";\r\n      e.className = \"msg ok\";\r\n    }\r\n  }\r\n  var clubs = [], picks = [], feeds = [], geoResults = [], simClubs = [], pickListError = false;\r\n  var CLUB_ALERTS = [\r\n    [\"goal\",\"a_goal\"], [\"against\",\"a_against\"], [\"card\",\"a_card\"], [\"sub\",\"a_sub\"],\r\n    [\"varNo\",\"a_var\"], [\"penalty\",\"a_pen\"], [\"penMiss\",\"a_penMiss\"], [\"start\",\"a_start\"], [\"half\",\"a_half\"], [\"end\",\"a_end\"]\r\n  ];\r\n  function effAlerts(cl) { return cl.alerts || (cfg && cfg.football && cfg.football.alerts) || {}; }\r\n  // The panel is served at /plugins/<id>/api/ui (or .../s/<session>/api/ui), so the API lives in the\r\n  // same folder. A relative \"api/state\" resolved to .../api/api/state and every request 404ed.\r\n  var BASE = (function () {\r\n    var p = String((window.location && window.location.pathname) || \"\").replace(/\\/ui\\/?$/, \"/\");\r\n    return p.slice(-1) === \"/\" ? p : p + \"/\";\r\n  })();\r\n\r\n  function tr(k) { return (T[lang] && T[lang][k]) || T.en[k] || k; }\r\n  function fmtWhen(iso) {\r\n    try {\r\n      return new Date(iso).toLocaleString(lang === \"pt\" ? \"pt-PT\" : \"en-GB\",\r\n        { weekday: \"short\", day: \"numeric\", month: \"short\", hour: \"2-digit\", minute: \"2-digit\" });\r\n    } catch (e) { return String(iso).slice(0, 16); }\r\n  }\r\n  function esc(s) { return String(s == null ? \"\" : s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\"); }\r\n  function applyText() {\r\n    var i, els = document.querySelectorAll(\"[data-t]\");\r\n    for (i = 0; i < els.length; i++) { els[i].textContent = tr(els[i].getAttribute(\"data-t\")); }\r\n    $(\"l-en\").className = lang === \"en\" ? \"on\" : \"\";\r\n    $(\"l-pt\").className = lang === \"pt\" ? \"on\" : \"\";\r\n  }\r\n  function syncSwitches() {\r\n    var all = document.querySelectorAll(\"label.switch input[type=checkbox]\"), i, b;\r\n    for (i = 0; i < all.length; i++) {\r\n      b = all[i].parentNode && all[i].parentNode.querySelector(\".sw-state\");\r\n      if (b) { b.textContent = all[i].checked ? \"On\" : \"Off\"; }\r\n    }\r\n  }\r\n  function say(msg, cls) { var e = $(\"add-msg\"); if (e) { e.textContent = msg || \"\"; e.className = \"msg \" + (cls || \"\"); } }\r\n  function sayPick(msg, cls) { var e = $(\"pick-msg\"); if (e) { e.textContent = msg || \"\"; e.className = \"msg \" + (cls || \"\"); } }\r\n  function api(path, body) {\r\n    var opt = { method: body ? \"POST\" : \"GET\", cache: \"no-store\" };\r\n    if (body) { opt.headers = { \"Content-Type\": \"application/json\" }; opt.body = JSON.stringify(body); }\r\n    return fetch(BASE + path, opt).then(function (r) {\r\n      return r.json().then(function (j) {\r\n        if (!r.ok) { throw new Error((j && j.error) || (\"HTTP \" + r.status)); }\r\n        return j;\r\n      });\r\n    }, function () { throw new Error(tr(\"noAnswer\")); });\r\n  }\r\n  function act(btn, promise) {\r\n    if (!btn || btn.disabled) { return; }\r\n    var old = btn.textContent;\r\n    btn.disabled = true; btn.textContent = tr(\"loading\");\r\n    promise.then(function () { btn.className = btn.className.replace(/ fail| done/g, \"\") + \" done\"; })\r\n      .catch(function (e) { btn.className = btn.className.replace(/ fail| done/g, \"\") + \" fail\"; say(tr(\"err\") + e.message, \"err\"); })\r\n      .then(function () { btn.disabled = false; btn.textContent = old; });\r\n  }\r\n  function fillSel(el, list, value) {\r\n    el.innerHTML = (list || []).map(function (x) { return '<option value=\"' + esc(x.id) + '\">' + esc(x.name || x.label) + \"</option>\"; }).join(\"\");\r\n    if (value) { el.value = value; }\r\n  }\r\n  function fillMode(el, value) {\r\n    el.innerHTML = [\"banner\", \"full\", \"overlay\"].map(function (id) {\r\n      return '<option value=\"' + id + '\">' + esc(tr(\"mode_\" + id)) + \"</option>\";\r\n    }).join(\"\");\r\n    el.value = value || \"banner\";\r\n  }\r\n  function range(id, value) { $(id).value = value; $(id + \"v\").textContent = value; }\r\n\r\n  // ---- lists ---------------------------------------------------------------------------------------------------------------\r\n  function compsFor(league) {\r\n    var c = null, i, out = [], country = \"\";\r\n    for (i = 0; i < cfg.comps.length; i++) { if (cfg.comps[i].id === league) { c = cfg.comps[i]; } }\r\n    country = c ? c.country : \"\";\r\n    for (i = 0; i < cfg.comps.length; i++) {\r\n      if (cfg.comps[i].country === country || cfg.comps[i].country === \"eu\") { out.push(cfg.comps[i]); }\r\n    }\r\n    return out;\r\n  }\r\n  function renderClubs() {\r\n    var box = $(\"clubs\"), i, j, html = \"\";\r\n    if (!clubs.length) { box.innerHTML = '<div class=\"msg\">' + esc(tr(\"noClubs\")) + \"</div>\"; return; }\r\n    for (i = 0; i < clubs.length; i++) {\r\n      var cl = clubs[i], comps = compsFor(cl.league);\r\n      html += '<div class=\"club\" data-id=\"' + esc(cl.id) + '\">';\r\n      html += '<div class=\"club-head\"><b>' + esc(cl.name) + '</b><span class=\"tag\">' + esc(cl.league) + \"</span>\";\r\n      html += '<button type=\"button\" class=\"x\" data-act=\"rm\">' + esc(tr(\"remove\")) + \"</button></div>\";\r\n      html += '<div class=\"comps\">';\r\n      for (j = 0; j < comps.length; j++) {\r\n        html += '<label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-comp=\"' + esc(comps[j].id) + '\"' +\r\n          (cl.comps.indexOf(comps[j].id) >= 0 ? \" checked\" : \"\") + \"> <span>\" + esc(comps[j].name) + \"</span>\" + '<b class=\"sw-state\">On</b>' + \"</label>\";\r\n      }\r\n      html += \"</div>\";\r\n      html += '<label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-act=\"news\"' + (cl.news ? \" checked\" : \"\") +\r\n        \"> <span>\" + esc(tr(\"clubNewsShort\")) + \"</span>\" + '<b class=\"sw-state\">On</b>' + \"</label>\";\r\n      html += '<div class=\"small\" style=\"margin-top:6px\">' + esc(tr(\"clubAlertsTitle\")) + \": \" +\r\n        (cl.alerts ? esc(tr(\"custom\")) : esc(tr(\"inherited\"))) +\r\n        (cl.alerts ? ' <button type=\"button\" class=\"x\" data-clubreset=\"' + esc(cl.id) + '\">' + esc(tr(\"useGlobal\")) + \"</button>\" : \"\") + \"</div>\";\r\n      html += '<div class=\"comps\">';\r\n      for (j = 0; j < CLUB_ALERTS.length; j++) {\r\n        html += '<label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-cal=\"' + esc(cl.id) + '\" data-key=\"' + CLUB_ALERTS[j][0] + '\"' +\r\n          (effAlerts(cl)[CLUB_ALERTS[j][0]] ? \" checked\" : \"\") + \"> <span>\" + esc(tr(CLUB_ALERTS[j][1])) + \"</span>\" + '<b class=\"sw-state\">On</b>' + \"</label>\";\r\n      }\r\n      html += \"</div>\";\r\n      html += \"</div>\";\r\n    }\r\n    box.innerHTML = html;\r\n    syncSwitches();\r\n  }\r\n  // The test buttons act for one club: the one picked here, so a club with custom alerts\r\n  // can be checked without touching the others. The pick survives the 20 s refresh.\r\n  function renderTestClubs() {\r\n    var sel = $(\"test-club\"), keep = sel.value, i, html = \"\";\r\n    if (!clubs.length) { sel.innerHTML = '<option value=\"\">' + esc(tr(\"noClubs\")) + \"</option>\"; return; }\r\n    for (i = 0; i < clubs.length; i++) {\r\n      html += '<option value=\"' + esc(clubs[i].id) + '\">' + esc(clubs[i].name) + \"</option>\";\r\n    }\r\n    sel.innerHTML = html;\r\n    if (keep) { sel.value = keep; }\r\n    if (!sel.value) { sel.value = clubs[0].id; }\r\n  }\r\n  function updatePickButton() {\r\n    var sp = $(\"add-sport\").value, i, meta = null;\r\n    for (i = 0; i < (cfg ? cfg.otherSports.length : 0); i++) { if (cfg.otherSports[i].id === sp) { meta = cfg.otherSports[i]; } }\r\n    // A race pick needs an ESPN event id: never fall back to the bare sport label, because every\r\n    // such pick would then follow the same race.\r\n    $(\"add-pick\").disabled = !sp || !meta || !!(cfg.maxPicks && picks.length >= cfg.maxPicks) ||\r\n      pickListError;\r\n  }\r\n  function renderPicks() {\r\n    var box = $(\"picks\"), i, k, html = \"\", label;\r\n    if (!picks.length) { box.innerHTML = '<div class=\"msg\">' + esc(tr(\"noPicks\")) + \"</div>\"; updatePickButton(); return; }\r\n    for (i = 0; i < picks.length; i++) {\r\n      label = picks[i].sport;\r\n      for (k = 0; k < cfg.otherSports.length; k++) {\r\n        if (cfg.otherSports[k].id === picks[i].sport) { label = cfg.otherSports[k].label; }\r\n      }\r\n      html += '<div class=\"pick\" data-i=\"' + i + '\"><span>' + esc(picks[i].name) + \" <span class=\\\"small\\\">\" +\r\n        esc(label) + \"</span></span><button type=\\\"button\\\" class=\\\"x\\\" data-act=\\\"rm\\\">\" + esc(tr(\"remove\")) + \"</button></div>\";\r\n    }\r\n    box.innerHTML = html;\r\n    updatePickButton();\r\n  }\r\n  function renderFeeds() {\r\n    $(\"feeds\").innerHTML = cfg.feeds.map(function (f) {\r\n      return '<label class=\"switch\"><input type=\"checkbox\" role=\"switch\" data-feed=\"' + esc(f.id) + '\"' +\r\n        (feeds.indexOf(f.id) >= 0 ? \" checked\" : \"\") + \"> <span>\" + esc(f.name) + \"</span>\" + '<b class=\"sw-state\">On</b>' + \"</label>\";\r\n    }).join(\"\");\r\n    syncSwitches();\r\n  }\r\n  function simsay(s, cls) { var e = $(\"sim-msg\"); if (e) { e.textContent = s || \"\"; e.className = \"msg \" + (cls || \"\"); } }\r\n  function renderSim() {\r\n    var box = $(\"sim-grid\"), i, html = \"\";\r\n    if (!simClubs.length) { box.innerHTML = '<div class=\"msg\">' + esc(tr(\"noClubs\")) + \"</div>\"; return; }\r\n    for (i = 0; i < simClubs.length; i++) {\r\n      var c = simClubs[i];\r\n      html += '<div><button type=\"button\" class=\"simbtn\" data-sim=\"' + esc(c.id) + '\">' +\r\n        '<img src=\"' + esc(c.logo) + '\" alt=\"\"><span><b>' + esc(c.name) + \"</b><small>\" + esc(c.msg || tr(\"simTitle\")) +\r\n        \"</small></span></button>\" +\r\n        '<div class=\"simrow\"><select data-simlevel=\"' + esc(c.id) + '\">' +\r\n        [\"ok\",\"info\",\"warn\",\"alert\"].map(function (lv) {\r\n          return '<option value=\"' + lv + '\"' + (c.level === lv ? \" selected\" : \"\") + \">\" + lv + \"</option>\";\r\n        }).join(\"\") +\r\n        '</select><button type=\"button\" class=\"x\" data-simrm=\"' + esc(c.id) + '\">x</button></div></div>';\r\n    }\r\n    box.innerHTML = html;\r\n  }\r\n  function wmsg(s, cls) { var e = $(\"weather-msg\"); if (e) { e.textContent = s || \"\"; e.className = \"msg \" + (cls || \"\"); } }\r\n  function renderCustomPlaces() {\r\n    var box = $(\"custom-places\"), list = (cfg && cfg.weather && cfg.weather.custom) || [], i;\r\n    if (!list.length) { box.innerHTML = \"\"; return; }\r\n    var html = '<div style=\"margin-top:8px\">' + esc(tr(\"savedPlaces\")) + ': ';\r\n    for (i = 0; i < list.length; i++) {\r\n      html += '<span class=\"tag\" style=\"margin-right:6px\">' + esc(list[i].name) +\r\n        ' <button type=\"button\" class=\"x\" data-act=\"rmplace\" data-id=\"' + esc(list[i].id) + '\">x</button></span>';\r\n    }\r\n    box.innerHTML = html + \"</div>\";\r\n  }\r\n\r\n  // ---- fill -----------------------------------------------------------------------------------------------------------------\r\n  function fill() {\r\n    var c = cfg;\r\n    $(\"ver\").textContent = c.version ? \"v\" + c.version : \"\";\r\n    $(\"m-sport\").checked = !!c.modules.sport;\r\n    $(\"m-weather\").checked = !!c.modules.weather;\r\n    $(\"m-news\").checked = !!c.modules.news;\r\n    fillSel($(\"w-place\"), c.places, c.weather.place);\r\n    fillSel($(\"w-provider\"), (c.weatherProviders || []).map(function (p) {\r\n      return { id: p.id, name: p.id === 'ipma' ? 'IPMA' : 'Open-Meteo' };\r\n    }), c.weather.provider);\r\n    fillSel($(\"w-when\"), (c.weatherWhen || []).map(function (x) {\r\n      return { id: x.id, name: tr(\"when_\" + x.id) };\r\n    }), c.weather.when);\r\n    renderCustomPlaces();\r\n    geoResults = [];\r\n    $(\"place-results\").innerHTML = \"\";\r\n    $(\"place-results\").className = \"hidden\";\r\n    range(\"w-interval\", c.weather.interval); range(\"w-seconds\", c.weather.seconds); range(\"w-volume\", c.weather.volume);\r\n    $(\"w-quiet\").checked = !!c.weather.quiet; $(\"w-sound\").checked = !!c.weather.sound;\r\n    fillMode($(\"w-mode\"), c.weather.mode);\r\n\r\n    range(\"n-interval\", c.news.interval); range(\"n-seconds\", c.news.seconds); range(\"n-volume\", c.news.volume);\r\n    $(\"n-count\").value = String(c.news.count);\r\n    $(\"n-quiet\").checked = !!c.news.quiet; $(\"n-sound\").checked = !!c.news.sound;\r\n    fillMode($(\"n-mode\"), c.news.mode);\r\n\r\n    fillSel($(\"f-provider\"), c.providers, c.football.provider);\r\n    fillMode($(\"f-mode\"), c.football.mode);\r\n    $(\"f-sound\").checked = !!c.football.sound;\r\n    range(\"f-goalsec\", c.football.goalSeconds); range(\"f-othersec\", c.football.otherSeconds); range(\"f-volume\", c.football.volume);\r\n    $(\"f-next-enabled\").checked = !!(c.football.nextGame && c.football.nextGame.enabled);\r\n    $(\"f-next-minutes\").value = String((c.football.nextGame && c.football.nextGame.minutes) || 0);\r\n    var fb = document.querySelectorAll(\"[data-fb]\"), i, k;\r\n    for (i = 0; i < fb.length; i++) {\r\n      k = fb[i].getAttribute(\"data-fb\");\r\n      fb[i].checked = !!c.football.alerts[k === \"card\" ? \"card\" : k];\r\n    }\r\n\r\n    fillMode($(\"o-mode\"), c.others.mode);\r\n    $(\"o-sound\").checked = !!c.others.sound;\r\n    range(\"o-seconds\", c.others.seconds); range(\"o-volume\", c.others.volume);\r\n    var ob = document.querySelectorAll(\"[data-ob]\");\r\n    for (i = 0; i < ob.length; i++) { ob[i].checked = !!c.others.alerts[ob[i].getAttribute(\"data-ob\")]; }\r\n\r\n    clubs = JSON.parse(JSON.stringify(c.football.clubs || []));\r\n    picks = JSON.parse(JSON.stringify(c.others.picks || []));\r\n    feeds = (c.news.feeds || []).slice(0);\r\n    simClubs = JSON.parse(JSON.stringify((c.sim && c.sim.clubs) || []));\r\n    renderClubs(); renderTestClubs(); renderPicks(); renderFeeds();  renderSim();\r\n\r\n    var cv = c.civ || {}, clv = cv.levels || {};\r\n    var wp = (c.weather && c.weather.proactive) || {};\r\n    $(\"wp-enabled\").checked = !!wp.enabled;\r\n    $(\"wp-minutes\").value = String(wp.minutes || 60);\r\n    $(\"wp-rain\").checked = wp.rain !== false; $(\"wp-wind\").checked = wp.wind !== false;\r\n    $(\"wp-heat\").checked = wp.heat !== false; $(\"wp-storm\").checked = wp.storm !== false;\r\n    $(\"wp-rainpct\").value = wp.rainPct || 60; $(\"wp-windkmh\").value = wp.windKmh || 50;\r\n    $(\"wp-heatc\").value = wp.heatC || 35; $(\"wp-stormcode\").value = wp.stormCode || 95;\r\n\r\n    $(\"civ-enabled\").checked = !!cv.enabled;\r\n    $(\"m-civ\").checked = !!cv.enabled;\r\n    fillSel($(\"civ-district\"), c.civAreas || [], cv.district);\r\n    $(\"civ-yellow\").checked = !!clv.yellow; $(\"civ-orange\").checked = !!clv.orange; $(\"civ-red\").checked = !!clv.red;\r\n    $(\"civ-anepc\").checked = !!cv.anepc; $(\"civ-news\").checked = !!cv.news;\r\n    $(\"civ-keywords\").value = cv.keywords || \"\";\r\n    fillMode($(\"civ-mode\"), cv.mode);\r\n    $(\"civ-sound\").checked = !!cv.sound;\r\n    range(\"civ-interval\", cv.interval); range(\"civ-seconds\", cv.seconds); range(\"civ-volume\", cv.volume);\r\n\r\n    fillSel($(\"add-league\"), c.clubLeagues, c.clubLeagues[0] && c.clubLeagues[0].id);\r\n    fillSel($(\"add-sport\"), [{ id: \"\", name: tr(\"none\") }].concat(c.otherSports), \"\");\r\n    loadTeams($(\"add-league\").value, $(\"add-team\"));\r\n    loadTeams2();\r\n    applyTabVisibility();\r\n    syncSwitches();\r\n    dirty = false;\r\n  }\r\n  function loadTeams(league, el) {\r\n    el.innerHTML = \"<option>\" + esc(tr(\"loading\")) + \"</option>\";\r\n    api(\"teams\", { sport: \"soccer\", league: league, provider: $(\"f-provider\").value })\r\n      .then(function (d) { fillSel(el, d.teams); })\r\n      .catch(function (e) { el.innerHTML = \"<option>\" + esc(tr(\"err\") + e.message) + \"</option>\"; });\r\n  }\r\n  function loadTeams2() {\r\n    var sp = $(\"add-sport\").value, el = $(\"add-team2\"), meta = null, i;\r\n    updatePickButton();\r\n    pickListError = false;\r\n    if (!sp) { el.innerHTML = '<option value=\"\">' + esc(tr(\"none\")) + \"</option>\"; return; }\r\n    for (i = 0; i < cfg.otherSports.length; i++) { if (cfg.otherSports[i].id === sp) { meta = cfg.otherSports[i]; } }\r\n    if (!meta) { el.innerHTML = '<option value=\"\">' + esc(tr(\"none\")) + \"</option>\"; return; }\r\n    el.innerHTML = \"<option>\" + esc(tr(\"loading\")) + \"</option>\";\r\n    // Races have an ESPN event id, so two F1 picks can follow two different races.\r\n    var route = meta.teams ? \"teams\" : \"races\";\r\n    var args = meta.teams ? { sport: sp, league: sp, provider: \"espn\" } : {};\r\n    api(route, args)\r\n      .then(function (d) {\r\n        var list = d.teams || d.races || [];\r\n        // A past Grand Prix can never alert again: keep the picker useful.\r\n        if (!meta.teams) { list = list.filter(function (x) { return !x.past; }); }\r\n        pickListError = !list.length;\r\n        fillSel(el, list);\r\n      })\r\n      .catch(function () {\r\n        pickListError = true;\r\n        el.innerHTML = '<option value=\"\">' + esc(tr(meta.teams ? \"noTeams\" : \"noRaces\")) + \"</option>\";\r\n      });\r\n  }\r\n\r\n  // ---- save -----------------------------------------------------------------------------------------------------------------\r\n  function body() {\r\n    var fb = {}, ob = {}, i, k;\r\n    var fbEls = document.querySelectorAll(\"[data-fb]\");\r\n    for (i = 0; i < fbEls.length; i++) {\r\n      k = fbEls[i].getAttribute(\"data-fb\");\r\n      if (k !== \"card\") { fb[k] = fbEls[i].checked; }\r\n    }\r\n    fb.card = document.querySelector('[data-fb=\"card\"]').checked;\r\n    var obEls = document.querySelectorAll(\"[data-ob]\");\r\n    for (i = 0; i < obEls.length; i++) { ob[obEls[i].getAttribute(\"data-ob\")] = obEls[i].checked; }\r\n    return {\r\n      modules: { sport: $(\"m-sport\").checked, weather: $(\"m-weather\").checked, news: $(\"m-news\").checked },\r\n      civ: {\r\n        enabled: $(\"civ-enabled\").checked, district: $(\"civ-district\").value,\r\n        levels: { yellow: $(\"civ-yellow\").checked, orange: $(\"civ-orange\").checked, red: $(\"civ-red\").checked },\r\n        anepc: $(\"civ-anepc\").checked, news: $(\"civ-news\").checked, keywords: $(\"civ-keywords\").value,\r\n        interval: parseInt($(\"civ-interval\").value, 10), seconds: parseInt($(\"civ-seconds\").value, 10),\r\n        sound: $(\"civ-sound\").checked, mode: $(\"civ-mode\").value, volume: parseInt($(\"civ-volume\").value, 10)\r\n      },\r\n      weather: {\r\n        place: $(\"w-place\").value, custom: ((cfg && cfg.weather && cfg.weather.custom) || []).slice(0),\r\n        provider: $(\"w-provider\").value, when: $(\"w-when\").value,\r\n        interval: parseInt($(\"w-interval\").value, 10), seconds: parseInt($(\"w-seconds\").value, 10),\r\n        quiet: $(\"w-quiet\").checked, sound: $(\"w-sound\").checked, mode: $(\"w-mode\").value,\r\n        volume: parseInt($(\"w-volume\").value, 10),\r\n        proactive: {\r\n          enabled: $(\"wp-enabled\").checked, minutes: parseInt($(\"wp-minutes\").value, 10),\r\n          rain: $(\"wp-rain\").checked, wind: $(\"wp-wind\").checked,\r\n          heat: $(\"wp-heat\").checked, storm: $(\"wp-storm\").checked,\r\n          rainPct: parseInt($(\"wp-rainpct\").value, 10), windKmh: parseInt($(\"wp-windkmh\").value, 10),\r\n          heatC: parseInt($(\"wp-heatc\").value, 10), stormCode: parseInt($(\"wp-stormcode\").value, 10)\r\n        }\r\n      },\r\n      news: {\r\n        feeds: feeds.slice(0), interval: parseInt($(\"n-interval\").value, 10), seconds: parseInt($(\"n-seconds\").value, 10),\r\n        count: parseInt($(\"n-count\").value, 10), quiet: $(\"n-quiet\").checked, sound: $(\"n-sound\").checked, mode: $(\"n-mode\").value,\r\n        volume: parseInt($(\"n-volume\").value, 10)\r\n      },\r\n      football: {\r\n        provider: $(\"f-provider\").value, clubs: clubs,\r\n        alerts: { goal: fb.goal, against: fb.against, card: fb.card, sub: fb.sub, varNo: fb.varNo, penalty: fb.penalty, penMiss: fb.penMiss, start: fb.start, half: fb.half, end: fb.end },\r\n        goalSeconds: parseInt($(\"f-goalsec\").value, 10), otherSeconds: parseInt($(\"f-othersec\").value, 10),\r\n        sound: $(\"f-sound\").checked, mode: $(\"f-mode\").value, volume: parseInt($(\"f-volume\").value, 10),\r\n        nextGame: { enabled: $(\"f-next-enabled\").checked, minutes: parseInt($(\"f-next-minutes\").value, 10) }\r\n      },\r\n      others: {\r\n        picks: picks, alerts: { start: ob.start, half: ob.half, end: ob.end, score: ob.score },\r\n        seconds: parseInt($(\"o-seconds\").value, 10), sound: $(\"o-sound\").checked, mode: $(\"o-mode\").value,\r\n        volume: parseInt($(\"o-volume\").value, 10)\r\n      }\r\n    };\r\n  }\r\n  // `forTest` lets the test buttons work even with every news source unticked: the payload just\r\n  // omits the list and the backend keeps the sources it already has.\r\n  function save(forTest) {\r\n    var b = body();\r\n    if (!feeds.length) {\r\n      if (!forTest) { say(tr(\"chooseOne\"), \"err\"); return Promise.reject(new Error(tr(\"chooseOne\"))); }\r\n      delete b.news.feeds;\r\n    }\r\n    return api(\"config\", b).then(function () {\r\n      dirty = false; lastSaveAt = Date.now(); updateSaveState(); return state();\r\n    });\r\n  }\r\n  function saveOnly(btn) {\r\n    act(btn, save().then(function () { btn.className = btn.className.replace(/ fail| done/g, \"\") + \" done\"; say(tr(\"saved\"), \"ok\"); }));\r\n  }\r\n  // Test sends what is on screen: save first, otherwise a style just picked is ignored.\r\n  // Football events carry the club picked in \"Test with\", so the banner shows that club's name,\r\n  // crest and style; weather, news and civil protection ignore it.\r\n  function test(kind) {\r\n    return save(true).then(function () {\r\n      var b = { kind: kind }, tc = $(\"test-club\");\r\n      if (tc && tc.value && kind !== \"weather\" && kind !== \"news\" && kind !== \"civ\" && kind !== \"score\") {\r\n        b.club = tc.value;\r\n      }\r\n      return api(\"test\", b);\r\n    }).then(function () {\r\n      return new Promise(function (r) { setTimeout(r, 900); }).then(state);\r\n    });\r\n  }\r\n  function state() {\r\n    return api(\"state\").then(function (d) {\r\n      var first = !cfg;\r\n      cfg = d.config;\r\n      if (cfg.version) { $(\"ver\").textContent = \"v\" + cfg.version; }\r\n      if (first && cfg.lang && cfg.lang !== lang) { lang = cfg.lang; applyText(); }\r\n      if (first || !dirty) { fill(); }\r\n      $(\"sport-line\").textContent = (d.status.sport && d.status.sport.line) || \"-\";\r\n      $(\"sport-stat\").textContent = (d.status.sport && d.status.sport.at) ?\r\n        (tr(\"checked\") + new Date(d.status.sport.at).toLocaleTimeString() + \" \\u00B7 \" + (d.status.sport.state || \"\")) : \"\";\r\n      var nx = d.next || [], parts = [], ni;\r\n      for (ni = 0; ni < nx.length && ni < 4; ni++) {\r\n        var g = nx[ni], who = (g.club === g.home || g.club === g.away) ? \"\" : g.club + \": \";\r\n        parts.push(who + g.home + \" x \" + g.away + \" \\u00B7 \" + fmtWhen(g.date));\r\n      }\r\n      $(\"next-line\").textContent = parts.length ? tr(\"nextMatch\") + \": \" + parts.join(\" | \") : tr(\"noNext\");\r\n      var cl = d.civ || [], ch = \"\", ci, a, lv;\r\n      if (!cl.length) {\r\n        $(\"civ-list\").innerHTML = '<div class=\"msg\">' + esc(tr(\"noCiv\")) + \"</div>\";\r\n      } else {\r\n        for (ci = 0; ci < cl.length && ci < 8; ci++) {\r\n          a = cl[ci];\r\n          lv = a.level === \"red\" ? tr(\"civRed\") : (a.level === \"orange\" ? tr(\"civOrange\") :\r\n            (a.level === \"yellow\" ? tr(\"civYellow\") : tr(\"civNotice\")));\r\n          ch += '<div class=\"club\"><div class=\"club-head\"><b>' + esc(a.title) + '</b><span class=\"tag\">' + esc(lv) + \"</span></div>\";\r\n          ch += '<div class=\"small\">' + esc(a.source) + (a.area ? \" \\u00B7 \" + esc(a.area) : \"\") +\r\n            (a.endsAt ? \" \\u00B7 \" + esc(tr(\"civUntil\")) + \" \" + esc(String(a.endsAt).slice(0, 16)) : \"\") + \"</div>\";\r\n          if (a.message) { ch += '<div class=\"msg\">' + esc(a.message) + \"</div>\"; }\r\n          if (a.url && /^https?:/.test(a.url)) {\r\n            ch += '<a href=\"' + esc(a.url) + '\" target=\"_blank\" rel=\"noopener\">' + esc(tr(\"civSource\")) + \"</a>\";\r\n          }\r\n          ch += \"</div>\";\r\n        }\r\n        $(\"civ-list\").innerHTML = ch;\r\n      }\r\n      $(\"civ-status\").textContent = (d.status.civ && d.status.civ.at) ?\r\n        (tr(\"checked\") + new Date(d.status.civ.at).toLocaleTimeString()) : \"\";\r\n      $(\"weather-line\").textContent = d.status.weather.line || tr(\"noneyet\");\r\n      $(\"news-line\").textContent = d.status.news.line || tr(\"noneyet\");\r\n\r\n      var wkeys = Object.keys(d.watches || {}), wh = \"\", wi, wv, wname;\r\n      for (wi = 0; wi < wkeys.length; wi++) {\r\n        wv = d.watches[wkeys[wi]];\r\n        if (!wv) { continue; }\r\n        wname = wkeys[wi].replace(/^club:|^other:/, \"\");\r\n        wh += \"<div><b>\" + esc(wname) + \"</b>: \" + esc(wv.line || \"\\u2014\") +\r\n          (wv.state ? ' <span class=\"small\">' + esc(wv.state) + \"</span>\" : \"\") + \"</div>\";\r\n      }\r\n      $(\"diag-watches\").innerHTML = wh || tr(\"noClubs\");\r\n      var logs = (d.log || []).slice(0, 10), lh = \"\", li, lg;\r\n      for (li = 0; li < logs.length; li++) {\r\n        lg = logs[li];\r\n        lh += \"<div>\" + esc(new Date(lg.at).toLocaleTimeString()) + \" \\u00B7 \" + esc(lg.mod) +\r\n          \" \\u00B7 \" + esc(lg.kind) + \" \\u00B7 \" + esc(lg.text) + \"</div>\";\r\n      }\r\n      $(\"diag-log\").innerHTML = lh || \"\\u2014\";\r\n      var hv = d.health || {}, hk = Object.keys(hv), hh = \"\", hi, hn, hp;\r\n      for (hi = 0; hi < hk.length; hi++) {\r\n        hn = hk[hi]; hp = hv[hn];\r\n        hh += \"<div><b>\" + esc(hn) + \"</b>: \" + esc(hp.last || \"ok\") +\r\n          (hp.fails ? ' <span class=\"small\">(' + esc(hp.fails) + \")</span>\" : \"\") +\r\n          (hp.okAt ? ' <span class=\"small\">' + esc(fmtWhen(new Date(hp.okAt).toISOString())) + \"</span>\" : \"\") + \"</div>\";\r\n      }\r\n      $(\"diag-health\").innerHTML = hh || tr(\"noneyet\");\r\n      $(\"api-help\").textContent = lang === \"pt\"\r\n        ? \"Estado publico (sem chaves):\\n  curl http://<TV-IP>:8099/plugins/match-alerts/api/last\\n\\nRotas:\\n  GET  /api/state    estado completo (painel)\\n  GET  /api/last     vista publica\\n  POST /api/test     {kind:goal|weather|news|civ}\\n  POST /api/poll     {module:sport|weather|news|civ}\\n  POST /api/clearlog esvazia o registo\\n\\nNota: o Vetro recusa pedidos com Origin de outro site; use um script na TV ou localhost.\"\r\n        : \"Public state (no keys):\\n  curl http://<TV-IP>:8099/plugins/match-alerts/api/last\\n\\nRoutes:\\n  GET  /api/state    full state (panel only)\\n  GET  /api/last     public read-only view\\n  POST /api/test     {kind:goal|weather|news|civ}\\n  POST /api/poll     {module:sport|weather|news|civ}\\n  POST /api/clearlog empties the log\\n\\nNote: Vetro refuses requests with an Origin from another site; use a script on the TV or localhost.\";\r\n      $(\"tabnav-label\").textContent = tabs[currentTab()].textContent;\r\n      updateSaveState();\r\n    });\r\n  }\r\n\r\n  // ---- wiring ---------------------------------------------------------------------------------------------------------------\r\n  var tabs = document.querySelectorAll(\".tabs button\");\r\n  function currentTab() {\r\n    for (var i = 0; i < tabs.length; i++) { if (tabs[i].className.indexOf(\"on\") >= 0) { return i; } }\r\n    return 0;\r\n  }\r\n  // Setup and Technical are always visible. The other tabs follow the module switches in Setup;\r\n  // hiding a tab never clears its configuration, it only hides the button and pane.\r\n  function tabEnabled(name) {\r\n    if (name === \"setup\" || name === \"tech\") { return true; }\r\n    if (name === \"weather\") { return $(\"m-weather\").checked; }\r\n    if (name === \"news\") { return $(\"m-news\").checked; }\r\n    if (name === \"sport\") { return $(\"m-sport\").checked; }\r\n    return true;\r\n  }\r\n  function visibleTabs() {\r\n    var out = [], i;\r\n    for (i = 0; i < tabs.length; i++) { if (tabEnabled(tabs[i].getAttribute(\"data-tab\"))) { out.push(i); } }\r\n    return out;\r\n  }\r\n  function updatePaneState() {\r\n    var i, name, on, active = tabs[currentTab()].getAttribute(\"data-tab\"), pane;\r\n    for (i = 0; i < tabs.length; i++) {\r\n      name = tabs[i].getAttribute(\"data-tab\"); on = tabEnabled(name);\r\n      tabs[i].hidden = !on;\r\n      tabs[i].setAttribute(\"aria-selected\", name === active ? \"true\" : \"false\");\r\n      pane = document.getElementById(\"tab-\" + name);\r\n      if (pane) { pane.hidden = !on || name !== active; }\r\n    }\r\n    var civColumn = $(\"civ-column\");\r\n    if (civColumn) { civColumn.hidden = !$(\"m-civ\").checked; }\r\n  }\r\n  function applyTabVisibility() {\r\n    var vis = visibleTabs();\r\n    if (vis.length && vis.indexOf(currentTab()) < 0) { switchTab(vis[0]); }\r\n    else { updatePaneState(); }\r\n  }\r\n  function stepTab(delta) {\r\n    var vis = visibleTabs(), pos = vis.indexOf(currentTab());\r\n    if (!vis.length) { return; }\r\n    if (pos < 0) { pos = 0; }\r\n    pos = Math.max(0, Math.min(vis.length - 1, pos + delta));\r\n    switchTab(vis[pos]);\r\n  }\r\n  function switchTab(idx) {\r\n    if (idx < 0) { idx = tabs.length - 1; }\r\n    if (idx >= tabs.length) { idx = 0; }\r\n    var id = tabs[idx].getAttribute(\"data-tab\"), panes = document.querySelectorAll(\".tab\"), i;\r\n    for (i = 0; i < tabs.length; i++) { tabs[i].className = i === idx ? \"on\" : \"\"; }\r\n    for (i = 0; i < panes.length; i++) { panes[i].className = panes[i].id === \"tab-\" + id ? \"tab on\" : \"tab\"; }\r\n    updatePaneState();\r\n    $(\"tabnav-label\").textContent = tabs[idx].textContent;\r\n    $(\"tab-prev\").disabled = false; $(\"tab-next\").disabled = false;\r\n    window.scrollTo(0, 0);\r\n  }\r\n  for (var ti = 0; ti < tabs.length; ti++) {\r\n    tabs[ti].addEventListener(\"click\", function () {\r\n      for (var i = 0; i < tabs.length; i++) { if (tabs[i] === this) { switchTab(i); return; } }\r\n    });\r\n  }\r\n  var subtabs = document.querySelectorAll(\".subtabs button\");\r\n  function switchSubtab(idx) {\r\n    var i, name = subtabs[idx].getAttribute(\"data-subtab\"), panes = document.querySelectorAll(\".subtab\");\r\n    for (i = 0; i < subtabs.length; i++) {\r\n      subtabs[i].className = i === idx ? \"on\" : \"\";\r\n      subtabs[i].setAttribute(\"aria-selected\", i === idx ? \"true\" : \"false\");\r\n    }\r\n    for (i = 0; i < panes.length; i++) { panes[i].className = \"subtab\" + (panes[i].id === \"subtab-\" + name ? \" on\" : \"\"); }\r\n    window.scrollTo(0, 0);\r\n  }\r\n  for (var si = 0; si < subtabs.length; si++) {\r\n    subtabs[si].addEventListener(\"click\", function () {\r\n      for (var i = 0; i < subtabs.length; i++) { if (subtabs[i] === this) { switchSubtab(i); return; } }\r\n    });\r\n  }\r\n  $(\"tab-prev\").addEventListener(\"click\", function () { stepTab(-1); });\r\n  $(\"tab-next\").addEventListener(\"click\", function () { stepTab(1); });\r\n  $(\"save-all\").addEventListener(\"click\", function () {\r\n    act(this, save().then(function () { say(tr(\"saved\"), \"ok\"); }));\r\n  });\r\n  // One click runs every module's test in order; the Shard spaces banners 1 s apart.\r\n  $(\"test-all\").addEventListener(\"click\", function () {\r\n    var chain = Promise.resolve(), kinds = [\"goal\", \"weather\", \"news\", \"civ\"];\r\n    kinds.forEach(function (kind) {\r\n      chain = chain.then(function () { return api(\"test\", { kind: kind }); })\r\n        .then(function () { return new Promise(function (r) { setTimeout(r, 1100); }); });\r\n    });\r\n    act(this, chain.then(function () { say(tr(\"sent\"), \"ok\"); }));\r\n  });\r\n  // Dialogs do not work in the sandbox: a second click within 5 s confirms, as in the Bedtime Shard.\r\n  var clearArmed = null;\r\n  $(\"clear-log\").addEventListener(\"click\", function () {\r\n    var btn = this;\r\n    if (!clearArmed) {\r\n      clearArmed = setTimeout(function () { clearArmed = null; btn.textContent = tr(\"clearLog\"); }, 5000);\r\n      btn.textContent = tr(\"confirmClear\");\r\n      return;\r\n    }\r\n    clearTimeout(clearArmed); clearArmed = null;\r\n    btn.textContent = tr(\"clearLog\");\r\n    act(btn, api(\"clearlog\", {}).then(function () { $(\"diag-log\").innerHTML = \"\\u2014\"; }));\r\n  });\r\n  // Switching the panel language must not throw away clubs or sources added but not saved yet.\r\n  function setLang(l) {\r\n    lang = l; applyText();\r\n    $(\"tabnav-label\").textContent = tabs[currentTab()].textContent;\r\n    updateSaveState();\r\n    if (!dirty) { fill(); }\r\n    api(\"config\", { lang: l }).catch(function () {});\r\n  }\r\n  $(\"l-en\").addEventListener(\"click\", function () { setLang(\"en\"); });\r\n  $(\"l-pt\").addEventListener(\"click\", function () { setLang(\"pt\"); });\r\n\r\n  // Any edit marks the form dirty so the 20 s refresh does not overwrite it.\r\n  document.body.addEventListener(\"input\", function (e) {\r\n    var t = e.target;\r\n    if (t && (t.tagName === \"INPUT\" || t.tagName === \"SELECT\")) {\r\n      dirty = true; updateSaveState();\r\n      if (t.id && t.id.indexOf(\"v\") < 0 && $(t.id + \"v\")) { $(t.id + \"v\").textContent = t.value; }\r\n    }\r\n  }, true);\r\n  document.body.addEventListener(\"change\", function (e) {\r\n    var t = e.target;\r\n    if (t && (t.tagName === \"INPUT\" || t.tagName === \"SELECT\") && t.id !== \"test-club\") { dirty = true; updateSaveState(); }\r\n    if (t && t.type === \"checkbox\" && t.getAttribute(\"role\") === \"switch\") { syncSwitches(); }\r\n    if (t && (t.id === \"m-civ\" || t.id === \"civ-enabled\")) {\r\n      $(\"m-civ\").checked = t.checked; $(\"civ-enabled\").checked = t.checked;\r\n      applyTabVisibility();\r\n    } else if (t && /^m-(sport|weather|news)$/.test(t.id)) {\r\n      applyTabVisibility();\r\n    }\r\n    if (t && t.id === \"add-league\") { loadTeams(t.value, $(\"add-team\")); }\r\n    if (t && t.id === \"add-sport\") { loadTeams2(); }\r\n    if (t && t.id === \"f-provider\") { loadTeams($(\"add-league\").value, $(\"add-team\")); }\r\n    if (t && t.getAttribute(\"data-feed\")) {\r\n      var id = t.getAttribute(\"data-feed\"), i = feeds.indexOf(id);\r\n      if (t.checked && i < 0) { feeds.push(id); }\r\n      if (!t.checked && i >= 0) { feeds.splice(i, 1); }\r\n      \r\n      save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n    }\r\n    if (t && t.getAttribute(\"data-cn\")) {\r\n      var cid = t.getAttribute(\"data-cn\"), j;\r\n      for (j = 0; j < clubs.length; j++) { if (clubs[j].id === cid) { clubs[j].news = t.checked; } }\r\n      renderClubs();\r\n      save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n    }\r\n    if (t && t.getAttribute(\"data-comp\")) {\r\n      var card = t.parentNode;\r\n      while (card && !card.getAttribute(\"data-id\")) { card = card.parentNode; }\r\n      if (card) {\r\n        var cid2 = card.getAttribute(\"data-id\"), comp = t.getAttribute(\"data-comp\"), k;\r\n        for (k = 0; k < clubs.length; k++) {\r\n          if (clubs[k].id === cid2) {\r\n            var ix = clubs[k].comps.indexOf(comp);\r\n            if (t.checked && ix < 0) { clubs[k].comps.push(comp); }\r\n            if (!t.checked && ix >= 0) { clubs[k].comps.splice(ix, 1); }\r\n          }\r\n        }\r\n      }\r\n    }\r\n    if (t && t.getAttribute(\"data-act\") === \"news\") {\r\n      var card2 = t.parentNode;\r\n      while (card2 && !card2.getAttribute(\"data-id\")) { card2 = card2.parentNode; }\r\n      if (card2) {\r\n        var cid3 = card2.getAttribute(\"data-id\"), m;\r\n        for (m = 0; m < clubs.length; m++) { if (clubs[m].id === cid3) { clubs[m].news = t.checked; } }\r\n        \r\n        save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n      }\r\n    }\r\n    if (t && t.getAttribute(\"data-cal\")) {\r\n      var card3 = t.parentNode;\r\n      while (card3 && !card3.getAttribute(\"data-id\")) { card3 = card3.parentNode; }\r\n      if (card3) {\r\n        var cid4 = card3.getAttribute(\"data-id\"), key = t.getAttribute(\"data-key\"), cl4;\r\n        for (var ci = 0; ci < clubs.length; ci++) {\r\n          if (clubs[ci].id === cid4) {\r\n            cl4 = clubs[ci];\r\n            if (!cl4.alerts) {\r\n              var eff = effAlerts(cl4), ea = {};\r\n              for (var ek in eff) { if (eff.hasOwnProperty(ek)) { ea[ek] = eff[ek]; } }\r\n              cl4.alerts = ea;\r\n            }\r\n            cl4.alerts[key] = t.checked;\r\n          }\r\n        }\r\n        renderClubs();\r\n        save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n      }\r\n    }\r\n  }, true);\r\n\r\n  // Remove buttons (clubs and picks).\r\n  document.body.addEventListener(\"click\", function (e) {\r\n    var t = e.target;\r\n    if (!t || t.getAttribute(\"data-act\") !== \"rm\") { return; }\r\n    var box = t.parentNode;\r\n    while (box && !box.getAttribute(\"data-id\") && !box.getAttribute(\"data-i\")) { box = box.parentNode; }\r\n    if (!box) { return; }\r\n    if (box.getAttribute(\"data-id\")) {\r\n      var id = box.getAttribute(\"data-id\"), i;\r\n      for (i = 0; i < clubs.length; i++) { if (clubs[i].id === id) { clubs.splice(i, 1); } }\r\n      renderClubs(); \r\n    } else {\r\n      picks.splice(parseInt(box.getAttribute(\"data-i\"), 10), 1);\r\n      renderPicks();\r\n    }\r\n    // Removing a club/pick is meaningless if it is lost when the panel closes: save right away.\r\n    save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n  });\r\n\r\n  $(\"add-club\").addEventListener(\"click\", function () {\r\n    var league = $(\"add-league\").value, team = $(\"add-team\").value, name = \"\", i;\r\n    if (!team) { say(tr(\"noTeams\"), \"err\"); return; }\r\n    for (i = 0; i < $(\"add-team\").options.length; i++) {\r\n      if ($(\"add-team\").options[i].value === team) { name = $(\"add-team\").options[i].text; }\r\n    }\r\n    var max = cfg.maxClubs || 3;\r\n    if (clubs.length >= max) { say(tr(\"maxClubs\") + max, \"err\"); return; }\r\n    for (i = 0; i < clubs.length; i++) { if (clubs[i].id === team) { say(tr(\"err\") + \"already added\", \"err\"); return; } }\r\n    clubs.push({ id: team, name: name, league: league, comps: compsFor(league).map(function (c) { return c.id; }), news: false });\r\n    renderClubs(); \r\n    act(this, save().then(function () { say(tr(\"saved\") + \" (\" + name + \")\", \"ok\"); }));\r\n  });\r\n  $(\"add-pick\").addEventListener(\"click\", function () {\r\n    var sp = $(\"add-sport\").value, el = $(\"add-team2\"), meta = null, i, name = \"\", team = \"\";\r\n    if (!sp) { sayPick(tr(\"noSport\"), \"err\"); return; }\r\n    if (cfg.maxPicks && picks.length >= cfg.maxPicks) { sayPick(tr(\"pickLimit\") + cfg.maxPicks, \"err\"); return; }\r\n    for (i = 0; i < cfg.otherSports.length; i++) { if (cfg.otherSports[i].id === sp) { meta = cfg.otherSports[i]; } }\r\n    if (!meta) { return; }\r\n    if (pickListError) { sayPick(tr(meta.teams ? \"noTeams\" : \"noRaces\"), \"err\"); return; }\r\n    if (!el.value) { sayPick(tr(meta.teams ? \"noTeams\" : \"noRaces\"), \"err\"); return; }\r\n    team = el.value;\r\n    for (i = 0; i < el.options.length; i++) { if (el.options[i].value === team) { name = el.options[i].text; } }\r\n    if (!name) { name = team; }\r\n    // Team picks are unique by team id, race picks by ESPN event id (name only for old configs).\r\n    var key = team;\r\n    for (i = 0; i < picks.length; i++) {\r\n      if (picks[i].sport === sp && (picks[i].teamId || picks[i].name) === key) { sayPick(tr(\"err\") + \"already added\", \"err\"); return; }\r\n    }\r\n    picks.push({ sport: sp, league: sp, teamId: team, name: name });\r\n    renderPicks();\r\n    act(this, save().then(function () { sayPick(tr(\"saved\") + \" (\" + name + \")\", \"ok\"); }));\r\n  });\r\n\r\n  // ---- custom places -------------------------------------------------------------------------------------------------------\r\n  $(\"place-find\").addEventListener(\"click\", function () {\r\n    var name = $(\"place-search\").value.replace(/^\\s+|\\s+$/g, \"\");\r\n    if (name.length < 2) { wmsg(tr(\"typePlace\"), \"err\"); return; }\r\n    act(this, api(\"geocode\", { name: name }).then(function (d) {\r\n      geoResults = d.places || [];\r\n      if (!geoResults.length) {\r\n        $(\"place-results\").innerHTML = \"\";\r\n        $(\"place-results\").className = \"hidden\";\r\n        wmsg(tr(\"noPlaces\"), \"err\");\r\n        return;\r\n      }\r\n      fillSel($(\"place-results\"), geoResults.map(function (p, i) { return { id: String(i), name: p.name }; }), \"0\");\r\n      $(\"place-results\").className = \"\";\r\n      wmsg(tr(\"found\") + geoResults.length, \"ok\");\r\n    }).catch(function (e) { wmsg(tr(\"err\") + e.message, \"err\"); }));\r\n  });\r\n  $(\"place-add\").addEventListener(\"click\", function () {\r\n    var p = geoResults[parseInt($(\"place-results\").value, 10)];\r\n    if (!p) { wmsg(tr(\"findFirst\"), \"err\"); return; }\r\n    var list = ((cfg && cfg.weather && cfg.weather.custom) || []).slice(0), i, exists = false;\r\n    for (i = 0; i < list.length; i++) { if (list[i].id === p.id) { exists = true; } }\r\n    if (!exists) { list.push(p); }\r\n    if (list.length > 10) { wmsg(tr(\"tooManyPlaces\"), \"err\"); return; }\r\n    act(this, api(\"config\", { weather: { custom: list, place: p.id } }).then(function () {\r\n      return state();\r\n    }).then(function () {\r\n      dirty = false; fill();\r\n      wmsg(tr(\"placeAdded\") + \": \" + p.name, \"ok\");\r\n    }));\r\n  });\r\n  document.body.addEventListener(\"click\", function (e) {\r\n    var t = e.target;\r\n    if (!t || t.getAttribute(\"data-act\") !== \"rmplace\") { return; }\r\n    var id = t.getAttribute(\"data-id\"), list = [], i;\r\n    var cur = (cfg && cfg.weather && cfg.weather.custom) || [];\r\n    for (i = 0; i < cur.length; i++) { if (cur[i].id !== id) { list.push(cur[i]); } }\r\n    var place = cfg.weather.place === id ? \"lisbon\" : cfg.weather.place;\r\n    act(t, api(\"config\", { weather: { custom: list, place: place } }).then(function () {\r\n      return state();\r\n    }).then(function () { dirty = false; fill(); wmsg(tr(\"placeRemoved\"), \"ok\"); }));\r\n  });\r\n\r\n  $(\"save-mod\").addEventListener(\"click\", function () { saveOnly(this); });\r\n  $(\"save-weather\").addEventListener(\"click\", function () { saveOnly(this); });\r\n  $(\"save-news\").addEventListener(\"click\", function () { saveOnly(this); });\r\n  $(\"save-civ\").addEventListener(\"click\", function () { saveOnly(this); });\r\n\r\n  // ---- goal simulation -----------------------------------------------------------------------------------------------\r\n  function saveSim() {\r\n    return api(\"config\", { sim: { clubs: simClubs } }).then(function () {\r\n      return state();\r\n    }).then(function () { renderSim(); dirty = false; });\r\n  }\r\n  // The crest and the name are children of the button: a click on them must count as one click.\r\n  function closestData(el, attr) {\r\n    while (el && el !== document.body) {\r\n      if (el.getAttribute && el.getAttribute(attr)) { return el; }\r\n      el = el.parentNode;\r\n    }\r\n    return null;\r\n  }\r\n  document.body.addEventListener(\"click\", function (e) {\r\n    var b = closestData(e.target, \"data-sim\"), id, oldBg, oldBorder;\r\n    if (b) {\r\n      id = b.getAttribute(\"data-sim\");\r\n      // Do not use act(): it replaces textContent and would destroy the crest inside the button.\r\n      b.disabled = true;\r\n      simsay(tr(\"loading\"), \"\");\r\n      api(\"test-club\", { id: id }).then(function (d) {\r\n        simsay(tr(\"sent\") + \": \" + d.title + \" - \" + d.message, \"ok\");\r\n        // Green for 3 seconds so the click is unmistakable on the TV.\r\n        oldBg = b.style.background; oldBorder = b.style.borderColor;\r\n        b.style.background = \"#1c4b2f\"; b.style.borderColor = \"#3fb950\";\r\n        setTimeout(function () { b.style.background = oldBg; b.style.borderColor = oldBorder; }, 3000);\r\n      }).catch(function (err) { simsay(tr(\"err\") + err.message, \"err\"); })\r\n        .then(function () { b.disabled = false; });\r\n      return;\r\n    }\r\n    b = closestData(e.target, \"data-simrm\");\r\n    if (b) {\r\n      id = b.getAttribute(\"data-simrm\");\r\n      var i;\r\n      for (i = 0; i < simClubs.length; i++) { if (simClubs[i].id === id) { simClubs.splice(i, 1); break; } }\r\n      saveSim().catch(function (err) { simsay(tr(\"err\") + err.message, \"err\"); });\r\n    }\r\n    b = closestData(e.target, \"data-clubreset\");\r\n    if (b) {\r\n      id = b.getAttribute(\"data-clubreset\");\r\n      for (var ci = 0; ci < clubs.length; ci++) { if (clubs[ci].id === id) { delete clubs[ci].alerts; break; } }\r\n      renderClubs();\r\n      save().catch(function (err) { say(tr(\"err\") + err.message, \"err\"); });\r\n    }\r\n  });\r\n  document.body.addEventListener(\"change\", function (e) {\r\n    var t = e.target, id = t && t.getAttribute(\"data-simlevel\"), i;\r\n    if (!id) { return; }\r\n    for (i = 0; i < simClubs.length; i++) { if (simClubs[i].id === id) { simClubs[i].level = t.value; } }\r\n    saveSim().catch(function (err) { simsay(tr(\"err\") + err.message, \"err\"); });\r\n  });\r\n  $(\"sim-add\").addEventListener(\"click\", function () {\r\n    var name = $(\"sim-name\").value.replace(/^\\s+|\\s+$/g, \"\"), id = $(\"sim-id\").value.replace(/^\\s+|\\s+$/g, \"\");\r\n    if (!name || !/^\\d{1,8}$/.test(id)) { simsay(tr(\"err\") + \" id\", \"err\"); return; }\r\n    if (simClubs.length >= 10) { simsay(tr(\"maxClubs\") + \"10\", \"err\"); return; }\r\n    var i;\r\n    for (i = 0; i < simClubs.length; i++) { if (simClubs[i].id === id) { simsay(tr(\"err\") + \"already added\", \"err\"); return; } }\r\n    simClubs.push({ id: id, name: name, msg: $(\"sim-text\").value, level: $(\"sim-level\").value,\r\n      logo: \"https://a.espncdn.com/i/teamlogos/soccer/500/\" + id + \".png\" });\r\n    $(\"sim-name\").value = \"\"; $(\"sim-id\").value = \"\"; $(\"sim-text\").value = \"\";\r\n    saveSim().then(function () { simsay(tr(\"saved\") + \": \" + name, \"ok\"); })\r\n      .catch(function (err) { simsay(tr(\"err\") + err.message, \"err\"); });\r\n  });\r\n  $(\"t-civ\").addEventListener(\"click\", function () { act(this, test(\"civ\")); });\r\n  $(\"save-football\").addEventListener(\"click\", function () { saveOnly(this); });\r\n  $(\"save-others\").addEventListener(\"click\", function () { saveOnly(this); });\r\n  $(\"check\").addEventListener(\"click\", function () {\r\n    act(this, api(\"poll\", {}).then(function () { return new Promise(function (r) { setTimeout(r, 1500); }); }).then(state));\r\n  });\r\n  $(\"t-weather\").addEventListener(\"click\", function () { act(this, test(\"weather\")); });\r\n  $(\"t-news\").addEventListener(\"click\", function () { act(this, test(\"news\")); });\r\n  $(\"t-goal\").addEventListener(\"click\", function () { act(this, test(\"goal\")); });\r\n  $(\"t-against\").addEventListener(\"click\", function () { act(this, test(\"against\")); });\r\n  $(\"t-card\").addEventListener(\"click\", function () { act(this, test(\"card\")); });\r\n  $(\"t-start\").addEventListener(\"click\", function () { act(this, test(\"start\")); });\r\n  $(\"t-end\").addEventListener(\"click\", function () { act(this, test(\"end\")); });\r\n  $(\"t-next\").addEventListener(\"click\", function () { act(this, test(\"next\")); });\r\n  $(\"t-score\").addEventListener(\"click\", function () { act(this, test(\"score\")); });\r\n  $(\"savekey\").addEventListener(\"click\", function () {\r\n    act(this, api(\"config\", { apiKey: $(\"apikey\").value }).then(function () {\r\n      $(\"apikey\").value = \"\"; $(\"keymsg\").textContent = tr(\"keyset\"); return state();\r\n    }));\r\n  });\r\n  $(\"checkkey\").addEventListener(\"click\", function () {\r\n    act(this, api(\"keycheck\", {}).then(function (d) {\r\n      $(\"keymsg\").textContent = tr(\"keyok\") + d.remaining + \" (\" + (d.plan || \"-\") + \")\";\r\n    }).catch(function (e) { $(\"keymsg\").textContent = tr(\"err\") + e.message; }));\r\n  });\r\n\r\n  applyText();\r\n  $(\"tabnav-label\").textContent = tabs[currentTab()].textContent;\r\n  updateSaveState();\r\n  state().catch(function (e) { say(tr(\"err\") + e.message, \"err\"); });\r\n  setInterval(function () { state().catch(function () {}); }, 20000);\r\n})();\r\n</script>\r\n</body>\r\n</html>\r\n"}}
