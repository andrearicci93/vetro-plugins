seUp(SPECIAL[e.key]);\r\n    return;\r\n  }\r\n});\r\n\r\nvar CHAR_KEY_MAP = {\r\n  // Base ASCII keys\r\n  \" \": { key: \"space\" },\r\n  \".\": { key: \"period\" },\r\n  \",\": { key: \"comma\" },\r\n  \"-\": { key: \"minus\" },\r\n  \"=\": { key: \"equal\" },\r\n  \"/\": { key: \"slash\" },\r\n  \";\": { key: \"semicolon\" },\r\n  \"'\": { key: \"apostrophe\" },\r\n  \"[\": { key: \"bracketleft\" },\r\n  \"]\": { key: \"bracketright\" },\r\n  \"\\\\\": { key: \"backslash\" },\r\n  \"`\": { key: \"grave\" },\r\n\r\n  // Shifted symbols\r\n  \"!\": { key: \"1\", shift: true },\r\n  \"@\": { key: \"2\", shift: true },\r\n  \"#\": { key: \"3\", shift: true },\r\n  \"$\": { key: \"4\", shift: true },\r\n  \"%\": { key: \"5\", shift: true },\r\n  \"^\": { key: \"6\", shift: true },\r\n  \"&\": { key: \"7\", shift: true },\r\n  \"*\": { key: \"8\", shift: true },\r\n  \"(\": { key: \"9\", shift: true },\r\n  \")\": { key: \"0\", shift: true },\r\n  \"_\": { key: \"minus\", shift: true },\r\n  \"+\": { key: \"equal\", shift: true },\r\n  \"~\": { key: \"grave\", shift: true },\r\n  \"{\": { key: \"bracketleft\", shift: true },\r\n  \"}\": { key: \"bracketright\", shift: true },\r\n  \"|\": { key: \"backslash\", shift: true },\r\n  \":\": { key: \"semicolon\", shift: true },\r\n  \"\\\"\": { key: \"apostrophe\", shift: true },\r\n  \"<\": { key: \"comma\", shift: true },\r\n  \">\": { key: \"period\", shift: true },\r\n  \"?\": { key: \"slash\", shift: true }\r\n};\r\n\r\nvar keyQueue = [];\r\nvar keySending = false;\r\n\r\nfunction pumpKeyQueue() {\r\n  if (keySending || keyQueue.length === 0) return;\r\n  keySending = true;\r\n  var nextItem = keyQueue.shift();\r\n  var p;\r\n  if (nextItem.type === \"text\") {\r\n    sendText(nextItem.text, false);\r\n    p = Promise.resolve();\r\n  } else {\r\n    p = sendKey(nextItem.key, nextItem.shift, nextItem.ctrl);\r\n  }\r\n  (p || Promise.resolve()).then(function () {\r\n    keySending = false;\r\n    pumpKeyQueue();\r\n  }).catch(function () {\r\n    keySending = false;\r\n    pumpKeyQueue();\r\n  });\r\n}\r\n\r\nvar directTextBuffer = \"\";\r\n\r\nfunction resetDirectTextBuffer() {\r\n  directTextBuffer = \"\";\r\n  if (ti && document.activeElement !== ti) {\r\n    ti.value = \"\";\r\n    ti.dir = \"ltr\";\r\n  }\r\n}\r\n\r\nfunction syncDirectInputMirror() {\r\n  if (ti && document.activeElement !== ti) {\r\n    ti.value = directTextBuffer;\r\n    ti.dir = RTL_REGEX.test(directTextBuffer) ? \"rtl\" : \"ltr\";\r\n  }\r\n}\r\n\r\nfunction sendDirectKey(key, shift, ctrl) {\r\n  keyQueue.push({ type: \"key\", key: key, shift: !!shift, ctrl: !!ctrl });\r\n  pumpKeyQueue();\r\n}\r\n\r\nfunction sendDirectText(text) {\r\n  keyQueue.push({ type: \"text\", text: text });\r\n  pumpKeyQueue();\r\n}\r\n\r\nfunction sendSubmit() {\r\n  resetDirectTextBuffer();\r\n  if (wsConnected && ws && ws.readyState === WebSocket.OPEN) {\r\n    try {\r\n      ws.send(JSON.stringify({\r\n        method: \"ms.remote.control\",\r\n        params: {\r\n          TypeOfRemote: \"SendInputEnd\"\r\n        }\r\n      }));\r\n      return Promise.resolve();\r\n    } catch (e) {\r\n      wsConnected = false;\r\n    }\r\n  }\r\n  return fetch(\"key\", {\r\n    method: \"POST\",\r\n    headers: { \"Content-Type\": \"text/plain\" },\r\n    body: JSON.stringify({ key: \"Return\" })\r\n  }).then(function (r) { return r.json(); })\r\n    .then(function (d) {\r\n      if (!d.ok) setStatus(\"Failed: \" + (d.error || d.stderr || \"\"), \"err\");\r\n    })\r\n    .catch(function () { setStatus(\"Network error\", \"err\"); });\r\n}\r\n\r\ndocument.addEventListener(\"keydown\", function (e) {\r\n  // Always handle Ctrl+Enter / Cmd+Enter as OK click everywhere\r\n  if ((e.key === \"Enter\" || e.keyCode === 13) && (e.ctrlKey || e.metaKey)) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendKey(\"Return\");\r\n    if (screenTime) screenTime.textContent = \"Sent OK\";\r\n    return;\r\n  }\r\n\r\n  // If focus is inside an input or textarea, let native input handling proceed\r\n  if (document.activeElement && (document.activeElement.tagName === \"INPUT\" || document.activeElement.tagName === \"TEXTAREA\")) {\r\n    return;\r\n  }\r\n\r\n  // Ctrl+A / Cmd+A -> Select All in focused input field on TV\r\n  if ((e.ctrlKey || e.metaKey) && (e.key === \"a\" || e.key === \"A\" || e.keyCode === 65)) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendDirectKey(\"a\", false, true);\r\n    if (screenTime) screenTime.textContent = \"Select All (Ctrl+A)\";\r\n    return;\r\n  }\r\n\r\n  // Ctrl+S / Cmd+S -> Open Search on TV\r\n  if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === \"s\" || e.key === \"S\" || e.keyCode === 83)) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendKey(\"XF86Search\");\r\n    if (screenTime) screenTime.textContent = \"Search (Ctrl+S)\";\r\n    return;\r\n  }\r\n\r\n  // Ctrl+Z / Cmd+Z -> Undo in focused input field on TV\r\n  if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && (e.key === \"z\" || e.key === \"Z\" || e.keyCode === 90)) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendDirectKey(\"z\", false, true);\r\n    if (screenTime) screenTime.textContent = \"Undo (Ctrl+Z)\";\r\n    return;\r\n  }\r\n\r\n  // Allow native browser shortcuts (like Ctrl+R, Ctrl+W, etc.) to pass\r\n  if (e.ctrlKey || e.altKey || e.metaKey) {\r\n    return;\r\n  }\r\n\r\n  // Enter (without Ctrl) when not in an input box -> submit (act like Enter on Android keyboard)\r\n  if (e.key === \"Enter\") {\r\n    e.preventDefault();\r\n    sendSubmit();\r\n    if (screenTime) screenTime.textContent = \"Submit ↵\";\r\n    return;\r\n  }\r\n\r\n  // Backspace when not in an input box -> delete directly on TV\r\n  if (e.key === \"Backspace\") {\r\n    e.preventDefault();\r\n    if (directTextBuffer.length > 1) {\r\n      directTextBuffer = directTextBuffer.slice(0, -1);\r\n      sendDirectText(directTextBuffer);\r\n      syncDirectInputMirror();\r\n      if (screenTime) screenTime.textContent = \"Sent ⌫\";\r\n      return;\r\n    }\r\n    if (directTextBuffer.length === 1) {\r\n      directTextBuffer = \"\";\r\n      syncDirectInputMirror();\r\n    }\r\n    sendDirectKey(\"BackSpace\");\r\n    if (screenTime) screenTime.textContent = \"Sent ⌫\";\r\n    return;\r\n  }\r\n\r\n  // Escape -> Back\r\n  if (e.key === \"Escape\") {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendKey(\"XF86Back\");\r\n    if (screenTime) screenTime.textContent = \"Sent Back\";\r\n    return;\r\n  }\r\n\r\n  // Home -> Open TV Home / Smart Hub\r\n  if (e.key === \"Home\" || e.keyCode === 36) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    sendKey(\"XF86Home\");\r\n    if (screenTime) screenTime.textContent = \"Sent Home\";\r\n    return;\r\n  }\r\n\r\n  // Arrow keys -> continuous repeat navigation\r\n  if (SPECIAL[e.key]) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    if (e.repeat) return;\r\n    pressDown(SPECIAL[e.key]);\r\n    return;\r\n  }\r\n\r\n  // Single printable characters (letters, numbers, space, punctuation, symbols) -> direct typing to TV\r\n  if (e.key && e.key.length === 1) {\r\n    e.preventDefault();\r\n    if (directTextBuffer.length > 0) {\r\n      directTextBuffer += e.key;\r\n      sendDirectText(directTextBuffer);\r\n      syncDirectInputMirror();\r\n      if (screenTime) screenTime.textContent = \"Typed '\" + e.key + \"'\";\r\n      return;\r\n    }\r\n    var mapped = CHAR_KEY_MAP[e.key];\r\n    if (mapped) {\r\n      sendDirectKey(mapped.key, mapped.shift, false);\r\n      if (screenTime) screenTime.textContent = \"Typed '\" + e.key + \"'\";\r\n      return;\r\n    }\r\n    if (/^[A-Z]$/.test(e.key)) {\r\n      sendDirectKey(e.key.toLowerCase(), true, false);\r\n      if (screenTime) screenTime.textContent = \"Typed '\" + e.key + \"'\";\r\n      return;\r\n    }\r\n    if (/^[a-z0-9]$/.test(e.key)) {\r\n      sendDirectKey(e.key, false, false);\r\n      if (screenTime) screenTime.textContent = \"Typed '\" + e.key + \"'\";\r\n      return;\r\n    }\r\n    directTextBuffer = e.key;\r\n    sendDirectText(directTextBuffer);\r\n    syncDirectInputMirror();\r\n    if (screenTime) screenTime.textContent = \"Typed '\" + e.key + \"'\";\r\n    return;\r\n  }\r\n});\r\n\r\ndocument.addEventListener(\"paste\", function (e) {\r\n  if (document.activeElement && (document.activeElement.tagName === \"INPUT\" || document.activeElement.tagName === \"TEXTAREA\")) {\r\n    return;\r\n  }\r\n  var clip = e.clipboardData || window.clipboardData;\r\n  var pasted = clip ? clip.getData(\"text\") : \"\";\r\n  if (pasted) {\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    directTextBuffer = pasted;\r\n    sendDirectText(directTextBuffer);\r\n    syncDirectInputMirror();\r\n    if (screenTime) screenTime.textContent = \"Pasted text\";\r\n  }\r\n});\r\n\r\ndocument.addEventListener(\"keyup\", function (e) {\r\n  if (document.activeElement && (document.activeElement.tagName === \"INPUT\" || document.activeElement.tagName === \"TEXTAREA\")) {\r\n    return;\r\n  }\r\n  if (e.key === \"Backspace\" && activeHoldKey === \"BackSpace\") {\r\n    e.preventDefault();\r\n    releaseUp(\"BackSpace\");\r\n    return;\r\n  }\r\n  var key = SPECIAL[e.key];\r\n  if (key && activeHoldKey === key) {\r\n    e.preventDefault();\r\n    releaseUp(key);\r\n  }\r\n});\r\n\r\nwindow.addEventListener(\"blur\", function () {\r\n  if (activeHoldKey) releaseUp();\r\n});\r\n\r\ndocument.getElementById(\"btn-send\").addEventListener(\"click\", function () {\r\n  var t = ti.value; ti.value = \"\"; ti.dir = \"ltr\";\r\n  resetDirectTextBuffer();\r\n  if (t) {\r\n    sendText(t, true);\r\n  } else {\r\n    sendSubmit();\r\n  }\r\n  ti.focus();\r\n});\r\n\r\nvar btnBksp = document.getElementById(\"btn-bksp\");\r\nbtnBksp.addEventListener(\"pointerdown\", function (e) {\r\n  e.preventDefault();\r\n  if (directTextBuffer.length > 1) {\r\n    directTextBuffer = directTextBuffer.slice(0, -1);\r\n    sendDirectText(directTextBuffer);\r\n    syncDirectInputMirror();\r\n    if (screenTime) screenTime.textContent = \"Sent ⌫\";\r\n    return;\r\n  }\r\n  if (directTextBuffer.length === 1) {\r\n    directTextBuffer = \"\";\r\n    syncDirectInputMirror();\r\n  }\r\n  pressDown(\"BackSpace\");\r\n});\r\nbtnBksp.addEventListener(\"pointerup\", function (e) {\r\n  e.preventDefault();\r\n  releaseUp(\"BackSpace\");\r\n  if (!isTouch) ti.focus();\r\n});\r\nbtnBksp.addEventListener(\"pointerleave\", function (e) {\r\n  if (activeHoldKey === \"BackSpace\") releaseUp(\"BackSpace\");\r\n});\r\nbtnBksp.addEventListener(\"pointercancel\", function (e) {\r\n  if (activeHoldKey === \"BackSpace\") releaseUp(\"BackSpace\");\r\n});\r\n\r\nvar btnSelectAll = document.getElementById(\"btn-select-all\");\r\nif (btnSelectAll) {\r\n  btnSelectAll.addEventListener(\"click\", function () {\r\n    resetDirectTextBuffer();\r\n    sendDirectKey(\"a\", false, true);\r\n    if (screenTime) screenTime.textContent = \"Select All (Ctrl+A)\";\r\n  });\r\n}\r\n\r\nvar keyButtons = document.querySelectorAll(\"[data-key]\");\r\nfor (var i = 0; i < keyButtons.length; i++) {\r\n  (function (btn) {\r\n    var k = btn.getAttribute(\"data-key\");\r\n    if (REPEAT_KEYS[k]) {\r\n      btn.addEventListener(\"pointerdown\", function (e) {\r\n        e.preventDefault();\r\n        resetDirectTextBuffer();\r\n        pressDown(k);\r\n      });\r\n      btn.addEventListener(\"pointerup\", function (e) {\r\n        e.preventDefault();\r\n        releaseUp(k);\r\n      });\r\n      btn.addEventListener(\"pointerleave\", function (e) {\r\n        if (activeHoldKey === k) releaseUp(k);\r\n      });\r\n      btn.addEventListener(\"pointercancel\", function (e) {\r\n        if (activeHoldKey === k) releaseUp(k);\r\n      });\r\n    } else {\r\n      btn.addEventListener(\"click\", function () {\r\n        resetDirectTextBuffer();\r\n        sendKey(k);\r\n      });\r\n    }\r\n  })(keyButtons[i]);\r\n}\r\n\r\n// Collapsible cards handling\r\nvar boxKeyboard = document.getElementById(\"box-keyboard\");\r\nvar btnToggleKeyboard = document.getElementById(\"btn-toggle-keyboard\");\r\nvar keyboardHeader = document.getElementById(\"keyboard-header\");\r\n\r\nfunction toggleKeyboardCollapse(e) {\r\n  if (e && e.target && (e.target.closest(\"#status\") || e.target.closest(\"a\") || e.target.closest(\"input\"))) return;\r\n  var collapsed = boxKeyboard.classList.toggle(\"is-collapsed\");\r\n  btnToggleKeyboard.setAttribute(\"aria-expanded\", collapsed ? \"false\" : \"true\");\r\n  try {\r\n    localStorage.setItem(\"vetro_keyboard_collapsed\", collapsed ? \"1\" : \"0\");\r\n  } catch (err) {}\r\n}\r\n\r\nif (btnToggleKeyboard && boxKeyboard) {\r\n  btnToggleKeyboard.addEventListener(\"click\", function (e) {\r\n    e.stopPropagation();\r\n    toggleKeyboardCollapse();\r\n  });\r\n  if (keyboardHeader) {\r\n    keyboardHeader.addEventListener(\"click\", toggleKeyboardCollapse);\r\n  }\r\n  try {\r\n    if (localStorage.getItem(\"vetro_keyboard_collapsed\") === \"1\") {\r\n      boxKeyboard.classList.add(\"is-collapsed\");\r\n      btnToggleKeyboard.setAttribute(\"aria-expanded\", \"false\");\r\n    }\r\n  } catch (err) {}\r\n}\r\n\r\nvar boxPlayback = document.getElementById(\"box-playback\");\r\nvar btnTogglePlayback = document.getElementById(\"btn-toggle-playback\");\r\nvar playbackHeader = document.getElementById(\"playback-header\");\r\n\r\nfunction togglePlaybackCollapse(e) {\r\n  if (e && e.target && (e.target.closest(\"a\") || e.target.closest(\"button:not(.btn-collapse)\"))) return;\r\n  var collapsed = boxPlayback.classList.toggle(\"is-collapsed\");\r\n  btnTogglePlayback.setAttribute(\"aria-expanded\", collapsed ? \"false\" : \"true\");\r\n  try {\r\n    localStorage.setItem(\"vetro_playback_collapsed\", collapsed ? \"1\" : \"0\");\r\n  } catch (err) {}\r\n}\r\n\r\nif (btnTogglePlayback && boxPlayback) {\r\n  btnTogglePlayback.addEventListener(\"click\", function (e) {\r\n    e.stopPropagation();\r\n    togglePlaybackCollapse();\r\n  });\r\n  if (playbackHeader) {\r\n    playbackHeader.addEventListener(\"click\", togglePlaybackCollapse);\r\n  }\r\n  try {\r\n    if (localStorage.getItem(\"vetro_playback_collapsed\") === \"1\") {\r\n      boxPlayback.classList.add(\"is-collapsed\");\r\n      btnTogglePlayback.setAttribute(\"aria-expanded\", \"false\");\r\n    }\r\n  } catch (err) {}\r\n}\r\n\r\n// Screen preview, interactive pointer / D-Pad, standalone tab & fullscreen orientation logic\r\nvar boxScreen = document.getElementById(\"box-screen\");\r\nvar btnToggleScreen = document.getElementById(\"btn-toggle-screen\");\r\nvar screenHeader = document.getElementById(\"screen-header\");\r\nvar screenStage = document.getElementById(\"screen-stage\");\r\nvar screenFrame = document.getElementById(\"screen-frame\");\r\nvar screenImg = document.getElementById(\"screen-img\");\r\nvar tvCursor = document.getElementById(\"tv-cursor\");\r\nvar screenSpinner = document.getElementById(\"screen-spinner\");\r\nvar screenTime = document.getElementById(\"screen-time\");\r\nvar screenHint = document.getElementById(\"screen-hint\");\r\nvar btnRefreshScreen = document.getElementById(\"btn-refresh-screen\");\r\nvar chkAutoRefresh = document.getElementById(\"chk-auto-refresh\");\r\n\r\nvar linkStandalone = document.getElementById(\"link-standalone\");\r\nvar standaloneBanner = document.getElementById(\"standalone-banner\");\r\nvar standaloneUrlInput = document.getElementById(\"standalone-url-input\");\r\nvar btnCopyScreenUrl = document.getElementById(\"btn-copy-screen-url\");\r\nvar btnCopyPluginUrl = document.getElementById(\"btn-copy-plugin-url\");\r\nvar btnCloseStandalone = document.getElementById(\"btn-close-standalone\");\r\nvar btnEnterTheater = document.getElementById(\"btn-enter-theater\");\r\nvar btnExitTheater = document.getElementById(\"btn-exit-theater\");\r\nvar btnRotateScreen = document.getElementById(\"btn-rotate-screen\");\r\nvar btnNativeFs = document.getElementById(\"btn-native-fs\");\r\nvar btnTheaterInput = document.getElementById(\"btn-theater-input\");\r\nvar theaterInputActive = false;\r\n\r\nvar btnModePointer = document.getElementById(\"btn-mode-pointer\");\r\nvar btnModeDpad = document.getElementById(\"btn-mode-dpad\");\r\nvar pointerTools = document.getElementById(\"pointer-tools\");\r\nvar dpadTools = document.getElementById(\"dpad-tools\");\r\nvar chkHoverOnly = document.getElementById(\"chk-hover-only\");\r\nvar btnRightMode = document.getElementById(\"btn-right-mode\");\r\nvar btnScrollUp = document.getElementById(\"btn-scroll-up\");\r\nvar btnScrollDown = document.getElementById(\"btn-scroll-down\");\r\nvar btnPreviewBack = document.getElementById(\"btn-preview-back\");\r\n\r\nvar screenCapturing = false;\r\nvar hasScreenImage = false;\r\nvar autoRefreshTimer = null;\r\nvar previewMode = \"pointer\";\r\nvar rightClickArmed = false;\r\nvar isScreenOnly = false;\r\nvar isRotatedLandscape = false;\r\n\r\nvar basePluginUrl = location.href.split(\"#\")[0];\r\nvar standaloneScreenUrl = basePluginUrl + \"#screen\";\r\n\r\nvar curTvX = 960;\r\nvar curTvY = 540;\r\nvar lastTapTime = 0;\r\nvar lastTapX = -100;\r\nvar lastTapY = -100;\r\n\r\nvar ptrActive = false;\r\nvar ptrId = null;\r\nvar ptrDownClientX = 0;\r\nvar ptrDownClientY = 0;\r\nvar ptrLastClientX = 0;\r\nvar ptrLastClientY = 0;\r\nvar ptrDownTv = null;\r\nvar ptrHoldTimer = null;\r\nvar ptrIsButtonDown = false;\r\nvar ptrIsDragging = false;\r\nvar ptrLastDragSend = 0;\r\nvar dpadAccX = 0;\r\nvar dpadAccY = 0;\r\nvar dpadSwiped = false;\r\n\r\nfunction copyTextToClipboard(str, inputEl) {\r\n  if (inputEl) {\r\n    inputEl.value = str;\r\n    inputEl.focus();\r\n    inputEl.select();\r\n  } else {\r\n    var tmp = document.createElement(\"input\");\r\n    tmp.value = str;\r\n    tmp.style.position = \"fixed\";\r\n    tmp.style.opacity = \"0\";\r\n    document.body.appendChild(tmp);\r\n    tmp.focus();\r\n    tmp.select();\r\n    try { document.execCommand(\"copy\"); } catch (e) {}\r\n    document.body.removeChild(tmp);\r\n    return;\r\n  }\r\n  try { document.execCommand(\"copy\"); } catch (e) {}\r\n  if (navigator.clipboard && navigator.clipboard.writeText) {\r\n    navigator.clipboard.writeText(str).catch(function () {});\r\n  }\r\n}\r\n\r\nfunction fitScreenFrame() {\r\n  if (!screenFrame || !screenStage) return;\r\n  if (!isScreenOnly) {\r\n    screenFrame.style.width = \"\";\r\n    screenFrame.style.height = \"\";\r\n    return;\r\n  }\r\n  var sw = screenStage.clientWidth - 4;\r\n  var sh = screenStage.clientHeight - 4;\r\n  if (sw <= 0 || sh <= 0) return;\r\n  var w = Math.min(sw, Math.floor(sh * 16 / 9));\r\n  var h = Math.floor(w * 9 / 16);\r\n  screenFrame.style.width = w + \"px\";\r\n  screenFrame.style.height = h + \"px\";\r\n}\r\n\r\nfunction setRotatedLandscape(on) {\r\n  isRotatedLandscape = !!on;\r\n  document.body.classList.toggle(\"is-rotated-landscape\", isRotatedLandscape);\r\n  if (btnRotateScreen) btnRotateScreen.classList.toggle(\"active\", isRotatedLandscape);\r\n  setTimeout(fitScreenFrame, 20);\r\n}\r\n\r\nfunction setTheaterInput(on) {\r\n  theaterInputActive = !!on;\r\n  document.body.classList.toggle(\"has-theater-input\", theaterInputActive);\r\n  if (btnTheaterInput) btnTheaterInput.classList.toggle(\"active\", theaterInputActive);\r\n  try { localStorage.setItem(\"vetro_theater_input\", theaterInputActive ? \"1\" : \"0\"); } catch (e) {}\r\n  setTimeout(fitScreenFrame, 30);\r\n}\r\n\r\nfunction setScreenOnlyMode(on, syncHash) {\r\n  isScreenOnly = !!on;\r\n  document.body.classList.toggle(\"is-screen-only\", isScreenOnly);\r\n  if (!isScreenOnly && isRotatedLandscape) {\r\n    setRotatedLandscape(false);\r\n  }\r\n  if (isScreenOnly) {\r\n    boxScreen.classList.remove(\"is-collapsed\");\r\n    if (btnToggleScreen) btnToggleScreen.setAttribute(\"aria-expanded\", \"true\");\r\n    if (!hasScreenImage && !screenCapturing) {\r\n      fetchScreenshot();\r\n    }\r\n    var savedInput = null;\r\n    try { savedInput = localStorage.getItem(\"vetro_theater_input\"); } catch (e) {}\r\n    if (savedInput !== null) {\r\n      setTheaterInput(savedInput === \"1\");\r\n    } else {\r\n      setTheaterInput(!!isMobile);\r\n    }\r\n  } else {\r\n    document.body.classList.remove(\"has-theater-input\");\r\n    if (btnTheaterInput) btnTheaterInput.classList.remove(\"active\");\r\n  }\r\n  if (syncHash) {\r\n    try {\r\n      if (history && history.replaceState) {\r\n        history.replaceState(null, \"\", isScreenOnly ? \"#screen\" : basePluginUrl);\r\n      }\r\n    } catch (e) {}\r\n  }\r\n  fitScreenFrame();\r\n  setTimeout(fitScreenFrame, 40);\r\n}\r\n\r\nif (linkStandalone) {\r\n  linkStandalone.href = standaloneScreenUrl;\r\n  if (isStandaloneTab) {\r\n    linkStandalone.style.display = \"none\";\r\n  }\r\n  linkStandalone.addEventListener(\"click\", function (e) {\r\n    e.preventDefault();\r\n    e.stopPropagation();\r\n    if (boxScreen.classList.contains(\"is-collapsed\")) {\r\n      toggleScreenCollapse();\r\n    }\r\n    if (standaloneBanner && standaloneUrlInput) {\r\n      standaloneBanner.style.display = \"block\";\r\n      copyTextToClipboard(standaloneScreenUrl, standaloneUrlInput);\r\n      if (btnCopyScreenUrl) btnCopyScreenUrl.classList.add(\"active\");\r\n      if (btnCopyPluginUrl) btnCopyPluginUrl.classList.remove(\"active\");\r\n    }\r\n  });\r\n}\r\n\r\nif (btnCopyScreenUrl) {\r\n  btnCopyScreenUrl.onclick = function () {\r\n    copyTextToClipboard(standaloneScreenUrl, standaloneUrlInput);\r\n    btnCopyScreenUrl.classList.add(\"active\");\r\n    if (btnCopyPluginUrl) btnCopyPluginUrl.classList.remove(\"active\");\r\n    btnCopyScreenUrl.textContent = \"✔ Copied Screen URL\";\r\n    setTimeout(function () { btnCopyScreenUrl.textContent = \"📋 Screen Fullscreen URL\"; }, 1600);\r\n  };\r\n}\r\nif (btnCopyPluginUrl) {\r\n  btnCopyPluginUrl.onclick = function () {\r\n    copyTextToClipboard(basePluginUrl, standaloneUrlInput);\r\n    btnCopyPluginUrl.classList.add(\"active\");\r\n    if (btnCopyScreenUrl) btnCopyScreenUrl.classList.remove(\"active\");\r\n    btnCopyPluginUrl.textContent = \"✔ Copied Plugin URL\";\r\n    setTimeout(function () { btnCopyPluginUrl.textContent = \"📋 Full Plugin URL\"; }, 1600);\r\n  };\r\n}\r\nif (btnCloseStandalone && standaloneBanner) {\r\n  btnCloseStandalone.onclick = function () {\r\n    standaloneBanner.style.display = \"none\";\r\n  };\r\n}\r\n\r\nif (btnEnterTheater) {\r\n  btnEnterTheater.addEventListener(\"click\", function (e) {\r\n    e.stopPropagation();\r\n    setScreenOnlyMode(true, true);\r\n  });\r\n}\r\nif (btnExitTheater) {\r\n  btnExitTheater.onclick = function () {\r\n    if (document.fullscreenElement || document.webkitFullscreenElement) {\r\n      try {\r\n        if (document.exitFullscreen) document.exitFullscreen();\r\n        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();\r\n      } catch (e) {}\r\n    }\r\n    setScreenOnlyMode(false, true);\r\n  };\r\n}\r\nif (btnRotateScreen) {\r\n  btnRotateScreen.onclick = function () {\r\n    setRotatedLandscape(!isRotatedLandscape);\r\n  };\r\n}\r\nif (btnTheaterInput) {\r\n  btnTheaterInput.onclick = function () {\r\n    setTheaterInput(!theaterInputActive);\r\n  };\r\n}\r\n\r\nif (btnNativeFs) {\r\n  var canFs = !!(isStandaloneTab && (document.documentElement.requestFullscreen || document.documentElement.webkitRequestFullscreen));\r\n  if (!canFs) {\r\n    btnNativeFs.style.display = \"none\";\r\n  } else {\r\n    btnNativeFs.onclick = function () {\r\n      var fsEl = document.fullscreenElement || document.webkitFullscreenElement;\r\n      if (!fsEl) {\r\n        var reqFs = document.documentElement.requestFullscreen || document.documentElement.webkitRequestFullscreen;\r\n        try {\r\n          var p = reqFs.call(document.documentElement);\r\n          if (p && p.then) {\r\n            p.then(function () {\r\n              if (screen.orientation && screen.orientation.lock) {\r\n                screen.orientation.lock(\"landscape\").catch(function () {});\r\n              }\r\n              setRotatedLandscape(false);\r\n              setTimeout(fitScreenFrame, 80);\r\n            }).catch(function () {});\r\n          }\r\n        } catch (err) {}\r\n      } else {\r\n        try {\r\n          if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock();\r\n        } catch (err2) {}\r\n        try {\r\n          if (document.exitFullscreen) document.exitFullscreen();\r\n          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();\r\n        } catch (err3) {}\r\n      }\r\n    };\r\n  }\r\n}\r\n\r\ndocument.addEventListener(\"fullscreenchange\", function () {\r\n  var fsActive = !!(document.fullscreenElement || document.webkitFullscreenElement);\r\n  if (btnNativeFs) btnNativeFs.classList.toggle(\"active\", fsActive);\r\n  setTimeout(fitScreenFrame, 60);\r\n});\r\n\r\nwindow.addEventListener(\"resize\", function () {\r\n  if (isScreenOnly) {\r\n    if (isRotatedLandscape && window.innerWidth > window.innerHeight + 40) {\r\n      setRotatedLandscape(false);\r\n    } else {\r\n      fitScreenFrame();\r\n    }\r\n  }\r\n});\r\nwindow.addEventListener(\"orientationchange\", function () {\r\n  setTimeout(function () {\r\n    if (isScreenOnly) {\r\n      if (isRotatedLandscape && window.innerWidth > window.innerHeight + 40) {\r\n        setRotatedLandscape(false);\r\n      } else {\r\n        fitScreenFrame();\r\n      }\r\n    }\r\n  }, 120);\r\n});\r\nwindow.addEventListener(\"hashchange\", function () {\r\n  if (location.hash === \"#screen\" && !isScreenOnly) {\r\n    setScreenOnlyMode(true, false);\r\n  } else if (location.hash !== \"#screen\" && isScreenOnly) {\r\n    setScreenOnlyMode(false, false);\r\n  }\r\n});\r\n\r\nfunction showCursorMarker(pctX, pctY, holding) {\r\n  if (!tvCursor || previewMode !== \"pointer\") return;\r\n  tvCursor.style.display = \"block\";\r\n  tvCursor.style.left = pctX.toFixed(2) + \"%\";\r\n  tvCursor.style.top = pctY.toFixed(2) + \"%\";\r\n  if (holding) {\r\n    tvCursor.classList.add(\"is-holding\");\r\n  } else {\r\n    tvCursor.classList.remove(\"is-holding\");\r\n  }\r\n}\r\n\r\nfunction spawnRipple(pctX, pctY, altColor) {\r\n  if (!screenFrame) return;\r\n  var r = document.createElement(\"div\");\r\n  r.className = altColor ? \"click-ripple ripple-alt\" : \"click-ripple\";\r\n  r.style.left = pctX.toFixed(2) + \"%\";\r\n  r.style.top = pctY.toFixed(2) + \"%\";\r\n  screenFrame.appendChild(r);\r\n  setTimeout(function () {\r\n    if (r.parentNode) r.parentNode.removeChild(r);\r\n  }, 450);\r\n}\r\n\r\nfunction getTvCoords(clientX, clientY) {\r\n  var rect = screenImg.getBoundingClientRect();\r\n  if (!rect.width || !rect.height) {\r\n    return { x: 960, y: 540, pctX: 50, pctY: 50, relX: 0.5, relY: 0.5 };\r\n  }\r\n  var relX, relY;\r\n  if (isRotatedLandscape) {\r\n    relX = (clientY - rect.top) / rect.height;\r\n    relY = 1 - ((clientX - rect.left) / rect.width);\r\n  } else {\r\n    relX = (clientX - rect.left) / rect.width;\r\n    relY = (clientY - rect.top) / rect.height;\r\n  }\r\n  if (relX < 0) relX = 0; else if (relX > 1) relX = 1;\r\n  if (relY < 0) relY = 0; else if (relY > 1) relY = 1;\r\n  return {\r\n    x: Math.max(0, Math.min(1919, Math.round(relX * 1919))),\r\n    y: Math.max(0, Math.min(1079, Math.round(relY * 1079))),\r\n    pctX: relX * 100,\r\n    pctY: relY * 100,\r\n    relX: relX,\r\n    relY: relY\r\n  };\r\n}\r\n\r\nfunction ensureWsMouse() {\r\n  if (!wsConnected || !ws || ws.readyState !== WebSocket.OPEN) return false;\r\n  if (!wsMouseReady) {\r\n    try {\r\n      ws.send(JSON.stringify({\r\n        method: \"ms.remote.control\",\r\n        params: { Cmd: \"Create\", TypeOfRemote: \"CreateMouseDevice\" }\r\n      }));\r\n      wsMouseReady = true;\r\n    } catch (e) {\r\n      wsConnected = false;\r\n      wsMouseReady = false;\r\n      return false;\r\n    }\r\n  }\r\n  return true;\r\n}\r\n\r\nfunction wsSendMouseMove(dx, dy) {\r\n  ws.send(JSON.stringify({\r\n    method: \"ms.remote.control\",\r\n    params: {\r\n      Cmd: \"Move\",\r\n      Position: { x: String(dx), y: String(dy) },\r\n      TypeOfRemote: \"ProcessMouseDevice\"\r\n    }\r\n  }));\r\n}\r\n\r\nfunction wsSendMouseBtn(cmd) {\r\n  ws.send(JSON.stringify({\r\n    method: \"ms.remote.control\",\r\n    params: { Cmd: cmd, TypeOfRemote: \"ProcessMouseDevice\" }\r\n  }));\r\n}\r\n\r\nfunction wsJumpCursor(tx, ty) {\r\n  wheelLastJumpTime = 0;\r\n  wsSendMouseMove(-2000, -2000);\r\n  wsSendMouseMove(-2000, -2000);\r\n  if (tx < 36 && ty < 36 && (tx > 0 || ty > 0)) {\r\n    wsSendMouseMove(100, 100);\r\n    wsSendMouseMove(Math.round((tx - 200) / 2), Math.round((ty - 200) / 2));\r\n  } else if (tx > 0 || ty > 0) {\r\n    wsSendMouseMove(Math.round(tx / 2), Math.round(ty / 2));\r\n  }\r\n  curTvX = tx;\r\n  curTvY = ty;\r\n}\r\n\r\nvar mouseHttpBusy = false;\r\nvar mouseHttpQueue = [];\r\nvar wheelTimer = null;\r\nvar wheelLastSent = 0;\r\nvar wheelPendingDelta = 0;\r\nvar wheelPendingCoords = null;\r\nvar wheelLastJumpX = -100;\r\nvar wheelLastJumpY = -100;\r\nvar wheelLastJumpTime = 0;\r\n\r\nfunction computeDeltaStep(targetX, targetY) {\r\n  var dxTv = targetX - curTvX;\r\n  var dyTv = targetY - curTvY;\r\n  var dist = Math.sqrt(dxTv * dxTv + dyTv * dyTv);\r\n  if (dist < 2) return null;\r\n  var scale = dist >= 40 ? 0.5 : (dist >= 14 ? 0.58 : 0.72);\r\n  var sx = Math.round(dxTv * scale);\r\n  var sy = Math.round(dyTv * scale);\r\n  if (sx === 0 && sy === 0) return null;\r\n  return { sx: sx, sy: sy, scale: scale };\r\n}\r\n\r\nfunction drainMouseHttp() {\r\n  if (mouseHttpBusy || mouseHttpQueue.length === 0) return;\r\n  var item = mouseHttpQueue.shift();\r\n  if (item.__target) {\r\n    var step = computeDeltaStep(item.__target.x, item.__target.y);\r\n    if (!step) {\r\n      drainMouseHttp();\r\n      return;\r\n    }\r\n    wheelLastJumpTime = 0;\r\n    curTvX = Math.max(0, Math.min(1919, Math.round(curTvX + step.sx / step.scale)));\r\n    curTvY = Math.max(0, Math.min(1079, Math.round(curTvY + step.sy / step.scale)));\r\n    item = { action: \"drag\", dx: step.sx, dy: step.sy };\r\n  }\r\n  mouseHttpBusy = true;\r\n  fetch(\"mouse\", {\r\n    method: \"POST\",\r\n    headers: { \"Content-Type\": \"text/plain\" },\r\n    body: JSON.stringify(item)\r\n  }).catch(function () {}).then(function () {\r\n    mouseHttpBusy = false;\r\n    drainMouseHttp();\r\n  });\r\n}\r\n\r\nfunction postMouseFallback(payload) {\r\n  var last = mouseHttpQueue[mouseHttpQueue.length - 1];\r\n  if (payload && payload.action === \"wheel\" && last && last.action === \"wheel\") {\r\n    last.delta = Math.max(-5, Math.min(5, (last.delta || 0) + (payload.delta || 0)));\r\n    if (last.delta === 0) last.delta = (payload.delta < 0 ? -1 : 1);\r\n    if (typeof payload.x === \"number\" && typeof payload.y === \"number\") {\r\n      last.x = payload.x;\r\n      last.y = payload.y;\r\n    }\r\n  } else if (payload && ((payload.action === \"move\" && last && (last.action === \"move\" || last.__target)) ||\r\n      ((payload.action === \"down\" || payload.action === \"click\" || payload.action === \"rightclick\") && last && last.__target))) {\r\n    mouseHttpQueue[mouseHttpQueue.length - 1] = payload;\r\n  } else {\r\n    mouseHttpQueue.push(payload);\r\n  }\r\n  drainMouseHttp();\r\n}\r\n\r\nfunction tvMouseJumpAndAct(tx, ty, actionName) {\r\n  if (actionName === \"wheel\") {\r\n    tvMouseWheel(-1, { x: tx, y: ty, pctX: tx / 19.2, pctY: ty / 10.8 });\r\n    return;\r\n  }\r\n  wheelLastJumpTime = 0;\r\n  if (ensureWsMouse()) {\r\n    try {\r\n      if (actionName === \"clickInPlace\") {\r\n        wsSendMouseBtn(\"LeftClick\");\r\n      } else {\r\n        wsJumpCursor(tx, ty);\r\n        if (actionName === \"click\") wsSendMouseBtn(\"LeftClick\");\r\n        else if (actionName === \"rightclick\") wsSendMouseBtn(\"RightClick\");\r\n        else if (actionName === \"down\") wsSendMouseBtn(\"Press\");\r\n      }\r\n      return;\r\n    } catch (e) {\r\n      wsConnected = false;\r\n      wsMouseReady = false;\r\n    }\r\n  }\r\n  postMouseFallback({ action: actionName, x: tx, y: ty });\r\n  curTvX = tx;\r\n  curTvY = ty;\r\n}\r\n\r\nfunction tvMouseStepDelta(targetX, targetY) {\r\n  if (ensureWsMouse()) {\r\n    var wsStep = computeDeltaStep(targetX, targetY);\r\n    if (!wsStep) return;\r\n    try {\r\n      wheelLastJumpTime = 0;\r\n      wsSendMouseMove(wsStep.sx, wsStep.sy);\r\n      curTvX = Math.max(0, Math.min(1919, Math.round(curTvX + wsStep.sx / wsStep.scale)));\r\n      curTvY = Math.max(0, Math.min(1079, Math.round(curTvY + wsStep.sy / wsStep.scale)));\r\n      return;\r\n    } catch (e) {\r\n      wsConnected = false;\r\n      wsMouseReady = false;\r\n    }\r\n  }\r\n  var last = mouseHttpQueue[mouseHttpQueue.length - 1];\r\n  if (last && last.__target) {\r\n    last.__target.x = targetX;\r\n    last.__target.y = targetY;\r\n  } else {\r\n    mouseHttpQueue.push({ __target: { x: targetX, y: targetY } });\r\n  }\r\n  drainMouseHttp();\r\n}\r\n\r\nfunction tvMouseRelease() {\r\n  if (ensureWsMouse()) {\r\n    try {\r\n      wsSendMouseBtn(\"Release\");\r\n      return;\r\n    } catch (e) {\r\n      wsConnected = false;\r\n      wsMouseReady = false;\r\n    }\r\n  }\r\n  postMouseFallback({ action: \"up\" });\r\n}\r\n\r\nfunction flushPendingWheel() {\r\n  wheelTimer = null;\r\n  if (wheelPendingDelta === 0) return;\r\n  var delta = Math.max(-5, Math.min(5, wheelPendingDelta));\r\n  var coords = wheelPendingCoords;\r\n  wheelPendingDelta = 0;\r\n  wheelPendingCoords = null;\r\n  wheelLastSent = Date.now();\r\n  var payload = { action: \"wheel\", delta: delta };\r\n  if (coords) {\r\n    var distSq = (coords.x - wheelLastJumpX) * (coords.x - wheelLastJumpX) +\r\n                 (coords.y - wheelLastJumpY) * (coords.y - wheelLastJumpY);\r\n    if (distSq > 144 || (wheelLastSent - wheelLastJumpTime) > 2000) {\r\n      payload.x = coords.x;\r\n      payload.y = coords.y;\r\n      wheelLastJumpX = coords.x;\r\n      wheelLastJumpY = coords.y;\r\n      wheelLastJumpTime = wheelLastSent;\r\n    }\r\n    curTvX = coords.x;\r\n    curTvY = coords.y;\r\n    showCursorMarker(coords.pctX, coords.pctY, false);\r\n  }\r\n  postMouseFallback(payload);\r\n  screenTime.textContent = (delta > 0 ? \"Scrolled ▲\" : \"Scrolled ▼\") + \" (\" + curTvX + \", \" + curTvY + \")\";\r\n}\r\n\r\nfunction tvMouseWheel(delta, coords) {\r\n  wheelPendingDelta += (delta > 0 ? 1 : -1);\r\n  if (coords) wheelPendingCoords = coords;\r\n  var elapsed = Date.now() - wheelLastSent;\r\n  if (elapsed >= 150 && !wheelTimer) {\r\n    flushPendingWheel();\r\n  } else if (!wheelTimer) {\r\n    wheelTimer = setTimeout(flushPendingWheel, Math.max(20, 150 - elapsed));\r\n  }\r\n}\r\n\r\nfunction setPreviewMode(mode) {\r\n  previewMode = (mode === \"dpad\") ? \"dpad\" : \"pointer\";\r\n  if (btnModePointer) btnModePointer.classList.toggle(\"active\", previewMode === \"pointer\");\r\n  if (btnModeDpad) btnModeDpad.classList.toggle(\"active\", previewMode === \"dpad\");\r\n  if (pointerTools) pointerTools.style.display = (previewMode === \"pointer\") ? \"inline-flex\" : \"none\";\r\n  if (dpadTools) dpadTools.style.display = (previewMode === \"dpad\") ? \"inline-flex\" : \"none\";\r\n  if (screenFrame) screenFrame.classList.toggle(\"is-dpad-mode\", previewMode === \"dpad\");\r\n  if (tvCursor && previewMode !== \"pointer\") tvCursor.style.display = \"none\";\r\n  if (screenHint) {\r\n    screenHint.textContent = (previewMode === \"dpad\")\r\n      ? \"D-Pad mode (YouTube & TV apps): Swipe to move focus · Tap edges (▲▼◀▶) or center (OK) · Right-click: Back\"\r\n      : \"Tap: click · Double-tap: double-click · Hold or drag: press & drag · Right-click or Shift+Wheel supported\";\r\n  }\r\n  try { localStorage.setItem(\"vetro_preview_mode\", previewMode); } catch (e) {}\r\n  if (isScreenOnly) fitScreenFrame();\r\n}\r\n\r\ntry {\r\n  if (localStorage.getItem(\"vetro_preview_mode\") === \"dpad\") {\r\n    setPreviewMode(\"dpad\");\r\n  }\r\n} catch (e) {}\r\n\r\nif (btnModePointer) {\r\n  btnModePointer.onclick = function () { setPreviewMode(\"pointer\"); };\r\n}\r\nif (btnModeDpad) {\r\n  btnModeDpad.onclick = function () { setPreviewMode(\"dpad\"); };\r\n}\r\nif (btnRightMode) {\r\n  btnRightMode.onclick = function () {\r\n    rightClickArmed = !rightClickArmed;\r\n    btnRightMode.classList.toggle(\"active\", rightClickArmed);\r\n  };\r\n}\r\nif (btnScrollUp) {\r\n  btnScrollUp.onclick = function () { tvMouseWheel(1, null); };\r\n}\r\nif (btnScrollDown) {\r\n  btnScrollDown.onclick = function () { tvMouseWheel(-1, null); };\r\n}\r\nif (btnPreviewBack) {\r\n  btnPreviewBack.onclick = function () {\r\n    resetDirectTextBuffer();\r\n    sendKey(\"XF86Back\");\r\n    screenTime.textContent = \"Sent Back\";\r\n  };\r\n}\r\n\r\nfunction isPreviewInteractive() {\r\n  return !!(hasScreenImage && screenImg && screenFrame);\r\n}\r\n\r\nif (screenFrame) {\r\n  screenFrame.addEventListener(\"contextmenu\", function (e) {\r\n    if (!isPreviewInteractive()) return;\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    var c = getTvCoords(e.clientX, e.clientY);\r\n    spawnRipple(c.pctX, c.pctY, true);\r\n    if (previewMode === \"dpad\") {\r\n      sendKey(\"XF86Back\");\r\n      screenTime.textContent = \"D-Pad Back\";\r\n      return;\r\n    }\r\n    showCursorMarker(c.pctX, c.pctY, false);\r\n    tvMouseJumpAndAct(c.x, c.y, \"rightclick\");\r\n    screenTime.textContent = \"Right-click (\" + c.x + \", \" + c.y + \")\";\r\n  });\r\n\r\n  screenFrame.addEventListener(\"wheel\", function (e) {\r\n    if (!isPreviewInteractive() || previewMode !== \"pointer\") return;\r\n    if (!e.shiftKey && !e.altKey && !e.ctrlKey) return;\r\n    e.preventDefault();\r\n    var c = getTvCoords(e.clientX, e.clientY);\r\n    tvMouseWheel(e.deltaY < 0 ? 1 : -1, c);\r\n  }, { passive: false });\r\n\r\n  screenFrame.addEventListener(\"pointerdown\", function (e) {\r\n    if (!isPreviewInteractive()) return;\r\n    if (e.pointerType === \"mouse\" && e.button !== 0) return;\r\n    e.preventDefault();\r\n    resetDirectTextBuffer();\r\n    try { screenFrame.setPointerCapture(e.pointerId); } catch (err) {}\r\n\r\n    ptrActive = true;\r\n    ptrId = e.pointerId;\r\n    ptrDownClientX = e.clientX;\r\n    ptrDownClientY = e.clientY;\r\n    ptrLastClientX = e.clientX;\r\n    ptrLastClientY = e.clientY;\r\n    ptrDownTv = getTvCoords(e.clientX, e.clientY);\r\n    ptrIsButtonDown = false;\r\n    ptrIsDragging = false;\r\n    dpadAccX = 0;\r\n    dpadAccY = 0;\r\n    dpadSwiped = false;\r\n\r\n    if (ptrHoldTimer) clearTimeout(ptrHoldTimer);\r\n\r\n    if (previewMode === \"pointer\") {\r\n      var hoverOnly = (chkHoverOnly && chkHoverOnly.checked) || e.altKey;\r\n      showCursorMarker(ptrDownTv.pctX, ptrDownTv.pctY, false);\r\n      if (!hoverOnly && !rightClickArmed) {\r\n        ptrHoldTimer = setTimeout(function () {\r\n          ptrHoldTimer = null;\r\n          if (!ptrActive || ptrIsDragging) return;\r\n          ptrIsButtonDown = true;\r\n          showCursorMarker(ptrDownTv.pctX, ptrDownTv.pctY, true);\r\n          tvMouseJumpAndAct(ptrDownTv.x, ptrDownTv.y, \"down\");\r\n          screenTime.textContent = \"Holding (\" + ptrDownTv.x + \", \" + ptrDownTv.y + \")…\";\r\n        }, 300);\r\n      }\r\n    }\r\n  });\r\n\r\n  screenFrame.addEventListener(\"pointermove\", function (e) {\r\n    if (!ptrActive || e.pointerId !== ptrId) return;\r\n    e.preventDefault();\r\n    var rawDx = e.clientX - ptrDownClientX;\r\n    var rawDy = e.clientY - ptrDownClientY;\r\n    var stepDx = e.clientX - ptrLastClientX;\r\n    var stepDy = e.clientY - ptrLastClientY;\r\n    ptrLastClientX = e.clientX;\r\n    ptrLastClientY = e.clientY;\r\n\r\n    if (previewMode === \"dpad\") {\r\n      if (isRotatedLandscape) {\r\n        dpadAccX += stepDy;\r\n        dpadAccY += -stepDx;\r\n      } else {\r\n        dpadAccX += stepDx;\r\n        dpadAccY += stepDy;\r\n      }\r\n      var stepPx = 56;\r\n      if (Math.abs(rawDx) >= 14 || Math.abs(rawDy) >= 14) {\r\n        while (Math.abs(dpadAccX) >= stepPx || Math.abs(dpadAccY) >= stepPx) {\r\n          dpadSwiped = true;\r\n          if (Math.abs(dpadAccX) >= Math.abs(dpadAccY)) {\r\n            var dirX = dpadAccX > 0 ? \"Right\" : \"Left\";\r\n            sendKey(dirX);\r\n            screenTime.textContent = \"D-Pad \" + dirX;\r\n            dpadAccX += (dpadAccX > 0 ? -stepPx : stepPx);\r\n          } else {\r\n            var dirY = dpadAccY > 0 ? \"Down\" : \"Up\";\r\n            sendKey(dirY);\r\n            screenTime.textContent = \"D-Pad \" + dirY;\r\n            dpadAccY += (dpadAccY > 0 ? -stepPx : stepPx);\r\n          }\r\n        }\r\n      }\r\n      return;\r\n    }\r\n\r\n    var distClient = Math.sqrt(rawDx * rawDx + rawDy * rawDy);\r\n    if (!ptrIsDragging && distClient >= 6) {\r\n      ptrIsDragging = true;\r\n      if (ptrHoldTimer) {\r\n        clearTimeout(ptrHoldTimer);\r\n        ptrHoldTimer = null;\r\n      }\r\n      var hoverMoveOnly = (chkHoverOnly && chkHoverOnly.checked) || e.altKey;\r\n      if (!ptrIsButtonDown) {\r\n        if (hoverMoveOnly) {\r\n          tvMouseJumpAndAct(ptrDownTv.x, ptrDownTv.y, \"move\");\r\n        } else {\r\n          ptrIsButtonDown = true;\r\n          tvMouseJumpAndAct(ptrDownTv.x, ptrDownTv.y, \"down\");\r\n        }\r\n      }\r\n    }\r\n\r\n    if (ptrIsDragging) {\r\n      var cur = getTvCoords(e.clientX, e.clientY);\r\n      showCursorMarker(cur.pctX, cur.pctY, ptrIsButtonDown);\r\n      var now = Date.now();\r\n      var useWs = ensureWsMouse();\r\n      if (!useWs) tvMouseStepDelta(cur.x, cur.y);\r\n      if (now - ptrLastDragSend >= (useWs ? 20 : 50)) {\r\n        ptrLastDragSend = now;\r\n        if (useWs) tvMouseStepDelta(cur.x, cur.y);\r\n        screenTime.textContent = (ptrIsButtonDown ? \"Dragging (\" : \"Moving (\") + cur.x + \", \" + cur.y + \")…\";\r\n      }\r\n    }\r\n  });\r\n\r\n  function finishPointerGesture(e, cancelled) {\r\n    if (!ptrActive || e.pointerId !== ptrId) return;\r\n    ptrActive = false;\r\n    if (ptrHoldTimer) {\r\n      clearTimeout(ptrHoldTimer);\r\n      ptrHoldTimer = null;\r\n    }\r\n    try { screenFrame.releasePointerCapture(e.pointerId); } catch (err) {}\r\n\r\n    var endCoords = getTvCoords(e.clientX, e.clientY);\r\n\r\n    if (previewMode === \"dpad\") {\r\n      if (!cancelled && !dpadSwiped) {\r\n        spawnRipple(endCoords.pctX, endCoords.pctY, false);\r\n        var rx = endCoords.relX;\r\n        var ry = endCoords.relY;\r\n        var dpadKey;\r\n        if (rx >= 0.34 && rx <= 0.66 && ry >= 0.28 && ry <= 0.72) {\r\n          dpadKey = \"Return\";\r\n        } else if (Math.abs(rx - 0.5) > Math.abs(ry - 0.5)) {\r\n          dpadKey = rx < 0.5 ? \"Left\" : \"Right\";\r\n        } else {\r\n          dpadKey = ry < 0.5 ? \"Up\" : \"Down\";\r\n        }\r\n        sendKey(dpadKey);\r\n        screenTime.textContent = \"D-Pad \" + (dpadKey === \"Return\" ? \"OK\" : dpadKey);\r\n      }\r\n      return;\r\n    }\r\n\r\n    if (ptrIsDragging) {\r\n      tvMouseStepDelta(endCoords.x, endCoords.y);\r\n      if (ptrIsButtonDown) {\r\n        tvMouseRelease();\r\n        ptrIsButtonDown = false;\r\n      }\r\n      showCursorMarker(endCoords.pctX, endCoords.pctY, false);\r\n      screenTime.textContent = \"Moved to (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n      return;\r\n    }\r\n\r\n    if (ptrIsButtonDown) {\r\n      tvMouseRelease();\r\n      ptrIsButtonDown = false;\r\n      showCursorMarker(endCoords.pctX, endCoords.pctY, false);\r\n      screenTime.textContent = \"Released (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n      return;\r\n    }\r\n\r\n    if (cancelled) return;\r\n\r\n    showCursorMarker(endCoords.pctX, endCoords.pctY, false);\r\n    var hoverOnlyTap = (chkHoverOnly && chkHoverOnly.checked) || e.altKey;\r\n    if (hoverOnlyTap) {\r\n      spawnRipple(endCoords.pctX, endCoords.pctY, true);\r\n      tvMouseJumpAndAct(endCoords.x, endCoords.y, \"move\");\r\n      screenTime.textContent = \"Moved cursor (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n      return;\r\n    }\r\n\r\n    if (rightClickArmed) {\r\n      rightClickArmed = false;\r\n      if (btnRightMode) btnRightMode.classList.remove(\"active\");\r\n      spawnRipple(endCoords.pctX, endCoords.pctY, true);\r\n      tvMouseJumpAndAct(endCoords.x, endCoords.y, \"rightclick\");\r\n      screenTime.textContent = \"Right-click (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n      return;\r\n    }\r\n\r\n    var nowTap = Date.now();\r\n    var tapDist = Math.sqrt((endCoords.x - lastTapX) * (endCoords.x - lastTapX) + (endCoords.y - lastTapY) * (endCoords.y - lastTapY));\r\n    if (nowTap - lastTapTime < 350 && tapDist < 34) {\r\n      lastTapTime = 0;\r\n      spawnRipple(endCoords.pctX, endCoords.pctY, true);\r\n      tvMouseJumpAndAct(endCoords.x, endCoords.y, \"clickInPlace\");\r\n      screenTime.textContent = \"Double-click (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n      return;\r\n    }\r\n\r\n    lastTapTime = nowTap;\r\n    lastTapX = endCoords.x;\r\n    lastTapY = endCoords.y;\r\n    spawnRipple(endCoords.pctX, endCoords.pctY, false);\r\n    tvMouseJumpAndAct(endCoords.x, endCoords.y, \"click\");\r\n    screenTime.textContent = \"Click (\" + endCoords.x + \", \" + endCoords.y + \")\";\r\n  }\r\n\r\n  screenFrame.addEventListener(\"pointerup\", function (e) {\r\n    finishPointerGesture(e, false);\r\n  });\r\n  screenFrame.addEventListener(\"pointercancel\", function (e) {\r\n    finishPointerGesture(e, true);\r\n  });\r\n}\r\n\r\nfunction fetchScreenshot() {\r\n  if (screenCapturing) return;\r\n  screenCapturing = true;\r\n  if (!hasScreenImage) {\r\n    screenSpinner.textContent = \"Capturing screen from TV…\";\r\n    screenSpinner.style.display = \"block\";\r\n  } else {\r\n    screenTime.textContent = \"Updating preview…\";\r\n  }\r\n  btnRefreshScreen.disabled = true;\r\n  btnRefreshScreen.textContent = \"⏳ Capturing…\";\r\n\r\n  var img = new Image();\r\n  var url = \"screenshot?t=\" + Date.now();\r\n  img.onload = function () {\r\n    hasScreenImage = true;\r\n    screenImg.src = url;\r\n    screenImg.style.display = \"block\";\r\n    if (screenFrame) screenFrame.classList.add(\"has-image\");\r\n    screenSpinner.style.display = \"none\";\r\n    screenCapturing = false;\r\n    btnRefreshScreen.disabled = false;\r\n    btnRefreshScreen.textContent = \"🔄 Capture / Refresh\";\r\n    var d = new Date();\r\n    var pad = function (n) { return (n < 10 ? \"0\" : \"\") + n; };\r\n    screenTime.textContent = \"Captured at \" + pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds());\r\n    if (isScreenOnly) fitScreenFrame();\r\n\r\n    if (chkAutoRefresh && chkAutoRefresh.checked && (!boxScreen.classList.contains(\"is-collapsed\") || isScreenOnly)) {\r\n      autoRefreshTimer = setTimeout(fetchScreenshot, 3500);\r\n    }\r\n  };\r\n  img.onerror = function () {\r\n    if (!hasScreenImage) {\r\n      screenSpinner.textContent = \"Failed to capture screen from TV\";\r\n    } else {\r\n      screenTime.textContent = \"Refresh failed — retrying\";\r\n    }\r\n    screenCapturing = false;\r\n    btnRefreshScreen.disabled = false;\r\n    btnRefreshScreen.textContent = \"🔄 Capture / Refresh\";\r\n\r\n    if (chkAutoRefresh && chkAutoRefresh.checked && (!boxScreen.classList.contains(\"is-collapsed\") || isScreenOnly)) {\r\n      autoRefreshTimer = setTimeout(fetchScreenshot, 5000);\r\n    }\r\n  };\r\n  img.src = url;\r\n}\r\n\r\nfunction toggleScreenCollapse(e) {\r\n  if (e && e.target && (e.target.closest(\"#link-standalone\") || e.target.closest(\"#btn-enter-theater\"))) return;\r\n  var collapsed = boxScreen.classList.toggle(\"is-collapsed\");\r\n  btnToggleScreen.setAttribute(\"aria-expanded\", collapsed ? \"false\" : \"true\");\r\n  if (collapsed) {\r\n    if (autoRefreshTimer) {\r\n      clearTimeout(autoRefreshTimer);\r\n      autoRefreshTimer = null;\r\n    }\r\n  } else {\r\n    if (!hasScreenImage) {\r\n      fetchScreenshot();\r\n    } else if (chkAutoRefresh && chkAutoRefresh.checked && !screenCapturing) {\r\n      fetchScreenshot();\r\n    }\r\n  }\r\n}\r\n\r\nif (location.hash === \"#screen\") {\r\n  setScreenOnlyMode(true, false);\r\n}\r\n\r\nif (btnToggleScreen && boxScreen) {\r\n  btnToggleScreen.addEventListener(\"click\", function (e) {\r\n    e.stopPropagation();\r\n    toggleScreenCollapse();\r\n  });\r\n  if (screenHeader) {\r\n    screenHeader.addEventListener(\"click\", toggleScreenCollapse);\r\n  }\r\n}\r\n\r\nif (chkAutoRefresh) {\r\n  chkAutoRefresh.onchange = function () {\r\n    if (chkAutoRefresh.checked) {\r\n      if (!screenCapturing) fetchScreenshot();\r\n    } else {\r\n      if (autoRefreshTimer) clearTimeout(autoRefreshTimer);\r\n    }\r\n  };\r\n}\r\n\r\nbtnRefreshScreen.onclick = function () {\r\n  fetchScreenshot();\r\n};\r\n\r\nif (!isTouch) {\r\n  ti.focus();\r\n}\r\n</script>\r\n</body>\r\n</html>\r\n"}}
