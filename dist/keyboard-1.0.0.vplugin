e.control\",\r\n          params: {\r\n            TypeOfRemote: \"SendInputEnd\"\r\n          }\r\n        }));\r\n      }\r\n      setStatus(\"Text sent ✔\", \"ok\");\r\n      return;\r\n    } catch (e) {\r\n      wsConnected = false;\r\n    }\r\n  }\r\n\r\n  if (isAscii) {\r\n    setStatus(\"Typing on TV…\", \"busy\");\r\n    fetch(\"type\", {\r\n      method: \"POST\",\r\n      headers: { \"Content-Type\": \"text/plain\" },\r\n      body: JSON.stringify({ text: text })\r\n    }).then(function (r) { return r.json(); })\r\n      .then(function (d) {\r\n        if (d.ok) {\r\n          if (submit) {\r\n            fetch(\"key\", {\r\n              method: \"POST\",\r\n              headers: { \"Content-Type\": \"text/plain\" },\r\n              body: JSON.stringify({ key: \"Return\" })\r\n            }).catch(function () {});\r\n          }\r\n          var warns = [];\r\n          if (d.truncated) warns.push(\"truncated to 200 chars\");\r\n          if (d.dropped && d.dropped.length > 0) warns.push(\"unsupported chars omitted: \" + d.dropped.join(\" \"));\r\n          if (warns.length > 0) {\r\n            setStatus(\"Text sent (\" + warns.join(\"; \") + \")\", \"warn\");\r\n          } else {\r\n            setStatus(\"Text sent ✔\", \"ok\");\r\n          }\r\n        } else {\r\n          setStatus(\"Failed: \" + (d.error || \"\"), \"err\");\r\n        }\r\n      })\r\n      .catch(function () { setStatus(\"Network error\", \"err\"); });\r\n  } else {\r\n    certBanner.style.display = \"block\";\r\n    setStatus(\"Unicode text input requires TV certificate approval (see banner above)\", \"warn\");\r\n    initWS();\r\n  }\r\n}\r\n\r\n// Auto RTL text direction for right-to-left scripts\r\nvar RTL_REGEX = /[\\u0591-\\u07FF\\uFB1D-\\uFDFD\\uFE70-\\uFEFC]/;\r\nti.addEventListener(\"input\", function () {\r\n  ti.dir = RTL_REGEX.test(ti.value) ? \"rtl\" : \"ltr\";\r\n  directTextBuffer = ti.value;\r\n});\r\n\r\nti.addEventListener(\"keydown\", function (e) {\r\n  if 