{"format":"vetro-plugin","version":1,"manifest":{"id":"eightbitdo-guide","apiVersion":1,"name":"8BitDo Guide","version":"1.1.1","description":"Open the Vetro launcher with Guide on the Bluetooth 8BitDo Ultimate 2 Wireless; forward other buttons and axes. No network access.","author":"augusto1024","permissions":["exec"],"main":"index.js"},"files":{"GuideBridge.cs":"using System;\nusing System.IO;\nusing System.Text;\nusing System.Threading;\nusing System.Diagnostics;\nusing System.Collections.Generic;\nusing System.Runtime.InteropServices;\n\ninternal static class Program\n{\n    // Linux ARM32 UAPI constants: input.h/uinput.h. Keep the guard in Main\n    // before any evdev grab: this helper encodes 16-byte input_event records.\n    const string Name = \"8BitDo Ultimate 2 Wireless\", Phys = \"vetro-8bitdo-guide-proxy\";\n    const string StatusPath = \"/tmp/vetro-8bitdo-guide-status.json\";\n    const int Guide = 316, NonBlock = 0x800, CloseExec = 0x80000;\n    static int physical = -1, output = -1;\n    static volatile bool quitting;\n    static bool grabbed;\n    static uint presses, shown, frames;\n    static string last = \"waiting\", node;\n    static readonly Stopwatch lifetime = Stopwatch.StartNew();\n    static int previewSeconds;\n    static bool Expired\n    {\n        get\n        {\n            return quitting || (previewSeconds > 0 && lifetime.Elapsed.TotalSeconds >= previewSeconds);\n        }\n    }\n\n    [StructLayout(LayoutKind.Sequential)]\n    struct PollFd\n    {\n        public int fd;\n        public short events, revents;\n    }\n\n    struct Ev\n    {\n        public ushort type, code;\n        public int value;\n        public Ev(int t, int c, int v)\n        {\n            type = (ushort)t;\n            code = (ushort)c;\n            value = v;\n        }\n    }\n\n    [DllImport(\"libc.so.6\", SetLastError = true)]\n    static extern int open(string name, int flags, int mode);\n    [DllImport(\"libc.so.6\")]\n    static extern int close(int fd);\n    [DllImport(\"libc.so.6\", SetLastError = true)]\n    static extern int flock(int fd, int op);\n    [DllImport(\"libc.so.6\", EntryPoint = \"ioctl\", SetLastError = true)]\n    static extern int IoInt(int fd, uint code, int arg);\n    [DllImport(\"libc.so.6\", EntryPoint = \"ioctl\", SetLastError = true)]\n    static extern int IoBytes(int fd, uint code, [In, Out] byte[] arg);\n    [DllImport(\"libc.so.6\", EntryPoint = \"ioctl\", SetLastError = true)]\n    static extern int IoString(int fd, uint code, string arg);\n    [DllImport(\"libc.so.6\", SetLastError = true)]\n    static extern IntPtr read(int fd, [Out] byte[] data, UIntPtr count);\n    [DllImport(\"libc.so.6\", SetLastError = true)]\n    static extern IntPtr write(int fd, byte[] data, UIntPtr count);\n    [DllImport(\"libc.so.6\", SetLastError = true)]\n    static extern int poll([In, Out] PollFd[] fds, uint count, int timeout);\n    [DllImport(\"libc.so.6\")]\n    static extern int rename(string from, string to);\n    static uint ReadCode(int n, int size)\n    {\n        return 0x80004500u | ((uint)size << 16) | (uint)n;\n    }\n\n    static bool Bit(byte[] mask, int bit)\n    {\n        return bit >= 0 && bit < mask.Length * 8 && (mask[bit / 8] & (1 << (bit % 8))) != 0;\n    }\n\n    static byte[] Query(int fd, int n, int size)\n    {\n        byte[] b = new byte[size];\n        if (IoBytes(fd, ReadCode(n, size), b) < 0)\n            throw new IOException(\"input-query-\" + n);\n        return b;\n    }\n\n    static void Require(int result, string operation)\n    {\n        if (result < 0)\n            throw new IOException(operation + \"-errno-\" + Marshal.GetLastWin32Error());\n    }\n\n    static string Text(byte[] b)\n    {\n        return Encoding.UTF8.GetString(b).TrimEnd('\\0');\n    }\n\n    static int Find()\n    {\n        for (int i = 0; i < 128; i++)\n        {\n            string path = \"/dev/input/event\" + i;\n            int fd = open(path, NonBlock | CloseExec, 0);\n            if (fd < 0)\n                continue;\n            try\n            {\n                byte[] id = Query(fd, 2, 8), location = new byte[128];\n                IoBytes(fd, ReadCode(7, 128), location); // many Bluetooth devices have no phys string\n                if (BitConverter.ToUInt16(id, 0) == 5 && BitConverter.ToUInt16(id, 2) == 0x2dc8 && BitConverter.ToUInt16(id, 4) == 0x6012 && Text(Query(fd, 6, 128)) == Name && Text(location) != Phys)\n                {\n                    node = path;\n                    return fd;\n                }\n            }\n            catch\n            {\n            }\n\n            close(fd);\n        }\n\n        node = null;\n        return -1;\n    }\n\n    static void Save(bool running)\n    {\n        try\n        {\n            string safe = last.Replace(\"\\\\\", \"_\").Replace(\"\\\"\", \"_\").Replace(\"\\n\", \" \");\n            File.WriteAllText(StatusPath + \".new\", \"{\\\"running\\\":\" + (running ? \"true\" : \"false\") + \",\\\"connected\\\":\" + (grabbed ? \"true\" : \"false\") + \",\\\"mode\\\":\\\"proxy\\\",\\\"preview\\\":\" + (previewSeconds > 0 ? \"true\" : \"false\") + \",\\\"node\\\":\\\"\" + (node ?? \"\") + \"\\\",\\\"presses\\\":\" + presses + \",\\\"emitted\\\":\" + shown + \",\\\"frames\\\":\" + frames + \",\\\"lastResult\\\":\\\"\" + safe + \"\\\"}\");\n            rename(StatusPath + \".new\", StatusPath);\n        }\n        catch\n        {\n        }\n    }\n\n    static void Cleanup()\n    {\n        int fd = Interlocked.Exchange(ref physical, -1);\n        grabbed = false;\n        if (fd >= 0)\n        {\n            IoInt(fd, 0x40044590, 0);\n            close(fd);\n        }\n\n        int ui = Interlocked.Exchange(ref output, -1);\n        if (ui >= 0)\n        {\n            IoInt(ui, 0x5502, 0);\n            close(ui);\n        }\n    }\n\n    static bool LauncherRunning()\n    {\n        try\n        {\n            int pid = int.Parse(File.ReadAllText(\"/home/owner/tvlauncher.pid\").Trim());\n            return pid > 1 && File.ReadAllText(\"/proc/\" + pid + \"/cmdline\").Contains(\"tvlauncher-dotnet.dll\");\n        }\n        catch\n        {\n            return false;\n        }\n    }\n\n    static bool Fifo(string command)\n    {\n        int fd = open(\"/home/owner/tvlauncher.fifo\", 1 | NonBlock | CloseExec, 0);\n        if (fd < 0)\n            return false;\n        try\n        {\n            byte[] b = Encoding.ASCII.GetBytes(command + \"\\n\");\n            return write(fd, b, (UIntPtr)b.Length).ToInt64() == b.Length;\n        }\n        finally\n        {\n            close(fd);\n        }\n    }\n\n    static void Show()\n    {\n        presses++;\n        if (!LauncherRunning())\n        {\n            last = \"launcher-off\";\n            return;\n        }\n\n        // No Samsung Guide event is forwarded, so no Smart Hub close or timing race.\n        if (Fifo(\"hide\"))\n        {\n            Thread.Sleep(150);\n            if (Fifo(\"show\"))\n            {\n                shown++;\n                last = \"launcher-shown\";\n                Save(true);\n                return;\n            }\n        }\n\n        last = \"show-error\";\n        Save(true);\n    }\n\n    static int Clone(byte[] keys, byte[] axes)\n    {\n        byte[] types = Query(physical, 0x20, 8);\n        for (int i = 0; i < 64; i++)\n            if (Bit(types, i) && i != 0 && i != 1 && i != 3 && i != 4)\n                throw new IOException(\"unsupported-event-type-\" + i);\n        if (Bit(axes, 47))\n            throw new IOException(\"multitouch-not-supported\");\n        int ui = open(\"/dev/uinput\", 1 | NonBlock | CloseExec, 0);\n        if (ui < 0)\n            throw new IOException(\"uinput-open\");\n        bool ok = false;\n        try\n        {\n            foreach (int type in new[]\n            {\n                1,\n                3,\n                4\n            }\n\n            )\n                if (Bit(types, type))\n                    Require(IoInt(ui, 0x40045564, type), \"event-capability\");\n            for (int i = 0; i < 768; i++)\n                if (Bit(keys, i))\n                    Require(IoInt(ui, 0x40045565, i), \"key-capability\");\n            byte[] msc = Query(physical, 0x24, 8);\n            for (int i = 0; i < 64; i++)\n                if (Bit(msc, i))\n                    Require(IoInt(ui, 0x40045568, i), \"msc-capability\");\n            byte[] props = Query(physical, 9, 8);\n            for (int i = 0; i < 64; i++)\n                if (Bit(props, i))\n                    Require(IoInt(ui, 0x4004556e, i), \"input-property\");\n            for (int i = 0; i < 64; i++)\n                if (Bit(axes, i))\n                {\n                    Require(IoInt(ui, 0x40045567, i), \"axis-capability\");\n                    byte[] setup = new byte[28];\n                    setup[0] = (byte)i;\n                    Array.Copy(Query(physical, 0x40 + i, 24), 0, setup, 4, 24);\n                    Require(IoBytes(ui, 0x401c5504, setup), \"axis-setup\");\n                }\n\n            byte[] dev = new byte[92];\n            Array.Copy(Query(physical, 2, 8), dev, 8);\n            byte[] title = Encoding.ASCII.GetBytes(Name);\n            Array.Copy(title, 0, dev, 8, title.Length);\n            Require(IoBytes(ui, 0x405c5503, dev), \"device-setup\");\n            Require(IoString(ui, 0x4004556c, Phys), \"device-identity\");\n            Require(IoInt(ui, 0x5501, 0), \"device-create\");\n            ok = true;\n            return ui;\n        }\n        finally\n        {\n            if (!ok)\n                close(ui);\n        }\n    }\n\n    static byte[] Pack(List<Ev> events)\n    {\n        byte[] b = new byte[events.Count * 16];\n        for (int i = 0; i < events.Count; i++)\n        {\n            int o = i * 16;\n            Ev e = events[i];\n            b[o + 8] = (byte)e.type;\n            b[o + 9] = (byte)(e.type >> 8);\n            b[o + 10] = (byte)e.code;\n            b[o + 11] = (byte)(e.code >> 8);\n            Array.Copy(BitConverter.GetBytes(e.value), 0, b, o + 12, 4);\n        }\n\n        return b;\n    }\n\n    static void Send(List<Ev> events)\n    {\n        if (events.Count == 0)\n            return;\n        byte[] b = Pack(events);\n        long n = write(output, b, (UIntPtr)b.Length).ToInt64();\n        if (n != b.Length)\n            throw new IOException(\"proxy-write\");\n        frames++;\n    }\n\n    static bool Filter(Ev e, List<Ev> frame, ref bool held)\n    {\n        if (e.type == 1 && e.code == Guide)\n        {\n            if (frame.Count > 0 && frame[frame.Count - 1].type == 4 && frame[frame.Count - 1].code == 4)\n                frame.RemoveAt(frame.Count - 1);\n            if (e.value == 1)\n                held = true;\n            else if (e.value == 0 && held)\n            {\n                held = false;\n                return true;\n            }\n\n            return false;\n        }\n\n        frame.Add(e);\n        return false;\n    }\n\n    static bool Sync(byte[] keys, byte[] axes)\n    {\n        byte[] state = Query(physical, 0x18, 96);\n        var frame = new List<Ev>();\n        for (int i = 0; i < 768; i++)\n            if (Bit(keys, i) && i != Guide)\n                frame.Add(new Ev(1, i, Bit(state, i) ? 1 : 0));\n        for (int i = 0; i < 64; i++)\n            if (Bit(axes, i))\n                frame.Add(new Ev(3, i, BitConverter.ToInt32(Query(physical, 0x40 + i, 24), 0)));\n        frame.Add(new Ev(0, 0, 0));\n        Send(frame);\n        return Bit(state, Guide);\n    }\n\n    static void Route(byte[] keys, byte[] axes)\n    {\n        byte[] bytes = new byte[4096];\n        // Clear pre-grab events; reconstruct the full current button/axis state.\n        for (int i = 0; i < 32; i++)\n            if (read(physical, bytes, (UIntPtr)bytes.Length).ToInt64() < 0)\n                break;\n        bool held = Sync(keys, axes), dropped = false, show = false;\n        var frame = new List<Ev>();\n        var check = Stopwatch.StartNew();\n        var saved = Stopwatch.StartNew();\n        PollFd[] p =\n        {\n            new PollFd\n            {\n                fd = physical,\n                events = 1\n            }\n        };\n        while (!Expired)\n        {\n            if (check.ElapsedMilliseconds > 2000)\n            {\n                if (!LauncherRunning())\n                    return;\n                check.Restart();\n            }\n\n            p[0].revents = 0;\n            int n = poll(p, 1, 250);\n            if (n < 0)\n            {\n                if (Marshal.GetLastWin32Error() == 4)\n                    continue;\n                return;\n            }\n\n            if (n == 0)\n                continue;\n            if ((p[0].revents & 0x38) != 0)\n                return;\n            long count = read(physical, bytes, (UIntPtr)bytes.Length).ToInt64();\n            if (count < 0)\n            {\n                int err = Marshal.GetLastWin32Error();\n                if (err == 4 || err == 11)\n                    continue;\n                return;\n            }\n\n            if (count == 0 || count % 16 != 0)\n                return;\n            for (int o = 0; o < count; o += 16)\n            {\n                Ev e = new Ev(BitConverter.ToUInt16(bytes, o + 8), BitConverter.ToUInt16(bytes, o + 10), BitConverter.ToInt32(bytes, o + 12));\n                if (e.type == 0 && e.code == 3)\n                {\n                    dropped = true;\n                    frame.Clear();\n                    show = false;\n                    continue;\n                }\n\n                if (dropped)\n                {\n                    if (e.type == 0 && e.code == 0)\n                    {\n                        held = Sync(keys, axes);\n                        dropped = false;\n                    }\n\n                    continue;\n                }\n\n                show = Filter(e, frame, ref held) || show;\n                if (e.type == 0 && e.code == 0)\n                {\n                    Send(frame);\n                    frame.Clear();\n                    if (show)\n                    {\n                        Show();\n                        show = false;\n                    }\n                }\n\n                if (frame.Count > 512)\n                    throw new IOException(\"missing-input-sync\");\n            }\n\n            if (saved.ElapsedMilliseconds > 2000)\n            {\n                Save(true);\n                saved.Restart();\n            }\n        }\n    }\n\n    static int SelfTest()\n    {\n        bool held = false;\n        var f = new List<Ev>();\n        Filter(new Ev(4, 4, 0x90001), f, ref held);\n        Filter(new Ev(1, 304, 1), f, ref held);\n        Filter(new Ev(3, 0, -12345), f, ref held);\n        Filter(new Ev(4, 4, 0x9000d), f, ref held);\n        if (Filter(new Ev(1, Guide, 1), f, ref held))\n            return 1;\n        Filter(new Ev(1, Guide, 2), f, ref held);\n        Filter(new Ev(4, 4, 0x9000d), f, ref held);\n        if (!Filter(new Ev(1, Guide, 0), f, ref held))\n            return 2;\n        if (Filter(new Ev(1, Guide, 0), f, ref held))\n            return 3;\n        Filter(new Ev(1, 304, 0), f, ref held);\n        Filter(new Ev(0, 0, 0), f, ref held);\n        if (f.Count != 5 || f[0].value != 0x90001 || f[1].code != 304 || f[2].value != -12345 || f[3].value != 0 || f[4].type != 0)\n            return 4;\n        byte[] packed = Pack(f);\n        if (packed.Length != 80 || BitConverter.ToInt32(packed, 44) != -12345)\n            return 5;\n        foreach (Ev e in f)\n            if (e.type == 1 && e.code == Guide)\n                return 6;\n        Console.WriteLine(\"Guide/scancode suppression, mixed button+axis passthrough, press/repeat/release, and 32-bit framing checks passed\");\n        return 0;\n    }\n\n    static int Main(string[] args)\n    {\n        if (args.Length == 1 && args[0] == \"--self-test\")\n            return SelfTest();\n        if (IntPtr.Size != 4 || !BitConverter.IsLittleEndian)\n        {\n            Console.Error.WriteLine(\"This helper requires a 32-bit little-endian TV runtime.\");\n            return 2;\n        }\n        if (args.Length == 1 && args[0] == \"--check-platform\")\n            return 0;\n        if (args.Length > 0 && (args.Length != 2 || args[0] != \"--preview-seconds\" || !int.TryParse(args[1], out previewSeconds) || previewSeconds < 1 || previewSeconds > 300))\n            return 2;\n        int locked = open(\"/tmp/vetro-8bitdo-guide.lock\", 2 | 0x40 | CloseExec, 384);\n        if (locked < 0)\n            return 1;\n        if (flock(locked, 2 | 4) < 0)\n        {\n            close(locked);\n            return 0;\n        }\n\n        AppDomain.CurrentDomain.ProcessExit += (s, e) =>\n        {\n            quitting = true;\n            Cleanup();\n            last = \"stopped\";\n            Save(false);\n        };\n        try\n        {\n            Save(true);\n            while (!Expired)\n            {\n                if (!LauncherRunning())\n                {\n                    last = \"launcher-off\";\n                    Save(true);\n                    Thread.Sleep(500);\n                    continue;\n                }\n\n                physical = Find();\n                if (physical < 0)\n                {\n                    last = \"waiting\";\n                    Save(true);\n                    Thread.Sleep(500);\n                    continue;\n                }\n\n                try\n                {\n                    byte[] keys = Query(physical, 0x21, 96), axes = Query(physical, 0x23, 8);\n                    output = Clone(keys, axes);\n                    Thread.Sleep(1000);\n                    if (Expired)\n                        break;\n                    Require(IoInt(physical, 0x40044590, 1), \"controller-grab\");\n                    grabbed = true;\n                    last = \"ready\";\n                    Save(true);\n                    Route(keys, axes);\n                }\n                catch (Exception e)\n                {\n                    last = e.Message;\n                }\n                finally\n                {\n                    Cleanup();\n                    Save(true);\n                }\n\n                if (!Expired)\n                    Thread.Sleep(1000);\n            }\n\n            return 0;\n        }\n        finally\n        {\n            Cleanup();\n            last = previewSeconds > 0 ? \"preview-ended\" : \"stopped\";\n            Save(false);\n            close(locked);\n        }\n    }\n}\n","README.md":"# 8BitDo Guide\n\nOpen Vetro's launcher by releasing Guide on an **8BitDo Ultimate 2 Wireless,\nconnected over Bluetooth**. Other buttons, scan codes and stick/trigger axes\nare forwarded through a virtual copy of the gamepad.\n\n## Compatibility\n\n| Device or feature | Status |\n| --- | --- |\n| 8BitDo Ultimate 2 Wireless, Bluetooth, `2dc8:6012` | Selected explicitly; tested on the TV below |\n| Other 8BitDo models, USB or wireless-dongle modes | Not supported by this device selector; untested |\n| Microsoft Xbox controllers | Not selected and not tested |\n| Force feedback or event types beyond keys, absolute axes and scan codes | Rejected before taking control of the physical device |\n\nThe selector checks the exact name, Bluetooth bus, vendor and product IDs.\nThis is not a generic Xbox-controller remapper. Supporting another device needs\nits own capability and application tests, including its haptics and controller\nenumeration; changing the name/IDs alone does not establish compatibility.\n\n### Requirements\n\n- A rooted TV running Vetro 0.5.0 with the Vetro launcher enabled.\n- The TV's existing .NET 3.1 runtime at `/usr/bin/dotnet`; none is installed by this Shard.\n- 32-bit little-endian Linux input-event records, evdev, `/dev/uinput`, and\n  systemd with `systemd-run --collect`.\n\nOlder TVs, other runtime versions, and 64-bit input-event layouts have not been\nvalidated. ES5 compatibility of the wrapper does not establish TV compatibility.\n\n### Actual TV tests\n\nThe helper in 1.1.0 was tested on a **Samsung UN43BU8000GXUG**, Tizen **6.5**,\nfirmware **T-KSU2EBUABC-1720.7**, Vetro **0.5.0**:\n\n- The owner confirmed Guide opens Vetro and it stays open from YouTube.\n- The owner confirmed Moonlight's controller buttons/sticks and Guide work.\n- The bounded preview was stopped and the normal supervised helper was enabled;\n  the TV reported exactly one proxy, with the preview stopped.\n\nThis 1.1.1 contribution keeps that helper behavior, refuses unsupported 64-bit\nruntime layouts before opening devices, makes its payload rebuildable, adds\nwrapper error/lifecycle checks, and supplies catalog metadata.\nThose packaging/wrapper changes are checked locally; they have not been installed\non the test TV. A reboot of the final proxy helper, standby/wake, and a physical\nBluetooth disconnect/reconnect have not been manually confirmed.\n\n## How it works\n\nSamsung's original Guide action competes with a second Home/show action. Merely\nobserving Guide and then opening Vetro did not work reliably on the test TV.\n\nThe helper clones the selected gamepad's identity, key/scan-code capabilities,\naxis limits, fuzz, flat, resolution and current state through uinput. It then\ntakes an exclusive evdev grab and forwards input frames, withholding Guide and\nits adjacent scan code. Guide release sends `hide`/`show` through Vetro's local\nlauncher FIFO. `SYN_DROPPED` triggers a full key/axis state resynchronization.\n\nThe TV/Moonlight may enumerate the clone as another controller. Test actual\ngameplay before leaving it enabled. The controller is released and the clone\ndestroyed when the helper stops, the controller disconnects, or the launcher\nturns off; the kernel also closes both descriptors if the process is killed.\n\n**Private integration:** `/home/owner/tvlauncher.pid` and `tvlauncher.fifo` are\nVetro launcher implementation details, not Shard API hooks. A Vetro update can\nbreak this integration. This Shard does not modify Vetro or Samsung firmware.\n\n## Permissions\n\n`exec`: runs the supervised helper as root to read/grab evdev, create a uinput\ndevice, and write to the launcher's FIFO. These are privileged operations.\n\n### Commands it runs\n\n| Command | Purpose |\n| --- | --- |\n| `echo … \\| base64 -d \\| sh` | Pass a fixed script to Vetro's root agent |\n| `base64 -d`, `gzip -d`, `chmod 600`, `mv` | Materialize the bundled managed DLL in the Shard's directory; no executable is downloaded |\n| `/usr/bin/dotnet … --self-test` | Check the helper's filter/framing before starting it |\n| `/usr/bin/dotnet … --check-platform` | Refuse unsupported runtime layouts before creating a service |\n| `systemctl is-active`, `reset-failed` | Inspect/reset this Shard's own transient unit |\n| `systemd-run --unit=vetro-8bitdo-guide --collect … /usr/bin/dotnet …` | Start the helper with restart-on-failure supervision |\n| `systemctl stop vetro-8bitdo-guide.service` | Stop the helper and release the controller |\n| `cat /tmp/vetro-8bitdo-guide-status.json` | Read current helper status |\n\nThe helper uses libc input ioctls and file I/O. It does not start or kill Samsung\nHome, run shell commands on button presses, or open a network listener.\n\n## Network\n\nNone. No runtime downloads or outbound requests.\n\n## Data it keeps\n\n- In `ctx.dir`: the reconstructed `guide-bridge.dll` and its temporary `.new` file.\n- In `/tmp`: `vetro-8bitdo-guide.lock` (process lock),\n  `vetro-8bitdo-guide-status.json` and `.new` (device node, current state and\n  counts), and `vetro-8bitdo-guide-selftest.log` (self-test result).\n- A transient systemd unit; no persistent systemd service file is installed.\n\nNo configuration, account credentials, room/TV identifiers or key-history log\nis stored. Status counters reset with the helper. Removing the disabled Shard\nremoves its directory; the small `/tmp` files disappear at reboot.\n\n## Disable or recover\n\nUse **Vetro Shards → 8BitDo Guide → Disable**, then Remove to uninstall.\nUse the TV remote or dashboard browser if gamepad controls are unavailable.\nThe helper's `--preview-seconds 120` mode automatically releases the controller;\nthe on-TV preview was also bounded by a separate systemd time limit.\n\n## Helper source and build\n\n`GuideBridge.cs` is the readable helper source. The managed payload is stored\nas gzip/base64 because the bundle format accepts text files. This is compiled\ncode, not plain JavaScript; it needs explicit maintainer review under the\ncatalog's text-only/no-binary policy. The private launcher integration above\nalso needs review before catalog publication.\n\nThe project at `helpers/eightbitdo-guide/GuideBridge.csproj` pins SDK 8.0.100 and\ntargets the TV's existing .NET 3.1 runtime. From the repository root:\n\n```sh\nnode scripts/build-eightbitdo-guide-helper.cjs\nnode scripts/build-eightbitdo-guide-helper.cjs --check\nnpm run build\nnpm test\nnpm run check\nnpm run test:runtime\n```\n\nThe helper build runs filter tests without TV access and produces a deterministic\nDLL without debug paths. `--check` rebuilds and compares the packaged payload,\nruntime configuration and dependency manifest with source. CI does the same.\nTests cover Guide/scan-code removal in a packet that also contains another\nbutton and axis movement, repeats/releases and 32-bit event encoding.\n","guide-bridge.deps.json":"{\n  \"runtimeTarget\": {\n    \"name\": \".NETCoreApp,Version=v3.1\",\n    \"signature\": \"\"\n  },\n  \"compilationOptions\": {},\n  \"targets\": {\n    \".NETCoreApp,Version=v3.1\": {\n      \"guide-bridge/1.0.0\": {\n        \"runtime\": {\n          \"guide-bridge.dll\": {}\n        }\n      }\n    }\n  },\n  \"libraries\": {\n    \"guide-bridge/1.0.0\": {\n      \"type\": \"project\",\n      \"serviceable\": false,\n      \"sha512\": \"\"\n    }\n  }\n}","guide-bridge.dll.gz.b64":"\n","guide-bridge.runtimeconfig.json":"{\n  \"runtimeOptions\": {\n    \"tfm\": \"netcoreapp3.1\",\n    \"framework\": {\n      \"name\": \"Microsoft.NETCore.App\",\n      \"version\": \"3.1.0\"\n    },\n    \"configProperties\": {\n      \"System.Reflection.Metadata.MetadataUpdater.IsSupported\": false\n    }\n  }\n}","index.js":"'use strict';\n\n// The bundled .NET helper forwards a matching gamepad, withholding Guide.\n// It releases its evdev grab and virtual gamepad when stopped. See README.md.\nmodule.exports = function (ctx) {\n    var fs = require('fs');\n    var path = require('path');\n    var timer = null;\n    var active = false;\n    var busy = false;\n    var generation = 0;\n    var detail = { running: false, connected: false, lastResult: 'stopped' };\n    var unit = 'vetro-8bitdo-guide';\n\n    function quote(value) {\n        return \"'\" + value.replace(/'/g, \"'\\\\''\") + \"'\";\n    }\n\n    function shell(script) {\n        var bytes = Buffer.from ? Buffer.from(script) : new Buffer(script);\n        return 'echo ' + bytes.toString('base64') + ' | base64 -d | sh';\n    }\n\n    function stopCommand() {\n        return 'systemctl stop ' + unit + '.service >/dev/null 2>&1 || true';\n    }\n\n    function startCommand() {\n        // Assets belong to the installed module; ctx.dir is its writable work area.\n        var encoded = fs.readFileSync(path.join(__dirname, 'guide-bridge.dll.gz.b64'), 'utf8').trim();\n        var binary = path.join(ctx.dir, 'guide-bridge.dll');\n        return shell('set -e\\n' +\n            'if ! systemctl is-active --quiet ' + unit + '.service; then\\n' +\n            'echo ' + quote(encoded) + ' | base64 -d | gzip -d > ' + quote(binary + '.new') + '\\n' +\n            'chmod 600 ' + quote(binary + '.new') + '\\n' +\n            'mv ' + quote(binary + '.new') + ' ' + quote(binary) + '\\n' +\n            '/usr/bin/dotnet ' + quote(binary) + ' --self-test > /tmp/vetro-8bitdo-guide-selftest.log\\n' +\n            '/usr/bin/dotnet ' + quote(binary) + ' --check-platform\\n' +\n            'systemctl reset-failed ' + unit + '.service >/dev/null 2>&1 || true\\n' +\n            'systemd-run --unit=' + unit + ' --collect -p Restart=on-failure -p RestartSec=2 ' +\n            '-p StandardOutput=null -p StandardError=null /usr/bin/dotnet ' + quote(binary) + ' >/dev/null 2>&1\\n' +\n            'fi\\ncat /tmp/vetro-8bitdo-guide-status.json 2>/dev/null || echo \"{}\"');\n    }\n\n    function failure(error, mine) {\n        if (active && mine === generation) {\n            detail = { running: false, connected: false, lastResult: String(error.message || error) };\n        }\n    }\n\n    function check() {\n        if (!active || busy) return;\n        busy = true;\n        var mine = generation;\n        var command;\n        try {\n            command = startCommand();\n        } catch (error) {\n            failure(error, mine);\n            busy = false;\n            return;\n        }\n        // A synchronous execute failure must also stay inside this callback.\n        Promise.resolve().then(function () {\n            return ctx.execute(command, 10000);\n        }).then(function (result) {\n            if (!active) return ctx.execute(stopCommand(), 10000);\n            if (mine !== generation) return;\n            if (result.exit_code || result.timed_out) {\n                throw new Error(result.stderr || 'Could not start the Guide bridge');\n            }\n            try {\n                detail = JSON.parse(result.stdout);\n            } catch (error) {\n                detail = { running: true, connected: false, lastResult: 'starting' };\n            }\n        }).catch(function (error) {\n            failure(error, mine);\n        }).then(function () {\n            busy = false;\n        });\n    }\n\n    return {\n        start: function () {\n            if (active) return;\n            active = true;\n            generation++;\n            detail = { running: false, connected: false, lastResult: 'starting' };\n            check();\n            timer = setInterval(check, 5000);\n        },\n        stop: function () {\n            active = false;\n            generation++;\n            if (timer) clearInterval(timer);\n            timer = null;\n            detail = { running: false, connected: false, lastResult: 'stopped' };\n            return Promise.resolve().then(function () {\n                return ctx.execute(stopCommand(), 10000);\n            }).catch(function () {});\n        },\n        status: function () {\n            return detail;\n        }\n    };\n};\n"}}
